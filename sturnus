def tailnet_login(ip):
    """Whose device a tailnet address is (tailscale whois; looked up again every few minutes), or None."""
    try:
        if not any(ipaddress.ip_address(ip) in n for n in TAILNET):
            return None
    except ValueError:
        return None
    hit = _whois.get(ip)
    if not hit or time.time() - hit[0] > 300:
        r = run([*(tailscale() or ['tailscale']), 'whois', '--json', ip], timeout=5)
        try:
            d = json.loads(r.stdout)
            hit = (time.time(), d['UserProfile']['LoginName'], (d.get('Node') or {}).get('ComputedName') or (d.get('Node') or {}).get('Name', '').split('.')[0])
        except (ValueError, KeyError, TypeError):
            hit = (time.time(), None, None)
        _whois[ip] = hit
    return hit[1:]


