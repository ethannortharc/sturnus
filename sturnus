# ---------- talk between sessions ----------

class Talk:
    """What the sessions said to each other: amail's mail, and Claude Code's own cross-session messages."""
    RX = re.compile(r'<cross-session-message[^>]*?from-name="([^"]+)"[^>]*>(.*?)</cross-session-message>', re.S)

    def __init__(self):
        self.native = deque(maxlen=400)
        self.offsets = {}
        self.seen = set()

    def scan_claude(self, name, path):
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        start = self.offsets.get(path)
        if start is None:
            start = max(0, size - 1500000)
        if size <= start:
            self.offsets[path] = size
            return
        with open(path, 'rb') as f:
            f.seek(start)
            data = f.read(size - start).decode('utf-8', 'replace')
        cut = data.rfind('\n') + 1
        self.offsets[path] = start + (cut if cut else 0)
        for line in data[:cut].splitlines():
            if 'cross-session-message' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            t, _ = text_of((d.get('message') or {}).get('content'))
            for frm, body in self.RX.findall(t):
                key = (frm, name, body[:80])
                if key in self.seen:
                    continue
                self.seen.add(key)
                at = d.get('timestamp')
                try:
                    at = time.mktime(time.strptime(at[:19], '%Y-%m-%dT%H:%M:%S')) - time.timezone if at else time.time()
                except (ValueError, TypeError):
                    at = time.time()
                self.native.append({'key': f'c:{frm}:{name}:{at:.0f}:{len(body)}', 'from': frm, 'to': name, 'text': body.strip()[:1200], 'at': at, 'via': 'claude'})

    def mail(self):
        out = []
        root = os.path.join(A.HOME, 'mail')
        for f in glob.glob(os.path.join(root, '*', '*', '*.json')):
            m = A.get(f)
            if m:
                out.append({'key': 'a:' + str(m.get('id') or os.path.basename(f)), 'from': m.get('from'), 'to': m.get('to'), 'text': (m.get('text') or '')[:1200], 'at': m.get('at') or 0,
                            'via': 'amail', 'unread': os.path.basename(os.path.dirname(f)) == 'new'})
        return out

    def all(self):
        items = self.mail() + list(self.native)
        items.sort(key=lambda m: -(m.get('at') or 0))
        return items[:300]


# ---------- workspaces, projects, work items ----------
# A workspace is a folder of projects (config "workspaces", else the folder above each git repository the sessions work
# in); a project is a git repository (all its worktrees one project) or a plain folder in a workspace; a work item is one
# of its worktrees and that worktree's branch. A session belongs to the project of the folder it is in now; one at the
# workspace's top by the files it works on; else to the workspace itself. The person can say otherwise.

GENERIC = {'workspace', 'workspaces', 'projects', 'project', 'src', 'code', 'repos', 'work', 'dev', 'git'}
USER_HOME = os.path.expanduser('~')
TOUCH = {'Edit': 3, 'Write': 3, 'MultiEdit': 3, 'NotebookEdit': 3, 'Read': 1, 'Grep': 1, 'Glob': 1}
CD = re.compile(r'(?:^|[;&|(]\s*)(?:cd|pushd)\s+("[^"]+"|\'[^\']+\'|[^\s;&|)]+)|\bgit\s+-C\s+("[^"]+"|\'[^\']+\'|[^\s;&|)]+)')
PATCH = re.compile(r'^\*\*\* (?:Update|Add|Delete) File: (.+)$', re.M)


def git(cwd, *args, timeout=6):
    r = run(['git', '-C', cwd, *args], timeout=timeout)
    return r.stdout.strip() if r.returncode == 0 else None


def ws_name(p):
    """A workspace's name: its folder's, or the one above when that is a generic word (…/software/workspace: software)."""
    b, up = os.path.basename(p), os.path.dirname(p)
    return os.path.basename(up) if b.lower() in GENERIC and up not in ('/', USER_HOME) else b


def web_url(remote):
    """A remote's page: git@host:o/r.git or ssh://git@host/o/r and https ones, as https://host/o/r."""
    if not remote:
        return None
    m = re.match(r'^(?:ssh://)?[^@/]+@([^:/]+)(?::\d+)?[:/](.+?)(?:\.git)?/?$', remote) or re.match(r'^https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?$', remote)
    return f'https://{m.group(1)}/{m.group(2)}' if m else None


class Projects:
    def __init__(self, cfg):
        self.cfg = cfg
        self.places = {}  # folder -> (when, where it is)
        self.facts = {}  # project key -> its git facts (refreshed by facts_loop)
        self.known = {}  # project key -> {key, name, path, git, workspace}
        self.touches = {}  # transcript -> (size, when, {project key: weight, work path: weight})
        self.kids = {}  # workspace -> (when, its projects)
        self.wpaths = {}  # workspace key -> its folder
        self.efile = os.path.join(CACHE, 'workspaces.json')
        self.ever = set(A.get(self.efile, []) or [])  # (every workspace a session has worked in: listed even when quiet)
        self.mfile = os.path.join(CACHE, 'attrib.json')
        self.manual = A.get(self.mfile, {}) or {}  # session id -> project key, or 'w:' + workspace key (the person's word)

    def configured(self):
        return [os.path.realpath(os.path.expanduser(p)) for p in self.cfg.get('workspaces') or []]

    def ws_of(self, root):
        """The workspace a project's folder is in: a configured one around it, else the folder above it (not the home
        folder or the root: a repository right in there is in no workspace)."""
        inside = [w for w in self.configured() if root == w or root.startswith(w + '/')]
        up = os.path.dirname(root)
        return max(inside, key=len) if inside else None if up in (USER_HOME, '/') else up

    def is_ws(self, p):
        """A folder of projects: configured, above a project seen, or holding two git repositories or more."""
        if p in self.configured():
            return True
        if p in (USER_HOME, '/'):
            return False
        if any(x['workspace'] == p for x in list(self.known.values())):
            return True
        try:
            subs = [e.path for e in os.scandir(p) if e.is_dir() and not e.name.startswith('.')][:80]
        except OSError:
            return False
        return sum(os.path.exists(os.path.join(d, '.git')) for d in subs) >= 2

    def where(self, p):
        """Where a folder is: {project: {key, name, path, git, workspace} | None, work: worktree path, branch, workspace}."""
        if not p:
            return {'project': None, 'workspace': None}
        p = os.path.realpath(os.path.expanduser(p))
        while not os.path.isdir(p) and p not in ('/', USER_HOME):  # (a folder since removed, a worktree merged: where it was)
            p = os.path.dirname(p)
        hit = self.places.get(p)
        if hit and time.time() - hit[0] < 600:
            return hit[1]
        if len(self.places) > 3000:
            self.places = {k: v for k, v in self.places.items() if time.time() - v[0] < 600}
        out = {'project': None, 'workspace': None, 'work': None, 'branch': None}
        rows = (git(p, 'rev-parse', '--path-format=absolute', '--git-common-dir', '--show-toplevel') or '').splitlines() if os.path.isdir(p) else []
        if len(rows) == 2:
            common, top = os.path.realpath(rows[0]), os.path.realpath(rows[1])
            root = os.path.dirname(common) if common.endswith('/.git') else common
            proj = {'key': A.key_of('p', common), 'name': os.path.basename(root), 'path': root, 'git': True, 'workspace': self.ws_of(root)}
            self.known[proj['key']] = proj
            out.update(project=proj, workspace=proj['workspace'], work=top, branch=git(top, 'symbolic-ref', '--short', '-q', 'HEAD') or '')
        else:
            ws = next((w for w in sorted(self.configured(), key=len, reverse=True) if p.startswith(w + '/')), None)
            up = p
            while not ws and up not in ('/', USER_HOME) and up.count('/') > 2:
                if self.is_ws(up):
                    ws = up
                up = os.path.dirname(up)
            if ws:
                out['workspace'] = ws
                if p != ws:  # (a plain folder in a workspace: its first level is the project)
                    root = os.path.join(ws, os.path.relpath(p, ws).split('/')[0])
                    proj = {'key': A.key_of('d', root), 'name': os.path.basename(root), 'path': root, 'git': False, 'workspace': ws}
                    self.known[proj['key']] = proj
                    out.update(project=proj, work=root)
        self.places[p] = (time.time(), out)
        return out

    def touched(self, s):
        """The projects (and worktrees) a session's recent tool calls worked in, weighted: edits 3, cd and git -C 2, reads 1."""
        path = transcript_of(s)
        if not path or path.endswith('/store.db'):
            return {}
        try:
            size = os.path.getsize(path)
        except OSError:
            return {}
        hit = self.touches.get(path)
        if hit and (hit[0] == size or time.time() - hit[1] < 60):
            return hit[2]
        weights, cwd = {}, s.get('cwd') or USER_HOME
        def add(p, w):
            if not p:
                return
            p = p.strip('"\'')
            p = os.path.normpath(os.path.join(cwd, os.path.expanduser(p)))
            d = p if os.path.isdir(p) else os.path.dirname(p)
            at = self.where(d)
            if at.get('project'):
                weights[at['project']['key']] = weights.get(at['project']['key'], 0) + w
                weights[at['work']] = weights.get(at['work'], 0) + w
        calls = 0
        for line in reversed(tail_lines(path, 900000)):
            if calls >= 200:
                break
            if 'tool_use' not in line and 'function_call' not in line and 'custom_tool_call' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            items = ((d.get('message') or {}).get('content') if isinstance(d.get('message'), dict) else None) or []
            for x in items if isinstance(items, list) else []:
                if isinstance(x, dict) and x.get('type') == 'tool_use':
                    calls += 1
                    i = x.get('input') if isinstance(x.get('input'), dict) else {}
                    if x.get('name') in TOUCH:
                        add(i.get('file_path') or i.get('notebook_path') or i.get('path'), TOUCH[x['name']])
                    elif x.get('name') == 'Bash':
                        for a, b in CD.findall(str(i.get('command') or '')):
                            add(a or b, 2)
            p = d.get('payload') if isinstance(d.get('payload'), dict) else {}
            if p.get('type') == 'function_call':
                calls += 1
                try:
                    args = json.loads(p.get('arguments') or '{}')
                except ValueError:
                    args = {}
                if isinstance(args, dict):
                    add(args.get('workdir') or args.get('cwd'), 2)
                    cmd = args.get('command')
                    for a, b in CD.findall(' '.join(cmd) if isinstance(cmd, list) else str(cmd or '')):
                        add(a or b, 2)
            elif p.get('type') == 'custom_tool_call':
                calls += 1
                for f in PATCH.findall(str(p.get('input') or '')):
                    add(f, 3)
        self.touches[path] = (size, time.time(), weights)
        return weights

    def attribute(self, s):
        """A session's project, work item and workspace, and how that was found: the person's word, its folder, its files."""
        at = self.where(s.get('cwd'))
        how = 'cwd'
        m = self.manual.get(s['id'])
        if m:
            how = 'manual'
            if m.startswith('w:'):
                ws = next((w for w in self.workspace_paths() if A.key_of('w', w) == m[2:]), at.get('workspace'))
                at = {'project': None, 'workspace': ws, 'work': None, 'branch': None}
            elif m in self.known:
                p = self.known[m]
                same = at.get('project') and at['project']['key'] == m
                at = {'project': p, 'workspace': p['workspace'], 'work': at['work'] if same else None, 'branch': at['branch'] if same else None}
        elif not at.get('project'):
            w = self.touched(s)
            best = max((k for k in w if k in self.known), key=lambda k: w[k], default=None)
            if best:
                p, how = self.known[best], 'files'
                work = max((k for k in w if k.startswith('/') and (self.where(k).get('project') or {}).get('key') == best), key=w.get, default=None)
                at = {'project': p, 'workspace': p['workspace'], 'work': work, 'branch': work and self.where(work).get('branch')}
            else:
                how = 'workspace' if at.get('workspace') else ''
        p = at.get('project')
        s['project'] = p and p['key']
        s['workspace'] = at.get('workspace') and A.key_of('w', at['workspace'])
        if s['workspace']:
            self.wpaths[s['workspace']] = at['workspace']
            if at['workspace'] not in self.ever and not s.get('unknown'):
                self.ever.add(at['workspace'])
                A.put(self.efile, sorted(self.ever))
        s['work'], s['branch'], s['attrib'] = at.get('work'), at.get('branch') or '', how

    def set_manual(self, sid, value):
        if value:
            self.manual[sid] = value
        else:
            self.manual.pop(sid, None)
        A.put(self.mfile, self.manual)

    def workspace_paths(self):
        return [w for w in dict.fromkeys(self.configured() + [p['workspace'] for p in list(self.known.values())] + list(self.wpaths.values())
                                         + sorted(w for w in self.ever if os.path.isdir(w))) if w]  # (and, after a restart, the remembered ones)

    def channel(self, p):
        """A project as amail's channel (its key is the project's)."""
        return p and {'key': p['key'], 'name': p['name'], 'path': p['path'], 'kind': 'project'}

    def ws_channel(self, wkey):
        w = self.wpaths.get(wkey) or next((x for x in self.workspace_paths() if A.key_of('w', x) == wkey), None)
        return w and {'key': wkey, 'name': ws_name(w), 'path': w, 'kind': 'workspace'}

    def projects_in(self, ws):
        """A workspace's projects: its git repositories (not worktrees of another) and plain folders, cached 5 min."""
        hit = self.kids.get(ws)
        if hit and time.time() - hit[0] < 300:
            return hit[1]
        out = []
        try:
            subs = sorted(e.path for e in os.scandir(ws) if e.is_dir() and not e.name.startswith('.'))[:120]
        except OSError:
            subs = []
        for d in subs:
            d = os.path.realpath(d)
            if os.path.isdir(os.path.join(d, '.git')):
                out.append(self.where(d)['project'])
            elif not os.path.exists(os.path.join(d, '.git')):  # (a plain folder; a worktree has a .git file and is its repository's)
                proj = {'key': A.key_of('d', d), 'name': os.path.basename(d), 'path': d, 'git': False, 'workspace': ws}
                self.known.setdefault(proj['key'], proj)
                out.append(proj)
        out = [p for p in out if p]
        self.kids[ws] = (time.time(), out)
        return out

    def git_facts(self, p):
        """A repository now: its main branch and worktrees (branch, ahead of / behind main, uncommitted files, last commit),
        upstream, last tag, remote page."""
        root = p['path']
        rows = git(root, 'worktree', 'list', '--porcelain') or ''
        works, cur = [], None
        for line in rows.splitlines():
            if line.startswith('worktree '):
                cur = {'path': os.path.realpath(line[9:]), 'branch': ''}
                works.append(cur)
            elif cur and line.startswith('branch '):
                cur['branch'] = line[7:].removeprefix('refs/heads/')
            elif cur and line == 'detached':
                cur['branch'] = ''
        if not works:
            return None
        main = works[0]['branch'] or 'HEAD'
        for w in works:
            w['main'] = w['path'] == works[0]['path']
            w['dirty'] = len((git(w['path'], 'status', '--porcelain') or '').splitlines()) if os.path.isdir(w['path']) else None
            last = (git(w['path'], 'log', '-1', '--format=%ct%x09%h%x09%s') or '').split('\t') if os.path.isdir(w['path']) else []
            w['at'], w['head'], w['subject'] = (float(last[0]), last[1], last[2][:160]) if len(last) == 3 else (0, '', '')
            if not w['main'] and w['branch']:
                n = (git(root, 'rev-list', '--left-right', '--count', f'{main}...{w["branch"]}') or '').split()
                w['behind'], w['ahead'] = (int(n[0]), int(n[1])) if len(n) == 2 else (None, None)
        up = (git(root, 'rev-list', '--left-right', '--count', f'{main}...{main}@{{u}}') or '').split()
        return {'main': main, 'works': works, 'ahead': int(up[0]) if len(up) == 2 else None, 'behind': int(up[1]) if len(up) == 2 else None,
                'tag': git(root, 'describe', '--tags', '--abbrev=0', main) or '', 'url': web_url(git(root, 'remote', 'get-url', 'origin')), 'at': time.time()}

    def facts_loop(self, deck):
        """Git facts, the projects with sessions first, every half minute (one with nothing going on, every ten)."""
        while True:
            try:
                busy = {s.get('project') for s in getattr(deck, 'all', [])}
                for p in list(self.known.values()):
                    f = self.facts.get(p['key'])
                    if not p['git'] or p['key'] not in getattr(deck, 'shown', busy) or (f and time.time() - f['at'] < (30 if p['key'] in busy else 600)):
                        continue
                    self.facts[p['key']] = self.git_facts(p) or {'at': time.time(), 'works': [], 'none': True}
            except Exception as e:
                deck.note(f'读 git 出错：{e!r}', False)
            time.sleep(5)


# ---------- the deck ----------

ORDER_RANK = {'waiting': 0, 'working': 1, 'idle': 2}
CODEX_NOT_TUI = {'app-server', 'exec', 'e', 'review', 'queue', 'archive', 'unarchive', 'delete', 'mcp', 'login', 'logout',
                 'agents', 'plugin', 'debug', 'sandbox', 'apply', 'cloud', 'features', 'completion', 'doctor', 'update', 'fork',
                 'exec-server', 'migrate-rollouts', 'remote-control'}


class Deck:
    def __init__(self):
        self.cfg = config()
        self.sums = Summaries()
        self.reports = Reports()
        self.origins = {}  # (pid -> how it was started: the process tree above it does not change)
        self.talk = Talk()
        self.state = {'sessions': [], 'talk': [], 'groups': {}, 'locks': [], 'at': 0}
        self.events = deque(maxlen=50)
        self.titles = A.get(os.path.join(CACHE, 'titles.json'), {}) or {}
        self.failed = {}
        self.pending = {}
        self.launched = {}  # marker -> what was started from this page, until its session shows up
        self.qfile = os.path.join(CACHE, 'queue.json')
        self.queue = A.get(self.qfile, []) or []
        self._dirs, self._dirs_at = [], 0
        self.projects = Projects(self.cfg)
        self.chan_at, self.chan_seen, self.woke, self.boards_at = {}, {}, {}, {}  # (calling sessions in: how far each channel was read, the posts looked at, when each was woken; the page's view of the channels)
        self.names = {}  # (a session's id -> its name: a Claude session renamed takes its channel places along)
        self.lock = threading.Lock()

    def note(self, text, ok=True):
        self.events.appendleft({'at': time.time(), 'text': text, 'ok': ok})

    def collect(self):
        ps = procs()
        raw = A.board()
        rows = A.rows()
        reg = {s['name']: s for s in A.claude_sessions()}
        sessions = []
        for name, e in rows.items():
            if (e.get('cwd') or '').startswith(CACHE):
                continue  # (the deck's own model runs: a summary, a check, a draft)
            kind = e.get('kind') or '?'
            s = {'id': f'{kind}:{e.get("session") or name}', 'name': name, 'kind': kind, 'session': e.get('session'),
                 'state': e.get('state') or 'idle', 'since': e.get('since') or e.get('at') or 0, 'at': e.get('at') or 0,
                 'cwd': e.get('cwd'), 'tool': e.get('tool'), 'tool_at': e.get('tool_at'), 'tool_end': e.get('tool_end'), 'said': e.get('said'),
                 'unread': e.get('unread', 0), 'pid': e.get('pid'), 'transcript': e.get('transcript'), 'loc': place_from(e),
                 'parent': (e.get('parent') or {}).get('name'), 'parent_pid': (e.get('parent') or {}).get('pid')}
            r = raw.get(name) or {}
            if r.get('state') == 'waiting' and (r.get('at') or 0) >= (s['at'] - 1):
                s['state'], s['waiting_for'] = 'waiting', r.get('waiting_for')
            s['prompting'] = s['state'] == 'waiting'  # (at a permission or choice prompt: typed text would answer it)
            if kind == 'claude' and name in reg:
                s['loc'] = place_of(reg[name]['pid']) or s['loc']
            if kind == 'codex':
                s['loc'] = None  # (set below, from the Codex window showing it)
            sessions.append(s)
        # Codex windows: the TUI processes, each showing one thread (by its resume id, else by its folder)
        tuis = []
        for p in ps:
            a = p['args']
            if p['comm'] != 'codex' or not a:
                continue
            sub = next((x for x in a[1:] if not x.startswith('-')), None)
            if sub in CODEX_NOT_TUI or any('app-server' in x for x in a):
                continue
            loc = place_of(p['pid'])
            tid = a[a.index('resume') + 1] if 'resume' in a and a.index('resume') + 1 < len(a) else None
            tuis.append({'pid': p['pid'], 'loc': loc, 'cwd': cwd_of(p['pid']), 'thread': tid, 'marker': env_of(p['pid'], 'STURNUS_NEW'), 'start': p['start']})
        codex = [s for s in sessions if s['kind'] == 'codex' and s['state'] not in ('gone', 'ended')]
        for t in tuis:
            hit = next((s for s in codex if t['thread'] and s['session'] == t['thread']), None)
            if not hit and t['loc']:  # (a window outside any multiplexer is known by its resume id only)
                same = [s for s in codex if s['cwd'] == t['cwd'] and not s.get('loc') and not s.get('parent')]
                hit = max(same, key=lambda s: s['at'], default=None)
            if hit:
                hit['loc'], hit['window_pid'] = t['loc'], t['pid']
                want = self.pending.get(t['marker'])
                if want and hit['name'] != want:
                    ok, _ = self.rename(hit, want)
                    if ok:
                        self.pending.pop(t['marker'], None)
            else:  # (a live window whose session the hooks have not named yet: it is there all the same)
                th = codex_launch_thread(t['start'], t['cwd']) or (None, None)
                sessions.append(self.window('codex', t['pid'], t['loc'], t['start'], t['cwd'], *th))
        # Cursor windows: the CLI runs as node (its comm "MainThread"), one per pane; matched to its hooks' session by pane
        seen_panes = set()
        for p in ps:
            a = p['args']
            if not a or not (a[0].endswith('/agent') or a[0].endswith('cursor-agent')) or any(x in ('-p', '--print', 'worker') for x in a):  # (a worker: the editor's, not a session)
                continue
            loc = place_of(p['pid'])
            key = (loc['session'], loc['pane']) if loc else p['pid']
            if key in seen_panes:
                continue
            seen_panes.add(key)
            hit = next((s for s in sessions if s['kind'] == 'cursor' and ((loc and s.get('loc') == loc) or s.get('pid') == p['pid']) and s['state'] not in ('gone', 'ended')), None)
            if not hit:
                chat = cursor_chat(p['pid'])
                sessions.append(self.window('cursor', p['pid'], loc, p['start'], cwd_of(p['pid']), chat, chat and chat.split('/')[-2]))
        now = time.time()
        for marker, l in list(self.launched.items()):  # (what this page started and is not a session yet: a card that says so)
            if now - l['at'] > 3600:
                self.launched.pop(marker)
                continue
            loc = marked(marker)
            if not loc and now - l['at'] > 20:
                self.launched.pop(marker)  # (it ended, or never came up)
                continue
            if loc and any((x.get('loc') or {}) == loc and not x.get('unknown') for x in sessions):
                self.launched.pop(marker)
                continue
            slow = now - l['at'] > 8
            sessions = [x for x in sessions if not (x.get('unknown') and x.get('loc') == loc)]
            sessions.append({'id': f'new:{marker}', 'name': l['name'], 'kind': l['kind'], 'state': 'waiting' if slow else 'working',
                             'since': l['at'], 'at': now, 'cwd': l['cwd'], 'loc': loc, 'unknown': True, 'starting': True,
                             'summary': '刚开起来，还没登记成会话' if slow else '正在启动…',
                             'needs_you': '去它的窗格看一眼：多半在等你确认（比如是否信任这个目录）' if slow else ''})
        for s in sessions:
            self.projects.attribute(s)
            was = self.names.get(s['id'])
            if was and was != s['name'] and not s.get('unknown'):
                A.move_member(was, s['name'])  # (renamed in its own CLI: its places on channels go with it)
            self.names[s['id']] = s['name']
        by_name = {s['name']: s for s in sessions}
        by_pid = {s['pid']: s for s in sessions if s.get('pid')}
        for s in sessions:
            if s.get('starting'):
                s['stale'] = s['hidden'] = False
                continue
            sm = self.sums.get(s['id']) or {}
            need = sm.get('needs_you') or ''
            if re.match(r'^(无需|不需要|暂无|没有需要|无$|无。|none|n/?a)', need, re.I):
                need = ''
            s['summary'], s['status'], s['needs_you'], s['summary_at'] = sm.get('summary'), sm.get('status'), need, sm.get('at')
            s['title'] = sm.get('title') or ''
            if s['state'] == 'idle' and s['status'] == 'waiting_user' and sm.get('at', 0) >= s['at'] - 5:
                s['state'] = 'waiting'  # (it stopped on a question to the person)
            s['stale'] = s['state'] != 'working' and now - (s['at'] or s['since'] or 0) > 24 * 3600  # (a day without a stir: out of the way, still there to open)
            s['hidden'] = s['state'] in ('gone', 'ended')  # (a session that has exited leaves the page)
            p = by_name.get(s.get('parent')) or by_pid.get(s.get('parent_pid'))
            if p and p is not s:
                s['parent'] = p['name']  # (started by another session: shown with it; when done, there for half an hour more)
                s['parent_id'], s['stale'] = p['id'], False
                s['hidden'] = s['hidden'] and now - (s['at'] or 0) > 1800
            elif not s.get('loc') and not s['hidden'] and not s.get('starting'):
                s['origin'] = self.origins.get(s.get('pid')) or self.origins.setdefault(s.get('pid'), origin_of(s.get('pid')))
            if s['kind'] == 'claude' and s['state'] not in ('gone', 'ended'):
                p = transcript_of(s)
                if p:
                    self.talk.scan_claude(s['name'], p)
        clients, tclients = zellij_clients(ps), TMUX.clients()
        zs = {}
        for n in zellij_sessions():
            zs[n] = {'name': n, 'mux': 'zellij', 'clients': [c for c in clients if c['session'] == n]}
        for n, sock in TMUX.sessions():
            zs[n] = {'name': n[5:], 'mux': 'tmux', 'sock': sock, 'clients': [c for c in tclients if c['session'] == n]}
        for n, z in zs.items():
            z['agents'] = len([s for s in sessions if (s.get('loc') or {}).get('session') == n and s['state'] not in ('gone', 'ended')])
        if now - getattr(self, '_dirs_at', 0) > 60:
            dirs = [s['cwd'] for s in sorted(sessions, key=lambda s: -(s['at'] or 0)) if s.get('cwd')]
            dirs += sorted(d for d in glob.glob(os.path.expanduser('~/projects/*')) if os.path.isdir(d))
            home = os.path.expanduser('~')
            self._dirs = list(dict.fromkeys(d.replace(home, '~', 1) for d in dirs if os.path.isdir(d)))[:60]
            self._dirs_at = now
        locks = []
        d = os.path.join(A.HOME, 'locks')
        for f in glob.glob(os.path.join(d, '*.json')):
            l = A.get(f)
            if l:
                locks.append({**l, 'key': os.path.basename(f)[:-5]})
        self.all = sessions
        self.publish(sessions)
        workspaces, projects = self.layout(sessions)
        boards = self.boards_view()
        with self.lock:
            self.state = {'sessions': [s for s in sessions if not s['hidden']], 'talk': self.talk.all(), 'groups': zs, 'locks': locks,
                          'workspaces': workspaces, 'projects': projects, 'boards': boards,
                          'muxes': [m for m in ('zellij', 'tmux') if shutil.which(m)], 'voice': self.voice_view(),
                          'at': now, 'version': VERSION, 'summarizer': {'busy': self.sums.busy, 'error': self.sums.error},
                          'decisions': list(reversed(self.sums.decisions[-60:])), 'models': self.models_view(),
                          'queue': list(reversed(self.queue[-120:])),
                          'inbox': A.take(ME_NAME, peek=True), 'lock_issues': self.lock_issues(sessions, locks),
                          'reports': dict(sorted(((k, v) for k, v in self.reports.data.items() if v.get('r')), key=lambda kv: -kv[1]['at'])[:80]),
                          'reporting': sorted(self.reports.asked | ({self.reports.busy} if self.reports.busy else set())),
                          'events': list(self.events), 'pane_titles': self.cfg.get('pane_titles', True), 'me': ME_NAME, 'dirs': self._dirs,
                          'launch': self.cfg.get('launch', DEFAULTS['launch']), 'work_lang': self.cfg.get('work_lang') or 'zh',
                          'about': {'started': STARTED, 'app': APP, 'config': CONF, 'source': self.cfg.get('source'),
                                    'listen': f'{self.cfg["host"]}:{self.cfg["port"]}', 'model': model_label(self.cfg, 'summary'),
                                    'assist': model_label(self.cfg, 'assist'),
                                    'summaries': len(self.sums.data)}}
        if self.cfg.get('pane_titles', True):
            self.retitle(sessions, zs)

    def layout(self, sessions):
        """The workspaces (those with sessions on them, and the configured ones) with their projects; each project with
        its git facts, how many sessions work on it, when it last moved."""
        P, projects, wss = self.projects, {}, {}
        def entry(p):
            if p['key'] not in projects:
                projects[p['key']] = {'key': p['key'], 'name': p['name'], 'path': p['path'], 'git': p['git'], 'workspace': p['workspace'] and A.key_of('w', p['workspace']),
                                      'facts': P.facts.get(p['key']), 'live': 0, 'at': 0}
            return projects[p['key']]
        for w in P.workspace_paths():
            k = A.key_of('w', w)
            wss[k] = {'key': k, 'name': ws_name(w), 'path': w, 'projects': [], 'live': 0, 'groups': {}}
        for s in sessions:
            on = not s['hidden'] and not s.get('stale') and s['state'] not in ('gone', 'ended')
            p = P.known.get(s.get('project'))
            if p and not s['hidden']:
                e = entry(p)
                e['live'] += on
                e['at'] = max(e['at'], s.get('at') or 0)
            w = wss.get(s.get('workspace'))
            if w and on:
                w['live'] += 1
                if s.get('loc'):
                    w['groups'][s['loc']['session']] = w['groups'].get(s['loc']['session'], 0) + 1
        shown = [w for w in wss.values() if w['live'] or w['path'] in P.configured() or w['path'] in P.ever]
        for w in shown:
            for p in P.projects_in(w['path']):
                entry(p)
        for e in projects.values():
            f = e['facts'] or {}
            e['at'] = max([e['at']] + [x['at'] for x in f.get('works') or []])
            if e['workspace'] in wss:
                wss[e['workspace']]['projects'].append(e['key'])
        self.shown = set(projects)
        for w in shown:
            w['projects'].sort(key=lambda k: (-projects[k]['live'], -projects[k]['at']))
            w['groups'] = sorted(w['groups'], key=lambda g: -w['groups'][g])
            w['at'] = max([projects[k]['at'] for k in w['projects']] or [0])  # (when anything in it last moved)
        return sorted(shown, key=lambda w: (-w['live'], -w['at'], w['name'])), projects

    def boards_view(self):
        """Every channel as the page lists it: what is new for the person, the last post, its discussions, who is on it."""
        out = {}
        for k, meta in A.channels().items():
            d = os.path.join(A.HOME, 'channels', k)
            mt = lambda x: os.stat(os.path.join(d, x)).st_mtime if os.path.isdir(os.path.join(d, x)) else 0
            seen = (A.get(os.path.join(d, 'seen', f'{ME_NAME}.json')) or {}).get('at', 0)
            sig_ = (mt('posts'), mt('topics'), mt('seen'), seen)
            hit = self.boards_at.get(k)
            if hit and hit[0] == sig_:
                out[k] = hit[1]
                continue
            new = [p for p in A.posts(k, since=seen) if p.get('from') != ME_NAME]
            last = (A.posts(k, since=seen) or [None])[-1] if seen else None
            if not last:
                names = sorted(f for f in os.listdir(os.path.join(d, 'posts')) if f.endswith('.json')) if mt('posts') else []
                last = names and A.get(os.path.join(d, 'posts', names[-1]))
            v = {'key': k, 'name': meta.get('name') or k, 'kind': meta.get('kind') or 'project', 'path': meta.get('path'),
                 'unread': len(new), 'calls': sum(A.calls(p, ME_NAME) for p in new),
                 'last': last and {'from': last.get('from'), 'kind': last.get('kind'), 'text': (last.get('text') or '')[:240], 'at': last.get('at'), 'topic': last.get('topic')},
                 'topics': [{k2: t.get(k2) for k2 in ('id', 'title', 'closed', 'members', 'at', 'max', 'by')} for t in A.topics(k)[:30]],
                 'members': [m for m in A.members(k) if m != ME_NAME]}
            self.boards_at[k] = (sig_, v)
            out[k] = v
        return out

    @staticmethod
    def window(kind, pid, loc, start, cwd, transcript, session):
        """A window the hooks never saw (it opened before them): its conversation, if found, says what it does; busy
        while that is being written. Still 'unknown': no mail reaches it."""
        try:
            at = max(os.path.getmtime(p) for p in (transcript, transcript + '-wal') if os.path.exists(p))
        except (TypeError, ValueError):
            at = None
        now = time.time()
        said = last_said(transcript, at)
        where = f'{loc["session"].removeprefix("tmux:")}:{loc["pane"]}' if loc else f'pid {pid}'
        return {'id': f'{kind}-window:{pid}', 'name': f'{kind.capitalize()} · {where}', 'kind': kind, 'pid': pid,
                'state': 'working' if at and now - at < 20 else 'idle', 'since': at or start, 'at': now if at is None else at,
                'cwd': cwd, 'loc': loc, 'unknown': True, 'transcript': transcript, 'session': session, 'said': said}

    def retitle(self, sessions, zs):
        """Each agent's pane carries its name and what it is doing. Zellij runs a plugin only in a session a terminal is
        attached to; a pane two sessions share (one suspended under the other) shows the livelier one."""
        best = {}
        for s in sessions:
            loc = s.get('loc')
            if not loc or s['state'] in ('gone', 'ended') or s.get('unknown') or (loc['mux'] == 'zellij' and not (zs.get(loc['session']) or {}).get('clients')):
                continue
            key = f'{loc["session"]}:{loc["pane"]}'
            rank = (ORDER_RANK.get(s['state'], 9), s['stale'], -(s['at'] or 0))
            if key not in best or rank < best[key][0]:
                best[key] = (rank, s)
        changed = False
        now = time.time()
        for key, (_, s) in best.items():
            loc = s['loc']
            mark = {'working': '●', 'waiting': '◆', 'idle': '○'}.get(s['state'], '○')
            what = (s.get('summary') or '')[:28]
            title = f'{mark} {s["name"]}' + (f' · {what}' if what else '')
            if self.titles.get(key) == title or now < self.failed.get(key, 0):
                continue
            if TMUX.title(loc, title) if loc['mux'] == 'tmux' else plugin(loc['session'], f'rename {loc["pane"]} {title}').returncode == 0:
                self.titles[key] = title
                changed = True
            else:
                self.failed[key] = now + 120  # (try again in a while, not every pass)
        if changed:
            A.put(os.path.join(CACHE, 'titles.json'), self.titles)

    def loop(self):
        while True:
            try:
                self.collect()
            except Exception as e:
                self.note(f'收集出错：{e!r}', False)
            time.sleep(2)

    # ---------- amail, with what the deck knows ----------

    def publish(self, sessions):
        """The deck's view for amail (amail status, waits): how each session stands, what it is on, its report."""
        out = {}
        for s in sessions:
            if s.get('starting') or (s.get('unknown') and not s.get('summary')):
                continue
            st, label = standing(s)
            loc = s.get('loc') or {}
            out[s['name']] = {'name': s['name'], 'kind': s['kind'], 'state': st, 'label': label, 'title': s.get('title') or '',
                              'summary': s.get('summary') or '', 'needs_you': s.get('needs_you') or '', 'since': s.get('since'), 'at': s.get('at'),
                              'where': loc and f'{loc["session"].removeprefix("tmux:")} pane {loc["pane"]}', 'parent': s.get('parent') if s.get('parent_id') else None,
                              'origin': s.get('origin'), 'project': self.projects.channel(self.projects.known.get(s.get('project'))),
                              'workspace': s.get('workspace') and self.projects.ws_channel(s['workspace']), 'branch': s.get('branch') or ''}
        reps = {v['name']: {**v['r'], 'at': v['at']} for v in self.reports.data.values() if v.get('r') and v.get('name') in out}
        A.put(A.path('deck.json'), {'at': time.time(), 'sessions': out, 'reports': reps})

    def lock_issues(self, sessions, locks):
        """Push locks whose holder has exited, or has not stirred for hours: the person may release them."""
        by = {s['name']: s for s in sessions}
        out = []
        for l in locks:
            s = by.get(l['holder'])
            if not s or s['state'] in ('gone', 'ended'):
                out.append({**l, 'why': f'{l["holder"]} 已经退出'})
            elif s['state'] != 'working' and time.time() - (s.get('at') or 0) > 3 * 3600:
                out.append({**l, 'why': f'{l["holder"]} {int((time.time() - s["at"]) // 3600)} 小时没动静'})
        return out

    def assist(self, q, history):
        """The deck's assistant: a question about the sessions, answered from everything the deck knows (and, for the
        sessions the question names, their latest conversation)."""
        if not q:
            return False, '先写问题'
        now, all_ = time.time(), getattr(self, 'all', [])
        live = [s for s in all_ if not s['hidden']]
        dur = lambda t: '刚刚' if not t or now - t < 60 else f'{int((now - t) // 60)} 分钟前' if now - t < 3600 else f'{int((now - t) // 3600)} 小时前' if now - t < 86400 else f'{int((now - t) // 86400)} 天前'
        def line(s):
            st, label = standing(s)
            g = (s.get('loc') or {}).get('session', '').removeprefix('tmux:') or ('子 agent' if s.get('parent_id') else '未托管')
            kids = [c['name'] for c in live if c.get('parent_id') == s['id']]
            return (f'- {s["name"]}（{s["kind"]} · {g} · {label} · {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")} · {dur(s.get("at"))}）：'
                    f'{s.get("title") or ""} — {s.get("summary") or s.get("said") or ""}' + (f'；要他：{s["needs_you"]}' if s.get('needs_you') else '')
                    + (f'；由 {s["parent"]} 启动' if s.get('parent_id') else '') + (f'；子 agent：{"、".join(kids)}' if kids else '') + ('；一天以上没动静' if s.get('stale') else ''))
        reps = []
        for v in sorted(self.reports.data.values(), key=lambda v: -v.get('at', 0)):
            r = v.get('r') or {}
            if r and any(s['name'] == v.get('name') for s in live):
                reps.append(f'- {v["name"]}：为了 {r.get("goal", "")}；现在 {r.get("now", "")}；接下来 {"；".join(r.get("next") or [])}'
                            + (f'；产出 {"、".join(r.get("refs") or [])}' if r.get('refs') else ''))
        decs = [f'- {d["name"]}（{"他定的" if d["by"] == "user" else "agent 定的"}，{dur(d["at"])}）：{d["what"]}' for d in self.sums.decisions[-25:]]
        talk = [f'- {m["from"]} → {m["to"]}（{dur(m["at"])}）：{m["text"][:220]}' for m in self.talk.all()[:15]]
        queue = [f'- 交给 {i.get("to") or i.get("group") or "先空的"}（{i.get("status")}）：{i.get("text", "")[:160]}' for i in self.queue if i.get('status') in ('waiting', 'held', 'checking', 'ready')]
        locks = [f'- {l.get("branch")} of {os.path.basename(l.get("repo") or "")}：{l.get("holder")} 持有，{dur(l.get("since"))}' for l in self.state.get('locks') or []]
        named = [s for s in live if s['name'].lower() in q.lower() or (s.get('title') and s['title'] in q)][:2]
        detail = ''.join(f'\n会话 {s["name"]} 最近的对话：\n' + '\n'.join(recent(transcript_of(s), 5000)) + '\n' for s in named if transcript_of(s))
        hist = '\n'.join(f'{"他" if h.get("who") == "user" else "你"}：{str(h.get("text") or "")[:600]}' for h in (history or [])[-6:] if isinstance(h, dict)) or '（这是第一个问题）'
        prompt = ASSIST.format(now=time.strftime('%Y-%m-%d %H:%M'), sessions='\n'.join(map(line, live)) or '（没有会话）', reports='\n'.join(reps) or '（还没有）',
                               decisions='\n'.join(decs) or '（还没有）', talk='\n'.join(talk) or '（没有）', queue='\n'.join(queue) or '（没有）',
                               locks='\n'.join(locks) or '（没有）', detail=detail, history=hist, q=q[:2000])
        try:
            return True, {'answer': ask_model(prompt, self.cfg, 'assist').strip()}
        except Exception as e:
            return False, f'助手没答上来：{e}'[:300]

    def recommend(self, text, group, project=''):
        if not text:
            return False, '先写要做的事'
        live = [s for s in getattr(self, 'all', []) if not s.get('parent_id') and not s.get('unknown') and s['state'] not in ('gone', 'ended')
                and (s.get('project') == project if project else not group or (s.get('loc') or {}).get('session') == group)]
        proj = self.projects.known.get(project)
        def line(s):
            st, label = standing(s)
            decs = [d['what'] for d in self.sums.decisions if d['sid'] == s['id']][-3:]
            g = (s.get('loc') or {}).get('session', '').removeprefix('tmux:') or '未托管'
            return (f'- {s["name"]}（{s["kind"]}，组 {g}，{label}，目录 {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")}）：'
                    f'{s.get("title") or ""} — {s.get("summary") or ""}' + (f'；定过：{"；".join(decs)}' if decs else ''))
        scope = (f'只在项目「{proj["name"]}」（{proj["path"]}）的会话里挑；新开的会话也开在这个项目里。' if proj
                 else f'只在组「{group.removeprefix("tmux:")}」里挑。' if group else '尽量在同一个组里挑。')
        try:
            out = ask_model(RECOMMEND.format(scope=scope, text=text, sessions='\n'.join(map(line, live)) or '（这里还没有会话）'), self.cfg, 'assist')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
        except Exception as e:
            return False, f'助手没给出建议：{e}'[:200]
        to = next((s for s in live if s['name'] == r.get('to')), None)
        new = r.get('new') if isinstance(r.get('new'), dict) else None
        if new:
            cwd = new.get('cwd') or (to or {}).get('cwd') or '~'
            if proj and not os.path.realpath(os.path.expanduser(cwd)).startswith(proj['path']):
                cwd = proj['path']
            new = {'kind': new.get('kind') if new.get('kind') in ('claude', 'codex', 'cursor') else 'claude', 'cwd': cwd,
                   'name': new.get('name') if NAME.fullmatch(str(new.get('name') or '')) else '', 'why': str(new.get('why') or '')[:200],
                   'group': group or ((to or {}).get('loc') or {}).get('session') or self.ws_group(proj) or next(iter(self.state['groups']), '')}
        return True, {'to': to and {'name': to['name'], 'id': to['id'], 'title': to.get('title') or '', 'group': (to.get('loc') or {}).get('session')},
                      'why': str(r.get('why') or '')[:200], 'new': new}

    def ws_group(self, proj):
        """Where a project's new session goes: the group most of its workspace's sessions are in."""
        w = proj and proj['workspace'] and next((w for w in self.state.get('workspaces') or [] if w['key'] == A.key_of('w', proj['workspace'])), None)
        return w and (w['groups'] or [None])[0]

    def notify(self, to, text, kind='question'):
        """Mail from the deck itself, and the reader woken if it is idle."""
        if A.send('sturnus', to, text, kind):
            self.wake(to)

    def wake(self, name):
        """An idle session is told it has mail or a call on a channel: a Codex thread by its queue, else a line typed into
        its pane (its hook then hands it over). Never one at a prompt of the person's, or at work (its next step brings it)."""
        s = next((x for x in getattr(self, 'all', []) if x['name'] == name and not x.get('unknown')), None)
        if not s or s['state'] != 'idle' or s.get('prompting'):
            return False
        if DRY:
            self.note(f'（试用，没有真的叫醒）{name}')
            return True
        if s['kind'] == 'codex' and s.get('session'):
            mails, items = A.take(name), A.news(name)
            text = '\n'.join(x for x in [mails and A.mail_text(name, mails), items and A.news_text(name, items)] if x)
            return not text or DRY or A.wake_codex({'session': s['session']}, text)[0]
        if s.get('loc') and not in_view(s['loc']):  # (someone at that pane may be typing: its next turn brings it)
            return self.type_in(s, '[amail] 有新消息', True)[0]
        return False

    def call_in(self):
        """Who a channel's new posts call in: a discussion's members, those named (@NAME, @all: everyone on it) — woken
        when idle and something is still waiting for them (a stop may have handed it over already); at most once a
        minute and twenty times an hour each, so two sessions calling each other cannot run on and on. The rest of a
        channel waits for their next turn."""
        now = time.time()
        for k, meta in A.channels().items():
            if k not in self.chan_at:  # (a channel made since the deck started: from its start; an older one: from now)
                self.chan_at[k] = (meta.get('at', 0) - .001) if (meta.get('at') or 0) > STARTED else now
            for p in A.posts(k, since=self.chan_at[k] - A.LOOK):
                if p['id'] in self.chan_seen:
                    continue
                self.chan_seen[p['id']] = p['at']
                self.chan_at[k] = max(self.chan_at[k], p['at'])
                on, who = set(A.members(k)), set()
                t = p.get('topic') and A.topic_get(k, p['topic'])
                if t and not t.get('closed'):
                    who |= set(t['members'])
                who |= on if 'all' in (p.get('to') or ()) else set(p.get('to') or ()) & on
                for n in sorted(who - {p.get('from'), ME_NAME, 'sturnus', 'amail'}):
                    w = [x for x in self.woke.get(n, []) if now - x < 3600]
                    if (w and now - w[-1] < 60) or len(w) >= 20 or not A.news(n, take=False):
                        continue
                    if self.wake(n):
                        self.woke[n] = w + [now]
                        if len(w) + 1 == 20:
                            self.note(f'{n} 这一小时被讨论区叫醒了 20 次，先不再叫它了', False)
        self.chan_seen = {i: at for i, at in self.chan_seen.items() if now - at < 3600}
        if now - getattr(self, 'pruned', 0) > 600:  # (a channel keeps its last 3000 posts)
            self.pruned = now
            for k in A.channels():
                d = os.path.join(A.HOME, 'channels', k, 'posts')
                old = sorted(f for f in os.listdir(d) if f.endswith('.json'))[:-3000] if os.path.isdir(d) else []
                for f in old:
                    os.remove(os.path.join(d, f))

    def mind_loop(self):
        self.prev, self.stopped, self.woken, self.checked, self.lock_seen = {}, {}, set(), {}, None
        while True:
            try:
                self.mind()
            except Exception as e:
                self.note(f'amail 跟进出错：{e!r}', False)
            time.sleep(4)

    def mind(self):
        now, ss = time.time(), {s['name']: s for s in getattr(self, 'all', [])}
        for n, s in ss.items():  # (who has just stopped)
            st = standing(s)[0]
            if self.prev.get(n) == 'working' and st != 'working':
                self.stopped[n] = now
            self.prev[n] = st
        for f in glob.glob(A.path('watches', '*.json')):
            w = A.get(f)
            if w:
                self.watch(f, w, ss.get(w['on']), now)
        for box in glob.glob(A.path('mail', '*', 'new')):  # (a question to an idle session wakes it)
            name = os.path.basename(os.path.dirname(box))
            for f in glob.glob(os.path.join(box, '*.json')):
                m = A.get(f) or {}
                if m.get('kind', 'fyi') != 'fyi' and m.get('id') not in self.woken and name != ME_NAME:
                    self.woken.add(m.get('id'))
                    self.wake(name)
        for f in sorted(glob.glob(A.path('route', '*.json'))):  # (a note to all: to the sessions it concerns)
            r = A.get(f)
            os.remove(f)
            if r:
                for n in self.route(r, ss):
                    A.send(r['from'], n, r['text'], r.get('kind'), routed=True)
        self.call_in()
        locks = {os.path.basename(f): A.get(f) or {} for f in glob.glob(A.path('locks', '*.json'))}
        for k, old in (self.lock_seen or {}).items():  # (a lock let go: those it turned away are told)
            if old.get('waiters') and (k not in locks or locks[k].get('holder') != old.get('holder')):
                for n in old['waiters']:
                    self.notify(n, f'{old["branch"]} of {old["repo"]} is free now ({old["holder"]} let go of it)')
        self.lock_seen = locks

    def watch(self, f, w, t, now):
        """One wait: told when its session stops (once the stop is in its summary), or once its condition holds."""
        done = lambda text: (self.notify(w['by'], text), os.path.exists(f) and os.remove(f))
        if now - w['at'] > 86400:
            return done(f'stopped watching {w["on"]} after a day' + (f' ({w["until"]})' if w.get('until') else ''))
        if not t:
            if now - w['at'] > 3600:
                done(f'{w["on"]} is nowhere to be seen; stopped watching it')
            return
        st, label = standing(t)
        about = f' (you asked it: {w["about"]})' if w.get('about') else ''
        if st in ('gone', 'ended'):
            return done(f'{w["on"]} has exited{about}. Last: {t.get("summary") or t.get("said") or "-"}')
        if w.get('about') and any(m.get('from') == w['on'] and m['at'] > w['at'] for m in self.mail_of(w['by'])):
            return os.remove(f)  # (it answered: nothing more to say)
        stop = self.stopped.get(w['on'], 0)
        if st == 'working' or (w.get('about') and stop <= w['at']):
            return  # (an asked one: told once it has worked on it and stopped)
        if (t.get('summary_at') or 0) < stop and now - stop < 90:
            return  # (stopped just now: its summary catches up first)
        if not w.get('until'):
            return done(f'{w["on"]} has stopped: {label}. {t.get("title") or ""} — {t.get("summary") or t.get("said") or ""}{about}')
        key = (w['id'], t.get('summary_at'), st)
        if self.checked.get(w['id'], (None, 0))[0] == key or now - self.checked.get(w['id'], (None, 0))[1] < 60:
            return
        self.checked[w['id']] = (key, now)
        rep = (self.reports.data.get(t['id']) or {}).get('r') or {}
        try:
            out = ask_model(UNTIL.format(name=w['on'], until=w['until'], label=label, title=t.get('title') or '', summary=t.get('summary') or '',
                                         report=f'它的报告：现在 {rep.get("now", "")}；做成了 {"；".join(rep.get("done") or [])}\n' if rep else '',
                                         said=(t.get('said') or '')[:600]), self.cfg, 'assist')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
        except Exception:
            return
        if r.get('met'):
            done(f'{w["on"]}: {w["until"]} — yes: {r.get("why") or ""}')

    @staticmethod
    def mail_of(name):
        return [A.get(f) or {} for box in ('new', 'cur') for f in glob.glob(A.path('mail', name, box, '*.json'))]

    def route(self, r, ss):
        live = [s for s in ss.values() if s['name'] != r['from'] and standing(s)[0] not in ('gone', 'ended', 'quiet') and not s.get('unknown')]
        if len(live) <= 2:
            return [s['name'] for s in live]
        lines = '\n'.join(f'- {s["name"]}（{s["kind"]}，目录 {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")}）：{s.get("title") or ""} — {s.get("summary") or ""}' for s in live)
        try:
            out = ask_model(ROUTE.format(frm=r['from'], text=r['text'], sessions=lines), self.cfg, 'assist')
            names = set(json.loads(re.search(r'\{.*\}', out, re.S).group(0)).get('to') or [])
            return [s['name'] for s in live if s['name'] in names]
        except Exception:
            return [s['name'] for s in live]  # (in doubt: everyone, as before)

    def summarize_loop(self):
        while True:
            try:
                for s in sorted(self.state['sessions'], key=lambda s: ({'working': 0, 'waiting': 1}.get(s['state'], 2), -(s['at'] or 0))):
                    if s.get('unknown') and not s.get('transcript'):
                        continue
                    basis = self.sums.due(s, self.cfg)
                    if basis and s['id'] not in self.reports.asked:
                        self.sums.make(s, basis, self.cfg)
                        break
                else:  # (no summary due: a report, the asked-for ones first)
                    live = [s for s in self.state['sessions'] if not (s.get('unknown') and not s.get('transcript'))]
                    s = next((s for s in sorted(live, key=lambda s: (s['id'] not in self.reports.asked, -(s['at'] or 0))) if self.reports.due(s)), None)
                    if s:
                        self.reports.make(s, self.cfg, self.sums.decisions)
            except Exception as e:
                self.sums.error = repr(e)[:300]
            time.sleep(4)

    def find(self, sid):
        return next((s for s in self.state['sessions'] if s['id'] == sid), None)

    # actions
    def act(self, what, body):
        s = self.find(body.get('id')) if body.get('id') else None
        if what == 'say':  # (words for a session, as the person's: how they get there follows how it stands)
            text = (body.get('text') or '').strip()
            if not s or not text:
                return False, '先写要说的话'
            how = say_how(s, bool(body.get('now')))
            if how == 'gone':
                return False, f'{s["name"]} 已经退出了'
            if how == 'menu':
                return False, f'{s["name"]} 停在一个授权或选择提示上，打进去的字会被当成对它的回答：先进终端处理它'
            if how == 'type':
                return self.type_in(s, text, True)
            if how == 'queue':
                return self.queue_act({'do': 'add', 'text': text, 'to': s['name'], 'mode': 'plain'})
            if not A.send(ME_NAME, s['name'], text, 'question'):
                return False, '发不出去'
            self.wake(s['name'])
            return True, f'放进了 {s["name"]} 的信箱：它不在 Zellij 或 tmux 里，下一步就会看到'
        if what == 'attribute':  # (the person's word on which project a session works on; '' goes back to what was found)
            v = str(body.get('project') or '')
            if not s:
                return False, '找不到这个会话'
            if v and v not in self.projects.known and not (v.startswith('w:') and self.projects.ws_channel(v[2:])):
                return False, '没有这个项目'
            self.projects.set_manual(s['id'], v)  # (the next collect places it so: only that thread changes what is known)
            p = self.projects.known.get(v)
            return True, f'{s["name"]} 算作' + (f'项目 {p["name"]} 的' if p else '工作区本身的' if v else '按它的目录和改的文件找到的项目的') + '会话'
        if what in ('board_post', 'board_seen', 'topic_new', 'topic_close'):
            return self.board_act(what, str(body.get('key') or ''), body)
        if what == 'jump':
            if not s:
                return False, '找不到这个会话'
            return go_to(s.get('loc'), body.get('via'))
        if what == 'send':
            to = s['name'] if s else body.get('to')
            text = (body.get('text') or '').strip()
            if not to or not text:
                return False, '缺少收件人或内容'
            if body.get('wake'):
                threading.Thread(target=self._ask, args=(to, text), daemon=True).start()
                return True, f'已发给 {to}，并在叫醒它'
            sent = A.send(ME_NAME, to, text)
            return bool(sent), f'已发给 {", ".join(sent)}' if sent else '没有发出'
        if what == 'rename':
            new = (body.get('name') or '').strip()
            if not s or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,40}', new):
                return False, '名字只能用字母、数字和 _ . -'
            return self.rename(s, new)
        if what == 'dirs':  # (the folders of this machine, for picking where a new session runs)
            d = os.path.realpath(os.path.expanduser(str(body.get('path') or '~')))
            if not os.path.isdir(d):
                return False, f'没有这个目录：{d}'
            try:
                names = sorted((e.name for e in os.scandir(d) if not e.name.startswith('.') and e.is_dir()), key=str.lower)
            except OSError as e:
                return False, f'读不了 {d}：{e.strerror}'
            h = os.path.expanduser('~')
            return True, {'path': d, 'show': d.replace(h, '~', 1) if d == h or d.startswith(h + '/') else d, 'dirs': names[:500], 'more': max(0, len(names) - 500)}
        if what == 'assistant':  # (a question to the deck's assistant)
            return self.assist(str(body.get('q') or '').strip(), body.get('history') or [])
        if what == 'recommend':  # (who should take a task: within a project or a group, or a new session there)
            return self.recommend(str(body.get('text') or '').strip(), str(body.get('group') or ''), str(body.get('project') or ''))
        if what == 'stop':  # (a session another one started: it and the processes under it)
            if not s or not s.get('parent_id') or not s.get('pid') or s['state'] in ('gone', 'ended'):
                return False, '只能停止由别的会话启动、还在跑的子 agent'
            kids = [p for p in A.pids() if any(a == s['pid'] for a, _ in A.ancestors(p)[1:])]
            for pid in [s['pid']] + kids:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
            return True, f'停止了 {s["name"]}（{s["parent"]} 启动的）'
        if what == 'unlock':  # (the person lets go of a push lock whose holder is gone; those it turned away are told)
            key = str(body.get('key') or '')
            f = A.path('locks', f'{key}.json')
            if not re.fullmatch(r'[0-9a-f]{12}', key) or not os.path.exists(f):
                return False, '这把锁已经不在了'
            l = A.get(f) or {}
            os.remove(f)
            return True, f'释放了 {l.get("holder")} 在 {os.path.basename(l.get("repo") or "")} 上的 {l.get("branch")} 推送锁'
        if what in ('mail_read', 'mail_reply'):  # (mail to the person: read, or answered, which wakes the writer)
            mid = str(body.get('mid') or '')
            f = next(iter(glob.glob(A.path('mail', ME_NAME, 'new', f'*-{mid}.json')))) if re.fullmatch(r'[0-9a-f]{12}', mid) else None
            m = f and A.get(f)
            if not m:
                return False, '这封已经处理过了'
            text = (body.get('text') or '').strip()
            if what == 'mail_reply':
                if not text:
                    return False, '先写回复'
                if not A.send(ME_NAME, m['from'], text, 'question'):
                    return False, '发不出去'
                self.wake(m['from'])
            os.replace(f, A.path('mail', ME_NAME, 'cur', os.path.basename(f)))
            return True, f'已回复 {m["from"]}' if what == 'mail_reply' else {}
        if what == 'report':  # (a report now, before the next summaries)
            if not s or not transcript_of(s):
                return False, '读不到这个会话的对话，写不了报告'
            self.reports.asked.add(s['id'])
            return True, {}
        if what == 'summarize':
            if not s:
                return False, '找不到这个会话'
            self.sums.data.pop(s['id'], None)
            return True, '马上重新总结'
        if what == 'new':
            return self.new_session(body)
        if what == 'queue':
            return self.queue_act(body)
        if what == 'type':
            return self.type_in(s, body.get('text') or '', bool(body.get('enter', True)))
        if what == 'models':
            try:
                role, m, key = self.model_from(body)
            except ValueError as e:
                return False, str(e)
            models = dict(self.cfg.get('models') or {})
            models[role] = m
            self.cfg['models'] = models
            save_config({'models': models})
            if key is not None:
                put_secret(role, key)
            return True, f'{"总结模型" if role == "summary" else "辅助模型"}已换成 {model_label(self.cfg, role)}'
        if what == 'voice' and 'only_on' in body:  # (the switch: at once, the rest as it was)
            v = {**voice_cfg(self.cfg), 'on': bool(body['only_on'])}
            self.cfg['voice'] = v
            save_config({'voice': v})
            self.state['voice'] = self.voice_view()  # (the page reads it back at once)
            return True, f'语音输入{"已开启：" + voice_label(v) if v["on"] else "已关闭"}'
        if what in ('voice', 'voice_test'):
            v = voice_cfg(self.cfg)
            if body.get('provider') not in STT:
                return False, '选一个语音服务'
            model = str(body.get('model') or '').strip()[:80]
            v.update(on=bool(body.get('on')), provider=body['provider'], model='' if model == STT_MODEL[body['provider']] else model,
                     url=str(body.get('url') or '').strip(), lang=body.get('lang') if body.get('lang') in ('zh', 'en') else '')
            if v['url'] and not re.match(r'^https?://', v['url']):
                return False, '接口地址要以 http:// 或 https:// 开头'
            key = body.get('key')
            key = key if key and '…' not in key and key != '已设置' else None
            if what == 'voice_test':
                t = time.time()
                try:
                    transcribe(silence(), 'audio/wav', v, key if key is not None else voice_key(v['provider']))
                except Exception as e:
                    return False, f'{voice_label(v)} 没调通：{e}'[:300]
                return True, f'{voice_label(v)} 调通了（{time.time() - t:.1f} 秒）'
            self.cfg['voice'] = v
            save_config({'voice': v})
            if key is not None:
                put_secret(f'voice:{v["provider"]}', key)
            self.state['voice'] = self.voice_view()  # (the page reads it back at once)
            return True, f'已保存：{voice_label(v)}' + ('' if v['on'] else '（语音输入还关着）')
        if what == 'models_test':
            try:
                role, m, key = self.model_from(body)
            except ValueError as e:
                return False, str(e)
            t = time.time()
            try:
                out = ask_model('只回复两个字：好的', self.cfg, role, m=m, key=key if key is not None else None)
            except Exception as e:
                return False, f'没调通：{e}'[:300]
            return True, f'调通了（{time.time() - t:.1f} 秒）：{out.strip()[:40]}'
        if what == 'draft':
            if not s:
                return False, '找不到这个会话'
            path = transcript_of(s)
            lines = recent(path, 5000) if path else []
            need = s.get('needs_you') or s.get('waiting_for') or s.get('summary') or ''
            try:
                text = ask_model(DRAFT.format(name=s['name'], need=need, text='\n'.join(lines) or (s.get('said') or '')), self.cfg, 'assist')
            except Exception as e:
                return False, f'起草失败：{e}'[:300]
            return True, {'draft': text.strip()[:600]}
        if what == 'work_lang':  # (the language the models write in for the person)
            v = 'en' if body.get('lang') == 'en' else 'zh'
            self.cfg['work_lang'] = v
            save_config({'work_lang': v})
            return True, {'zh': 'agent 的工作语言：中文。之后写的总结、简报、回答都用中文', 'en': 'Agents now write in English: summaries, reports and answers from here on'}[v]
        if what == 'titles':
            self.cfg['pane_titles'] = bool(body.get('on'))
            save_config({'pane_titles': self.cfg['pane_titles']})
            return True, '窗格标题：' + ('开' if self.cfg['pane_titles'] else '关')
        return False, f'不认识的操作 {what}'

    def board_act(self, what, key, body):
        """The person on a channel: posts, starts or closes a discussion, has read it."""
        meta = A.channels().get(key)
        if not meta:  # (a project's or a workspace's that nobody has posted to yet)
            ch = self.projects.channel(self.projects.known.get(key)) or self.projects.ws_channel(key)
            if not ch:
                return False, '没有这个讨论区'
            A.chan_ensure(ch)
            meta = ch
        try:
            if what == 'board_seen':
                A.put(A.seen_file(key, ME_NAME), {'at': time.time(), 'ids': [], 'auto': False})
                return True, {}
            if what == 'board_post':
                text = (body.get('text') or '').strip()
                if not text:
                    return False, '先写要说的话'
                m = A.post(ME_NAME, key, text, body.get('topic') or None)
                A.put(A.seen_file(key, ME_NAME), {'at': m['at'], 'ids': [], 'auto': False})
                return True, f'发到了 {meta["name"]} 的讨论区' + (f'，叫了 {"、".join(m["to"])}' if m['to'] else '')
            if what == 'topic_new':
                title = (body.get('title') or '').strip()
                invite = [n for n in body.get('invite') or [] if isinstance(n, str) and NAME.fullmatch(n)]
                if not title:
                    return False, '给讨论起个题目'
                t = A.topic_new(ME_NAME, key, title, (body.get('text') or '').strip(), invite, int(body.get('max') or A.TOPIC_MAX))
                return True, {'msg': f'在 {meta["name"]} 发起了讨论「{t["title"]}」' + (f'，叫了 {"、".join(invite)}' if invite else ''), 'topic': t['id']}
            t = A.topic_close(ME_NAME, key, str(body.get('topic') or ''))
            return True, f'讨论「{t["title"]}」结束了'
        except ValueError as e:
            return False, str(e)

    # ---------- the queue: things to hand a session once it is free, checked by the assistant first ----------
    def qsave(self):
        A.put(self.qfile, self.queue[-300:])

    def queue_act(self, b):
        what = b.get('do')
        if what == 'add':
            text = (b.get('text') or '').strip()
            if not text:
                return False, '写下要做的事'
            to, group = (b.get('to') or '').strip(), (b.get('group') or '').strip()
            item = {'id': os.urandom(5).hex(), 'text': text[:4000], 'to': to, 'group': group, 'mode': b.get('mode') if b.get('mode') in ('remind', 'plain') else 'auto',
                    'status': 'waiting', 'created': time.time(), 'note': ''}
            self.queue.append(item)
            self.qsave()
            if item['mode'] == 'plain':
                return True, f'{to} 正在做事：等它这一轮做完，把你的原话发给它'
            where = f'等 {to} 空闲' if to else f'等{group + " 组里" if group else ""}有会话空闲'
            return True, f'排上了：{where}，' + ('到时先由助手确认再发' if item['mode'] == 'auto' else '到时提醒你')
        item = next((q for q in self.queue if q['id'] == b.get('id')), None)
        if not item:
            return False, '找不到这件排队的事'
        if what == 'delete':
            self.queue.remove(item)
        elif what == 'drop':
            item.update(status='dropped', note=item.get('note') or '你取消了')
        elif what == 'restore':
            item.update(status='waiting', note='', checked=0)
        elif what == 'edit':
            item['text'] = (b.get('text') or item['text']).strip()[:4000]
            if 'to' in b:
                item['to'] = (b.get('to') or '').strip()
        elif what == 'send':
            s = self.find_name(b.get('to') or item.get('to') or item.get('ready_to'))
            if not s:
                return False, '先选一个要发给的会话'
            ok, msg = self.deliver(s, item.get('text'))
            if not ok:
                return False, msg
            item.update(status='sent', sent_to=s['name'], sent_at=time.time(), note='你手动发出')
        else:
            return False, '不认识的操作'
        self.qsave()
        return True, {'delete': '删掉了', 'drop': '不发了', 'restore': '重新排上了', 'edit': '改好了', 'send': f'发给了 {item.get("sent_to")}'}[what]

    def find_name(self, name):
        return next((x for x in self.state['sessions'] if x['name'] == name and not x.get('unknown')), None) if name else None

    def deliver(self, s, text):
        """Hand a session the text: into its terminal when it is in a pane, else into its amail box."""
        if s.get('loc'):
            ok, msg = self.type_in(s, text, True)
            if ok:
                return True, msg
        sent = A.send(ME_NAME, s['name'], text)
        return (True, f'放进了 {s["name"]} 的信箱') if sent else (False, '发不出去')

    def free(self, s):
        return s['state'] == 'idle' and not s.get('needs_you') and s.get('status') not in ('waiting_user', 'blocked') and not s.get('unknown') and not s.get('stale')

    def queue_loop(self):
        while True:
            try:
                self.queue_pass()
            except Exception as e:
                self.note(f'排队处理出错：{e!r}', False)
            time.sleep(8)

    def queue_pass(self):
        now = time.time()
        sessions = self.state['sessions']
        for item in self.queue:
            if item['status'] not in ('waiting', 'held'):
                continue
            if item['status'] == 'held' and now - item.get('checked', 0) < 600:
                continue
            if item['to']:
                t = self.find_name(item['to'])
                if not t:
                    item.update(status='held', note=f'{item["to"]} 不在了：换一个会话，或删掉', checked=now)
                    self.qsave()
                    continue
                if item['mode'] == 'plain':  # (the person's own words, held while it worked: as they are, once it stops)
                    if t['state'] in ('idle', 'waiting') and not t.get('prompting') and not t.get('unknown'):
                        ok, msg = self.deliver(t, item['text'])
                        item.update(status='sent' if ok else 'held', sent_to=t['name'] if ok else None, sent_at=now if ok else None, checked=now,
                                    note='它这一轮做完了，原话发出' if ok else f'没发出去：{msg}'[:200])
                        self.qsave()
                    continue
                cands = [t] if self.free(t) else []
            else:
                cands = [x for x in sessions if self.free(x) and (not item['group'] or (x.get('loc') or {}).get('session') == item['group'])]
            if not cands:
                continue
            if item['mode'] == 'remind':
                item.update(status='ready', note=f'{cands[0]["name"]} 空了，可以发了', ready_to=cands[0]['name'])
                self.qsave()
                continue
            item['status'] = 'checking'
            self.qsave()
            decs = '\n'.join(f'- {d["what"]}（{d["name"]}）' for d in self.sums.decisions[-12:]) or '（没有）'
            lines = '\n'.join(f'- {x["name"]} · 空闲 · {x.get("title") or ""} · {x.get("summary") or ""}' for x in cands[:8])
            prompt = CHECK.format(when=time.strftime('%m-%d %H:%M'), queued=ago_text(item['created']), text=item['text'], candidates=lines, decisions=decs,
                                  to_rule=f'只能是 {item["to"]}' if item['to'] else '从候选里挑最合适的一个')
            try:
                out = ask_model(prompt, self.cfg, 'assist')
                m = re.search(r'\{.*\}', out, re.S)
                r = json.loads(m.group(0)) if m else {}
            except Exception as e:
                item.update(status='waiting', note=f'助手没回上来，稍后再试：{e}'[:160], checked=now)
                self.qsave()
                continue
            verdict, reason = r.get('verdict'), str(r.get('reason') or '')[:160]
            item['checked'] = now
            if verdict == 'drop':
                item.update(status='dropped', note=f'助手觉得不用发了：{reason}')
            elif verdict == 'send':
                t = self.find_name(item['to'] or r.get('to'))
                t = t if t in cands else cands[0]
                text = str(r.get('text') or item['text']).strip() or item['text']
                ok, msg = self.deliver(t, text)
                item.update(status='sent' if ok else 'held', sent_to=t['name'] if ok else None, sent_at=now if ok else None,
                            sent_text=text if ok else None, note=(f'助手确认后发出：{reason}' if ok else f'没发出去：{msg}')[:200])
                if ok:
                    self.note(f'排队的事发给了 {t["name"]}')
            else:
                item.update(status='held', note=f'助手建议先等：{reason}')
            self.qsave()

    def new_session(self, b):
        """A new agent in a group (a Zellij or tmux session; made in the background when new), in its own tab or
        window, at a folder."""
        kind, group = b.get('kind'), (b.get('group') or '').strip()
        mux = 'tmux' if group.startswith('tmux:') or b.get('mux') == 'tmux' else 'zellij'
        group = group[5:] if group.startswith('tmux:') else group
        name, prompt = (b.get('name') or '').strip(), (b.get('prompt') or '').strip()
        cwd = os.path.realpath(os.path.expanduser((b.get('cwd') or '~').strip()))
        if kind not in ('claude', 'codex', 'cursor', 'shell'):
            return False, '选一个 agent，或终端'
        if not NAME.fullmatch(group):
            return False, '组名只能用字母、数字和 _ . -'
        if name and not NAME.fullmatch(name):
            return False, '名字只能用字母、数字和 _ . -'
        if name and name in A.rows():
            return False, f'{name} 已经有会话在用了'
        if not os.path.isdir(cwd):
            return False, f'目录不存在：{cwd}'
        argv = [os.environ.get('SHELL') or '/bin/bash', '-l'] if kind == 'shell' else list(self.cfg.get('launch', DEFAULTS['launch']).get(kind) or DEFAULTS['launch'][kind])
        if kind == 'claude' and name:
            argv += ['--name', name]
        if prompt and kind != 'shell':
            argv.append(prompt)
        marker = os.urandom(6).hex()
        env = [f'STURNUS_NEW={marker}'] + ([f'AMAIL_NAME={name}'] if name else [])
        tab = name or f'{"终端" if kind == "shell" else kind}·{os.path.basename(cwd) or "~"}'
        if mux == 'tmux':
            ok, made, loc = TMUX.new(group, tab, cwd, env, argv)
            if not ok:
                return False, f'tmux 开不了：{made}'
            return self.started(b, kind, name, tab, f'tmux:{group}', cwd, marker, made, loc)
        layout = f'''layout {{
    tab name={kdl(tab)} cwd={kdl(cwd)} {{
        pane size=1 borderless=true {{
            plugin location="zellij:tab-bar"
        }}
        pane command="env" name={kdl(tab)} cwd={kdl(cwd)} {{
            args {" ".join(kdl(a) for a in env + argv)}
        }}
        pane size=1 borderless=true {{
            plugin location="zellij:status-bar"
        }}
    }}
}}
'''
        os.makedirs(os.path.join(CACHE, 'layouts'), exist_ok=True)
        f = os.path.join(CACHE, 'layouts', f'{marker}.kdl')
        with open(f, 'w') as w:
            w.write(layout)
        made = ''
        if group not in zellij_sessions():
            r = run(['zellij', 'attach', '--create-background', group, 'options', '--show-startup-tips', 'false'], timeout=10)
            for _ in range(20):
                if group in zellij_sessions():
                    break
                time.sleep(.25)
            else:
                return False, f'建不了组 {group}：{(r.stderr or r.stdout).strip()[:160]}'
            made = f'新建了组 {group}，'
        else:
            with ROOM:
                room = zellij_room(group, 'tab')
            if room and not room['ok']:
                return False, (f'没有开：{group} 的 Zellij 已经开着 {room["held"]} 个文件，上限 {room["limit"]}，再开一个标签页要约 '
                               f'{room["need"]} 个，超过上限它会崩掉，里面的会话全部结束。先关掉一个连着它的终端，或者调高上限（见 README）。')
        r = zj(group, 'action', 'new-tab', '--layout', f, timeout=10)
        if r.returncode != 0:
            return False, f'开不了新标签页：{(r.stderr or r.stdout).strip()[:200]}'
        return self.started(b, kind, name, tab, group, cwd, marker, made, zellij_marked(group, marker))

    def started(self, b, kind, name, tab, group, cwd, marker, made, loc=None):
        if kind == 'shell':  # (not an agent: no card; the page opens it in its terminal once it runs)
            for _ in range(24):
                loc = loc or marked(marker)
                if loc:
                    return True, {'msg': f'{made}在 {group.removeprefix("tmux:")} 里开了终端「{tab}」', 'term': {'group': loc['session'], 'pane': loc['pane']}}
                time.sleep(.25)
            return True, f'{made}在 {group.removeprefix("tmux:")} 里开了终端「{tab}」'
        if kind == 'codex' and name:
            self.pending[marker] = name  # (a Codex thread takes its name once it shows up)
        self.launched[marker] = {'kind': kind, 'name': name or tab, 'group': group, 'cwd': cwd, 'at': time.time()}
        if b.get('jump'):
            threading.Thread(target=self._jump_when_up, args=(marker, tab), daemon=True).start()
        return True, f'{made}在 {group.removeprefix("tmux:")} 里开了「{tab}」（{ {"claude": "Claude Code", "codex": "Codex", "cursor": "Cursor"}[kind]}，{cwd.replace(os.path.expanduser("~"), "~")}）'

    def type_in(self, s, text, enter):
        """Type into a session's pane as if at its keyboard (and press Enter)."""
        if not s or not s.get('loc'):
            return False, '这个会话不在 Zellij 或 tmux 里'
        if DRY:
            self.note(f'（试用，没有真的输入）{s["name"]}：{text[:80]}')
            return True, f'（试用）会在 {s["name"]} 的终端里输入'
        loc = s['loc']
        if loc['mux'] == 'tmux':
            return (True, f'已在 {s["name"]} 的终端里输入') if TMUX.type(loc, text, enter) else (False, '写不进它的 tmux 窗格')
        if text:
            r = plugin(loc['session'], f'type {loc["pane"]} {text}')
            if r.returncode != 0 or 'ok' not in r.stdout:
                if (self.state['groups'].get(loc['session']) or {}).get('clients'):
                    ask_grant(loc['session'])
                    return False, f'第一次在组 {loc["session"]} 里输入：Zellij 在你的终端里弹了一个授权框，按 y 同意后再发一次'
                return False, f'写不进去：组 {loc["session"]} 要有终端连着'
        if enter:
            time.sleep(.15)  # (a TUI takes pasted text, then the key)
            plugin(loc['session'], f'enter {loc["pane"]}')
        return True, f'已在 {s["name"]} 的终端里输入'

    def _jump_when_up(self, marker, tab):
        for _ in range(40):
            loc = marked(marker)
            if loc:
                ok, msg = go_to(loc)
                self.note(f'「{tab}」：{msg}', ok)
                return
            time.sleep(.25)
        self.note(f'「{tab}」还没起来，稍后在卡片上点跳转', False)

    def voice_view(self):
        v = voice_cfg(self.cfg)
        mask = lambda k: (k[:3] + '…' + k[-4:]) if len(k) > 10 else ('已设置' if k else '')
        return {**v, 'keys': {p: mask(voice_key(p)) for p in STT}, 'label': voice_label(v), 'defaults': STT_MODEL}

    def models_view(self):
        out = {}
        for role in ('summary', 'assist'):
            m = model_for(self.cfg, role)
            k = secret(role)
            out[role] = {'source': m['source'], 'model': m.get('model') or '', 'url': m.get('url') or '', 'key_env': m.get('key_env') or '',
                         'key': (k[:3] + '…' + k[-4:]) if len(k) > 10 else ('已设置' if k else ''), 'label': model_label(self.cfg, role)}
        return out

    def model_from(self, b):
        role = b.get('role')
        if role not in ('summary', 'assist'):
            raise ValueError('不认识的模型用途')
        src = b.get('source')
        if src not in SOURCES:
            raise ValueError('选一个来源')
        m = {'source': src, 'model': str(b.get('model') or '').strip()[:80]}
        if src == 'api':
            m['url'] = str(b.get('url') or '').strip()
            if not re.match(r'^https?://', m['url']):
                raise ValueError('接口地址要以 http:// 或 https:// 开头')
            if not m['model']:
                raise ValueError('填上模型名')
            if b.get('key_env'):
                m['key_env'] = str(b['key_env']).strip()
        key = b.get('key')
        key = key if key and '…' not in key and key != '已设置' else None  # (the masked one shown back is not a new key)
        return role, m, key

    def _ask(self, to, text):
        try:
            r = A.ask(ME_NAME, to, text)
            self.note(f'问 {to}：{r}')
        except Exception as e:
            self.note(f'问 {to} 失败：{e!r}', False)

    def rename(self, s, new):
        if s['kind'] == 'claude':
            return False, f'Claude 会话的名字由它自己定：在那个会话里输入 /rename {new}，这里和 amail 会跟着变'
        if new in A.rows():
            return False, f'{new} 已经有人用了'
        if s['kind'] == 'codex' and s.get('session'):
            ok, msg = codex_set_name(s['session'], new)
            if not ok:
                self.note(f'Codex 会话名没改成：{msg}', False)
        r = run([sys.executable, os.path.join(APP, 'amail'), '--as', s['name'], 'rename', new])
        if r.returncode != 0:
            return False, (r.stderr or r.stdout).strip()[:200]
        self.titles = {}
        return True, f'{s["name"]} 改名为 {new}（amail、Zellij 窗格{"、Codex 会话" if s["kind"] == "codex" else ""}都已同步）'


ASKS = ('AskUserQuestion', 'ExitPlanMode')  # (tools that put a choice to the person in the terminal)


def say_how(s, now=False):
    """How the person's words for a session get there: typed into its pane when it is idle (or now, if asked); held until
    its turn ends while it works; not at all while it sits at a permission or choice prompt (they would answer it); by
    mail when it is in no pane."""
    if s['state'] in ('gone', 'ended'):
        return 'gone'
    if s.get('prompting') or (s.get('tool') in ASKS and s['state'] == 'working' and (s.get('tool_at') or 0) > (s.get('tool_end') or 0)):
        return 'menu'
    if not s.get('loc'):
        return 'mail'
    return 'queue' if s['state'] == 'working' and not now else 'type'


def codex_set_name(thread, name):
    """Name a Codex thread through the shared app-server daemon (WebSocket on its control socket)."""
    import base64, socket, struct
    path = os.path.expanduser('~/.codex/app-server-control/app-server-control.sock')
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(10)
        s.connect(path)
        s.sendall(('GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                   f'Sec-WebSocket-Key: {base64.b64encode(os.urandom(16)).decode()}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
        buf = b''
        while b'\r\n\r\n' not in buf:
            buf += s.recv(4096)
        rest = buf.split(b'\r\n\r\n', 1)[1]

        def send(obj):
            d = json.dumps(obj).encode()
            mask = os.urandom(4)
            n = len(d)
            hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0xFE]) + struct.pack('>H', n))
            s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(d)))

        def recv():
            nonlocal rest
            def take(n):
                nonlocal rest
                while len(rest) < n:
                    rest += s.recv(65536)
                d, rest = rest[:n], rest[n:]
                return d
            msg = b''
            while True:
                b0, b1 = take(2)
                n = b1 & 0x7f
                if n == 126:
                    n = struct.unpack('>H', take(2))[0]
                elif n == 127:
                    n = struct.unpack('>Q', take(8))[0]
                d = take(n)
                if b0 & 0x0f in (8,):
                    raise ConnectionError('closed')
                if b0 & 0x0f in (9, 10):
                    continue
                msg += d
                if b0 & 0x80:
                    return json.loads(msg)

        def call(i, method, params):
            send({'jsonrpc': '2.0', 'id': i, 'method': method, 'params': params})
            while True:
                m = recv()
                if m and m.get('id') == i:
                    return m

        call(1, 'initialize', {'clientInfo': {'name': 'sturnus', 'version': VERSION}})
        send({'jsonrpc': '2.0', 'method': 'initialized'})
        r = call(2, 'thread/name/set', {'threadId': thread, 'name': name})
        s.close()
        return 'error' not in r, str(r.get('error') or 'ok')
    except Exception as e:
        return False, repr(e)


