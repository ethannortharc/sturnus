def http_json(url, data=None, headers=None, method=None, timeout=90):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers or {}, method=method), timeout=timeout) as r:
            return json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        raise RuntimeError(f'{e.code}: {e.read().decode("utf-8", "replace")[:240]}')


def multipart(fields, audio, ctype):
    b = uuid4hex()
    ext = 'mp4' if 'mp4' in ctype else 'ogg' if 'ogg' in ctype else 'wav' if 'wav' in ctype else 'webm'
    out = b''.join(f'--{b}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode() for k, v in fields)
    out += f'--{b}\r\nContent-Disposition: form-data; name="file"; filename="voice.{ext}"\r\nContent-Type: {ctype}\r\n\r\n'.encode() + audio + f'\r\n--{b}--\r\n'.encode()
    return out, f'multipart/form-data; boundary={b}'


def uuid4hex():
    return os.urandom(12).hex()


def transcribe(audio, ctype, v, key):
    """Speech to text by the chosen service: Soniox, ElevenLabs, AssemblyAI, or any OpenAI-compatible endpoint."""
    p, lang = v['provider'], v.get('lang') or ''
    model = v.get('model') or STT_MODEL[p]
    if not key:
        raise RuntimeError('还没填 API key')
    if p == 'openai':
        body, ct = multipart([('model', model)] + ([('language', lang)] if lang else []), audio, ctype)
        url = (v.get('url') or 'https://api.openai.com/v1').rstrip('/') + '/audio/transcriptions'
        return http_json(url, body, {'Authorization': f'Bearer {key}', 'Content-Type': ct}).get('text', '')
    if p == 'elevenlabs':
        body, ct = multipart([('model_id', model)] + ([('language_code', lang)] if lang else []), audio, ctype)
        return http_json('https://api.elevenlabs.io/v1/speech-to-text', body, {'xi-api-key': key, 'Content-Type': ct}).get('text', '')
    if p == 'assemblyai':
        h, base = {'authorization': key}, 'https://api.assemblyai.com/v2'
        up = http_json(f'{base}/upload', audio, {**h, 'Content-Type': 'application/octet-stream'})['upload_url']
        req = {'audio_url': up, 'speech_model': model, **({'language_code': lang} if lang else {'language_detection': True})}
        t = http_json(f'{base}/transcript', json.dumps(req).encode(), {**h, 'Content-Type': 'application/json'})
        for _ in range(150):
            time.sleep(.6)
            r = http_json(f'{base}/transcript/{t["id"]}', headers=h)
            if r.get('status') == 'completed':
                return r.get('text') or ''
            if r.get('status') == 'error':
                raise RuntimeError(r.get('error') or 'AssemblyAI 出错')
        raise RuntimeError('AssemblyAI 太久没转完')
    if p == 'soniox':
        h, base = {'Authorization': f'Bearer {key}'}, 'https://api.soniox.com/v1'
        body, ct = multipart([], audio, ctype)
        f = http_json(f'{base}/files', body, {**h, 'Content-Type': ct})
        try:
            req = {'file_id': f['id'], 'model': model, 'language_hints': [lang] if lang else ['zh', 'en']}
            t = http_json(f'{base}/transcriptions', json.dumps(req).encode(), {**h, 'Content-Type': 'application/json'})
            try:
                for _ in range(150):
                    time.sleep(.6)
                    r = http_json(f'{base}/transcriptions/{t["id"]}', headers=h)
                    if r.get('status') == 'completed':
                        return http_json(f'{base}/transcriptions/{t["id"]}/transcript', headers=h).get('text', '')
                    if r.get('status') == 'error':
                        raise RuntimeError(r.get('error_message') or 'Soniox 出错')
                raise RuntimeError('Soniox 太久没转完')
            finally:
                try:
                    http_json(f'{base}/transcriptions/{t["id"]}', headers=h, method='DELETE')
                except Exception:
                    pass
        finally:
            try:
                http_json(f'{base}/files/{f["id"]}', headers=h, method='DELETE')  # (nothing of the person's voice stays there)
            except Exception:
                pass
    raise RuntimeError('选一个语音服务')


def silence():
    """A second of silence (16 kHz WAV): what the test sends."""
    n = 16000 * 2
    return b'RIFF' + struct.pack('<I', 36 + n) + b'WAVEfmt ' + struct.pack('<IHHIIHH', 16, 1, 1, 16000, 32000, 2, 16) + b'data' + struct.pack('<I', n) + bytes(n)


