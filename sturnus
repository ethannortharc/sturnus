def agent_model(kind):
    """The model a custom agent type runs on, from its definition's front matter (e.g. sonnet), or ''."""
    if kind not in _agent_models:
        m = ''
        try:
            with open(os.path.join(AGENT_DEFS, f'{os.path.basename(kind)}.md')) as f:
                x = re.search(r'^model:\s*([^\n]+)$', f.read(3000), re.M)
            m = x.group(1).strip().strip('"\'') if x else ''
        except OSError:
            pass
        _agent_models[kind] = m
    return _agent_models[kind]


def first_time(path):
    """When a conversation file begins: the first timestamp in its first lines, or None. (Claude Code may open one with
    lines that carry none.)"""
    try:
        with open(path, 'rb') as f:
            for _ in range(20):
                line = f.readline(400000)
                if not line:
                    return None
                try:
                    ts = json.loads(line).get('timestamp')
                    if ts:
                        return time.mktime(time.strptime(ts[:19], '%Y-%m-%dT%H:%M:%S')) - time.timezone
                except Exception:
                    continue
    except Exception:
        return None


_began = {}


def began_in(path):
    """The folder a conversation began in: the first one its first lines note (Claude Code notes one on each line,
    Codex one in its first), or None."""
    if not path or path in _began:
        return _began.get(path)
    try:
        with open(path, 'rb') as f:
            for _ in range(20):
                line = f.readline(400000)
                if not line:
                    return None  # (not there yet: looked at again later)
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                at = isinstance(d, dict) and (d.get('cwd') or isinstance(d.get('payload'), dict) and d['payload'].get('cwd'))
                if at and isinstance(at, str):
                    _began[path] = at
                    return at
    except OSError:
        return None
    _began[path] = None
    return None


SUB = re.compile(r'[0-9a-f]{6,40}')
_subs = {}


def sub_end(path):
    """How a sub-agent's conversation ends: 'said' on its last answer (the assistant's, with no tool call pending),
    'maybe' on assistant words that may go on, '' on anything else. (Claude Code seldom marks one finished.)"""
    for line in reversed(tail_lines(path, 60000)):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if not isinstance(d, dict) or d.get('type') not in ('user', 'assistant'):
            continue
        m = d.get('message') if isinstance(d.get('message'), dict) else {}
        c = m.get('content')
        if d['type'] != 'assistant' or any(isinstance(x, dict) and x.get('type') == 'tool_use' for x in (c if isinstance(c, list) else [])):
            return ''
        return 'said' if m.get('stop_reason') in ('end_turn', 'stop_sequence', 'max_tokens') else 'maybe'
    return ''


def subagents_of(s):
    """A Claude Code session's own sub-agents (its Agent tool: they have no process or hooks of their own), from the
    files Claude Code keeps beside its conversation: <session>/subagents/agent-<id>.meta.json (type, task, finished)
    and agent-<id>.jsonl (the sub-agent's conversation). Running ones first, then the last finished; at most 20."""
    path = transcript_of(s) if s['kind'] == 'claude' else None
    if not path or not path.endswith('.jsonl'):
        return []
    d = os.path.join(path[:-6], 'subagents')
    try:
        names = [n for n in os.listdir(d) if n.startswith('agent-') and n.endswith('.meta.json')]
    except OSError:
        return []
    now, out = time.time(), []
    for n in names:
        aid = n[6:-10]
        if not SUB.fullmatch(aid):
            continue
        mf, jf = os.path.join(d, n), os.path.join(d, f'agent-{aid}.jsonl')
        try:
            mt = os.path.getmtime(mf)
            jt = os.path.getmtime(jf) if os.path.exists(jf) else mt
        except OSError:
            continue
        hit = _subs.get(mf)
        if not hit or hit[0] != (mt, jt):
            m = A.get(mf, {}) or {}
            hit = ((mt, jt), {'id': aid, 'type': str(m.get('agentType') or ''), 'task': str(m.get('description') or '')[:200], 'finished': bool(m.get('finished')),
                               'start': (_subs.get(mf) or (None, {}))[1].get('start') or first_time(jf) or mt, 'at': max(mt, jt), 'end': sub_end(jf)})
            _subs[mf] = hit
        a, end = dict(hit[1]), hit[1].get('end', '')
        quiet = now - a['at']
        if a['finished'] or end == 'said' or (end == 'maybe' and quiet > 120) or quiet > 1800:
            a['state'], a['stopped'] = 'done', not a['finished'] and not end  # (stopped: half an hour quiet with no last word: cut off)
        else:
            a['state'] = 'working' if quiet < 120 else 'quiet'  # (quiet: no word for two minutes)
        a.pop('end', None)
        a['model'] = agent_model(a['type'])
        out.append(a)
    return sorted(out, key=lambda a: (a['state'] == 'done', -a['at']))[:20]


def transcript_of(s):
    if s.get('transcript') and os.path.exists(s['transcript']):
        return s['transcript']
    key = (s['kind'], s.get('session'))
    if key in _transcripts and os.path.exists(_transcripts[key]):
        return _transcripts[key]
    found = None
    if s['kind'] == 'claude' and s.get('session'):
        found = next(iter(glob.glob(os.path.expanduser(f'~/.claude/projects/*/{s["session"]}.jsonl'))), None)
    elif s['kind'] == 'codex' and s.get('session'):
        found = next(iter(sorted(glob.glob(os.path.expanduser(f'~/.codex/sessions/*/*/*/rollout-*-{s["session"]}.jsonl')))), None)
    elif s['kind'] == 'cursor' and s.get('session'):  # (its sessionStart hook gives no transcript_path yet)
        found = next(iter(glob.glob(os.path.expanduser(f'~/.cursor/projects/*/agent-transcripts/{s["session"]}/{s["session"]}.jsonl'))), None)
    if found:
        _transcripts[key] = found
    return found


def transcript_cwd(path):
    """The folder a conversation file says it ran in."""
    try:
        with open(path) as f:
            for _, line in zip(range(40), f):
                d = json.loads(line)
                c = d.get('cwd') or (d.get('payload') or {}).get('cwd')
                if c:
                    return c
    except (OSError, TypeError, ValueError, AttributeError):
        pass
    return None


def codex_meta(path, _seen={}):
    if path not in _seen:
        try:
            with open(path) as f:
                _seen[path] = json.loads(f.readline()).get('payload') or {}
        except (OSError, ValueError):
            _seen[path] = {}
    return _seen[path]


def codex_sub(meta):
    """Whether a Codex thread is a sub-agent's — one that another thread spawned, a review, its guardian — as its file's
    first line says: {parent: the thread that started it (None when the file does not name one), role: what to call it}.
    None for a thread of the person's own. (Each such thread fires the hooks of a session, so it would pass for one.)"""
    src = meta.get('source')
    sub = src.get('subagent') if isinstance(src, dict) else None
    if sub is None and not meta.get('parent_thread_id') and meta.get('thread_source') not in ('subagent', 'guardian_review'):
        return None
    spawn = sub.get('thread_spawn') if isinstance(sub, dict) and isinstance(sub.get('thread_spawn'), dict) else {}
    parent = meta.get('parent_thread_id') or spawn.get('parent_thread_id')
    place = os.path.basename(str(spawn.get('agent_path') or '').rstrip('/'))
    name = ' · '.join(x for x in (spawn.get('agent_nickname'), spawn.get('agent_role'), place) if isinstance(x, str) and x)
    what = sub if isinstance(sub, str) else sub.get('other') if isinstance(sub, dict) and isinstance(sub.get('other'), str) else ''
    role = name or {'review': tx('审查', 'review'), 'guardian': tx('守护检查', 'guardian check')}.get(what, what) or tx('子 agent', 'sub-agent')
    return {'parent': parent if isinstance(parent, str) and parent else None, 'role': str(role)[:60]}


def codex_fileless(s, file_of=None):
    """Whether a Codex thread keeps no conversation: its hooks named no file for it (their transcript_path is null
    then) and there is none on disk. The desktop app starts such threads of its own beside the person's — short runs
    that leave nothing behind — and each fires a session's hooks. A thread the person talks in always has a file."""
    return s.get('kind') == 'codex' and not s.get('transcript') and not (file_of or transcript_of)(s)


def codex_family(codex, meta_of):
    """Codex's sub-agent threads among its live ones, each given to the thread that started it: marked 'sub' (what to
    call it) and, where that thread is among them, 'parent' (its name). One whose file names no parent (a review, a
    guardian check of older Codex versions) is given to the thread of the person's in the same folder that stirred
    last; one with no such thread keeps the mark alone, and is no session of its own. (A thread marked before it is
    called — one that keeps no conversation — is left as it is: no thread's sub-agent, and no one's starter.)"""
    by = {s.get('session'): s for s in codex if s.get('session')}
    subs = []
    for s in codex:
        sub = codex_sub(meta_of(s))
        if sub:
            s['sub'] = sub['role']
            subs.append((s, sub))
    mine = [s for s in codex if not s.get('sub')]
    for s, sub in subs:
        p = by.get(sub['parent']) if sub['parent'] else None
        seen = set()
        while p is not None and p.get('sub') and id(p) not in seen:  # (a sub-agent's own sub-agent: shown with the thread at the top)
            seen.add(id(p))
            up = codex_sub(meta_of(p))
            p = by.get(up['parent']) if up and up['parent'] else None
        if p is None and not sub['parent']:
            home = meta_of(s).get('cwd') or s.get('cwd')
            near = [x for x in mine if (meta_of(x).get('cwd') or x.get('cwd')) == home]
            p = max(near, key=lambda x: x.get('at') or 0, default=None)
        if p is not None and p is not s and not p.get('sub'):
            s['parent'] = p['name']
    return [s for s, _ in subs]


def codex_launch_thread(start, cwd):
    """The thread a Codex window began with, for a window its hooks never saw (opened before they were installed):
    Codex starts one as the window opens, in its folder. ponytail: a later /new in that window is not followed."""
    best = None
    for f in glob.glob(os.path.expanduser(f'~/.codex/sessions/{time.strftime("%Y/%m/%d", time.localtime(start))}/rollout-*.jsonl')):
        m = re.search(r'rollout-(\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d)-(.+)\.jsonl$', f)
        gap = m and time.mktime(time.strptime(m.group(1), '%Y-%m-%dT%H-%M-%S')) - start
        if m and -5 <= gap <= 120 and (not best or abs(gap) < best[0]):
            meta = codex_meta(f)
            if meta.get('cwd') == cwd and isinstance(meta.get('source'), str):  # (a sub-agent's source is not a word)
                best = (abs(gap), f, m.group(2))
    return best and best[1:]


def cursor_chat(pid):
    """The chat a Cursor window shows: the store it holds open."""
    for p in A.proc_files(pid):
        if p.endswith('/store.db') and '/.cursor/chats/' in p:
            return p
    return None


def cursor_message(d):
    """A Cursor message, from its chat store or its transcript file, as {role, content}: a person's words without the
    wrappers Cursor puts around them, and what Cursor itself tells the agent left out."""
    m = d.get('message')  # (the transcript file nests it: {role, message: {content}})
    d = {'role': d.get('role'), 'content': m.get('content') if isinstance(m, dict) else d.get('content')}
    if d['role'] == 'user':
        t, _ = text_of(d['content'])
        q = re.search(r'<user_query>\s*(.*?)\s*</user_query>', t, re.S)
        d['content'] = q.group(1) if q else ''
    return d


def cursor_lines(lines):
    """A Cursor transcript file's lines (the transcript_path its hooks give) as its chat store's messages."""
    out = []
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get('role'):  # (not its {"type": "turn_ended"} marks)
            out.append(json.dumps(cursor_message(d)))
    return out


def cursor_messages(path):
    """A Cursor chat's messages {role, content}, in order (its latest root lists them by id)."""
    out = []
    try:
        db = sqlite3.connect(f'file:{path}?mode=ro', uri=True)
        try:
            meta = json.loads(bytes.fromhex(db.execute("select value from meta where key='0'").fetchone()[0]))
            root = db.execute('select data from blobs where id=?', (meta['latestRootBlobId'],)).fetchone()[0]
            for m in re.finditer(rb'\x0a\x20', root):  # ponytail: ids read as 32-byte fields, not a protobuf parse
                r = db.execute('select data from blobs where id=?', (root[m.end():m.end() + 32].hex(),)).fetchone()
                if r and r[0][:1] == b'{':
                    out.append(json.loads(r[0]))
        finally:
            db.close()
    except (sqlite3.Error, TypeError, ValueError, KeyError):
        return []
    return [cursor_message(d) for d in out]


_said = {}


def last_said(path, at):
    """What a conversation's agent said last (read again only when the conversation moved)."""
    if not path:
        return None
    if _said.get(path, (None,))[0] != at:
        said = next((i['text'] for i in reversed(transcript_items(path, 60)) if i['who'] == 'assistant'), None)
        _said[path] = (at, said and said[:1500])
    return _said[path][1]


def lines_of(path, size=400000):
    if path.endswith('/store.db'):
        return [json.dumps(d) for d in cursor_messages(path)]
    lines = tail_lines(path, size)
    return cursor_lines(lines) if '/.cursor/projects/' in path else lines


# (a picture inside a line: Claude Code's {"type":"image","source":{…,"data":"<base64>"}} and Codex's {"type":"input_image",
# "image_url":"data:image/png;base64,<base64>"})
PIC_DATA = re.compile(rb'("data":\s*"|"image_url":\s*"data:image/[A-Za-z0-9.+-]+;base64,)([A-Za-z0-9+/]{64,}={0,2})"')
PIC_TYPES = {'png': 'image/png', 'jpeg': 'image/jpeg', 'gif': 'image/gif', 'webp': 'image/webp'}
PIC_MOST = 40 << 20  # (of base64: more than that is not shown)
NOT_TALK = re.compile(rb'\{"type":"(api-request|api-request-blob|session-owner|atis-latch|mode|permission-mode|last-prompt|ai-title|tools-used)"')  # (Claude Code's own bookkeeping)


def tail_lines(path, size=400000, furthest=40000000, longest=300000):
    """The last lines of a file, about SIZE bytes of them, oldest first. A screenshot in a conversation weighs a megabyte
    or more: a line that long has its inline data taken out (or is left out), so it neither crowds out the words around
    it nor counts towards SIZE; for those, reading goes back as far as FURTHEST."""
    kept, got = [], 0
    try:
        with open(path, 'rb') as f:
            pos, seen, rest = os.path.getsize(path), 0, b''
            while pos > 0 and got < size and seen < furthest:
                n = min(1 << 20, pos)
                pos -= n
                seen += n
                f.seek(pos)
                parts = (f.read(n) + rest).split(b'\n')
                rest = parts.pop(0) if pos > 0 else b''  # (its start is in the part before)
                for line in reversed(parts):
                    if NOT_TALK.match(line):
                        continue
                    if len(line) > longest:
                        line = PIC_DATA.sub(rb'\1"', line)
                    if line.strip() and len(line) <= longest:
                        kept.append(line)
                        got += len(line)
                        if got >= size:
                            break
    except OSError:
        return []
    return [line.decode('utf-8', 'replace') for line in reversed(kept)]


def text_of(content):
    if isinstance(content, str):
        return content, []
    texts, tools = [], []
    for x in content or []:
        if not isinstance(x, dict):
            continue
        if x.get('type') in ('text', 'input_text', 'output_text') and x.get('text'):
            texts.append(x['text'])
        elif x.get('type') in ('tool_use', 'tool-call'):  # (Claude Code, Cursor)
            i = x.get('input') or x.get('args') or {}
            i = i if isinstance(i, dict) else {}
            tools.append(f'{x.get("name") or x.get("toolName")}({str(i.get("command") or i.get("file_path") or i.get("path") or i.get("description") or "")[:120]})')
    return '\n'.join(texts), tools


def pics_of(content, results=False):
    """The pictures among a message's parts, as the marks pics_out left for their data, in order: the parts' own, or
    with RESULTS those inside the results of steps (what a tool showed the agent)."""
    out = []
    for x in content if isinstance(content, list) else []:
        if not isinstance(x, dict):
            continue
        if x.get('type') == 'tool_result':
            out += pics_of(x.get('content')) if results else []
            continue
        v = (x.get('source') or {}).get('data') if x.get('type') == 'image' and isinstance(x.get('source'), dict) else \
            str(x.get('image_url') or '').rpartition(',')[2] if x.get('type') == 'input_image' else None
        if isinstance(v, str) and re.fullmatch(r'@pic\d+', v) and not results:
            out.append(int(v[4:]))
    return out


IMAGE_TAG = re.compile(r'\s*(<image\b[^>]*>|</image>)\s*')  # (Codex puts a picture between two parts that say only this)


def line_items(d):
    """One line of a conversation file (Claude Code's, Codex's, or another's in that shape) as items {who: user|assistant|
    tool, text, at}; pics on one that pictures came with (the marks pics_out left: said_of makes them what is kept)."""
    out = []
    if not isinstance(d, dict):
        return out
    at = d.get('timestamp')
    if d.get('type') == 'attachment':
        # (words sent while the agent was at work: Claude Code hands them to it at its next step and keeps them as a
        # line of this kind, where they took effect — the person's words all the same. What the harness queues the same
        # way, a background task's notice, is one line; another session's message is not the person's)
        a = d.get('attachment')
        if isinstance(a, dict) and a.get('type') == 'queued_command':
            t, _ = text_of(a.get('prompt'))
            who = (a.get('origin') or {}).get('kind') or ('human' if a.get('commandMode') == 'prompt' and not a.get('isMeta') else a.get('commandMode'))
            note = re.search(r'<summary>(.*?)</summary>', t, re.S) if who == 'task-notification' else None
            mine = pics_of(a.get('prompt')) if who == 'human' else []
            if who == 'human' and (t.strip() or mine) and not re.match(r'\s*<(task-notification|system-reminder|local-command|command-|cross-session-message)', t):
                out.append({'who': 'user', 'text': t.strip()[:4000], 'at': at or a.get('timestamp'), **({'pics': mine} if mine else {})})
            elif note:
                out.append({'who': 'tool', 'text': tx(f'后台通知：{" ".join(note.group(1).split())[:200]}', f'Background notice: {" ".join(note.group(1).split())[:200]}'), 'at': at})
        return out
    if d.get('type') in ('user', 'assistant') and isinstance(d.get('message'), dict):
        m = d['message']
        c = m.get('content')
        shown = pics_of(c, results=True) if m.get('role') == 'user' else []  # (what a step showed the agent: a screenshot, a picture it read)
        if m.get('role') == 'user' and isinstance(c, list) and all(isinstance(x, dict) and x.get('type') == 'tool_result' for x in c):
            return [{'who': 'tool', 'text': '', 'at': at, 'pics': shown}] if shown else out
        t, tools = text_of(c)
        if m.get('role') == 'user' and re.match(r'\s*<(task-notification|system-reminder|local-command|command-)', t):
            note = re.search(r'<summary>(.*?)</summary>', t, re.S)  # (the harness speaking, not the person: one line)
            if note:
                out.append({'who': 'tool', 'text': tx(f'后台通知：{" ".join(note.group(1).split())[:200]}', f'Background notice: {" ".join(note.group(1).split())[:200]}'), 'at': at})
            return out
        mine = pics_of(c) if m.get('role') == 'user' else []  # (the person's own, sent with their words)
        if t.strip() or mine:
            out.append({'who': m.get('role'), 'text': t.strip()[:4000], 'at': at, **({'pics': mine} if mine else {})})
        for tool in tools:
            out.append({'who': 'tool', 'text': tool, 'at': at})
        if shown:
            out.append({'who': 'tool', 'text': '', 'at': at, 'pics': shown})
    elif d.get('type') == 'response_item' and isinstance(d.get('payload'), dict):
        p = d['payload']
        if p.get('type') == 'message' and p.get('role') in ('user', 'assistant'):
            c = p.get('content')
            mine = pics_of(c) if p['role'] == 'user' else []
            if isinstance(c, list):  # (the two parts around a picture say nothing of their own)
                c = [x for x in c if not (isinstance(x, dict) and x.get('type') == 'input_text' and IMAGE_TAG.fullmatch(x.get('text') or ''))]
            t, _ = text_of(c)
            if (t.strip() or mine) and not t.lstrip().startswith(('<environment_context', '<user_instructions', '# AGENTS.md', '<permissions')):
                out.append({'who': p['role'], 'text': t.strip()[:4000], 'at': at, **({'pics': mine} if mine else {})})
        elif p.get('type') in ('function_call', 'custom_tool_call'):
            out.append({'who': 'tool', 'text': f'{p.get("name")}({str(p.get("arguments") or p.get("input") or "")[:160]})', 'at': at})
        elif p.get('type') in ('function_call_output', 'custom_tool_call_output'):
            shown = pics_of(p.get('output'))  # (what a step showed the agent)
            if shown:
                out.append({'who': 'tool', 'text': '', 'at': at, 'pics': shown})
    elif d.get('role') in ('user', 'assistant'):
        t, tools = text_of(d.get('content') or d.get('message'))
        if t.strip():
            out.append({'who': d['role'], 'text': t.strip()[:4000], 'at': at})
        for tool in tools:
            out.append({'who': 'tool', 'text': tool, 'at': at})
    return out


def pics_out(line, base=0):
    """A conversation line (bytes; BASE is where it begins in its file) with its pictures' data taken out, each leaving
    the mark @pic<i> in its place: (the line, [(where the data begins in the file, how long it is, the data)]). The line
    is then short enough to read, and a picture can be read from the file again when it is looked at."""
    spots = []

    def mark(m):
        spots.append((base + m.start(2), m.end(2) - m.start(2), m.group(2)))
        return m.group(1) + b'@pic%d"' % (len(spots) - 1)
    return (PIC_DATA.sub(mark, line) if b'"data"' in line or b'"image_url"' in line else line), spots


def pic_kind(head):
    """What picture these first bytes begin, and its size where they say it: (png|jpeg|gif|webp, width, height; 0 when
    not found), or None for what is no picture a page shows."""
    if head[:8] == b'\x89PNG\r\n\x1a\n' and len(head) >= 24:
        return ('png',) + struct.unpack('>II', head[16:24])
    if head[:6] in (b'GIF87a', b'GIF89a') and len(head) >= 10:
        return ('gif',) + struct.unpack('<HH', head[6:10])
    if head[:4] == b'RIFF' and head[8:12] == b'WEBP':
        if head[12:16] == b'VP8X' and len(head) >= 30:
            return 'webp', 1 + int.from_bytes(head[24:27], 'little'), 1 + int.from_bytes(head[27:30], 'little')
        if head[12:16] == b'VP8 ' and len(head) >= 30:
            w, h = struct.unpack('<HH', head[26:30])
            return 'webp', w & 0x3fff, h & 0x3fff
        if head[12:16] == b'VP8L' and len(head) >= 25:
            b = int.from_bytes(head[21:25], 'little')
            return 'webp', 1 + (b & 0x3fff), 1 + ((b >> 14) & 0x3fff)
        return 'webp', 0, 0
    if head[:2] == b'\xff\xd8':
        i = 2
        while i + 9 <= len(head) and head[i] == 0xff:  # (segment after segment, to the one that says the frame's size)
            m = head[i + 1]
            if m == 0xff:
                i += 1
            elif 0xc0 <= m <= 0xcf and m not in (0xc4, 0xc8, 0xcc):
                h, w = struct.unpack('>HH', head[i + 5:i + 9])
                return 'jpeg', w, h
            elif m == 0xda:
                break
            else:
                i += 2 + int.from_bytes(head[i + 2:i + 4], 'big')
        return 'jpeg', 0, 0
    return None


def pic_seen(spot, path, keep=None):
    """What the record keeps of one picture in a conversation file: where its data lies (p, o, l), a digest of it (h),
    what it is (t) and its size (w, ht). KEEP(name, bytes), given for a picture the person sent, keeps the picture
    itself with the record (k: it did). None for what is no picture."""
    o, l, raw = spot
    try:
        kind = pic_kind(base64.b64decode(raw[:1 << 17])) if l <= PIC_MOST else None  # (its beginning says what it is)
        if not kind:
            return None
        pic = {'p': path, 'o': o, 'l': l, 'h': hashlib.sha1(raw).hexdigest()[:16], 't': kind[0], 'w': kind[1], 'ht': kind[2]}
        if keep and keep(f'{pic["h"]}.{pic["t"]}', base64.b64decode(raw, validate=True)):
            pic['k'] = 1
        return pic
    except (ValueError, OSError):
        return None


def said_of(data, path, at=0, keep=None):
    """Whole lines of a conversation file (bytes; AT is where they begin in the file) as the items the record keeps of
    them: {who, text, at (seconds)}, with pics where pictures came with the words or with a step's result (pic_seen).
    KEEP(name, bytes) is given the pictures the person sent."""
    rows, pos = [], 0
    for l in data.split(b'\n'):
        base, pos = at + pos, pos + len(l) + 1
        if not l.strip() or NOT_TALK.match(l):
            continue
        l, spots = pics_out(l, base)
        if len(l) <= 300000:
            rows.append((l.decode('utf-8', 'replace'), spots))
    if '/.cursor/projects/' in path:
        rows = [(l, []) for l in cursor_lines([l for l, _ in rows])]
    items = []
    for l, spots in rows:
        try:
            got = line_items(json.loads(l))
        except ValueError:
            continue
        for it in got:
            if 'pics' in it:
                it['pics'] = [p for p in (pic_seen(spots[i], path, keep if it['who'] == 'user' else None) for i in it['pics'] if i < len(spots)) if p]
                if not it['pics']:
                    del it['pics']
            if it.get('text') or it.get('pics'):
                items.append(it)
    for it in items:
        it['at'] = stamp(it['at']) if isinstance(it.get('at'), str) else it.get('at')
    return items


def transcript_items(path, limit=120):
    """A conversation's end as items {who: user|assistant|tool, text, at}, oldest first, for reading on the page."""
    out = []
    for line in lines_of(path, 1500000):
        try:
            out += line_items(json.loads(line))
        except ValueError:
            continue
    return out[-limit:]


def items_of(lines):
    """A conversation's lines as (who, what), oldest first."""
    items = []
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            if line.strip():
                items.append(('', line.strip()[:400]))  # (a plain-text transcript)
            continue
        if not isinstance(d, dict):
            continue
        if d.get('type') == 'attachment':  # (Claude Code: words the person sent while it worked)
            a = d.get('attachment') or {}
            if a.get('type') == 'queued_command' and isinstance(a.get('prompt'), str) and a['prompt'].strip():
                items.append(('用户', a['prompt'].strip()))
            continue
        if d.get('type') in ('user', 'assistant') and isinstance(d.get('message'), dict):  # Claude Code
            m = d['message']
            t, tools = text_of(m.get('content'))
            if m.get('role') == 'user' and isinstance(m.get('content'), list) and all(isinstance(x, dict) and x.get('type') == 'tool_result' for x in m['content']):
                continue
            if t.strip():
                items.append(('用户' if m.get('role') == 'user' else '助手', t.strip()))
            for tool in tools:
                items.append(('工具', tool))
        elif d.get('type') == 'response_item' and isinstance(d.get('payload'), dict):  # Codex
            p = d['payload']
            if p.get('type') == 'message' and p.get('role') in ('user', 'assistant'):
                t, _ = text_of(p.get('content'))
                if t.strip() and not t.lstrip().startswith(('<environment_context', '<user_instructions', '# AGENTS.md')):
                    items.append(('用户' if p['role'] == 'user' else '助手', t.strip()))
            elif p.get('type') in ('function_call', 'custom_tool_call'):
                items.append(('工具', f'{p.get("name")}({str(p.get("arguments") or p.get("input") or "")[:120]})'))
        elif d.get('role') in ('user', 'assistant'):  # (Cursor and others)
            t, tools = text_of(d.get('content') or d.get('message'))
            if t.strip():
                items.append(('用户' if d['role'] == 'user' else '助手', t.strip()))
    return items


def recent(path, budget=7000):
    """The end of a conversation as lines (who: what), oldest first, within budget characters."""
    for size in (400000, 2000000, 8000000):  # (tools' output takes up most of a file and says little: further back when so)
        items = items_of(lines_of(path, size))
        if sum(len(t) for _, t in items) >= budget:
            break
    out, n = [], 0
    for who, t in reversed(items):
        t = t if len(t) < 1500 else t[:700] + ' … ' + t[-700:]
        line = f'{who}: {t}' if who else t
        if n + len(line) > budget:
            break
        out.append(line)
        n += len(line)
    return list(reversed(out))


def opening(path, budget=2500):
    """How a conversation began: the person's first asks, within budget characters."""
    if path.endswith('/store.db'):
        lines = lines_of(path)
    else:
        try:
            with open(path, 'rb') as f:
                lines = f.read(600000).decode('utf-8', 'replace').splitlines()[:-1]
        except OSError:
            return []
        if '/.cursor/projects/' in path:
            lines = cursor_lines(lines)
    out, n = [], 0
    for who, t in items_of(lines):
        if who != '用户' or t.lstrip().startswith('<'):
            continue
        line = f'用户: {t[:900]}'
        if n + len(line) > budget or len(out) == 6:
            break
        out.append(line)
        n += len(line)
    return out


# ---------- the conversations on disk: each a session that can be taken up again ----------

CLAUDE_OWN = ('cli', 'claude-desktop')  # (how a person's own Claude Code conversation was entered; 'sdk-cli' is a run with no window)
TITLE_LINES = (('custom-title', 'customTitle'), ('agent-name', 'agentName'), ('ai-title', 'aiTitle'))  # (the person's own name for it first)


def conv_title(path):
    """What a Claude Code conversation is called: the name the person gave it, else the one Claude Code made up; else ''."""
    best = {}
    try:
        with open(path, 'rb') as f:
            rows = [f.readline(400000) for _ in range(60)]
            f.seek(max(0, os.path.getsize(path) - 300000))
            rows += f.read().split(b'\n')
    except OSError:
        return ''
    for raw in rows:
        if b'-title"' not in raw and b'"agent-name"' not in raw:
            continue
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        for typ, key in TITLE_LINES:
            if isinstance(d, dict) and d.get('type') == typ and d.get(key):
                best[typ] = str(d[key])
    return next((best[t] for t, _ in TITLE_LINES if t in best), '')


def first_ask(path):
    """The person's first words in a conversation, as one short line: what it is called when nothing names it."""
    for l in opening(path, 400):
        return ' '.join(l.removeprefix('用户: ').split())[:60]
    return ''


def claude_convs(known):
    """Claude Code's conversations on disk that no session has yet and a person could take up again: entered at a
    terminal or in the desktop app (not a run with no window, not a sub-agent's), with something asked in them, their
    folder still there."""
    out = []
    for f in glob.glob(os.path.expanduser('~/.claude/projects/*/*.jsonl')):
        conv = os.path.basename(f)[:-6]
        if ('claude', conv) in known:
            continue
        entry = folder = began = None
        try:
            with open(f, 'rb') as h:
                for _ in range(60):
                    raw = h.readline(400000)
                    if not raw or (entry and folder and began):
                        break
                    try:
                        d = json.loads(raw)
                    except ValueError:
                        continue
                    if not isinstance(d, dict):
                        continue
                    if d.get('isSidechain'):
                        entry = 'side'
                        break
                    entry, folder, began = entry or d.get('entrypoint'), folder or d.get('cwd'), began or d.get('timestamp')
            at = os.path.getmtime(f)
        except OSError:
            continue
        if entry not in CLAUDE_OWN or not folder or folder.startswith(CACHE) or not os.path.isdir(folder):
            continue
        ask = first_ask(f)
        if ask:
            out.append({'kind': 'claude', 'conv': conv, 'path': f, 'folder': folder, 'began': stamp(began) or at, 'at': at, 'title': conv_title(f) or ask})
    return out


def codex_convs(known):
    """Codex's threads on disk likewise: a window's or the desktop app's, not a run with no window or a sub-agent's."""
    names = {}
    try:
        with open(os.path.expanduser('~/.codex/session_index.jsonl')) as f:
            for l in f:
                with contextlib.suppress(ValueError, KeyError, TypeError):
                    d = json.loads(l)
                    names[d['id']] = d.get('thread_name') or ''
    except OSError:
        pass
    out = []
    for f in glob.glob(os.path.expanduser('~/.codex/sessions/*/*/*/rollout-*.jsonl')):
        m = codex_meta(f)
        conv, folder = m.get('id'), m.get('cwd')
        if (not conv or ('codex', conv) in known or m.get('originator') == 'codex_exec' or not isinstance(m.get('source'), str) or m['source'] == 'exec'
                or not folder or not os.path.isdir(folder)):
            continue
        title = names.get(conv) or first_ask(f)
        if title:
            at = os.path.getmtime(f)
            out.append({'kind': 'codex', 'conv': conv, 'path': f, 'folder': folder, 'began': stamp(m.get('timestamp')) or at, 'at': at, 'title': title})
    return out


REST_EVERY = float(os.environ.get('STURNUS_REST_EVERY') or 600)  # (seconds between looks for sessions that have rested long enough)
PLAN_REST = float(os.environ.get('STURNUS_PLAN_REST') or 1800)  # (seconds a session the clock started rests before its terminal is stopped)


def open_book():
    """The record of the sessions that last. One that cannot be read as a database is set aside under another name (it is
    not deleted) and a new one begun: the deck, and the phone's view with it, still come up. A record another process
    holds for a moment is waited for."""
    for i in range(4):
        try:
            return K.Book()
        except sqlite3.OperationalError as e:
            if i == 3 or 'locked' not in str(e):
                raise
            time.sleep(2)
        except sqlite3.DatabaseError as e:
            aside = f'{K.PATH}.broken-{time.strftime("%Y%m%d-%H%M%S")}'
            os.replace(K.PATH, aside)
            for x in ('-wal', '-shm'):
                with contextlib.suppress(OSError):
                    os.replace(K.PATH + x, aside + x)
            print(f'sturnus: the record of sessions could not be read ({e}): set aside as {aside}, a new one begun', file=sys.stderr, flush=True)


# ---------- the model a session runs on, as its own conversation file says ----------

def conv_meta(path, kind):
    """The model a conversation was last run on, and how: {model, effort, speed} from the end of its file (Claude Code
    writes them on every answer; Codex in each turn's context and whenever a thread's settings are applied). {} when
    the file does not say."""
    try:
        size = os.path.getsize(path)
    except (OSError, TypeError):
        return {}
    for back in (300_000, 6_000_000):  # (the end of the file; further back when that is one long line or says nothing)
        try:
            with open(path, 'rb') as f:
                f.seek(max(0, size - back))
                lines = f.read().split(b'\n')
        except OSError:
            return {}
        out = {}
        for l in reversed(lines[1:] if size > back else lines):
            if kind == 'claude':
                if b'"assistant"' not in l[:4000] and b'"type":"assistant"' not in l:
                    continue
                try:
                    d = json.loads(l)
                except ValueError:
                    continue
                m = d.get('message') if isinstance(d.get('message'), dict) else {}
                model = m.get('model')
                if d.get('type') != 'assistant' or d.get('isSidechain') or not isinstance(model, str) or model.startswith('<'):
                    continue
                u = m.get('usage') if isinstance(m.get('usage'), dict) else {}
                return {k: v for k, v in (('model', model), ('effort', d.get('effort')), ('speed', u.get('speed'))) if isinstance(v, str) and v}
            if kind == 'codex':
                if b'turn_context' not in l[:300] and b'thread_settings_applied' not in l[:300]:
                    continue
                try:
                    d = json.loads(l)
                except ValueError:
                    continue
                p = d.get('payload') if isinstance(d.get('payload'), dict) else {}
                st = p.get('thread_settings') if isinstance(p.get('thread_settings'), dict) else p if d.get('type') == 'turn_context' else {}
                for k, names in (('model', ('model',)), ('effort', ('reasoning_effort', 'effort')), ('speed', ('service_tier',))):
                    v = next((st.get(n) for n in names if isinstance(st.get(n), str) and st.get(n)), None)
                    if v and k not in out:
                        out[k] = v
                if 'model' in out and 'effort' in out:
                    return out
        if out or size <= back:
            return out
    return {}


# ---------- a session's own worktree, and what it has changed ----------

def repo_of(folder):
    """The git repository a folder is in: (its main checkout's folder, this checkout's top, its common git folder), or None."""
    rows = (git(folder, 'rev-parse', '--path-format=absolute', '--git-common-dir', '--show-toplevel') or '').splitlines() if folder and os.path.isdir(folder) else []
    if len(rows) != 2:
        return None
    common, top = os.path.realpath(rows[0]), os.path.realpath(rows[1])
    return (os.path.dirname(common) if common.endswith('/.git') else top), top, common


def main_branch(root):
    """The branch work is merged into: main, else master, else the one the main checkout is on."""
    for b in ('main', 'master'):
        if git(root, 'rev-parse', '--verify', '-q', f'refs/heads/{b}'):
            return b
    return git(root, 'symbolic-ref', '--short', '-q', 'HEAD') or 'HEAD'


def worktree_add(folder, want):
    """A worktree and a branch of its own for a session, off the main branch, at <repository>/.claude/worktrees/<name>
    (kept out of the repository's own view: its local excludes say so when its ignore rules do not). Returns (True,
    its folder, its branch) or (False, why, '')."""
    r = repo_of(folder)
    if not r:
        return False, tx('这个目录不在 git 仓库里，开不了 worktree', 'This folder is in no git repository, so no worktree can be made'), ''
    root, _, common = r
    name = (T.slug(want, '') or f'session-{os.urandom(2).hex()}').lower()[:40].strip('-._') or f'session-{os.urandom(2).hex()}'
    branch, n = name, 1
    while git(root, 'rev-parse', '--verify', '-q', f'refs/heads/{branch}') or os.path.exists(os.path.join(root, '.claude', 'worktrees', branch)):
        n += 1
        branch = f'{name}-{n}'
    path = os.path.join(root, '.claude', 'worktrees', branch)
    if run(['git', '-C', root, 'check-ignore', '-q', path]).returncode != 0:
        with contextlib.suppress(OSError):
            os.makedirs(os.path.join(common, 'info'), exist_ok=True)
            with open(os.path.join(common, 'info', 'exclude'), 'a') as f:
                f.write('\n.claude/worktrees/\n')
    made = run(['git', '-C', root, 'worktree', 'add', path, '-b', branch, main_branch(root)], timeout=60)
    if made.returncode != 0:
        return False, tx(f'worktree 没开成：{(made.stderr or made.stdout).strip()[:200]}', f'The worktree could not be made: {(made.stderr or made.stdout).strip()[:200]}'), ''
    return True, path, branch


def git_status(top, ignored=False):
    """A checkout's status as [(two letters, path)]: '??' a file git does not know, '!!' one it ignores (with IGNORED)."""
    out = run(['git', '-C', top, 'status', '--porcelain', '-z', *(['--ignored'] if ignored else [])], timeout=30)
    rows, skip = [], False
    for e in out.stdout.split('\0') if out.returncode == 0 else []:
        if skip or len(e) < 4:
            skip = False  # (a renamed file's old name follows it)
            continue
        rows.append((e[:2], e[3:]))
        skip = e[0] in 'RC'
    return rows


def worktree_gone(path, branch, force=False):
    """A session's worktree and its branch taken away again: only a clean worktree, and a branch already merged (or one
    just made, with FORCE)."""
    r = repo_of(path)
    if not r:
        return
    run(['git', '-C', r[0], 'worktree', 'remove', *(['--force'] if force else []), path], timeout=60)
    run(['git', '-C', r[0], 'branch', '-D' if force else '-d', branch], timeout=30)


def worktree_done(folder, made='', drop=False):
    """A session's worktree merged into the main branch and taken away: the one sturnus made for it (FOLDER, on the
    branch MADE for it), only by a fast-forward, only from a clean worktree, only while the main checkout is on the main
    branch. Files in it that git ignores (.env, node_modules) would go with the folder: with any there, nothing is done
    until the person has said so (DROP). Returns (ok, words), or (False, {'ask': 'ignored', 'files': […], 'more': n})."""
    r = repo_of(folder)
    if not r or r[0] == r[1] or r[1] != os.path.realpath(folder) or f'{os.sep}.claude{os.sep}worktrees{os.sep}' not in r[1] + os.sep:
        return False, tx('这条会话不在自己的 worktree 里', 'This session is not in a worktree of its own')
    root, top, _ = r
    main, branch = main_branch(root), git(top, 'symbolic-ref', '--short', '-q', 'HEAD') or ''
    if not branch or branch == main or (made and branch != made):
        return False, tx(f'它的 worktree 不在给它开的分支{f"（{made}）" if made else ""}上，没有合并', f'Its worktree is not on the branch made for it{f" ({made})" if made else ""}: nothing merged')
    st = git_status(top, ignored=True)
    if any(x != '!!' for x, _ in st):
        return False, tx('它的 worktree 里还有没提交的改动：先让它提交（或者丢掉），再合并', 'Its worktree has changes not committed: have them committed (or dropped) first, then merge')
    left = [f for x, f in st if x == '!!']
    if left and not drop:
        return False, {'ask': 'ignored', 'files': left[:12], 'more': max(0, len(left) - 12)}
    if (git(root, 'symbolic-ref', '--short', '-q', 'HEAD') or '') != main:
        return False, tx(f'主工作区不在 {main} 上，没有合并', f'The main checkout is not on {main}: nothing merged')
    ahead = len((git(root, 'rev-list', f'{main}..{branch}') or '').split())
    if ahead:
        m = run(['git', '-C', root, 'merge', '--ff-only', branch], timeout=60)
        if m.returncode != 0:
            return False, tx(f'不能快进合并：先让它 rebase 到最新的 {main}。（{(m.stderr or m.stdout).strip()[:160]}）', f'It cannot be fast-forwarded: have it rebased onto the latest {main} first. ({(m.stderr or m.stdout).strip()[:160]})')
    rm = run(['git', '-C', root, 'worktree', 'remove', top], timeout=60)
    if rm.returncode != 0:
        return False, tx(f'已合并，但 worktree 没清掉：{(rm.stderr or rm.stdout).strip()[:160]}', f'Merged, but the worktree was not removed: {(rm.stderr or rm.stdout).strip()[:160]}')
    run(['git', '-C', root, 'branch', '-d', branch], timeout=30)
    return True, tx(f'{branch} 的 {ahead} 个提交已合进 {main}，worktree 和分支都清掉了' if ahead else f'{branch} 没有新提交，worktree 和分支清掉了', f'{ahead} commit(s) of {branch} merged into {main}; its worktree and branch are gone' if ahead else f'{branch} had nothing new; its worktree and branch are gone')


def changes(folder, one=''):
    """What a session has changed in its folder, against where its branch left the main branch (on the main branch
    itself: against its last commit): {top, branch, main, ahead, files: [{path, add, del, state}]}; with ONE, that file's
    diff as text. None outside a git repository."""
    r = repo_of(folder)
    if not r:
        return None
    root, top, _ = r
    main, branch = main_branch(root), git(top, 'symbolic-ref', '--short', '-q', 'HEAD') or ''
    base = (git(top, 'merge-base', 'HEAD', main) if branch != main else None) or git(top, 'rev-parse', 'HEAD') or ''
    if one:
        f = os.path.realpath(os.path.join(top, one))
        if not f.startswith(top + os.sep):
            return None
        d = run(['git', '-C', top, 'diff', base, '--', one], timeout=20).stdout if base else ''
        if not d and os.path.isfile(f):  # (a file git does not know yet: all of it is new)
            d = run(['git', '-C', top, 'diff', '--no-index', '--', os.devnull, one], timeout=20).stdout
        return {'path': one, 'diff': d[:300000], 'cut': len(d) > 300000}
    files = {}
    for l in (git(top, 'diff', '--numstat', base) or '').splitlines() if base else []:
        a, d, p = (l.split('\t') + ['', '', ''])[:3]
        files[p] = {'path': p, 'add': int(a) if a.isdigit() else 0, 'del': int(d) if d.isdigit() else 0, 'state': 'changed'}
    for st, p in git_status(top):
        if st == '??':
            files.setdefault(p, {'path': p, 'add': 0, 'del': 0, 'state': 'new'})
        elif p in files:
            files[p]['loose'] = True  # (changed again since its last commit)
    return {'top': top, 'show': tilde(top), 'branch': branch, 'main': main, 'own': root != top, 'ahead': len((git(top, 'rev-list', f'{base}..HEAD') or '').split()) if base else 0,
            'files': sorted(files.values(), key=lambda f: f['path'])[:400], 'more': max(0, len(files) - 400)}


def agent_argv(cfg, kind, conv='', name='', prompt=''):
    """What a terminal runs for an agent: its command as set (config "launch"), on with a conversation when one is named."""
    argv = list(cfg.get('launch', DEFAULTS['launch']).get(kind) or DEFAULTS['launch'][kind])
    if conv:
        argv += {'claude': ['--resume', conv], 'codex': ['resume', conv], 'cursor': ['--resume', conv]}[kind]
    if kind == 'claude' and name:
        argv += ['--name', name]
    return argv + ([prompt] if prompt else [])


def launch_session(book, cfg, kid, prompt='', group='', prefer='', taken=(), kind=''):
    """A terminal for a session that lasts, its agent in it: on with its latest conversation when it has one, from the
    start when it has none, or when another agent (KIND) takes it on: that one starts anew, with what it is told. The
    caller has seen that nothing runs for it now. Returns (True, {msg, marker, loc, group, kind, cwd, tab}) or (False, why)."""
    k = book.get(kid)
    if not k:
        return False, tx('找不到这条会话', 'Session not found')
    was = k['kind'] if k['kind'] in K.AGENTS else 'claude'
    kind = kind if kind in K.AGENTS else was
    seg = k['segs'][-1] if k['segs'] and k['segs'][-1]['kind'] == kind == was else None
    path = seg and (seg['path'] if seg['path'] and os.path.exists(seg['path']) else transcript_of({'kind': kind, 'session': seg['conv']}))
    if seg and not path:  # (its latest conversation has no file: cleared and nothing said since, or cleaned away: a new one)
        seg = None
    cwd = (path and began_in(path)) or k['folder']
    if not cwd or not os.path.isdir(cwd):
        return False, tx(f'它原来的目录不在了，没法在原地继续：{tilde(cwd or "?")}', f'The folder it ran in is gone, so it cannot go on there: {tilde(cwd or "?")}')
    name = k['name'] if NAME.fullmatch(k['name'] or '') and k['name'] not in taken else ''
    marker = os.urandom(6).hex()
    env = [f'STURNUS_NEW={marker}', f'STURNUS_SESSION={kid}'] + ([f'AMAIL_NAME={name}'] if name else [])
    sp = next((x for x in book.spaces() if x['id'] == k['space']), None)
    way = T.way(cfg, group)
    last = k['terms'][-1] if k['terms'] else None
    fits = lambda g: bool(g) and g.startswith('tmux:') == (way.mux == 'tmux')
    g = way.group(sp, k, next((x for x in (group, prefer, last and last['grp']) if fits(x)), None))
    tab = K.line(k['title'], 24) or name or f'{kind}·{os.path.basename(cwd) or "~"}'
    book.start(marker, kid)  # (the first process seen with this mark is the session's; what that one starts is not)
    ok, made, loc = way.start(g, tab, cwd, env, agent_argv(cfg, kind, seg['conv'] if seg else '', name, prompt), marker)
    if not ok:
        return False, made
    words = tx(f'{made}在 {g} 里{"接着" if seg else ""}开了「{tab}」', f'{made}Opened “{tab}” in {g}' + (', going on with its conversation' if seg else ''))
    return True, {'msg': words, 'marker': marker, 'loc': loc, 'group': f'tmux:{g}' if way.mux == 'tmux' else g, 'kind': kind, 'cwd': cwd, 'tab': tab, 'kept': kid}


