DIGEST_ST = {'working': '工作中', 'waiting': '等用户', 'blocked': '卡住了', 'review': '做完了，等用户验收', 'idle': '空闲'}


class Digests:
    """Each workspace's overview: its sessions grouped by the thing they work on, where each thing stands, and a line
    for the whole. Made by the summary model from the sessions' own summaries while the workspace's dashboard is open,
    and again when those change: at most every two minutes after the last, ten after one that failed."""

    def __init__(self):
        self.file = os.path.join(CACHE, 'digests.json')
        self.data = A.get(self.file, {}) or {}
        self.wanted, self.next, self.busy, self.errors = {}, {}, None, {}

    @staticmethod
    def sessions(wkey, sessions):
        ss = [s for s in sessions if s.get('workspace') == wkey and not s.get('stale') and s['state'] not in ('gone', 'ended')
              and not s.get('starting') and not (s.get('unknown') and not s.get('summary'))]
        return sorted(ss, key=lambda s: -(s.get('at') or 0))[:40]

    @staticmethod
    def basis(ss):  # (what it is made from: a session's state comes and goes, the page shows that itself)
        return hashlib.sha1(json.dumps([[s['id'], s.get('title'), s.get('summary'), s.get('needs_you'), s.get('project'), s.get('branch')]
                                        for s in sorted(ss, key=lambda s: s['id'])], ensure_ascii=False).encode()).hexdigest()[:12]

    def due(self, wkey, ss):
        if len(ss) < 2 or time.time() - self.wanted.get(wkey, 0) > 600:  # (one session needs no grouping; the dashboard not open for ten minutes)
            return False
        cur = self.data.get(wkey)
        return not (cur and cur.get('basis') == self.basis(ss)) and time.time() >= self.next.get(wkey, 0)

    def make(self, w, ss, cfg, pname):
        wkey, ok = w['key'], False
        self.busy = wkey
        def row(s):
            st = standing(s)[0]
            where = ' · '.join(x for x in (pname(s), s.get('branch')) if x) or '—'
            now = DIGEST_ST.get(st, st) + ('，也在等用户' if st == 'working' and (s.get('needs_you') or s.get('asks')) else '')
            what = f'{s.get("title") or "（还没有总结）"} — {s.get("summary") or ""}' + (f'；在等用户：{s["needs_you"]}' if s.get('needs_you') else '')
            return f'- {s["name"]}｜{where}｜{now}｜{ago_text(s.get("at") or s.get("since") or time.time())}｜{one_line(what, 300)}' + (f'｜由 {s["parent"]} 开的' if s.get('parent_id') else '')
        try:
            out = ask_model(DIGEST.format(ws=w['name'], rows='\n'.join(row(s) for s in ss)), cfg, 'summary')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
            by, seen, items = {s['name']: s['id'] for s in ss}, set(), []
            for x in r.get('items') or []:
                if not isinstance(x, dict):
                    continue
                ids = [by[n] for n in dict.fromkeys(str(n) for n in (x.get('sessions') or []) if isinstance(n, str)) if n in by and by[n] not in seen]
                if ids and one_line(x.get('thing'), 24):
                    seen.update(ids)
                    items.append({'thing': one_line(x.get('thing'), 24), 'now': one_line(x.get('now'), 120), 'sessions': ids})
            week = time.time() - 7 * DAY  # (a new dict, not changed in place: the state is read from it meanwhile)
            self.data = {**{k: v for k, v in self.data.items() if v.get('at', 0) > week}, wkey: {'at': time.time(), 'basis': self.basis(ss), 'headline': one_line(r.get('headline'), 140), 'items': items}}
            self.errors.pop(wkey, None)
            ok = True
            os.makedirs(CACHE, exist_ok=True)
            A.put(self.file, self.data)
        except Exception as e:
            self.errors[wkey] = f'{type(e).__name__}: {e}'[:300]
        finally:
            self.busy = None
            self.next[wkey] = time.time() + (120 if ok else 600)

    def view(self):
        return {k: {x: v.get(x) for x in ('at', 'headline', 'items')} for k, v in self.data.items()}


