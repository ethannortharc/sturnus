WORK_LANG = {  # (the agents' working language: what the models write for the person — summaries, reports, answers, drafts)
    'zh': '',
    'en': ('\n\n（工作语言：English。上面要求里说「中文」「汉字」的地方一律改成英文：给人看的文字都用英文写，长度按英文算，14 个汉字约 6 个英文单词，'
           '40 个汉字约 18 个单词；JSON 的键名，以及 status、by、verdict 这类约定的取值照旧。）'),
}


def ask_model(prompt, cfg, role='summary', m=None, key=None):
    prompt += WORK_LANG.get(cfg.get('work_lang') or 'zh', '')
    m = m or model_for(cfg, role)
    env = {**os.environ, 'AMAIL_SKIP': '1'}
    os.makedirs(CACHE, exist_ok=True)
    if m['source'] == 'api':
        key = key if key is not None else (secret(role) or os.environ.get(m.get('key_env') or '', ''))
        req = urllib.request.Request(str(m.get('url') or '').rstrip('/') + '/chat/completions', method='POST',
                                     data=json.dumps({'model': m.get('model'), 'messages': [{'role': 'user', 'content': prompt}], 'temperature': 0.2}).encode(),
                                     headers={'Content-Type': 'application/json', **({'Authorization': f'Bearer {key}'} if key else {})})
        with urllib.request.urlopen(req, timeout=90) as r:
            return json.loads(r.read())['choices'][0]['message']['content']
    if m['source'] == 'codex':
        out = os.path.join(CACHE, f'codex-{os.getpid()}-{threading.get_ident()}.txt')
        argv = ['codex', 'exec', '--ephemeral', '--skip-git-repo-check', '-s', 'read-only', '--color', 'never', '-o', out]
        if m.get('model'):
            argv += ['-m', m['model']]
        r = subprocess.run(argv + [prompt], capture_output=True, text=True, timeout=180, cwd=CACHE, env=env, stdin=subprocess.DEVNULL)
        try:
            text = open(out).read()
        except OSError:
            text = ''
        finally:
            try:
                os.remove(out)
            except OSError:
                pass
        if not text.strip():
            raise RuntimeError((r.stderr or r.stdout).strip()[-200:] or f'exit {r.returncode}')
        return text
    if m['source'] == 'pi':
        argv = ['pi', '-p', '--no-session'] + (['--model', m['model']] if m.get('model') else [])
        r = subprocess.run(argv + [prompt], capture_output=True, text=True, timeout=180, cwd=CACHE, env=env, stdin=subprocess.DEVNULL)
        if r.returncode != 0 or not r.stdout.strip():
            raise RuntimeError(' '.join((r.stderr or r.stdout).split())[:240] or f'exit {r.returncode}')
        return r.stdout
    argv = ['claude', '-p', '--model', m.get('model') or 'haiku', '--no-session-persistence', '--strict-mcp-config',
            '--setting-sources', 'project', '--disable-slash-commands', '--tools=']
    r = subprocess.run(argv, input=prompt, capture_output=True, text=True, timeout=120, cwd=CACHE, env=env)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:200] or f'exit {r.returncode}')
    return r.stdout


