@functools.lru_cache(None)
def tailscale():
    """The tailscale command, as the start of an argv; None without one. On macOS the app's own (a Homebrew one can be
    older than the app's daemon), through sh with stdin from /dev/null: run straight from a launchd job, it starts as the
    app and fails, not as the command line."""
    app = '/Applications/Tailscale.app/Contents/MacOS/Tailscale'
    if MAC and os.path.exists(app):
        return ['/bin/sh', '-c', 'exec "$0" "$@" < /dev/null', app]
    found = shutil.which('tailscale')
    return [found] if found else None


def tailnet_self():
    """This machine's tailnet name and its owner's login (looked up again every few minutes), or (None, None)."""
    if time.time() - _tailnet['at'] > 300:
        r = run([*tailscale(), 'status', '--json'], timeout=5) if tailscale() else None
        try:
            d = json.loads(r.stdout)
            me = d['Self']
            _tailnet.update(name=me['DNSName'].rstrip('.').lower(), owner=d['User'][str(me['UserID'])]['LoginName'],
                            ips=[x for x in me.get('TailscaleIPs') or [] if '.' in x])
        except (AttributeError, ValueError, KeyError, TypeError):
            _tailnet.update(name=None, owner=None, ips=[])
        _tailnet['at'] = time.time()
    return _tailnet.get('name'), _tailnet.get('owner')


