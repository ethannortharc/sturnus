def one_line(x, n):
    return re.sub(r'\s+', ' ', str(x or '')).strip()[:n]


def standing(s):
    """How a session stands, in a word and in words: as the page shows it."""
    st = s.get('status')
    if s['state'] in ('gone', 'ended'):
        return s['state'], 'exited'
    if s.get('stale'):
        return 'quiet', 'quiet for a day'
    if s['state'] == 'waiting' or st == 'waiting_user' or (s.get('needs_you') and st not in ('blocked', 'review')):
        return 'waiting', 'waits on the person'
    if st == 'blocked':
        return 'blocked', 'blocked'
    if st == 'review':
        return 'review', 'ready for review'
    return ('working', 'working') if s['state'] == 'working' else ('idle', 'idle')


class Reports:
    """Each session's report: what it is for, what it got done, what was decided and by whom, where it stands, what is
    next. Made by the summary model when the conversation has moved on (at most every half hour), at once when asked."""

    def __init__(self):
        self.file = os.path.join(CACHE, 'reports.json')
        self.data = A.get(self.file, {}) or {}
        self.asked, self.busy, self.error = set(), None, ''

    @staticmethod
    def moved(path):
        return max((os.path.getmtime(p) for p in (path, path + '-wal') if os.path.exists(p)), default=0)

    def due(self, s):
        if s['id'] in self.asked:
            return True
        path = transcript_of(s)
        cur = self.data.get(s['id'])
        if not path or s.get('starting') or (cur and (s.get('stale') or s['state'] in ('gone', 'ended'))):
            return False
        return not cur or (self.moved(path) > cur['basis'] + 1 and time.time() - cur['at'] > 1800)

    def make(self, s, cfg, decisions):
        self.asked.discard(s['id'])
        path = transcript_of(s)
        if not path:
            return
        known = [f'- {d["what"]}（{"开发者" if d["by"] == "user" else "agent"}）' for d in decisions if d['sid'] == s['id']][-12:]
        prompt = REPORT.format(kind=s['kind'], name=s['name'], cwd=s.get('cwd') or '?', known='\n'.join(known) or '（无）',
                               opening='\n'.join(opening(path)) or '（读不到）', log='\n'.join(recent(path, 16000)))
        self.busy = s['id']
        try:
            basis = self.moved(path)
            out = ask_model(prompt, cfg, 'summary')
            m = re.search(r'\{.*\}', out, re.S)
            r = json.loads(m.group(0))
            lst = lambda k, n, w: [one_line(x, w) for x in (r.get(k) or []) if one_line(x, w)][:n]
            self.data[s['id']] = {'at': time.time(), 'basis': basis, 'name': s['name'], 'kind': s['kind'],
                                  'group': (s.get('loc') or {}).get('session'),
                                  'r': {'goal': one_line(r.get('goal'), 160), 'done': lst('done', 8, 200), 'now': one_line(r.get('now'), 200),
                                        'next': lst('next', 4, 200), 'refs': lst('refs', 8, 300),
                                        'decisions': [{'what': one_line(d.get('what'), 160), 'by': 'user' if d.get('by') == 'user' else 'agent'}
                                                      for d in (r.get('decisions') or []) if isinstance(d, dict) and one_line(d.get('what'), 160)][:8]}}
            self.error = ''
            A.put(self.file, self.data)
        except Exception as e:
            self.error = f'{type(e).__name__}: {e}'[:300]
            self.data.setdefault(s['id'], {'r': None, 'basis': 0, 'name': s['name'], 'kind': s['kind']})['at'] = time.time()
        finally:
            self.busy = None


