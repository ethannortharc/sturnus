def origin_of(pid):
    """How a session outside Zellij and tmux was started, in words: what stands above its process."""
    chain = A.ancestors(pid)[1:] if pid else []
    for p, comm in chain:
        exe = A.proc_exe(p).lower()
        if comm in ('sshd', 'sshd-session'):
            return 'ssh 登录的终端'
        if comm in TERMS or comm.startswith('gnome-terminal'):
            return f'终端窗口（{TERMS.get(comm, comm)}）'
        if comm.lower() == 'screen':
            return 'screen 会话'
        if comm == 'code' or exe.endswith('/code') or '/visual studio code.app/' in exe:
            return 'VS Code 的终端'
        if comm == 'cursor' or (exe.endswith('/cursor') and 'cursor-agent' not in exe) or '/cursor.app/' in exe:
            return 'Cursor 编辑器的终端'
        if comm == 'ChatGPT' or '/chatgpt/' in exe or '/chatgpt.app/' in exe:
            return 'Codex 桌面应用'
        if comm == 'cron':
            return 'cron 定时任务'
        if comm == 'systemd':
            return '后台服务（systemd）'
    first = next((c for _, c in chain if c not in ('bash', 'zsh', 'sh', 'fish', 'dash', 'env', 'sudo', 'timeout', 'nohup', 'setsid', 'login')), None)
    if not first and A.MAC and chain and (A.proc(chain[-1][0]) or (None, 0))[1] == 1:
        return '后台服务（launchd）'  # (macOS: only shells between it and launchd, as a LaunchAgent starts one)
    return f'由 {first} 启动' if first else '来源不明'


def go_to(loc, via=None):
    """Bring a terminal to an agent's pane."""
    if not loc:
        return False, '这个会话不在 Zellij 或 tmux 里'
    return TMUX.focus(loc, via) if loc.get('mux') == 'tmux' else jump(loc, via)


def jump(loc, via=None):  # (Zellij)
    target, pane = loc['session'], str(loc['pane'])
    clients = zellij_clients(procs())
    if any(c['session'] == target for c in clients):
        ok = focus_in(target, pane)
        return ok, (f'已在 {target} 里切到这个窗格' if ok else f'没在 {target} 里找到窗格 {pane}')
    if not clients:
        return False, f'没有终端连着 Zellij。在终端里运行：zellij attach {target}'
    src = next((c for c in clients if c['pid'] == via), clients[0])
    r = plugin(src['session'], f'switch {target} {pane}')
    if r.returncode == 0 and 'ok' in r.stdout:
        return True, f'已把连着 {src["session"]} 的终端（{src["via"]}）切到 {target}'
    return False, f'切换失败：{(r.stderr or r.stdout).strip()[:200]}'


# ---------- transcripts ----------

_transcripts = {}


def transcript_of(s):
    if s.get('transcript') and os.path.exists(s['transcript']):
        return s['transcript']
    key = (s['kind'], s.get('session'))
    if key in _transcripts and os.path.exists(_transcripts[key]):
        return _transcripts[key]
    found = None
    if s['kind'] == 'claude' and s.get('session'):
        found = next(iter(glob.glob(os.path.expanduser(f'~/.claude/projects/*/{s["session"]}.jsonl'))), None)
    elif s['kind'] == 'codex' and s.get('session'):
        found = next(iter(sorted(glob.glob(os.path.expanduser(f'~/.codex/sessions/*/*/*/rollout-*-{s["session"]}.jsonl')))), None)
    if found:
        _transcripts[key] = found
    return found


def codex_meta(path, _seen={}):
    if path not in _seen:
        try:
            with open(path) as f:
                _seen[path] = json.loads(f.readline()).get('payload') or {}
        except (OSError, ValueError):
            _seen[path] = {}
    return _seen[path]


def codex_launch_thread(start, cwd):
    """The thread a Codex window began with, for a window its hooks never saw (opened before they were installed):
    Codex starts one as the window opens, in its folder. ponytail: a later /new in that window is not followed."""
    best = None
    for f in glob.glob(os.path.expanduser(f'~/.codex/sessions/{time.strftime("%Y/%m/%d", time.localtime(start))}/rollout-*.jsonl')):
        m = re.search(r'rollout-(\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d)-(.+)\.jsonl$', f)
        gap = m and time.mktime(time.strptime(m.group(1), '%Y-%m-%dT%H-%M-%S')) - start
        if m and -5 <= gap <= 120 and (not best or abs(gap) < best[0]):
            meta = codex_meta(f)
            if meta.get('cwd') == cwd and isinstance(meta.get('source'), str):  # (a sub-agent's source is not a word)
                best = (abs(gap), f, m.group(2))
    return best and best[1:]


def cursor_chat(pid):
    """The chat a Cursor window shows: the store it holds open."""
    for p in A.proc_files(pid):
        if p.endswith('/store.db') and '/.cursor/chats/' in p:
            return p
    return None


def cursor_messages(path):
    """A Cursor chat's messages {role, content}, in order (its latest root lists them by id); a person's words
    without the wrappers Cursor puts around them, and what Cursor itself tells the agent left out."""
    out = []
    try:
        db = sqlite3.connect(f'file:{path}?mode=ro', uri=True)
        try:
            meta = json.loads(bytes.fromhex(db.execute("select value from meta where key='0'").fetchone()[0]))
            root = db.execute('select data from blobs where id=?', (meta['latestRootBlobId'],)).fetchone()[0]
            for m in re.finditer(rb'\x0a\x20', root):  # ponytail: ids read as 32-byte fields, not a protobuf parse
                r = db.execute('select data from blobs where id=?', (root[m.end():m.end() + 32].hex(),)).fetchone()
                if r and r[0][:1] == b'{':
                    out.append(json.loads(r[0]))
        finally:
            db.close()
    except (sqlite3.Error, TypeError, ValueError, KeyError):
        return []
    for d in out:
        if d.get('role') == 'user':
            t, _ = text_of(d.get('content'))
            q = re.search(r'<user_query>\s*(.*?)\s*</user_query>', t, re.S)
            d['content'] = q.group(1) if q else ''
    return out


_said = {}


def last_said(path, at):
    """What a conversation's agent said last (read again only when the conversation moved)."""
    if not path:
        return None
    if _said.get(path, (None,))[0] != at:
        said = next((i['text'] for i in reversed(transcript_items(path, 60)) if i['who'] == 'assistant'), None)
        _said[path] = (at, said and said[:1500])
    return _said[path][1]


def lines_of(path, size=400000):
    if path.endswith('/store.db'):
        return [json.dumps(d) for d in cursor_messages(path)]
    return tail_lines(path, size)


def tail_lines(path, size=400000):
    try:
        with open(path, 'rb') as f:
            f.seek(max(0, os.path.getsize(path) - size))
            data = f.read().decode('utf-8', 'replace')
    except OSError:
        return []
    lines = data.splitlines()
    return lines[1:] if len(lines) > 1 else lines


def text_of(content):
    if isinstance(content, str):
        return content, []
    texts, tools = [], []
    for x in content or []:
        if not isinstance(x, dict):
            continue
        if x.get('type') in ('text', 'input_text', 'output_text') and x.get('text'):
            texts.append(x['text'])
        elif x.get('type') in ('tool_use', 'tool-call'):  # (Claude Code, Cursor)
            i = x.get('input') or x.get('args') or {}
            i = i if isinstance(i, dict) else {}
            tools.append(f'{x.get("name") or x.get("toolName")}({str(i.get("command") or i.get("file_path") or i.get("path") or i.get("description") or "")[:120]})')
    return '\n'.join(texts), tools


def transcript_items(path, limit=120):
    """A conversation's end as items {who: user|assistant|tool, text, at}, oldest first, for reading on the page."""
    out = []
    for line in lines_of(path, 1500000):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        at = d.get('timestamp')
        if d.get('type') in ('user', 'assistant') and isinstance(d.get('message'), dict):
            m = d['message']
            c = m.get('content')
            if m.get('role') == 'user' and isinstance(c, list) and all(isinstance(x, dict) and x.get('type') == 'tool_result' for x in c):
                continue
            t, tools = text_of(c)
            if m.get('role') == 'user' and re.match(r'\s*<(task-notification|system-reminder|local-command|command-)', t):
                note = re.search(r'<summary>(.*?)</summary>', t, re.S)  # (the harness speaking, not the person: one line)
                if note:
                    out.append({'who': 'tool', 'text': f'后台通知：{" ".join(note.group(1).split())[:200]}', 'at': at})
                continue
            if t.strip():
                out.append({'who': m.get('role'), 'text': t.strip()[:4000], 'at': at})
            for tool in tools:
                out.append({'who': 'tool', 'text': tool, 'at': at})
        elif d.get('type') == 'response_item' and isinstance(d.get('payload'), dict):
            p = d['payload']
            if p.get('type') == 'message' and p.get('role') in ('user', 'assistant'):
                t, _ = text_of(p.get('content'))
                if t.strip() and not t.lstrip().startswith(('<environment_context', '<user_instructions', '# AGENTS.md', '<permissions')):
                    out.append({'who': p['role'], 'text': t.strip()[:4000], 'at': at})
            elif p.get('type') in ('function_call', 'custom_tool_call'):
                out.append({'who': 'tool', 'text': f'{p.get("name")}({str(p.get("arguments") or p.get("input") or "")[:160]})', 'at': at})
        elif d.get('role') in ('user', 'assistant'):
            t, tools = text_of(d.get('content') or d.get('message'))
            if t.strip():
                out.append({'who': d['role'], 'text': t.strip()[:4000], 'at': at})
            for tool in tools:
                out.append({'who': 'tool', 'text': tool, 'at': at})
    return out[-limit:]


def items_of(lines):
    """A conversation's lines as (who, what), oldest first."""
    items = []
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            if line.strip():
                items.append(('', line.strip()[:400]))  # (a plain-text transcript)
            continue
        if not isinstance(d, dict):
            continue
        if d.get('type') in ('user', 'assistant') and isinstance(d.get('message'), dict):  # Claude Code
            m = d['message']
            t, tools = text_of(m.get('content'))
            if m.get('role') == 'user' and isinstance(m.get('content'), list) and all(isinstance(x, dict) and x.get('type') == 'tool_result' for x in m['content']):
                continue
            if t.strip():
                items.append(('用户' if m.get('role') == 'user' else '助手', t.strip()))
            for tool in tools:
                items.append(('工具', tool))
        elif d.get('type') == 'response_item' and isinstance(d.get('payload'), dict):  # Codex
            p = d['payload']
            if p.get('type') == 'message' and p.get('role') in ('user', 'assistant'):
                t, _ = text_of(p.get('content'))
                if t.strip() and not t.lstrip().startswith(('<environment_context', '<user_instructions', '# AGENTS.md')):
                    items.append(('用户' if p['role'] == 'user' else '助手', t.strip()))
            elif p.get('type') in ('function_call', 'custom_tool_call'):
                items.append(('工具', f'{p.get("name")}({str(p.get("arguments") or p.get("input") or "")[:120]})'))
        elif d.get('role') in ('user', 'assistant'):  # (Cursor and others)
            t, tools = text_of(d.get('content') or d.get('message'))
            if t.strip():
                items.append(('用户' if d['role'] == 'user' else '助手', t.strip()))
    return items


def recent(path, budget=7000):
    """The end of a conversation as lines (who: what), oldest first, within budget characters."""
    out, n = [], 0
    for who, t in reversed(items_of(lines_of(path))):
        t = t if len(t) < 1500 else t[:700] + ' … ' + t[-700:]
        line = f'{who}: {t}' if who else t
        if n + len(line) > budget:
            break
        out.append(line)
        n += len(line)
    return list(reversed(out))


def opening(path, budget=2500):
    """How a conversation began: the person's first asks, within budget characters."""
    if path.endswith('/store.db'):
        lines = lines_of(path)
    else:
        try:
            with open(path, 'rb') as f:
                lines = f.read(600000).decode('utf-8', 'replace').splitlines()[:-1]
        except OSError:
            return []
    out, n = [], 0
    for who, t in items_of(lines):
        if who != '用户' or t.lstrip().startswith('<'):
            continue
        line = f'用户: {t[:900]}'
        if n + len(line) > budget or len(out) == 6:
            break
        out.append(line)
        n += len(line)
    return out


