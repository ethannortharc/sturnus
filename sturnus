WS_GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'


def ws_read(rfile):
    """One message from the browser as (opcode, bytes); None once it has gone."""
    data, op = b'', 0
    while True:
        h = rfile.read(2)
        if len(h) < 2:
            return None
        n = h[1] & 0x7F
        if n == 126:
            n = struct.unpack('>H', rfile.read(2))[0]
        elif n == 127:
            n = struct.unpack('>Q', rfile.read(8))[0]
        mask = rfile.read(4) if h[1] & 0x80 else b''
        b = rfile.read(n)
        if mask and n:  # (a browser masks what it sends)
            b = (int.from_bytes(b, 'big') ^ int.from_bytes((mask * (n // 4 + 1))[:n], 'big')).to_bytes(n, 'big')
        code = h[0] & 0x0F
        if code == 8:
            return None
        if code >= 8:  # (ping, pong: answered or let go, between the pieces of a message)
            return code, b
        op = op or code
        data += b
        if h[0] & 0x80:
            return op, data


def ws_send(sock, op, data):
    n = len(data)
    head = bytes([0x80 | op]) + (bytes([n]) if n < 126 else bytes([126]) + struct.pack('>H', n) if n < 65536 else bytes([127]) + struct.pack('>Q', n))
    sock.sendall(head + data)


def term_argv(loc):
    """What the browser's terminal runs: its own client of the agent's group, brought to the agent's pane."""
    if loc['mux'] == 'tmux':
        sock, pane = loc['sock'], loc['pane']
        name = f'{WEB_TMUX}{os.urandom(3).hex()}'
        # (a session grouped with the agent's: the same windows, its own current one, gone once the browser leaves)
        argv = ['tmux', '-S', sock, 'new-session', '-t', '=' + loc['session'][5:], '-s', name, ';', 'set-option', 'destroy-unattached', 'on']
        if pane:
            win = TMUX.tm(sock, 'display', '-p', '-t', pane, '#{window_index}').stdout.strip()
            argv += [';', 'select-window', '-t', f'={name}:{win}', ';', 'select-pane', '-t', pane]
        return argv
    return ['zellij', 'attach', loc['session']]


def term_bridge(rfile, conn, loc, cols, rows):
    """The pseudo-terminal and the websocket, joined both ways; the browser sends keys as binary, its size as text."""
    before = clients_of(loc['session']) if loc['mux'] == 'zellij' and loc.get('pane') else None
    env = {k: v for k, v in os.environ.items() if not k.startswith(('TMUX', 'ZELLIJ'))}
    env.update(TERM='xterm-256color', COLORTERM='truecolor', STURNUS_TERM='1')
    argv = term_argv(loc)
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.execvpe(argv[0], argv, env)
        finally:
            os._exit(127)
    resize = lambda c, r: fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', r, c, 0, 0))
    resize(cols, rows)
    if before is not None:  # (Zellij puts a new client where its first client stands: this one, alone, onto the pane)
        threading.Thread(target=zellij_bring, args=(loc, before), daemon=True).start()
    lock = threading.Lock()

    def out():
        try:
            while True:
                b = os.read(fd, 65536)
                if not b:
                    break
                with lock:
                    ws_send(conn, 2, b)
        except OSError:
            pass
        try:
            with lock:
                ws_send(conn, 8, b'')
            conn.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
    threading.Thread(target=out, daemon=True).start()
    try:
        while (m := ws_read(rfile)) is not None:
            op, data = m
            if op == 2:
                os.write(fd, data)
            elif op == 1:
                c = json.loads(data)
                resize(int(c['cols']), int(c['rows']))
            elif op == 9:
                with lock:
                    ws_send(conn, 10, data)
    except (OSError, ValueError, KeyError, TypeError):
        pass
    finally:
        try:
            os.kill(pid, signal.SIGHUP)
        except OSError:
            pass
        os.close(fd)
        threading.Thread(target=os.waitpid, args=(pid, 0), daemon=True).start()


def zellij_bring(loc, before):
    for _ in range(40):
        new = [c for c in clients_of(loc['session']) if c not in before]
        if new:
            plugin(loc['session'], f'focus {loc["pane"]}', client=max(new, key=int))
            return
        time.sleep(.15)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def end_headers(self):
        self.send_header('X-Frame-Options', 'SAMEORIGIN')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        super().end_headers()

    def send_json(self, obj, code=200, cookie=None):
        data = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Cache-Control', 'no-store')
        for c in [cookie] if isinstance(cookie, str) else cookie or []:
            self.send_header('Set-Cookie', c)
        self.end_headers()
        self.wfile.write(data)

    def cookie(self, name):
        m = re.search(rf'(?:^|;\s*){name}=([^;]+)', self.headers.get('Cookie') or '')
        return m.group(1) if m else ''

    def who(self):
        """'本机'; or, from the tailnet (straight to this machine's Tailscale address, or through tailscale serve), the
        owner's own devices only; None for anyone else. A request must also name this machine (no DNS rebinding)."""
        host = (self.headers.get('X-Forwarded-Host') or self.headers.get('Host') or '').rsplit(':', 1)[0].strip('[]').lower()
        login, peer = self.headers.get('Tailscale-User-Login'), self.client_address[0]
        name, owner = tailnet_self()
        self.https = False
        if peer in ('127.0.0.1', '::1'):
            # (tailscale serve also comes from here, with X-Forwarded-*: a peer it gives no login, a tagged machine or a
            # Funnel visitor, could name localhost as its host, and is not this machine)
            proxied = any(self.headers.get(h) for h in ('X-Forwarded-For', 'X-Forwarded-Host', 'X-Forwarded-Proto'))
            if host in ('127.0.0.1', 'localhost', '::1') and not login and not proxied:
                return '本机'
            if name and host == name and owner and login == owner:  # (tailscale serve: it sets the login itself)
                self.https = True
                return f'{self.headers.get("X-Forwarded-For") or "tailnet"}（{owner}）'
            return None
        names = {name, (name or '').split('.')[0], *(_tailnet.get('ips') or [])} - {None, ''}
        who = tailnet_login(peer)
        if host in names and who and owner and who[0] == owner:  # (only the owner's own devices, not ones shared in)
            return f'{who[1] or peer}（{peer}）'
        return None

    def gate(self):
        """True when the request may go on; otherwise it has been answered."""
        self.via = self.who()
        if self.via is None:
            self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
            return False
        bare = self.path.split('?')[0]
        if ACCESS_.check(self.cookie('deck')) or (self.command == 'GET' and OPEN.match(bare)) or (self.command == 'POST' and bare == '/api/login'):
            return True
        if self.command == 'GET' and bare in ('/', '/index.html'):
            self.static('login.html')
            return False
        self.send_json({'ok': False, 'msg': '要先登录', 'login': True}, 401)
        return False

    def static(self, name):
        f = os.path.join(APP, 'web', name)
        if not STATIC.match(name) or not os.path.isfile(f):
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header('Content-Type', TYPES.get(os.path.splitext(f)[1], 'application/octet-stream'))
        self.send_header('Cache-Control', 'max-age=31536000, immutable' if name.startswith('fonts/') else 'no-cache')
        self.end_headers()
        with open(f, 'rb') as h:
            self.wfile.write(h.read())

    def term(self):
        """The agent's terminal in the browser: a websocket to a client of its group run in a pseudo-terminal."""
        from urllib.parse import urlparse, parse_qs
        q = parse_qs(urlparse(self.path).query)
        arg = lambda k: (q.get(k) or [''])[0]
        if arg('id'):
            loc = (DECK.find(arg('id')) or {}).get('loc')
        else:  # (a group, at a pane of it or wherever it stands)
            g, z = arg('group'), DECK.state['groups'].get(arg('group'))
            pane = arg('pane') if re.fullmatch(r'%\d+' if (z or {}).get('mux') == 'tmux' else r'\d+', arg('pane')) else None
            loc = z and {'mux': z['mux'], 'session': g, 'pane': pane, 'sock': z.get('sock')}
        host = (self.headers.get('X-Forwarded-Host') or self.headers.get('Host') or '').rsplit(':', 1)[0]
        origin = urlparse(self.headers.get('Origin') or '').hostname or ''
        if (self.headers.get('Upgrade') or '').lower() != 'websocket' or not self.headers.get('Sec-WebSocket-Key') or origin != host.strip('[]'):
            return self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
        if not loc:
            return self.send_json({'ok': False, 'msg': '不在 Zellij 或 tmux 里'}, 404)
        room = None
        if loc['mux'] == 'zellij':
            with ROOM:
                room = zellij_room(loc['session'])
        accept = base64.b64encode(hashlib.sha1((self.headers['Sec-WebSocket-Key'] + WS_GUID).encode()).digest()).decode()
        self.wfile.write(f'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n'.encode())
        self.wfile.flush()
        self.close_connection = True
        if room and not room['ok']:  # (one more client would take the server down: the page says why, from close code 4001)
            ws_send(self.connection, 8, struct.pack('>H', 4001) + json.dumps({k: room[k] for k in ('held', 'limit', 'need')}).encode())
            # (then wait for the browser's own close: closing on frames it already sent would reset the connection, and
            # the close frame could be lost with it)
            self.connection.settimeout(1)
            try:
                while (m := ws_read(self.rfile)) is not None and m[0] != 8:
                    pass
            except (OSError, ValueError):
                pass
            return
        size = lambda k, d: max(10, min(1000, int((q.get(k) or [d])[0]) if str((q.get(k) or [d])[0]).isdigit() else d))
        term_bridge(self.rfile, self.connection, loc, size('cols', 120), size('rows', 36))

    def do_GET(self):
        if not self.gate():
            return
        if self.path.startswith('/api/term'):
            return self.term()
        if self.path.startswith('/api/state'):
            with DECK.lock:
                return self.send_json(DECK.state)
        if self.path.startswith('/api/board'):  # (a channel: its posts, discussions, who is on it)
            from urllib.parse import urlparse, parse_qs
            key = (parse_qs(urlparse(self.path).query).get('key') or [''])[0]
            meta = A.channels().get(key)
            if not meta:
                return self.send_json({'meta': None, 'posts': [], 'topics': [], 'members': []})
            return self.send_json({'meta': meta, 'posts': A.posts(key, limit=400), 'topics': A.topics(key), 'members': [m for m in A.members(key) if m != ME_NAME]})
        if self.path.startswith('/api/transcript'):
            from urllib.parse import urlparse, parse_qs
            sid = (parse_qs(urlparse(self.path).query).get('id') or [''])[0]
            s = DECK.find(sid)
            path = transcript_of(s) if s else None
            return self.send_json({'items': transcript_items(path) if path else []})
        bare = self.path.split('?')[0].split('#')[0]
        self.static('index.html' if bare in ('/', '/index.html') else bare.lstrip('/'))

    def do_POST(self):
        if not self.gate():
            return
        # (only this page: a cross-site form cannot set this header)
        if self.headers.get('X-Deck') != '1':
            return self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
        if self.path.endswith('/api/stt'):  # (a recording, as it is: to text)
            n = int(self.headers.get('Content-Length') or 0)
            v = voice_cfg(DECK.cfg)
            if not v['on']:
                return self.send_json({'ok': False, 'msg': '语音输入没开：设置 → 语音输入'})
            if not 0 < n <= 25 * 1024 * 1024:
                return self.send_json({'ok': False, 'msg': '录音太长了（最多 25 MB）' if n else '没录到声音'})
            audio = self.rfile.read(n)
            try:
                return self.send_json({'ok': True, 'via': voice_label(v), 'text': transcribe(audio, self.headers.get('Content-Type') or 'audio/webm', v, voice_key(v['provider'])).strip()})
            except Exception as e:
                return self.send_json({'ok': False, 'msg': f'没转成文字：{e}'[:300]})
        try:
            body = json.loads(self.rfile.read(int(self.headers.get('Content-Length') or 0)) or b'{}')
        except ValueError:
            body = {}
        what = self.path.rsplit('/', 1)[-1]
        secure = '; Secure' if self.https else ''  # (plain http on the tailnet is WireGuard's; a Secure cookie needs https)
        if what == 'login':
            sid, msg = ACCESS_.login(str(body.get('token') or '').strip(), self.via)
            if not sid:
                return self.send_json({'ok': False, 'msg': msg}, 401)
            DECK.note(f'新登录：{self.via}', True)
            return self.send_json({'ok': True}, cookie=f'deck={sid}; HttpOnly; SameSite=Strict; Path=/; Max-Age={30 * DAY}{secure}')
        if what == 'access':  # (the signed-in browsers: list, sign one out, or this one)
            mine = Access.key(self.cookie('deck'))
            if body.get('do') == 'drop':
                key = mine if body.get('key') == 'me' else str(body.get('key') or '')
                ACCESS_.drop(key)
                if key == mine:
                    return self.send_json({'ok': True}, cookie=f'deck=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0{secure}')
            return self.send_json({'ok': True, 'sessions': ACCESS_.listing(mine), 'local': f'http://127.0.0.1:{DECK.cfg["port"]}',
                                   'tailnet': tailnet_urls(DECK.cfg)})
        try:
            ok, msg = DECK.act(what, body)
        except Exception as e:
            ok, msg = False, repr(e)
        if isinstance(msg, dict):  # (an answer with data, not a line to show)
            return self.send_json({'ok': ok, **msg})
        DECK.note(msg, ok)
        self.send_json({'ok': ok, 'msg': msg})


def serve():
    global DECK
    os.makedirs(CACHE, exist_ok=True)
    DECK = Deck()
    try:
        DECK.collect()
    except Exception as e:  # (the loop keeps trying; the page says what went wrong)
        DECK.note(f'收集出错：{e!r}', False)
    threading.Thread(target=DECK.loop, daemon=True).start()
    threading.Thread(target=DECK.summarize_loop, daemon=True).start()
    threading.Thread(target=DECK.queue_loop, daemon=True).start()
    threading.Thread(target=DECK.mind_loop, daemon=True).start()
    threading.Thread(target=DECK.projects.facts_loop, args=(DECK,), daemon=True).start()
    cfg = DECK.cfg
    global ACCESS_
    ACCESS_ = Access()
    srv = ThreadingHTTPServer((cfg['host'], int(cfg['port'])), Handler)
    print(f'sturnus {VERSION} on http://{cfg["host"]}:{cfg["port"]}', flush=True)
    if cfg.get('tailnet', True) and tailscale():
        threading.Thread(target=bind_tailnet, args=(int(cfg['port']),), daemon=True).start()
    srv.serve_forever()


