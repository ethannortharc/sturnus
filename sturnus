@functools.cache
def boot_time():
    """When this machine started: a terminal from before then ended with the restart."""
    try:
        if MAC:
            m = re.search(r'sec = (\d+)', run(['sysctl', '-n', 'kern.boottime']).stdout)
            return float(m.group(1)) if m else 0
        with open('/proc/uptime') as f:
            return time.time() - float(f.read().split()[0])
    except (OSError, ValueError):
        return 0


