def save_config(patch):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    c = A.get(CONF, {}) or {}
    c.update(patch)
    A.put(CONF, c, 2)


PLUGIN_GRANTS = ['ChangeApplicationState', 'ReadApplicationState', 'ReadCliPipes', 'WriteToStdin', 'StartWebServer']
def grant_zellij():
    """Zellij asks the person before a plugin may act; the deck's plugin gets its three grants once, by its path."""
    f = GRANTS
    os.makedirs(os.path.dirname(f), exist_ok=True)
    s = open(f).read() if os.path.exists(f) else ''
    s = re.sub(r'"' + re.escape(WASM) + r'" \{[^}]*\}\n?', '', s)
    with open(f, 'w') as w:
        w.write(s + f'"{WASM}" {{\n' + ''.join(f'    {p}\n' for p in PLUGIN_GRANTS) + '}\n')


def ungrant_zellij(wasm=WASM):
    f = GRANTS
    if os.path.exists(f):
        s = re.sub(r'"' + re.escape(wasm) + r'" \{[^}]*\}\n?', '', open(f).read())
        with open(f, 'w') as w:
            w.write(s)


def systemctl(*a):
    return run(['systemctl', '--user', *a], timeout=20)


def write_unit(cur):
    argv = [A.PYTHON, os.path.join(cur, 'sturnus'), 'serve']
    os.makedirs(os.path.dirname(UNIT), exist_ok=True)
    if MAC:
        with open(UNIT, 'wb') as u:
            plistlib.dump({'Label': LABEL, 'ProgramArguments': argv, 'RunAtLoad': True, 'KeepAlive': {'SuccessfulExit': False},
                           'ThrottleInterval': 3, 'ProcessType': 'Interactive', 'StandardOutPath': LOG, 'StandardErrorPath': LOG,
                           'EnvironmentVariables': {'PATH': os.environ.get('PATH', '/usr/bin:/bin'), 'PYTHONUTF8': '1'}}, u)
        return
    with open(UNIT, 'w') as u:
        u.write(f'''[Unit]
Description=sturnus: the sessions on this machine, one page
After=default.target

[Service]
ExecStart={' '.join(argv)}
Restart=on-failure
RestartSec=3
KillMode=process
Environment=PATH={os.environ.get("PATH", "/usr/bin:/bin")}

[Install]
WantedBy=default.target
''')


def service(do):
    """The user service, systemd's on Linux and launchd's on macOS: 'start' (afresh, now and at every login), 'stop'
    (and not at login), 'gone' (its unit file was removed), or 'state'."""
    if not MAC:
        if do == 'start':
            systemctl('daemon-reload')
            systemctl('enable', 'sturnus.service')
            return systemctl('restart', 'sturnus.service')
        if do == 'state':
            r = systemctl('is-active', 'sturnus.service')
            return r.stdout.strip() or r.stderr.strip()
        return systemctl('daemon-reload') if do == 'gone' else systemctl('disable', '--now', 'sturnus.service')
    job = f'gui/{os.getuid()}/{LABEL}'
    if do == 'state':
        m = re.search(r'^\s*state = (\S+)', run(['launchctl', 'print', job]).stdout, re.M)
        return 'active' if m and m.group(1) == 'running' else (m.group(1) if m else 'inactive')
    if do == 'gone':
        return None
    r = run(['launchctl', 'bootout', job], timeout=20)
    if do == 'start':
        for _ in range(20):  # (bootout returns before launchd has let go of the job)
            r = run(['launchctl', 'bootstrap', f'gui/{os.getuid()}', UNIT], timeout=20)
            if r.returncode == 0:
                break
            time.sleep(0.5)
    return r


FILES = ['sturnus', 'amail', 'VERSION', 'README.md', 'LICENSE', 'web', 'zellij-jump.wasm']


def move_into(old, new):
    """What OLD holds goes into NEW, then OLD goes. A file NEW has already stays, and OLD's is kept beside it as
    <name>.agentdeck. When one is a link to the other, the folder stays as it is, under NEW's name."""
    if not os.path.isdir(old):
        return
    if os.path.realpath(old) == os.path.realpath(new):
        if os.path.islink(new):
            os.remove(new)
            shutil.move(old, new)
        elif os.path.islink(old):
            os.remove(old)
        return
    if not os.path.isdir(new):
        os.makedirs(new)
        shutil.copymode(old, new)
    for f in os.listdir(old):
        to = os.path.join(new, f)
        shutil.move(os.path.join(old, f), to + '.agentdeck' if os.path.lexists(to) else to)
    if os.path.islink(old):
        os.remove(old)
    else:
        shutil.rmtree(old, ignore_errors=True)


def adopt(with_service=True):
    """The first install takes over an agentdeck one (this app's name before): its settings, sign-ins, keys and caches
    move here, its service, its plugin's grant and its folder go. Run once this version's own links are in place."""
    old = {k: os.path.expanduser(v) for k, v in (('share', '~/.local/share/agentdeck'), ('conf', '~/.config/agentdeck'),
                                                 ('cache', '~/.cache/agentdeck'), ('unit', '~/.config/systemd/user/agentdeck.service'))}
    if not any(os.path.lexists(p) for p in old.values()):
        return ''
    if not with_service and os.path.exists(old['unit']):  # (its service may be running on these files: leave it all)
        return 'agentdeck is still installed with its service: `./sturnus install` with the service takes it over'
    if with_service and os.path.exists(old['unit']):
        systemctl('disable', '--now', 'agentdeck.service')  # (before this one's service takes the port)
    if os.path.exists(old['unit']):
        os.remove(old['unit'])
        if with_service:
            systemctl('daemon-reload')
    move_into(old['conf'], os.path.dirname(CONF))
    move_into(old['cache'], CACHE)
    c = A.get(CONF, {}) or {}
    if c.get('source') and not os.path.exists(os.path.join(c['source'], 'sturnus')):
        c.pop('source')  # (it named the agentdeck folder; install sets this one's)
        A.put(CONF, c, 2)
    link = os.path.join(BIN, 'agentdeck')
    if os.path.islink(link) and os.path.realpath(link).startswith(old['share']):
        os.remove(link)
    ungrant_zellij(os.path.join(old['share'], 'zellij-jump.wasm'))
    shutil.rmtree(old['share'], ignore_errors=True)
    return 'took over agentdeck: its settings, sign-ins and caches moved here; its service and folder removed'


def install(src, with_service=True):
    src = os.path.realpath(src)
    ver = open(os.path.join(src, 'VERSION')).read().strip()
    dest = os.path.join(SHARE, 'versions', ver)
    if os.path.realpath(dest) != src:
        shutil.rmtree(dest, ignore_errors=True)
        os.makedirs(dest)
        for f in FILES:
            p = os.path.join(src, f)
            if os.path.isdir(p):
                shutil.copytree(p, os.path.join(dest, f))
            elif os.path.exists(p):
                shutil.copy2(p, os.path.join(dest, f))
    # (the new version proves it can read this machine before it becomes the current one)
    chk = run([sys.executable, os.path.join(dest, 'sturnus'), 'check'], timeout=120)
    if chk.returncode != 0:
        sys.exit(f'sturnus {ver} failed its check, the current version stays:\n{(chk.stderr or chk.stdout)[-1500:]}')
    cur = os.path.join(SHARE, 'current')
    tmp = cur + '.new'
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(dest, tmp)
    os.replace(tmp, cur)
    shutil.copy2(os.path.join(dest, 'zellij-jump.wasm'), WASM)
    grant_zellij()
    os.makedirs(BIN, exist_ok=True)
    for name in ('sturnus', 'amail'):
        link = os.path.join(BIN, name)
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(os.path.join(cur, name), link)
    took = adopt(with_service)
    c = A.get(CONF, {}) or {}
    if not src.startswith(os.path.realpath(SHARE) + os.sep):
        c['source'] = src  # (where upgrade looks: the folder last installed from, never the deck's own copy)
    if not os.path.exists(CONF):
        c.update({'host': DEFAULTS['host'], 'port': DEFAULTS['port']})
    save_config(c)
    hooks = run([sys.executable, os.path.join(cur, 'amail'), 'install'], timeout=90)
    for repo in c.get('lock_repos', []):  # (the push lock's git hook, in the repos it guards)
        if os.path.isdir(os.path.expanduser(repo)):
            run([sys.executable, os.path.join(cur, 'amail'), 'install-git', os.path.expanduser(repo)])
    if not with_service:
        return '\n'.join(x for x in (f'sturnus {ver} installed (no service)', took, hooks.stdout.strip()) if x)
    write_unit(cur)
    service('start')
    down = ''
    for _ in range(20):  # (launchd and systemd start it a moment later)
        if service('state') == 'active':
            break
        time.sleep(.25)
    else:
        down = f'the service did not start ({service("state")}): see {LOG if MAC else "journalctl --user -u sturnus"}'
    access_data()
    https = serve_https(config())
    if https.startswith('https://'):
        save_config({'https': True})
    reach = tailnet_urls(config())
    reach = '\n'.join(x for x in (f'\ntailnet (your own devices): {reach}' if reach else '', https if not https.startswith('https://') else '') if x)
    for old in sorted(glob.glob(os.path.join(SHARE, 'versions', '*')), key=os.path.getmtime)[:-3]:  # (keep three to go back to)
        if os.path.realpath(old) != os.path.realpath(dest):
            shutil.rmtree(old, ignore_errors=True)
    cfg = config()
    return '\n'.join(x for x in (f'sturnus {ver} installed: http://{cfg["host"]}:{cfg["port"]}{reach}',
                                 'sign in with the token from: sturnus token', down, took, hooks.stdout.strip()) if x)


def uninstall(purge, with_service=True):
    out = []
    if with_service:
        service('stop')
        serve_https(config(), on=False)
    if os.path.exists(UNIT):
        os.remove(UNIT)
        if with_service:
            service('gone')
    out.append('service removed')
    if MAC and with_service and os.path.exists(LOG):  # (the service's log goes with it)
        os.remove(LOG)
    amail = os.path.join(SHARE, 'current', 'amail')
    if os.path.exists(amail):
        out.append(run([sys.executable, amail, 'uninstall'], timeout=90).stdout.strip())
        for hook in glob.glob(os.path.expanduser('~/projects/*/.git/hooks/pre-push')) + glob.glob(os.path.expanduser('~/projects/*/*/.git/hooks/pre-push')):
            try:
                if 'amail prepush' in open(hook).read() or 'amail: refuse a push' in open(hook).read():
                    os.remove(hook)
                    out.append(f'removed {hook}')
            except OSError:
                pass
    ungrant_zellij()
    for name in ('sturnus', 'amail'):
        link = os.path.join(BIN, name)
        if os.path.islink(link) and SHARE in os.path.realpath(link):
            os.remove(link)
    shutil.rmtree(SHARE, ignore_errors=True)
    out.append(f'removed {SHARE}')
    if purge:
        for d in (os.path.dirname(CONF), CACHE, A.HOME):
            shutil.rmtree(d, ignore_errors=True)
        out.append('settings, caches and mail removed')
    return '\n'.join(x for x in out if x)


def newer(a, b):
    return [int(x) for x in a.split('.')] > [int(x) for x in b.split('.')]


RELEASES = 'ethannortharc/sturnus'  # (the GitHub repository releases come from; config "releases" names another)


def git_source(src):
    """A git checkout to upgrade from: pull it (fast-forward only, when nothing is uncommitted). Says what happened."""
    if not src or run(['git', '-C', src, 'rev-parse', '--is-inside-work-tree']).stdout.strip() != 'true':
        return None
    if run(['git', '-C', src, 'status', '--porcelain']).stdout.strip():
        return f'{src} has uncommitted changes: not pulled'
    if run(['git', '-C', src, 'rev-parse', '--abbrev-ref', '@{u}']).returncode != 0:
        return f'{src} follows no remote branch: not pulled'
    r = run(['git', '-C', src, 'pull', '--ff-only', '-q'], timeout=120)
    return f'pulled {src}' if r.returncode == 0 else f'could not pull {src}: {(r.stderr or r.stdout).strip()[:200]}'


def latest_release(cfg):
    """The newest release on GitHub: (version, archive url, checksum url)."""
    repo = cfg.get('releases') or RELEASES
    d = http_json(f'https://api.github.com/repos/{repo}/releases/latest', headers={'Accept': 'application/vnd.github+json', 'User-Agent': f'sturnus/{VERSION}'}, timeout=30)
    v = str(d.get('tag_name') or '').lstrip('v')
    if not re.fullmatch(r'\d+(\.\d+)*', v):
        raise ValueError(f'the newest release of {repo} is not a version: {d.get("tag_name")!r}')
    assets = {a.get('name'): a.get('browser_download_url') for a in d.get('assets') or []}
    tar, sha = assets.get(f'sturnus-{v}.tar.gz'), assets.get(f'sturnus-{v}.tar.gz.sha256')
    if not tar or not sha:
        raise ValueError(f'release v{v} of {repo} has no sturnus-{v}.tar.gz with its .sha256')
    return v, tar, sha


def fetch_release(v, tar, sha):
    """A release archive, downloaded, checked against its checksum and unpacked under the install's own folder: the
    folder to install from."""
    import io, tarfile
    get = lambda url: urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': f'sturnus/{VERSION}'}), timeout=120).read()
    data, want = get(tar), get(sha).decode().split()[0].lower()
    if hashlib.sha256(data).hexdigest() != want:
        raise ValueError(f'sturnus-{v}.tar.gz does not match its checksum: not installed')
    top, dest = f'sturnus-{v}', os.path.join(SHARE, 'src')
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:gz') as t:
        for m in t.getmembers():  # (only plain files and folders inside its own folder)
            parts = m.name.split('/')
            if parts[0] != top or '..' in parts or m.name.startswith('/') or not (m.isfile() or m.isdir()):
                raise ValueError(f'sturnus-{v}.tar.gz holds {m.name!r}: not installed')
        shutil.rmtree(os.path.join(dest, top), ignore_errors=True)
        os.makedirs(dest, exist_ok=True)
        t.extractall(dest, **({'filter': 'data'} if hasattr(tarfile, 'data_filter') else {}))  # (newer Pythons check again, and say nothing)
    return os.path.join(dest, top)


def upgrade(argv):
    """The newest version, installed by itself (its own install steps, not this one's)."""
    cfg = A.get(CONF, {}) or {}
    src = cfg.get('source')
    pulled = None if '--release' in argv else git_source(src)
    if pulled is not None:
        print(pulled)
        v = open(os.path.join(src, 'VERSION')).read().strip()
        if not newer(v, VERSION) and '--force' not in argv:
            return print(f'sturnus {VERSION} is current ({src} has {v}); --force to install it again')
    else:
        try:
            v, tar, sha = latest_release(cfg)
        except Exception as e:
            sys.exit(f'sturnus: could not see the newest release: {e}')
        if not newer(v, VERSION) and '--force' not in argv:
            return print(f'sturnus {VERSION} is current (the newest release is {v}); --force to install it again')
        try:
            src = fetch_release(v, tar, sha)
        except Exception as e:
            sys.exit(f'sturnus: could not get release {v}: {e}')
        print(f'got release {v}')
    sys.stdout.flush()  # (what was said so far, before this process becomes the new version's install)
    os.execv(sys.executable, [sys.executable, os.path.join(src, 'sturnus'), 'install', '--from', src] + (['--no-service'] if '--no-service' in argv else []))


def main(argv):
    c = argv[0] if argv else 'help'
    if c == 'serve':
        serve()
    elif c == 'install':
        src = argv[argv.index('--from') + 1] if '--from' in argv else APP
        print(install(src, '--no-service' not in argv))
    elif c == 'upgrade':
        upgrade(argv)
    elif c == 'uninstall':
        print(uninstall('--purge' in argv, '--no-service' not in argv))
    elif c == 'status':
        cfg = config()
        reach = tailnet_urls(cfg)
        print(f'sturnus {VERSION} ({APP})\nservice: {service("state")}' + (f' (log: {LOG})' if MAC else '') +
              f'\nhttp://{cfg["host"]}:{cfg["port"]}' + (f'\ntailnet: {reach}' if reach else ''))
    elif c == 'open':
        cfg = config()
        url = f'http://{cfg["host"]}:{cfg["port"]}'
        print(url)
        run(['open' if MAC else 'xdg-open', url])
    elif c == 'token':  # (the sign-in token, for the person at this terminal; --rotate signs every browser out)
        d = access_data('--rotate' in argv)
        if '--rotate' in argv:
            print('new token; every browser signed out')
        print(d['token'])
    elif c == 'version':
        print(VERSION)
    elif c == 'check':
        d = Deck()
        d.cfg['pane_titles'] = False  # (a check names no panes)
        d.collect()
        d.launched['0' * 12] = {'kind': 'claude', 'name': 'check', 'group': 'check', 'cwd': '/', 'at': time.time()}
        d.collect()
        print(f'ok: {len(d.state["sessions"])} sessions, {len(d.state["groups"])} groups, {len(d.state["talk"])} messages')
    else:
        print(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
