def serve_https(cfg, on=True):
    """https://<machine>.<tailnet>.ts.net:<https_port>, by tailscale serve to the deck on 127.0.0.1: Tailscale's
    certificate is for the machine's name (an address gets none); who comes in is checked as on the address.
    Returns the address, or why there is none."""
    ts, port = tailscale(), int(cfg.get('https_port', 7443))
    if not on:
        if ts and cfg.get('https'):
            run([*ts, 'serve', f'--https={port}', 'off'], timeout=20)
        return ''
    if not ts or not cfg.get('tailnet', True):
        return ''
    r = run([*ts, 'serve', '--bg', f'--https={port}', f'http://127.0.0.1:{cfg["port"]}'], timeout=30)
    name, _ = tailnet_self()
    if r.returncode != 0 or not name:
        why = (r.stderr or r.stdout).strip()[-300:]
        hint = '; sudo tailscale set --operator=$USER lets this user run it' if 'denied' in why.lower() else ''
        return f'https: not set up ({why}{hint})'
    return f'https://{name}:{port}'


