PHONE_LOCK = threading.Lock()  # (one answer at a time: two taps arriving together must not both type)
PHONE_DONE = {}  # (item id → when it was answered: the state seen is up to a collect old, so a repeat is refused meanwhile)


def phone_now(s):
    """What Claude Code's registry and amail's board say of a session this moment, not at the last collect."""
    reg = next((x for x in A.claude_sessions() if x.get('name') == s['name']), None) if s['kind'] == 'claude' else None
    return reg, (A.board() or {}).get(s['name']) or {}


def phone_answer(deck, iid, choice, text=''):
    """(http status, message): the person's answer from the phone, to the very item it showed."""
    gone = tx('这件事已经变了，刷新看看现在的样子', 'This has changed; refresh to see where it stands')
    with PHONE_LOCK:
        now = time.time()
        for k in [k for k, at in PHONE_DONE.items() if now - at > 60]:
            del PHONE_DONE[k]
        if iid in PHONE_DONE:
            return 409, tx('这件已经回答过了', 'This has been answered already')
        with deck.lock:
            sessions, groups = list(deck.state['sessions']), dict(deck.state.get('groups') or {})
        it = next((i for i in phone_items(sessions, groups=groups) if i['id'] == iid), None)
        if not it:
            return 409, gone
        if choice not in {a['id'] for a in it['actions']}:
            return 400, tx('这里没有这个选项', 'That is not a choice here')
        s = deck.find(it['session'])
        if not s:
            return 409, tx('这个会话已经不在了', 'That session is gone')
        reg, raw = phone_now(s)
        if it['kind'] in ('permission', 'question'):
            # (still at the same prompt this moment: Claude Code says it waits, and the prompt on record is this one)
            if not reg or reg.get('status') != 'waiting' or raw.get('state') != 'waiting' or (raw.get('asking') or {}) != (s.get('asking') or {}):
                return 409, gone
            keys = {'allow': '1', 'deny': '\x1b'}.get(choice) or choice[1:]
            ok, msg = deck.type_in(s, keys, False)
            if not ok:
                return 502, msg
            PHONE_DONE[iid] = now
            return 200, {'allow': tx('已允许', 'Allowed'), 'deny': tx('已拒绝', 'Denied')}.get(choice) or tx(f'已选「{next(a["label"] for a in it["actions"] if a["id"] == choice)}」', 'Chosen')
        if choice == 'done':
            ticked = sum(1 for a in it['asks'] if deck.sums.ask_done(a)[0])  # (only those the card showed)
            PHONE_DONE[iid] = now
            return (200, tx('记下了：已处理', 'Marked as handled')) if ticked else (409, tx('这件已经处理过了', 'This one is already handled'))
        text = (text or '').strip()
        if not text:
            return 400, tx('先写要说的话', 'Write what to say first')
        if (reg.get('status') == 'waiting') if reg else raw.get('state') == 'waiting':
            # (it has just stopped at a prompt: typed words and Enter would answer that. Claude Code's own registry says so
            # for a session it lists; amail's record stays 'waiting' after a deny by Esc, which ends no call)
            return 409, tx('它刚停在一个提示上，先处理那个', 'It has just stopped at a prompt; answer that first')
        ok, msg = deck.act('say', {'id': s['id'], 'text': text})
        msg = msg.get('msg') if isinstance(msg, dict) else msg
        if ok:
            PHONE_DONE[iid] = now
        return (200 if ok else 502), msg or (tx('发出去了', 'Sent') if ok else tx('没发出去', 'Not sent'))


