def claude_login():
    """The person's Claude Code sign-in while it is good: the access token in Claude Code's own file. On macOS a deck run
    by launchd would read the login keychain instead, and its copy goes stale when the person's sessions run where the
    keychain is out of reach (inside Zellij) and keep only the file fresh. Read only: their sessions refresh it."""
    if any(os.environ.get(k) for k in ('CLAUDE_CODE_OAUTH_TOKEN', 'ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN')):
        return None
    try:
        o = (A.get(os.path.join(os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude'), '.credentials.json'), {}) or {}).get('claudeAiOauth')
        left = float(o.get('expiresAt') or 0) / 1000 - time.time()
    except Exception:  # (a file not as Claude Code writes it: its own way)
        return None
    tok = o.get('accessToken')
    return tok if isinstance(tok, str) and left > 150 else None  # (good through a call's two minutes; else Claude Code's own way, which refreshes)


def ask_model(prompt, cfg, role='summary', m=None, key=None):
    prompt += WORK_LANG.get(cfg.get('work_lang') or 'zh', '')
    m = m or model_for(cfg, role)
    env = {**os.environ, 'AMAIL_SKIP': '1'}
    os.makedirs(CACHE, exist_ok=True)
    if m['source'] == 'api':
        key = key if key is not None else (secret(role) or os.environ.get(m.get('key_env') or '', ''))
        req = urllib.request.Request(str(m.get('url') or '').rstrip('/') + '/chat/completions', method='POST',
                                     data=json.dumps({'model': m.get('model'), 'messages': [{'role': 'user', 'content': prompt}], 'temperature': 0.2}).encode(),
                                     headers={'Content-Type': 'application/json', **({'Authorization': f'Bearer {key}'} if key else {})})
        with urllib.request.urlopen(req, timeout=90) as r:
            return json.loads(r.read())['choices'][0]['message']['content']
    if m['source'] == 'codex':
        out = os.path.join(CACHE, f'codex-{os.getpid()}-{threading.get_ident()}.txt')
        argv = ['codex', 'exec', '--ephemeral', '--skip-git-repo-check', '-s', 'read-only', '--color', 'never', '-o', out]
        if m.get('model'):
            argv += ['-m', m['model']]
        r = subprocess.run(argv + [prompt], capture_output=True, text=True, timeout=180, cwd=CACHE, env=env, stdin=subprocess.DEVNULL)
        try:
            text = open(out).read()
        except OSError:
            text = ''
        finally:
            try:
                os.remove(out)
            except OSError:
                pass
        if not text.strip():
            raise RuntimeError((r.stderr or r.stdout).strip()[-200:] or f'exit {r.returncode}')
        return text
    if m['source'] == 'pi':
        argv = ['pi', '-p', '--no-session'] + (['--model', m['model']] if m.get('model') else [])
        r = subprocess.run(argv + [prompt], capture_output=True, text=True, timeout=180, cwd=CACHE, env=env, stdin=subprocess.DEVNULL)
        if r.returncode != 0 or not r.stdout.strip():
            raise RuntimeError(' '.join((r.stderr or r.stdout).split())[:240] or f'exit {r.returncode}')
        return r.stdout
    argv = ['claude', '-p', '--model', m.get('model') or 'haiku', '--no-session-persistence', '--strict-mcp-config',
            '--setting-sources', 'project', '--disable-slash-commands', '--tools=']
    tok = claude_login()
    r = subprocess.run(argv, input=prompt, capture_output=True, text=True, timeout=120, cwd=CACHE, env={**env, 'CLAUDE_CODE_OAUTH_TOKEN': tok} if tok else env)
    if r.returncode != 0:
        err = (r.stderr or r.stdout).strip()[:200] or f'exit {r.returncode}'
        if re.search(r'authenticat|oauth|not logged in', err, re.I) and not re.search(r'api key', err, re.I):
            raise RuntimeError(tx(f'Claude Code 的登录过期了：在终端里开一次 claude 就会刷新（需要的话再 /login）。{err}',
                                  f'Claude Code’s sign-in has expired: start claude once in a terminal to refresh it (/login if it asks). {err}'))
        raise RuntimeError(err)
    return r.stdout


