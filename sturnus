PROMPT = '''你在为一位开发者的「会话总览」写状态。下面是一个 AI 编码会话（{kind}，名字 {name}，目录 {cwd}）最近的对话片段，最后几行最新。
只输出一行 JSON，不要别的：{{"title": "...", "summary": "...", "status": "...", "needs_you": "...", "decisions": [{{"what": "...", "by": "..."}}]}}
- title：不超过 14 个汉字的任务名，像给这件事起的标题（例如「发布 faw 0.8.2」「复现 Mantis 1349608」）。
- summary：不超过 40 个汉字。说清做到哪一步、下一步是什么。要具体（带上分支、功能、版本、文件等名字），不要空话。
- status：working（正在干活）、waiting_user（在等用户回答或拍板）、review（做完了，等用户检查结果）、blocked（卡住或出错）、done（这件事做完了，不用再看）、idle（没有任务）之一。
- needs_you：只有当它在等用户决定、批准、回答、检查结果或亲手做某件事时，才用一句话说清要用户做什么、怎么做；否则必须是空字符串（不要写「无需…」「暂无」之类）。
- decisions：片段里已经做出的决定（方案取舍、批准、范围、放弃什么），每条不超过 40 个汉字；by 是 user（用户定的）或 agent（它自己定的）。没有就给空列表。

片段：
{text}
'''
NONE = re.compile(r'^(无需|不需要|暂无|没有需要|无$|无。|none|n/?a|nothing|no action)', re.I)


class Summaries:
    def __init__(self):
        self.file = os.path.join(CACHE, 'summaries.json')
        self.dfile = os.path.join(CACHE, 'decisions.json')
        self.data = A.get(self.file, {}) or {}
        self.decisions = A.get(self.dfile, []) or []
        self.error = ''
        self.busy = None

    def get(self, sid):
        return self.data.get(sid)

    def due(self, s, cfg):
        if s['state'] in ('gone', 'ended') and time.time() - (s.get('at') or 0) > 3600:
            return False
        path = transcript_of(s)
        basis = f'{os.path.getmtime(path):.0f}' if path and os.path.exists(path) else (s.get('said') or '')[:200]
        if not basis:
            return False
        cur = self.data.get(s['id'])
        if cur and cur.get('basis') == basis and 'title' in cur:  # (one from before titles is made again once)
            return False
        # (anew when it changed: at most every so often while it works, soon once it stops)
        every = cfg['summarizer']['every_working'] if s['state'] == 'working' else cfg['summarizer']['every_other']
        if cur and time.time() - cur.get('at', 0) < every:
            return False
        return basis

    def make(self, s, basis, cfg):
        path = transcript_of(s)
        lines = recent(path) if path else []
        if not lines and s.get('said'):
            lines = [f'助手: {s["said"]}']
        if not lines:
            return
        prompt = PROMPT.format(kind=s['kind'], name=s['name'], cwd=s.get('cwd') or '?', text='\n'.join(lines))
        self.busy = s['id']
        try:
            out = ask_model(prompt, cfg, 'summary')
            m = re.search(r'\{.*\}', out, re.S)
            if not m:  # (a model that wandered off, say into a tool call: the last summary stays)
                raise ValueError(f'不是 JSON：{out.strip()[:80]}')
            r = json.loads(m.group(0))
            need = str(r.get('needs_you') or '').strip()
            if NONE.match(need):
                need = ''  # (a model that says "nothing needed" in words)
            self.data[s['id']] = {'title': str(r.get('title') or '')[:24], 'summary': str(r.get('summary') or '')[:120],
                                  'status': r.get('status') or '', 'needs_you': need[:200], 'at': time.time(), 'basis': basis}
            self.note_decisions(s, r.get('decisions') or [])
            self.error = ''
            os.makedirs(CACHE, exist_ok=True)
            A.put(self.file, self.data)
        except Exception as e:
            self.error = f'{type(e).__name__}: {e}'[:300]
            self.data.setdefault(s['id'], {})['at'] = time.time()  # (do not hammer a failing model)
        finally:
            self.busy = None

    def note_decisions(self, s, found):
        """Keep each decision once (the same excerpt is read again on the next summary)."""
        key = lambda t: re.sub(r'\W+', '', t).lower()
        have = {(d['sid'], key(d['what'])) for d in self.decisions}
        added = False
        for d in found[:6]:
            what = str((d or {}).get('what') or '').strip()[:80]
            if not what or (s['id'], key(what)) in have:
                continue
            self.decisions.append({'sid': s['id'], 'name': s['name'], 'what': what, 'by': 'user' if (d or {}).get('by') == 'user' else 'agent', 'at': time.time()})
            have.add((s['id'], key(what)))
            added = True
        if added:
            self.decisions = self.decisions[-500:]
            A.put(self.dfile, self.decisions)


REPORT = '''你在给一位开发者写某个 AI 编码会话的简报（{kind}，名字 {name}，目录 {cwd}）。他同时开着很多会话，靠这份简报想起：
