                     'at': k.get('at') or 0, 'spaced': bool(k.get('spaced')), 'pinned': bool(k.get('pinned')), 'archived': bool(k.get('archived')), 'live': lid, 'conv': conv, 'wt': bool(k.get('wt')),
                     'model': meta.get('model') or {},
                     'terms': [{'n': t['n'], 'mux': t.get('mux') or '', 'grp': (t.get('grp') or '').removeprefix('tmux:'), 'pane': t.get('pane') or '',
                                'origin': t.get('origin') or '', 'began': t.get('began') or 0, 'ended': t.get('ended'), 'why': t.get('why') or '',
                                'words': t.get('words') or ''} for t in k.get('terms') or []],
                     'segs': [{'n': x['n'], 'kind': x.get('kind') or '', 'how': x.get('how') or ''} for x in k.get('segs') or []]}}


def tilde(p):
    """A folder as a person writes it: the home folder as ~."""
    h = os.path.expanduser('~')
    return '~' + p[len(h):] if p == h or p.startswith(h + '/') else p


def phone_prompt(deck, s):
    """The id of the prompt a session is stopped at, as a phone is shown it ('' at none), or '?' while its records this
    moment differ from the last look round (it is changing): keys from a phone go only to the prompt it saw."""
    reg, raw = phone_now(s)
    waits = (reg.get('status') == 'waiting') if reg else raw.get('state') == 'waiting'
    if not at_menu(s):
        return '?' if waits else ''
    if s['kind'] == 'claude' and ((raw.get('asking') or {}) != (s.get('asking') or {}) or (reg and not waits)):
        return '?'
    with deck.lock:
        groups = dict(deck.state.get('groups') or {})
    it = next(iter(phone_items([s], groups=groups)), None)
    return it['id'] if it else ''


def app_state(deck, after, wait):
    """app_view as soon as it differs from the one the phone has (`after`), or after `wait` seconds as it is."""
    end = time.time() + max(0, min(25, wait))
    while True:
        v = app_view(deck)
        left = end - time.time()
        if v['rev'] != after or left <= 0:
            return v
        with deck.changed:
            deck.changed.wait(min(left, 5))


