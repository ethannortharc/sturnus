PROMPT = '''你在为一位开发者的「会话总览」写状态。下面是一个 AI 编码会话（{kind}，名字 {name}，目录 {cwd}）最近的对话片段，最后几行最新。
只输出一行 JSON，不要别的：{{"title": "...", "summary": "...", "status": "...", "needs_you": "...", "ask_quote": "...", "resolved": [], "decisions": [{{"what": "...", "by": "..."}}]}}
- title：不超过 14 个汉字的任务名，像给这件事起的标题（例如「发布 faw 0.8.2」「复现 Mantis 1349608」）。
- summary：不超过 40 个汉字。说清做到哪一步、下一步是什么。要具体（带上分支、功能、版本、文件等名字），不要空话。
- status：working（正在干活）、waiting_user（在等用户回答或拍板；这时 needs_you 必须写清要他做什么。在等别的会话、别人、CI 或合并的不算，用 working 或 idle）、review（做完了，等用户检查结果）、blocked（卡住或出错）、done（这件事做完了，不用再看）、idle（没有任务）之一。
- needs_you：只有当它在等用户决定、批准、回答、检查结果或亲手做某件事时（它一边接着干活一边等用户回答的也算），才用一句话说清要用户做什么、怎么做；否则必须是空字符串（不要写「无需…」「暂无」之类）。就是下面「还在等用户的事」里的某一条时，照抄那一条。
- ask_quote：needs_you 不为空时，从片段里原样摘出它向用户提出这件事的原话，不超过 300 字；否则空字符串。
- resolved：下面「还在等用户的事」里，片段显示用户已经回应过、或已经不再需要用户的那些的编号（数字）；看不出来就给空列表。
- decisions：片段里已经做出的决定（方案取舍、批准、范围、放弃什么），每条不超过 40 个汉字；by 是 user（用户定的）或 agent（它自己定的）。没有就给空列表。

还在等用户的事（编号：内容）：
{held}

用户已经点了「已处理」的事（不要再写进 needs_you，除非片段里在那之后又重新问起）：
{done}

片段：
{text}
'''
def ask_key(t):
    return re.sub(r'\W+', '', t or '').lower()


def alike(a, b):
    """Two wordings of the same thing asked of the person."""
    return difflib.SequenceMatcher(None, ask_key(a), ask_key(b)).ratio() > .75


def asked_in(a, text):
    """Whether an ask's question is still there in an excerpt of the conversation: its quoted words; without any, it was
    ticked off within the last few hours."""
    q = ask_key(a.get('quote'))[:60]
    return q in ask_key(text) if q else time.time() - (a.get('done') or 0) < 6 * 3600


NONE = re.compile(r'^(无需|不需要|暂无|没有需要|无$|无。|none|n/?a|nothing|no action)', re.I)


class Summaries:
    def __init__(self):
        self.file = os.path.join(CACHE, 'summaries.json')
        self.dfile = os.path.join(CACHE, 'decisions.json')
        self.data = A.get(self.file, {}) or {}
        self.decisions = A.get(self.dfile, []) or []
        self.afile = os.path.join(CACHE, 'asks.json')
        self.asks = A.get(self.afile, []) or []  # (what the sessions asked of the person, kept until it is answered)
        self.alock = threading.Lock()  # (the summaries' thread and the person's ticks both change it)
        self.error = ''
        self.busy = None

    def get(self, sid):
        return self.data.get(sid)

    def due(self, s, cfg):
        if s['state'] in ('gone', 'ended') and time.time() - (s.get('at') or 0) > 3600:
            return False
        path = transcript_of(s)
        basis = f'{os.path.getmtime(path):.0f}' if path and os.path.exists(path) else (s.get('said') or '')[:200]
        if not basis:
            return False
        cur = self.data.get(s['id'])
        if cur and cur.get('basis') == basis and 'title' in cur:  # (one from before titles is made again once)
            return False
        # (anew when it changed: at most every so often while it works, soon once it stops)
        every = cfg['summarizer']['every_working'] if s['state'] == 'working' else cfg['summarizer']['every_other']
        if cur and time.time() - cur.get('at', 0) < every:
            return False
        return basis

    def make(self, s, basis, cfg):
        path = transcript_of(s)
        lines = recent(path) if path else []
        if not lines and s.get('said'):
            lines = [f'助手: {s["said"]}']
        if not lines:  # (nothing to read yet: noted, or it stays due and no other session, report or task list gets a turn)
            self.data.setdefault(s['id'], {'title': ''}).update(basis=basis, at=time.time())
            return
        held, text = self.open_asks(s['id']), '\n'.join(lines)
        done = [a for a in self.asks if a['sid'] == s['id'] and a.get('by') == 'user'][-5:]
        prompt = PROMPT.format(kind=s['kind'], name=s['name'], cwd=s.get('cwd') or '?', text=text,
                               held='\n'.join(f'{i}：{a["what"]}' for i, a in enumerate(held, 1)) or '（没有）',
                               done='\n'.join(f'- {a["what"]}' for a in done) or '（没有）')
        self.busy = s['id']
        try:
            out = ask_model(prompt, cfg, 'summary')
            m = re.search(r'\{.*\}', out, re.S)
            if not m:  # (a model that wandered off, say into a tool call: the last summary stays)
                raise ValueError(tx(f'不是 JSON：{out.strip()[:80]}', f'Not JSON: {out.strip()[:80]}'))
            r = json.loads(m.group(0))
            need, status = str(r.get('needs_you') or '').strip(), r.get('status') or ''
            if NONE.match(need):
                need = ''  # (a model that says "nothing needed" in words)
            with self.alock:  # (the person's ticks change the asks and this summary too)
                if not self.note_asks(s, need[:200], str(r.get('ask_quote') or ''), r.get('resolved'), held, text):
                    need, status = '', '' if status == 'waiting_user' else status  # (what the person ticked off, read again)
                self.data[s['id']] = {'title': str(r.get('title') or '')[:24], 'summary': str(r.get('summary') or '')[:120],
                                      'status': status, 'needs_you': need[:200], 'at': time.time(), 'basis': basis}
                os.makedirs(CACHE, exist_ok=True)
                A.put(self.file, self.data)
            self.note_decisions(s, r.get('decisions') or [])
            self.error = ''
        except Exception as e:
            self.error = f'{type(e).__name__}: {e}'[:300]
            self.data.setdefault(s['id'], {})['at'] = time.time()  # (do not hammer a failing model)
        finally:
            self.busy = None

    def open_asks(self, sid):
        return [a for a in self.asks if a['sid'] == sid and not a.get('done')]

    def note_asks(self, s, need, quote, resolved, held, text):
        """Keep each thing a session asks of the person until the person has answered it (as a later summary sees) or
        ticks it off: a session that works on scrolls its question out of the excerpt the summaries read. False when
        the need is one the person ticked off whose question is still there in the excerpt: no new ask. (Under alock.)"""
        now, changed, stands = time.time(), False, True
        for i in resolved if isinstance(resolved, list) else []:
            i = int(i) if str(i).strip().isdigit() else 0
            if 1 <= i <= len(held) and not held[i - 1].get('done'):
                held[i - 1].update(done=now, by='seen')
                changed = True
        same = next((a for a in held if not a.get('done') and alike(a['what'], need)), None) if need else None
        seen = not same and need and next((a for a in self.asks if a['sid'] == s['id'] and a.get('by') == 'user' and a.get('done')
                                           and asked_in(a, text) and (alike(a['what'], need) or quote and alike(a.get('quote'), quote))), None)
        if same and quote and not same.get('quote'):
            same['quote'], changed = quote.strip()[:400], True
        elif seen:
            stands = False
        elif need and not same:
            self.asks.append({'id': secrets.token_hex(6), 'sid': s['id'], 'name': s['name'], 'what': need, 'quote': quote.strip()[:400], 'at': now})
            changed = True
        if changed:
            self.save_asks()
        return stands

    def ask_done(self, aid):
        with self.alock:
            a = next((a for a in self.asks if a['id'] == aid and not a.get('done')), None)
            if not a:
                return False, tx('这件已经处理过了', 'This one is already handled')
            a.update(done=time.time(), by='user')
            self.save_asks()
        return True, {}

    def ticked(self, sid, since):
        """What the person ticked off of a session's asks since a time (its last summary's)."""
        return [a for a in self.asks if a['sid'] == sid and a.get('by') == 'user' and (a.get('done') or 0) > since]

    def save_asks(self):
        now = time.time()
        self.asks = [a for a in self.asks if now - (a.get('done') or a['at']) < 7 * DAY][-300:]  # (a week on, handled or not, it goes)
        os.makedirs(CACHE, exist_ok=True)
        A.put(self.afile, self.asks)

    def note_decisions(self, s, found):
        """Keep each decision once (the same excerpt is read again on the next summary)."""
        key = lambda t: re.sub(r'\W+', '', t).lower()
        have = {(d['sid'], key(d['what'])) for d in self.decisions}
        added = False
        for d in found[:6]:
            what = str((d or {}).get('what') or '').strip()[:80]
            if not what or (s['id'], key(what)) in have:
                continue
            self.decisions.append({'sid': s['id'], 'name': s['name'], 'what': what, 'by': 'user' if (d or {}).get('by') == 'user' else 'agent', 'at': time.time()})
            have.add((s['id'], key(what)))
            added = True
        if added:
            self.decisions = self.decisions[-500:]
            A.put(self.dfile, self.decisions)


REPORT = '''你在给一位开发者写某个 AI 编码会话的简报（{kind}，名字 {name}，目录 {cwd}）。他同时开着很多会话，靠这份简报想起：
