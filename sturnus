def ws_read(rfile):
    """One message from the browser as (opcode, bytes); None once it has gone."""
    data, op = b'', 0
    while True:
        h = rfile.read(2)
        if len(h) < 2:
            return None
        n = h[1] & 0x7F
        if n == 126:
            n = struct.unpack('>H', rfile.read(2))[0]
        elif n == 127:
            n = struct.unpack('>Q', rfile.read(8))[0]
        mask = rfile.read(4) if h[1] & 0x80 else b''
        b = rfile.read(n)
        if mask and n:  # (a browser masks what it sends)
            b = (int.from_bytes(b, 'big') ^ int.from_bytes((mask * (n // 4 + 1))[:n], 'big')).to_bytes(n, 'big')
        code = h[0] & 0x0F
        if code == 8:
            return None
        if code >= 8:  # (ping, pong: answered or let go, between the pieces of a message)
            return code, b
        op = op or code
        data += b
        if h[0] & 0x80:
            return op, data


def ws_send(sock, op, data):
    n = len(data)
    head = bytes([0x80 | op]) + (bytes([n]) if n < 126 else bytes([126]) + struct.pack('>H', n) if n < 65536 else bytes([127]) + struct.pack('>Q', n))
    sock.sendall(head + data)


def term_bridge(rfile, conn, loc, cols, rows):
    """The pseudo-terminal and the websocket, joined both ways; the browser sends keys as binary, its size as text."""
    before = clients_of(loc['session']) if loc['mux'] == 'zellij' and loc.get('pane') else None
    env = {k: v for k, v in os.environ.items() if not k.startswith(('TMUX', 'ZELLIJ'))}
    env.update(TERM='xterm-256color', COLORTERM='truecolor', STURNUS_TERM='1')
    argv = term_argv(loc)
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.execvpe(argv[0], argv, env)
        finally:
            os._exit(127)
    resize = lambda c, r: fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', r, c, 0, 0))
    resize(cols, rows)
    if before is not None:  # (Zellij puts a new client where its first client stands: this one, alone, onto the pane)
        threading.Thread(target=zellij_bring, args=(loc, before), daemon=True).start()
    lock = threading.Lock()

    def out():
        try:
            while True:
                b = os.read(fd, 65536)
                if not b:
                    break
                with lock:
                    ws_send(conn, 2, b)
        except OSError:
            pass
        try:
            with lock:
                ws_send(conn, 8, b'')
            conn.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
    threading.Thread(target=out, daemon=True).start()
    try:
        while (m := ws_read(rfile)) is not None:
            op, data = m
            if op == 2:
                os.write(fd, data)
            elif op == 1:
                c = json.loads(data)
                resize(int(c['cols']), int(c['rows']))
            elif op == 9:
                with lock:
                    ws_send(conn, 10, data)
    except (OSError, ValueError, KeyError, TypeError):
        pass
    finally:
        try:
            os.kill(pid, signal.SIGHUP)
        except OSError:
            pass
        os.close(fd)
        threading.Thread(target=os.waitpid, args=(pid, 0), daemon=True).start()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def end_headers(self):
        self.send_header('X-Frame-Options', 'SAMEORIGIN')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        super().end_headers()

    def send_json(self, obj, code=200, cookie=None):
        data = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Cache-Control', 'no-store')
        for c in [cookie] if isinstance(cookie, str) else cookie or []:
            self.send_header('Set-Cookie', c)
        self.end_headers()
        self.wfile.write(data)

    def cookie(self, name):
        m = re.search(rf'(?:^|;\s*){name}=([^;]+)', self.headers.get('Cookie') or '')
        return m.group(1) if m else ''

    def who(self):
        """'本机'; or, from the tailnet (straight to this machine's Tailscale address, or through tailscale serve), the
        owner's own devices only; None for anyone else. A request must also name this machine (no DNS rebinding)."""
        host = (self.headers.get('X-Forwarded-Host') or self.headers.get('Host') or '').rsplit(':', 1)[0].strip('[]').lower()
        login, peer = self.headers.get('Tailscale-User-Login'), self.client_address[0]
        name, owner = tailnet_self()
        self.https = False
        if peer in ('127.0.0.1', '::1'):
            # (tailscale serve also comes from here, with X-Forwarded-*: a peer it gives no login, a tagged machine or a
            # Funnel visitor, could name localhost as its host, and is not this machine)
            proxied = any(self.headers.get(h) for h in ('X-Forwarded-For', 'X-Forwarded-Host', 'X-Forwarded-Proto'))
            if host in ('127.0.0.1', 'localhost', '::1') and not login and not proxied:
                return '本机'
            if name and host == name and owner and login == owner:  # (tailscale serve: it sets the login itself)
                self.https = True
                return f'{self.headers.get("X-Forwarded-For") or "tailnet"}（{owner}）'
            return None
        names = {name, (name or '').split('.')[0], *(_tailnet.get('ips') or [])} - {None, ''}
        who = tailnet_login(peer)
        if host in names and who and owner and who[0] == owner:  # (only the owner's own devices, not ones shared in)
            return f'{who[1] or peer}（{peer}）'
        return None

    def gate(self):
        """True when the request may go on; otherwise it has been answered."""
        self.via = self.who()
        if self.via is None:
            self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
            return False
        bare = self.path.split('?')[0]
        auth = self.headers.get('Authorization') or ''
        if (ACCESS_.check(self.cookie('deck')) or (auth.startswith('Bearer ') and ACCESS_.device(auth[7:].strip()))
                or (self.command == 'GET' and OPEN.match(bare)) or (self.command == 'POST' and bare in ('/api/login', '/api/app/pair'))):
            return True
        if self.command == 'GET' and bare in ('/', '/index.html'):
            self.static('login.html')
            return False
        self.send_json({'ok': False, 'msg': tx('要先登录', 'Sign in first'), 'login': True}, 401)
        return False

    def static(self, name):
        f = os.path.join(APP, 'web', name)
        if not STATIC.match(name) or not os.path.isfile(f):
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header('Content-Type', TYPES.get(os.path.splitext(f)[1], 'application/octet-stream'))
        self.send_header('Cache-Control', 'max-age=31536000, immutable' if name.startswith('fonts/') else 'no-cache')
        self.end_headers()
        with open(f, 'rb') as h:
            self.wfile.write(h.read())

    def term(self):
        """The agent's terminal in the browser: a websocket to a client of its group run in a pseudo-terminal."""
        from urllib.parse import urlparse, parse_qs
        q = parse_qs(urlparse(self.path).query)
        arg = lambda k: (q.get(k) or [''])[0]
        if arg('id'):
            loc = (DECK.find(arg('id')) or {}).get('loc')
        else:  # (a group, at a pane of it or wherever it stands)
            g, z = arg('group'), DECK.state['groups'].get(arg('group'))
            pane = arg('pane') if re.fullmatch(r'%\d+' if (z or {}).get('mux') == 'tmux' else r'\d+', arg('pane')) else None
            loc = z and {'mux': z['mux'], 'session': g, 'pane': pane, 'sock': z.get('sock')}
        host = (self.headers.get('X-Forwarded-Host') or self.headers.get('Host') or '').rsplit(':', 1)[0]
        origin = urlparse(self.headers.get('Origin') or '').hostname or ''
        if (self.headers.get('Upgrade') or '').lower() != 'websocket' or not self.headers.get('Sec-WebSocket-Key') or origin != host.strip('[]'):
            return self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
        if not loc:
            return self.send_json({'ok': False, 'msg': tx('不在 Zellij 或 tmux 里', 'Not in Zellij or tmux')}, 404)
        room = None
        if loc['mux'] == 'zellij':
            with ROOM:
                room = zellij_room(loc['session'])
        accept = base64.b64encode(hashlib.sha1((self.headers['Sec-WebSocket-Key'] + WS_GUID).encode()).digest()).decode()
        self.wfile.write(f'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n'.encode())
        self.wfile.flush()
        self.close_connection = True
        if room and not room['ok']:  # (one more client would take the server down: the page says why, from close code 4001)
            ws_send(self.connection, 8, struct.pack('>H', 4001) + json.dumps({k: room[k] for k in ('held', 'limit', 'need')}).encode())
            # (then wait for the browser's own close: closing on frames it already sent would reset the connection, and
            # the close frame could be lost with it)
            self.connection.settimeout(1)
            try:
                while (m := ws_read(self.rfile)) is not None and m[0] != 8:
                    pass
            except (OSError, ValueError):
                pass
            return
        size = lambda k, d: max(10, min(1000, int((q.get(k) or [d])[0]) if str((q.get(k) or [d])[0]).isdigit() else d))
        term_bridge(self.rfile, self.connection, loc, size('cols', 120), size('rows', 36))

    def do_GET(self):
        if not self.gate():
            return
        if self.path.startswith('/api/term'):
            return self.term()
        if self.path.startswith('/api/state'):
            with DECK.lock:
                return self.send_json(DECK.state)
        if self.path.startswith('/api/screen'):  # (a pane as it looks now, read only: the phone's terminal tab)
            from urllib.parse import urlparse, parse_qs
            s = DECK.find((parse_qs(urlparse(self.path).query).get('id') or [''])[0])
            loc = s and s.get('loc')
            if not loc or not loc.get('pane'):
                return self.send_json({'ok': False, 'msg': tx('它不在 Zellij 或 tmux 的窗格里', 'It is in no Zellij or tmux pane')}, 404)
            ok, text, cols = pane_screen(loc)
            return self.send_json({'ok': ok, 'text': text[-200000:], 'cols': cols, **({} if ok else {'msg': tx('读不到它的窗格', 'Its pane could not be read')})})
        if self.path.startswith('/api/app/state'):  # (the Sturnus phone app: news from this machine, as soon as there is some)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            wait = (q.get('wait') or ['0'])[0]
            _REQ.lang = 'en' if self.headers.get('X-Lang') == 'en' else 'zh'
            try:
                return self.send_json(app_state(DECK, (q.get('after') or [''])[0], int(wait) if wait.isdigit() else 0))
            finally:
                _REQ.lang = None
        if self.path.startswith('/api/app/session'):  # (one session's page on the phone: its asks, report, tasks, sub-agents, messages)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            kid = (q.get('kept') or [''])[0]  # (a session that lasts: by its own id, running or not)
            v = app_kept_page(DECK, kid) if kid else app_session(DECK, (q.get('id') or [''])[0])
            return self.send_json(v or {'ok': False, 'msg': tx('这个会话已经不在了', 'That session is gone')}, 200 if v else 404)
        if self.path.split('?')[0] in ('/api/phone/summary', '/api/phone/inbox'):  # (Columba, the iPhone app)
            _REQ.lang = 'en' if self.headers.get('X-Lang') == 'en' else 'zh'
            try:
                return self.send_json(phone_view(DECK, self.path.split('?')[0].rsplit('/', 1)[-1]))
            finally:
                _REQ.lang = None
        if self.path.startswith('/api/board'):  # (a channel: its posts, discussions, who is on it)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            key, topic = (q.get('key') or [''])[0], (q.get('topic') or [''])[0]
            meta = A.channels().get(key)
            if not meta:
                return self.send_json({'meta': None, 'posts': [], 'topics': [], 'members': []})
            ts, tp = A.topics(key), A.topic_get(key, topic)
            return self.send_json({'meta': meta, 'posts': A.topic_posts(key, tp) if tp else A.posts(key, limit=400),
                                   'topics': [{**t, 'n': A.topic_n(key, t)} for t in ts], 'members': [m for m in A.members(key) if m != ME_NAME]})
        if self.path.startswith('/api/story'):  # (a session's timeline and decisions by topic; asked for when it has none yet)
            from urllib.parse import urlparse, parse_qs
            sid = (parse_qs(urlparse(self.path).query).get('id') or [''])[0]
            if sid not in DECK.stories.data and DECK.find(sid):
                DECK.stories.asked.add(sid)
            return self.send_json(DECK.stories.view(sid))
        if self.path.startswith('/api/digest'):  # (a workspace's dashboard is open: its overview is kept up to date meanwhile)
            from urllib.parse import urlparse, parse_qs
            key = (parse_qs(urlparse(self.path).query).get('ws') or [''])[0]
            if any(w['key'] == key for w in DECK.state.get('workspaces') or []):
                DECK.digests.wanted[key] = time.time()
            return self.send_json({'ok': True})
        if self.path.startswith('/api/tasks'):  # (all of them, the long-ended too, or those that mention something)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            one = lambda k: (q.get(k) or [''])[0]
            return self.send_json(DECK.tasks_find(one('q'), one('scope'), True if one('closed') else False, bool(one('archived'))))
        if self.path.startswith('/api/task'):
            from urllib.parse import urlparse, parse_qs
            try:
                return self.send_json({'ok': True, 'task': DECK.task_view((parse_qs(urlparse(self.path).query).get('id') or [''])[0])})
            except ValueError as e:
                return self.send_json({'ok': False, 'msg': str(e)}, 404)
        if self.path.startswith('/api/kept'):  # (one session that lasts, with its conversations and terminals; or all of them, the archived too)
            from urllib.parse import urlparse, parse_qs
            kid = (parse_qs(urlparse(self.path).query).get('id') or [''])[0]
            if not kid:
                return self.send_json({'ok': True, 'kept': list(DECK.kept.values())})
            v = DECK.kept_page(kid)
            return self.send_json(v or {'ok': False, 'msg': tx('找不到这条会话', 'Session not found')}, 200 if v else 404)
        if self.path.startswith('/api/diff'):  # (what a session has changed in its folder; with a file, that file's diff)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            k = DECK.book.get((q.get('kept') or [''])[0])
            v = k and changes(k['wt'] if k['wt'] and os.path.isdir(k['wt']) else k['work'] if k['work'] and os.path.isdir(k['work']) else k['folder'], (q.get('file') or [''])[0])
            if v and 'top' in v:  # (its to merge and clear away: only the worktree sturnus made for it)
                v['own'] = bool(k['wt']) and os.path.realpath(k['wt']) == v['top']
            return self.send_json({'ok': bool(v), **(v or {'msg': tx('它的目录不在 git 仓库里', 'Its folder is in no git repository') if k else tx('找不到这条会话', 'Session not found')})})
        if self.path.startswith('/api/search'):  # (where something was said, in any session's conversations)
            from urllib.parse import urlparse, parse_qs
            return self.send_json({'ok': True, 'hits': DECK.search((parse_qs(urlparse(self.path).query).get('q') or [''])[0].strip())})
        if self.path.startswith('/api/pic?'):  # (one picture of a session's conversation, by where it is in the record)
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            try:
                got = DECK.kept_pic(q['kept'][0], int(q['seg'][0]), int(q['n'][0]), int((q.get('i') or ['0'])[0]), (q.get('h') or [''])[0])
            except (KeyError, ValueError, sqlite3.Error):
                got = None
            if not got:
                return self.send_json({'ok': False, 'msg': tx('这张图片已经不在了', 'This picture is no longer there')}, 404)
            self.send_response(200)
            self.send_header('Content-Type', PIC_TYPES[got[0]])
            self.send_header('Content-Length', str(len(got[1])))
            self.send_header('Cache-Control', 'private, max-age=31536000, immutable')  # (its address carries its digest: it never changes)
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Content-Security-Policy', "default-src 'none'")
            try:
                self.end_headers()
                self.wfile.write(got[1])
            except (BrokenPipeError, ConnectionResetError):
                pass  # (the page went on to something else before it had all of it)
            return
        if self.path.startswith('/api/transcript'):
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            sid, sub = (q.get('id') or [''])[0], (q.get('sub') or [''])[0]
            if (q.get('kept') or [''])[0]:  # (a session that lasts: all its conversations, one after another; N of them, the last 200 unless more are asked for)
                try:
                    n = int((q.get('n') or ['200'])[0])
                except ValueError:
                    n = 200
                items, more = DECK.kept_said(q['kept'][0], n)
                # (the page that shows it asks every second or so while it works: what it already has is not sent again)
                sig = hashlib.sha1(json.dumps([len(items)] + [[i.get('seg'), i.get('at'), i.get('who'), len(i.get('text') or ''), len(i.get('pics') or [])] for i in items[-4:]]).encode()).hexdigest()[:16]
                if (q.get('have') or [''])[0] == sig:
                    return self.send_json({'same': True, 'sig': sig, 'more': more})
                return self.send_json({'items': items, 'sig': sig, 'more': more})
            s = DECK.find(sid)
            path = transcript_of(s) if s else None
            if path and sub:  # (one of its sub-agents' conversations, from beside its own)
                f = os.path.join(path[:-6], 'subagents', f'agent-{sub}.jsonl') if SUB.fullmatch(sub) and path.endswith('.jsonl') else None
                path = f if f and os.path.exists(f) else None
            # (a session that lasts is read from its record, as its own page reads it: the pictures are there)
            kid = None if sub or not s else next((k for k, v in dict(getattr(DECK, 'kept', None) or {}).items() if v.get('live') == s['id']), None)
            if kid:
                try:
                    return self.send_json({'items': DECK.kept_items(kid, 120), 'kept': kid})
                except (sqlite3.Error, OSError):
                    pass
            return self.send_json({'items': transcript_items(path) if path else []})
        bare = self.path.split('?')[0].split('#')[0]
        self.static('index.html' if bare in ('/', '/index.html') else bare.lstrip('/'))

    def do_POST(self):
        _REQ.lang = 'en' if self.headers.get('X-Lang') == 'en' else 'zh'
        try:
            return self._post()
        finally:
            _REQ.lang = None

    def _post(self):
        if not self.gate():
            return
        # (only this page: a cross-site form cannot set this header)
        if self.headers.get('X-Deck') != '1':
            return self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
        # (everything below goes by the path without its query: the gate let it in by that path, and a query such as
        # "/api/login?/say" must not reach another action than the one let in)
        bare = self.path.split('?')[0].split('#')[0]
        if bare == '/api/stt':  # (a recording, as it is: to text)
            n = int(self.headers.get('Content-Length') or 0)
            v = voice_cfg(DECK.cfg)
            if not v['on']:
                return self.send_json({'ok': False, 'msg': tx('语音输入没开：设置 → 语音输入', 'Voice input is off: Settings → Voice input')})
            if not 0 < n <= 25 * 1024 * 1024:
                return self.send_json({'ok': False, 'msg': tx('录音太长了（最多 25 MB）', 'The recording is too long (25 MB at most)') if n else tx('没录到声音', 'No sound recorded')})
            audio = self.rfile.read(n)
            try:
                return self.send_json({'ok': True, 'via': voice_label(v), 'text': transcribe(audio, self.headers.get('Content-Type') or 'audio/webm', v, voice_key(v['provider'])).strip()})
            except Exception as e:
                return self.send_json({'ok': False, 'msg': tx(f'没转成文字：{e}', f'Could not turn it into text: {e}')[:300]})
        try:
            body = json.loads(self.rfile.read(int(self.headers.get('Content-Length') or 0)) or b'{}')
        except ValueError:
            body = {}
        if bare.startswith('/api/phone/actions/'):  # (an answer from a phone app, to the item it showed)
            code, msg = phone_answer(DECK, bare.rsplit('/', 1)[-1], str(body.get('choice') or ''), str(body.get('text') or ''))
            if code == 200:
                DECK.note(tx(f'手机上：{msg}', f'From the phone: {msg}'))
            return self.send_json({'ok': code == 200, 'msg': msg}, code)
        if bare == '/api/app/pair':  # (a phone with a pairing code: its own key from now on)
            key, msg = ACCESS_.pair(str(body.get('code') or ''), str(body.get('device') or ''), self.via)
            if not key:
                return self.send_json({'ok': False, 'msg': msg}, 401)
            DECK.note(tx(f'手机 App 配对了：{body.get("device") or "iPhone"}（{self.via}）', f'Phone app paired: {body.get("device") or "iPhone"} ({self.via})'), True)
            return self.send_json({'ok': True, 'key': key, 'machine': app_view(DECK)['machine']})
        if not bare.startswith('/api/') or bare.count('/') != 2:
            return self.send_json({'ok': False, 'msg': 'not found'}, 404)
        what = bare.rsplit('/', 1)[-1]
        secure = '; Secure' if self.https else ''  # (plain http on the tailnet is WireGuard's; a Secure cookie needs https)
        if what == 'login':
            sid, msg = ACCESS_.login(str(body.get('token') or '').strip(), self.via)
            if not sid:
                return self.send_json({'ok': False, 'msg': msg}, 401)
            DECK.note(tx(f'新登录：{self.via}', f'New sign-in: {self.via}'), True)
            return self.send_json({'ok': True}, cookie=f'deck={sid}; HttpOnly; SameSite=Strict; Path=/; Max-Age={30 * DAY}{secure}')
        if what == 'access':  # (the signed-in browsers: list, sign one out, or this one)
            if not ACCESS_.check(self.cookie('deck')):  # (a browser's settings: a phone's key manages no access)
                return self.send_json({'ok': False, 'msg': 'forbidden'}, 403)
            mine = Access.key(self.cookie('deck'))
            if body.get('do') == 'pair':  # (a code for a phone, and the link a camera opens the app with)
                code = ACCESS_.pair_code()
                url, link = pair_link(DECK.cfg, code)
                return self.send_json({'ok': True, 'code': code, 'url': url, 'link': link, 'life': PAIR_LIFE,
                                       **({} if url else {'msg': tx('这台机器没连 Tailscale，手机够不着它', 'This machine is not on Tailscale, so a phone cannot reach it')})})
            if body.get('do') == 'drop':
                key = mine if body.get('key') == 'me' else str(body.get('key') or '')
                ACCESS_.drop(key)
                if key == mine:
                    return self.send_json({'ok': True}, cookie=f'deck=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0{secure}')
            return self.send_json({'ok': True, 'sessions': ACCESS_.listing(mine), 'devices': ACCESS_.devices(), 'local': f'http://127.0.0.1:{DECK.cfg["port"]}',
                                   'tailnet': tailnet_urls(DECK.cfg)})
        try:
            ok, msg = DECK.act(what, body)
        except Exception as e:
            ok, msg = False, repr(e)
        if isinstance(msg, dict):  # (an answer with data, not a line to show)
            return self.send_json({'ok': ok, **msg})
        DECK.note(msg, ok)
        self.send_json({'ok': ok, 'msg': msg})


def serve():
    global DECK
    DECK = Deck()
    try:
        DECK.collect()
    except Exception as e:  # (the loop keeps trying; the page says what went wrong)
        DECK.note(tx(f'收集出错：{e!r}', f'Collecting failed: {e!r}'), False)
    threading.Thread(target=DECK.loop, daemon=True).start()
    threading.Thread(target=DECK.summarize_loop, daemon=True).start()
    threading.Thread(target=DECK.queue_loop, daemon=True).start()
    threading.Thread(target=DECK.mind_loop, daemon=True).start()
    threading.Thread(target=DECK.projects.facts_loop, args=(DECK,), daemon=True).start()
    threading.Thread(target=DECK.index_loop, daemon=True).start()
    threading.Thread(target=DECK.keep_loop, daemon=True).start()
    threading.Thread(target=DECK.plan_loop, daemon=True).start()
    cfg = DECK.cfg
    global ACCESS_
    ACCESS_ = Access()
    srv = ThreadingHTTPServer((cfg['host'], int(cfg['port'])), Handler)
    print(f'sturnus {VERSION} on http://{cfg["host"]}:{cfg["port"]}', flush=True)
    if cfg.get('tailnet', True) and tailscale():
        threading.Thread(target=bind_tailnet, args=(int(cfg['port']),), daemon=True).start()
    srv.serve_forever()


