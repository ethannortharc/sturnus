    def model_from(self, b):
        role = b.get('role')
        if role not in ('summary', 'assist'):
            raise ValueError(tx('不认识的模型用途', 'Unknown model role'))
        src = b.get('source')
        if src not in SOURCES:
            raise ValueError(tx('选一个来源', 'Pick a source'))
        m = {'source': src, 'model': str(b.get('model') or '').strip()[:80]}
        if src == 'api':
            m['url'] = str(b.get('url') or '').strip()
            if not re.match(r'^https?://', m['url']):
                raise ValueError(tx('接口地址要以 http:// 或 https:// 开头', 'The API address must start with http:// or https://'))
            if not m['model']:
                raise ValueError(tx('填上模型名', 'Fill in the model name'))
            if b.get('key_env'):
                m['key_env'] = str(b['key_env']).strip()
        key = b.get('key')
        key = key if key and '…' not in key and key not in ('已设置', 'set') else None  # (the masked one shown back is not a new key)
        return role, m, key

