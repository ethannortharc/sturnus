CODEX_NOT_TUI = {'app-server', 'exec', 'e', 'review', 'queue', 'archive', 'unarchive', 'delete', 'mcp', 'login', 'logout',
                 'agents', 'plugin', 'debug', 'sandbox', 'apply', 'cloud', 'features', 'completion', 'doctor', 'update', 'fork',
                 'exec-server', 'migrate-rollouts', 'remote-control'}
# (options of the codex command that take a value: the word after one is its value, not what the command is asked to do)
CODEX_VALUED = {'-c', '--config', '-C', '--cd', '-m', '--model', '-p', '--profile', '-s', '--sandbox', '-a', '--ask-for-approval', '-i', '--image',
                '--add-dir', '--remote', '--enable', '--disable', '--local-provider', '--listen'}


def codex_asked(args):
    """What a codex command line asks for: its subcommand (exec, app-server, resume …), or None for the plain window
    (with or without a first ask). The value after an option that takes one is passed over: `codex -c x=1 exec-server`
    asks for exec-server."""
    skip = False
    for x in args[1:]:
        if skip:
            skip = False
        elif x in CODEX_VALUED:
            skip = True
        elif not x.startswith('-'):
            return x
    return None


def post_at(f):
    """When a channel's post was written, by its file's name (<at>-<id>.json); 0 for another file."""
    try:
        return float(f.split('-', 1)[0])
    except ValueError:
        return 0


class Deck:
    def __init__(self):
        os.makedirs(CACHE, exist_ok=True)  # (before anything keeps a file there: the first install's check builds a deck too)
        self.cfg = config()
        self.sums = Summaries()
        self.reports = Reports()
        self.stories = Stories()
        self.digests = Digests()
        self.origins = {}  # (pid -> how it was started: the process tree above it does not change)
        self.talk = Talk()
        self.state = {'sessions': [], 'talk': [], 'groups': {}, 'locks': [], 'at': 0}
        self.changed = threading.Condition()  # (told after every collect: the phone app's calls wait on it for news)
        self.events = deque(maxlen=50)
        self.titles = A.get(os.path.join(CACHE, 'titles.json'), {}) or {}
        self.failed = {}
        self.pending = {}
        self.launched = {}  # marker -> what was started from this page, until its session shows up
        self.everyone = []  # (all the sessions, the ended ones too; the state holds those on the page)
        self.linking = {}  # marker -> the task a session started from this page is for, until it is a session
        self.tasks_seen, self.tasks_kept, self.tidied = (0, []), 0, {}  # (the store as last read; when it was last trimmed; scope -> when tidied, what it had)
        self.tasks_lock, self.tasks_current, self.tasks_error = threading.Lock(), {}, ''  # (session name -> the task it touched last)
        self.qfile = os.path.join(CACHE, 'queue.json')
        self.queue = A.get(self.qfile, []) or []
        self._dirs, self._dirs_at = [], 0
        self.projects = Projects(self.cfg)
        self.chan_at, self.chan_seen, self.woke, self.boards_at = {}, {}, {}, {}  # (calling sessions in: how far each channel was read, the posts looked at, when each was woken; the page's view of the channels)
        self.names = {}  # (a session's id -> its name: a Claude session renamed takes its channel places along)
        self.born_at = {}  # (a session's id -> when it began: found once, so the column's order holds still)
        self.lock = threading.Lock()
        self.book = open_book()  # (the sessions that last, and their workspaces)
        self.kept, self.wants, self.items = {}, {}, {}  # (the sessions as the page lists them; (pid, when it started) -> the session it was started for; conversation file -> its items as last read)
        self.metas = {}  # (session -> (when read, its file as it was, the model it runs on): read again when the file has grown)
        self.keep_lock = threading.Lock()  # (one reader of a conversation file at a time: what it reads goes after what is there)
        self.recovered = self.book.meta('recover')  # (the restart whose sessions the person has already been offered)

    def began(self, s, born):
        """When a session began: its conversation's first timestamp, else its process's start, else when this deck first saw it."""
        if s['id'] not in self.born_at:
            p = transcript_of(s)
            self.born_at[s['id']] = (p and first_time(p)) or born.get(s.get('pid')) or time.time()
        return self.born_at[s['id']]

    def note(self, text, ok=True):
        self.events.appendleft({'at': time.time(), 'text': text, 'ok': ok})

    def collect(self):
        ps = procs()
        born = {p['pid']: p['start'] for p in ps}
        raw = A.board()
        rows = A.rows()
        reg = {s['name']: s for s in A.claude_sessions()}
        sessions = []
        for name, e in rows.items():
            if (e.get('cwd') or '').startswith(CACHE):
                continue  # (the deck's own model runs: a summary, a check, a draft)
            kind = e.get('kind') or '?'
            s = {'id': f'{kind}:{e.get("session") or name}', 'name': name, 'kind': kind, 'session': e.get('session'),
                 'state': e.get('state') or 'idle', 'since': e.get('since') or e.get('at') or 0, 'at': e.get('at') or 0,
                 'cwd': e.get('cwd'), 'tool': e.get('tool'), 'tool_at': e.get('tool_at'), 'tool_end': e.get('tool_end'), 'said': e.get('said'),
                 'unread': e.get('unread', 0), 'pid': e.get('pid'), 'transcript': e.get('transcript'), 'loc': place_from(e),
                 'parent': (e.get('parent') or {}).get('name'), 'parent_pid': (e.get('parent') or {}).get('pid'),
                 'from': place_from(e['from']) if isinstance(e.get('from'), dict) else None}  # (a headless run: the pane it was started from)
            r = raw.get(name) or {}
            listed = kind == 'claude' and name in reg  # (Claude Code's own registry says whether it waits: that is taken as it is)
            if r.get('state') == 'waiting' and (r.get('at') or 0) >= (s['at'] - 1) and not listed and s['state'] not in ('gone', 'ended'):
                s['state'] = 'waiting'
            if s['state'] == 'waiting' and r.get('state') == 'waiting':
                s['waiting_for'], s['asking'] = r.get('waiting_for'), r.get('asking')
            if listed:
                s['cc_status'], s['cc_since'] = reg[name].get('status'), (reg[name].get('statusUpdatedAt') or 0) / 1000
            s['prompting'] = s['state'] == 'waiting'  # (at a permission or choice prompt: typed text would answer it)
            # (the folder it was opened in: Claude Code's own record while it runs, else where its conversation began,
            # else the one amail saw first — Cursor's, its workspace; its hooks report the folder each command runs in)
            s['home'] = (reg[name].get('cwd') if kind == 'claude' and name in reg else None) \
                or (kind != 'cursor' and began_in(transcript_of(s))) or e.get('home') or s['cwd']
            if kind == 'claude' and name in reg:
                live = place_of(reg[name]['pid'])
                s['loc'], s['loc_live'] = live or s['loc'], bool(live)  # (a phone types only into a pane found now)
            if kind == 'codex':
                s['loc'] = None  # (set below, from the Codex window showing it)
            sessions.append(s)
        # Codex windows: the TUI processes, each showing one thread (by its resume id, else by its folder)
        tuis = []
        for p in ps:
            a = p['args']
            if p['comm'] != 'codex' or not a:
                continue
            if codex_asked(a) in CODEX_NOT_TUI or any('app-server' in x for x in a):
                continue
            loc, cwd = place_of(p['pid']), cwd_of(p['pid'])
            d = next((a[i + 1] for i, x in enumerate(a[:-1]) if x in ('-C', '--cd')), None) or next((x[5:] for x in a if x.startswith('--cd=')), None)
            if d and cwd:  # (codex -C <folder>: the thread's folder, not the shell's)
                cwd = os.path.normpath(os.path.join(cwd, os.path.expanduser(d)))
            resume = 'resume' in a
            tid = a[a.index('resume') + 1] if resume and a.index('resume') + 1 < len(a) and not a[a.index('resume') + 1].startswith('-') else None
            tuis.append({'pid': p['pid'], 'loc': loc, 'cwd': cwd, 'thread': tid, 'resume': resume, 'marker': env_of(p['pid'], 'STURNUS_NEW'), 'start': p['start']})
        codex = [s for s in sessions if s['kind'] == 'codex' and s['state'] not in ('gone', 'ended')]
        for s in codex:
            if codex_fileless(s):
                s['sub'] = tx('临时线程', 'short-lived thread')  # (the desktop app's own run: no session, and under no one's)
        codex_family(codex, lambda s: codex_meta(transcript_of(s) or ''))  # (sub-agent threads: with the thread that started them, not sessions of their own)
        # (a window shows a thread that has stirred since it opened; one opened with `codex resume` and no id, an older one
        # too: the person picks it there. A new window has none until its first message: Codex registers a thread then)
        # (a thread's folder: where it began, as its file's first line says; its hooks report each command's folder instead)
        home = lambda s: codex_meta(transcript_of(s) or '').get('cwd') or s['cwd']
        may_show = lambda t, s: home(s) == t['cwd'] and (t['resume'] and not t['thread'] or (s['at'] or 0) >= t['start'] - 5)
        shown = set()
        for t in sorted(tuis, key=lambda t: -t['start']):  # (the newest window first: a thread begun since it opened is its)
            hit = next((s for s in codex if t['thread'] and s['session'] == t['thread']), None)
            if not hit and t['loc']:  # (a window outside any multiplexer is known by its resume id only)
                same = [s for s in codex if may_show(t, s) and not s.get('loc') and not s.get('parent') and not s.get('sub')]
                hit = max(same, key=lambda s: (self.began(s, born) >= t['start'] - 5, s['at']), default=None)
            if hit:
                hit['loc'], hit['window_pid'] = t['loc'], t['pid']
                shown.add(t['pid'])
                want = self.pending.get(t['marker'])
                if want and hit['name'] != want:
                    ok, _ = self.rename(hit, want)
                    if ok:
                        self.pending.pop(t['marker'], None)
            else:  # (a live window whose session the hooks have not named yet: it is there all the same)
                th = codex_launch_thread(t['start'], t['cwd']) or (None, None)
                sessions.append(self.window('codex', t['pid'], t['loc'], t['start'], t['cwd'], *th))
        for s in codex:  # (a thread of a Codex window that no window shows now: quit, closed, or /new; Codex says nothing then)
            if s.get('window_pid') or s.get('parent') or s.get('sub') or s.get('from') or codex_meta(transcript_of(s) or '').get('originator') != 'codex-tui':
                continue
            if time.time() - (s['at'] or 0) > 120 and not any(t['pid'] not in shown and may_show(t, s) for t in tuis):
                s['state'] = 'gone'  # (not one that stirred in the last two minutes: a doubt costs a stray row for a while, not a page)
        # Cursor windows: the CLI runs as node (its comm "MainThread"), one per pane; matched to its hooks' session by pane
        seen_panes = set()
        for p in ps:
            a = p['args']
            if not a or not (a[0].endswith('/agent') or a[0].endswith('cursor-agent')) or any(x in ('-p', '--print', 'worker') for x in a):  # (a worker: the editor's, not a session)
                continue
            loc = place_of(p['pid'])
            key = (loc['session'], loc['pane']) if loc else p['pid']
            if key in seen_panes:
                continue
            seen_panes.add(key)
            hit = next((s for s in sessions if s['kind'] == 'cursor' and ((loc and s.get('loc') == loc) or s.get('pid') == p['pid']) and s['state'] not in ('gone', 'ended')), None)
            if hit:
                hit['window_pid'] = p['pid']  # (its hooks may not know its process: a run it starts names it as parent)
            else:
                chat = cursor_chat(p['pid'])
                sessions.append(self.window('cursor', p['pid'], loc, p['start'], cwd_of(p['pid']), chat, chat and chat.split('/')[-2]))
        now = time.time()
        for marker, l in list(self.launched.items()):  # (what this page started and is not a session yet: a card that says so)
            if now - l['at'] > 3600:
                self.launched.pop(marker)
                continue
            loc = marked(marker)
            if not loc and now - l['at'] > 20:
                self.launched.pop(marker)  # (it ended, or never came up)
                continue
            if loc and any((x.get('loc') or {}) == loc and not x.get('unknown') for x in sessions):
                self.launched.pop(marker)
                continue
            slow = now - l['at'] > 8
            sessions = [x for x in sessions if not (x.get('unknown') and x.get('loc') == loc)]
            card = {'id': f'new:{marker}', 'name': l['name'], 'kind': l['kind'], 'state': 'waiting' if slow else 'working',
                    'since': l['at'], 'at': now, 'cwd': l['cwd'], 'loc': loc, 'unknown': True, 'starting': True, 'kept': l.get('kept'),
                    'summary': tx('刚开起来，还没登记成会话', 'Just started, not registered as a session yet') if slow else tx('正在启动…', 'Starting…'),
                    'needs_you': tx('去它的窗格看一眼：多半在等你确认（比如是否信任这个目录）', 'Take a look at its pane: it is probably waiting for you to confirm (for example, whether to trust this folder)') if slow else ''}
            if slow and l['kind'] == 'codex' and any(t['marker'] == marker for t in tuis):  # (its window is up: Codex registers a thread at its first message)
                card.update(state='idle', needs_you='', summary=tx('开好了，等你说第一句话（Codex 收到第一句话才登记成会话；窗格里若在问是否信任这个目录，先在那里回答）',
                                                                   'Ready for your first message (Codex registers a session at its first message; if its pane asks whether to trust this folder, answer there first)'))
            sessions.append(card)
        for marker, l in list(self.linking.items()):  # (started to work on a task: once it is a session, that task's)
            x = next((x for x in sessions if x.get('loc') and x['loc'] == (l['loc'] or marked(marker)) and not x.get('unknown')), None)
            if x:
                A.task_do({'do': 'set', 'who': A.task_who(x['name']), 'id': l['task'], 'status': 'doing', 'session': {'name': x['name'], 'sid': x['id'], 'kind': x['kind']}})
            if x or now - l['at'] > 900:
                self.linking.pop(marker)
        loose = []
        for s in sessions:
            if not self.projects.attribute(s):
                loose.append(s)
            if s['kind'] == 'claude' and s['state'] not in ('gone', 'ended'):
                s['subs'] = subagents_of(s)
            was = self.names.get(s['id'])
            if was and was != s['name'] and not s.get('unknown'):
                A.move_member(was, s['name'])  # (renamed in its own CLI: its places on channels go with it)
            self.names[s['id']] = s['name']
        by_name = {s['name']: s for s in sessions}
        by_pid = {s['pid']: s for s in sessions if s.get('pid')}
        for s in sessions:
            if s.get('window_pid'):
                by_pid.setdefault(s['window_pid'], s)
        # (one opened outside any workspace — in the home folder, a scratch folder: in the workspace of the session that
        # started it, else the one most sessions opened in its group are in, rather than wherever it works now)
        placed, apart = {}, {id(x) for x in loose}
        for x in sessions:
            g = (x.get('loc') or {}).get('session')
            if g and id(x) not in apart and x.get('workspace'):
                placed.setdefault(g, Counter())[x['workspace']] += 1
        for s in loose:
            p = by_name.get(s.get('parent')) or by_pid.get(s.get('parent_pid'))
            g = placed.get((s.get('loc') or s.get('from') or {}).get('session'))
            wkey, how = (p['workspace'], 'parent') if p and p is not s and p.get('workspace') else (g.most_common(1)[0][0], 'group') if g else (None, None)
            if wkey and self.projects.wpaths.get(wkey):
                self.projects.settle(s, self.projects.wpaths[wkey], how)
        for s in sessions:
            s['born'] = self.began(s, born)
        def starter(s):  # (who started a headless run: the live session in the pane it was started from, started before it)
            if not s.get('from'):
                return None
            ref = born.get(s.get('pid')) or s.get('at') or 0  # (one that has ended: before its last word)
            return next((x for x in sessions if x is not s and not x.get('from') and x.get('loc') == s['from'] and x['state'] not in ('gone', 'ended')
                         and born.get(x.get('pid') or x.get('window_pid'), 0) <= ref), None)
        for s in sessions:
            if s.get('starting'):
                s['stale'] = s['hidden'] = False
                continue
            sm = self.sums.get(s['id']) or {}
            need = sm.get('needs_you') or ''
            if re.match(r'^(无需|不需要|暂无|没有需要|无$|无。|none|n/?a)', need, re.I):
                need = ''
            s['summary'], s['status'], s['needs_you'], s['summary_at'] = sm.get('summary'), sm.get('status'), need, sm.get('at')
            s['title'] = sm.get('title') or ''
            s['asks'] = [{k: a.get(k) for k in ('id', 'what', 'quote', 'at')} for a in self.sums.open_asks(s['id'])]
            ticked = (need or s['status'] == 'waiting_user') and self.sums.ticked(s['id'], sm.get('at') or 0)
            if ticked:  # (ticked off since its last summary: that waits on the person no more for it, nor at all with none left open)
                if need and (not s['asks'] or any(alike(a['what'], need) for a in ticked)):
                    s['needs_you'] = ''
                if s['status'] == 'waiting_user' and not s['asks']:
                    s['status'] = ''
            if s['status'] == 'waiting_user' and not s['needs_you'] and not s['asks']:
                s['status'] = ''  # (waiting on the person, a summary says, for nothing it names: nothing for them to do)
            if s['state'] == 'idle' and s['status'] == 'waiting_user' and sm.get('at', 0) >= s['at'] - 5:
                s['state'] = 'waiting'  # (it stopped on a question to the person)
            s['stale'] = s['state'] != 'working' and now - (s['at'] or s['since'] or 0) > 24 * 3600  # (a day without a stir: out of the way, still there to open)
            s['hidden'] = s['state'] in ('gone', 'ended')  # (a session that has exited leaves the page)
            p = by_name.get(s.get('parent')) or by_pid.get(s.get('parent_pid')) or starter(s)
            if s.get('sub') and not s['title']:
                s['title'] = s['sub']  # (a sub-agent has no summary of its own to name it: what its starter called it)
            if p and p is not s:
                s['parent'] = p['name']  # (started by another session: shown with it; when done, there for half an hour more)
                s['parent_id'], s['stale'] = p['id'], False
                s['hidden'] = s['hidden'] and now - (s['at'] or 0) > 1800
            elif s.get('sub'):
                s['hidden'] = True  # (a sub-agent whose starter is not here: no session of the person's, so not on the page)
            elif not s.get('loc') and not s['hidden'] and not s.get('starting'):
                s['origin'] = self.origins.get(s.get('pid')) or self.origins.setdefault(s.get('pid'), origin_of(s.get('pid')))
            if s['kind'] == 'claude' and s['state'] not in ('gone', 'ended'):
                p = transcript_of(s)
                if p:
                    self.talk.scan_claude(s['name'], p)
        try:
            self.first_spaces()
            self.bind(sessions, born, now)
        except (sqlite3.Error, OSError) as e:  # (the page still shows what runs; the sessions that last, as last known)
            self.note(tx(f'会话记录现在读写不了：{e}', f'The record of sessions cannot be read or written just now: {e}'), False)
        clients, tclients = zellij_clients(ps), TMUX.clients()
        zs = {}
        for n in zellij_sessions():
            zs[n] = {'name': n, 'mux': 'zellij', 'clients': [c for c in clients if c['session'] == n]}
        for n, sock in TMUX.sessions():
            zs[n] = {'name': n[5:], 'mux': 'tmux', 'sock': sock, 'clients': [c for c in tclients if c['session'] == n]}
        for n, z in zs.items():
            z['agents'] = len([s for s in sessions if (s.get('loc') or {}).get('session') == n and s['state'] not in ('gone', 'ended')])
        if now - getattr(self, '_dirs_at', 0) > 60:
            dirs = [s.get('home') or s['cwd'] for s in sorted(sessions, key=lambda s: -(s['at'] or 0)) if s.get('home') or s.get('cwd')]  # (where sessions were opened)
            dirs += sorted(d for d in glob.glob(os.path.expanduser('~/projects/*')) if os.path.isdir(d))
            home = os.path.expanduser('~')
            self._dirs = list(dict.fromkeys(d.replace(home, '~', 1) for d in dirs if os.path.isdir(d)))[:60]
            self._dirs_at = now
        locks = []
        d = os.path.join(A.HOME, 'locks')
        for f in glob.glob(os.path.join(d, '*.json')):
            l = A.get(f)
            if l:
                locks.append({**l, 'key': os.path.basename(f)[:-5]})
        self.all = sessions
        self.publish(sessions)
        workspaces, projects = self.layout(sessions)
        boards = self.boards_view()
        task_rows = self.tasks_tick(sessions)
        try:
            kept, spaces = self.kept_view(sessions)
            plans = self.book.plans()
        except (sqlite3.Error, OSError):
            kept, spaces, plans = self.state.get('kept') or [], self.state.get('spaces') or [], self.state.get('plans') or []
        with self.lock:
            self.everyone = sessions
            self.state = {'sessions': [s for s in sessions if not s['hidden']], 'talk': self.talk.all(), 'groups': zs, 'locks': locks,
                          'tasks': task_rows, 'kept': kept, 'spaces': spaces, 'recover': self.recover_view(kept), 'plans': plans,
                          'terminal': {'way': T.way(self.cfg).key, 'usable': [w.key for w in T.WAYS.values() if w.usable()],
                                       'rest_days': float(self.cfg.get('rest_days', DEFAULTS['rest_days']) or 0)},
                          'workspaces': workspaces, 'projects': projects, 'boards': boards,
                          'muxes': [m for m in ('zellij', 'tmux') if shutil.which(m)], 'voice': self.voice_view(),
                          'at': now, 'version': VERSION, 'summarizer': {'busy': self.sums.busy, 'error': self.sums.error},
                          'decisions': list(reversed(self.sums.decisions[-60:])), 'models': self.models_view(),
                          'queue': list(reversed(self.queue[-120:])),
                          'inbox': A.take(ME_NAME, peek=True), 'lock_issues': self.lock_issues(sessions, locks),
                          'reports': dict(sorted(((k, v) for k, v in self.reports.data.items() if v.get('r')), key=lambda kv: -kv[1]['at'])[:80]),
                          'reporting': sorted(self.reports.asked | ({self.reports.busy} if self.reports.busy else set())),
                          'topics': self.stories.latest(),
                          'stories': {k: [len(v.get('topics') or []), v.get('at'), v.get('left', 0), len(v.get('turns') or [])] for k, v in self.stories.data.items()},
                          'storying': sorted(self.stories.asked | ({self.stories.busy} if self.stories.busy else set())),
                          'digests': self.digests.view(), 'digest': {'busy': self.digests.busy, 'errors': dict(self.digests.errors)},
                          'events': list(self.events), 'pane_titles': self.cfg.get('pane_titles', True), 'me': ME_NAME, 'dirs': self._dirs,
                          'launch': self.cfg.get('launch', DEFAULTS['launch']), 'work_lang': self.cfg.get('work_lang') or 'zh',
                          'about': {'started': STARTED, 'app': APP, 'config': CONF, 'source': self.cfg.get('source'),
                                    'listen': f'{self.cfg["host"]}:{self.cfg["port"]}', 'model': model_label(self.cfg, 'summary'),
                                    'assist': model_label(self.cfg, 'assist'),
                                    'summaries': len(self.sums.data)}}
        with self.changed:
            self.changed.notify_all()
        if self.cfg.get('pane_titles', True):
            self.retitle(sessions, zs)

    def layout(self, sessions):
        """The workspaces (those with sessions on them, and the configured ones) with their projects; each project with
        its git facts, how many sessions work on it, when it last moved."""
        P, projects, wss = self.projects, {}, {}
        def entry(p):
            if p['key'] not in projects:
                projects[p['key']] = {'key': p['key'], 'name': p['name'], 'path': p['path'], 'git': p['git'], 'workspace': p['workspace'] and A.key_of('w', p['workspace']),
                                      'facts': P.facts.get(p['key']), 'live': 0, 'at': 0}
            return projects[p['key']]
        for w in P.workspace_paths():
            k = A.key_of('w', w)
            wss[k] = {'key': k, 'name': ws_name(w), 'path': w, 'projects': [], 'live': 0, 'groups': {}}
        for s in sessions:
            on = not s['hidden'] and not s.get('stale') and s['state'] not in ('gone', 'ended')
            p = P.known.get(s.get('project'))
            if p and not s['hidden']:
                e = entry(p)
                e['live'] += on
                e['at'] = max(e['at'], s.get('at') or 0)
            w = wss.get(s.get('workspace'))
            if w and on:
                w['live'] += 1
                if s.get('loc'):
                    w['groups'][s['loc']['session']] = w['groups'].get(s['loc']['session'], 0) + 1
        shown = [w for w in wss.values() if w['live'] or w['path'] in P.configured() or w['path'] in P.ever]
        for w in shown:
            for p in P.projects_in(w['path']):
                entry(p)
        for e in projects.values():
            f = e['facts'] or {}
            e['at'] = max([e['at']] + [x['at'] for x in f.get('works') or []])
            if e['workspace'] in wss:
                wss[e['workspace']]['projects'].append(e['key'])
        self.shown = set(projects)
        for w in shown:
            w['projects'].sort(key=lambda k: (-projects[k]['live'], -projects[k]['at']))
            w['groups'] = sorted(w['groups'], key=lambda g: -w['groups'][g])
            w['at'] = max([projects[k]['at'] for k in w['projects']] or [0])  # (when anything in it last moved)
        return sorted(shown, key=lambda w: (-w['live'], -w['at'], w['name'])), projects

    def boards_view(self):
        """Every channel as the page lists it: what is new for the person, the last post, its discussions, who is on it."""
        out = {}
        for k, meta in A.channels().items():
            d = os.path.join(A.HOME, 'channels', k)
            mt = lambda x: os.stat(os.path.join(d, x)).st_mtime if os.path.isdir(os.path.join(d, x)) else 0
            seen = (A.get(os.path.join(d, 'seen', f'{ME_NAME}.json')) or {}).get('at', 0)
            sig_ = (mt('posts'), mt('topics'), mt('seen'), seen)
            hit = self.boards_at.get(k)
            if hit and hit[0] == sig_:
                out[k] = hit[1]
                continue
            # (what is new for the person, by the files' names; only the newest 500 of them read: a channel holds 3000)
            names = sorted(f for f in os.listdir(os.path.join(d, 'posts')) if f.endswith('.json')) if mt('posts') else []
            after = [f for f in names if post_at(f) > seen]
            new = [p for p in (A.get(os.path.join(d, 'posts', f)) for f in after[-500:]) if A.good_post(p) and p.get('from') != ME_NAME]
            last = A.get(os.path.join(d, 'posts', names[-1])) if names else None  # (not `names and …`: an empty channel would send [] and break the page)
            v = {'key': k, 'name': meta.get('name') or k, 'kind': meta.get('kind') or 'project', 'path': meta.get('path'),
                 'unread': len(new) + max(0, len(after) - 500), 'calls': sum(A.calls(p, ME_NAME) for p in new),
                 'last': last and {'from': last.get('from'), 'kind': last.get('kind'), 'text': (last.get('text') or '')[:240], 'at': last.get('at'), 'topic': last.get('topic')},
                 'topics': [{**{k2: t.get(k2) for k2 in ('id', 'title', 'closed', 'members', 'at', 'max', 'by')}, 'n': A.topic_n(k, t)} for t in A.topics(k)[:30]],
                 'members': [m for m in A.members(k) if m != ME_NAME]}
            self.boards_at[k] = (sig_, v)
            out[k] = v
        return out

    @staticmethod
    def window(kind, pid, loc, start, cwd, transcript, session):
        """A window the hooks never saw (it opened before them): its conversation, if found, says what it does; busy
        while that is being written. Still 'unknown': no mail reaches it."""
        try:
            at = max(os.path.getmtime(p) for p in (transcript, transcript + '-wal') if os.path.exists(p))
        except (TypeError, ValueError):
            at = None
        now = time.time()
        said = last_said(transcript, at)
        where = f'{loc["session"].removeprefix("tmux:")}:{loc["pane"]}' if loc else f'pid {pid}'
        return {'id': f'{kind}-window:{pid}', 'name': f'{kind.capitalize()} · {where}', 'kind': kind, 'pid': pid,
                'state': 'working' if at and now - at < 20 else 'idle', 'since': at or start, 'at': now if at is None else at,
                'cwd': cwd, 'loc': loc, 'unknown': True, 'transcript': transcript, 'session': session, 'said': said}

    def retitle(self, sessions, zs):
        """Each agent's pane carries its name and what it is doing. Zellij runs a plugin only in a session a terminal is
        attached to; a pane two sessions share (one suspended under the other) shows the livelier one."""
        best = {}
        for s in sessions:
            loc = s.get('loc')
            if not loc or s['state'] in ('gone', 'ended') or s.get('unknown') or (loc['mux'] == 'zellij' and not (zs.get(loc['session']) or {}).get('clients')):
                continue
            key = f'{loc["session"]}:{loc["pane"]}'
            rank = (ORDER_RANK.get(s['state'], 9), s['stale'], -(s['at'] or 0))
            if key not in best or rank < best[key][0]:
                best[key] = (rank, s)
        changed = False
        now = time.time()
        for key, (_, s) in best.items():
            loc = s['loc']
            mark = {'working': '●', 'waiting': '◆', 'idle': '○'}.get(s['state'], '○')
            what = (s.get('summary') or '')[:28]
            title = f'{mark} {s["name"]}' + (f' · {what}' if what else '')
            if self.titles.get(key) == title or now < self.failed.get(key, 0):
                continue
            if TMUX.title(loc, title) if loc['mux'] == 'tmux' else plugin(loc['session'], f'rename {loc["pane"]} {title}').returncode == 0:
                self.titles[key] = title
                changed = True
            else:
                self.failed[key] = now + 120  # (try again in a while, not every pass)
        if changed:
            A.put(os.path.join(CACHE, 'titles.json'), self.titles)

    def loop(self):
        while True:
            try:
                self.collect()
            except Exception as e:
                self.note(tx(f'收集出错：{e!r}', f'Collecting failed: {e!r}'), False)
            time.sleep(2)

    # ---------- amail, with what the deck knows ----------

    def publish(self, sessions):
        """The deck's view for amail (amail status, waits): how each session stands, what it is on, its report."""
        out = {}
        for s in sessions:
            if s.get('starting') or (s.get('unknown') and not s.get('summary')):
                continue
            st, label = standing(s)
            loc = s.get('loc') or {}
            out[s['name']] = {'name': s['name'], 'kind': s['kind'], 'state': st, 'label': label, 'title': s.get('title') or '',
                              'summary': s.get('summary') or '', 'needs_you': s.get('needs_you') or '', 'since': s.get('since'), 'at': s.get('at'),
                              'where': loc and f'{loc["session"].removeprefix("tmux:")} pane {loc["pane"]}', 'parent': s.get('parent') if s.get('parent_id') else None,
                              'origin': s.get('origin'), 'project': self.projects.channel(self.projects.known.get(s.get('project'))),
                              'workspace': s.get('workspace') and self.projects.ws_channel(s['workspace']), 'branch': s.get('branch') or ''}
        reps = {v['name']: {**v['r'], 'at': v['at']} for v in self.reports.data.values() if v.get('r') and v.get('name') in out}
        A.put(A.path('deck.json'), {'at': time.time(), 'sessions': out, 'reports': reps})

    def lock_issues(self, sessions, locks):
        """Push locks whose holder has exited, or has not stirred for hours: the person may release them."""
        by = {s['name']: s for s in sessions}
        out = []
        for l in locks:
            s = by.get(l['holder'])
            if not s or s['state'] in ('gone', 'ended'):
                out.append({**l, 'why': tx(f'{l["holder"]} 已经退出', f'{l["holder"]} has exited')})
            elif s['state'] != 'working' and time.time() - (s.get('at') or 0) > 3 * 3600:
                out.append({**l, 'why': tx(f'{l["holder"]} {int((time.time() - s["at"]) // 3600)} 小时没动静', f'{l["holder"]} has been quiet for {int((time.time() - s["at"]) // 3600)} h')})
        return out

    def assist(self, q, history):
        """The deck's assistant: a question about the sessions, answered from everything the deck knows (and, for the
        sessions the question names, their latest conversation)."""
        if not q:
            return False, tx('先写问题', 'Write a question first')
        now, all_ = time.time(), getattr(self, 'all', [])
        live = [s for s in all_ if not s['hidden']]
        dur = lambda t: '刚刚' if not t or now - t < 60 else f'{int((now - t) // 60)} 分钟前' if now - t < 3600 else f'{int((now - t) // 3600)} 小时前' if now - t < 86400 else f'{int((now - t) // 86400)} 天前'
        def line(s):
            st, label = standing(s)
            g = (s.get('loc') or {}).get('session', '').removeprefix('tmux:') or ('子 agent' if s.get('parent_id') else '未托管')
            kids = [c['name'] for c in live if c.get('parent_id') == s['id']]
            return (f'- {s["name"]}（{s["kind"]} · {g} · {label} · {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")} · {dur(s.get("at"))}）：'
                    f'{s.get("title") or ""} — {s.get("summary") or s.get("said") or ""}' + (f'；要他：{s["needs_you"]}' if s.get('needs_you') else '')
                    + (f'；由 {s["parent"]} 启动' if s.get('parent_id') else '') + (f'；子 agent：{"、".join(kids)}' if kids else '') + ('；一天以上没动静' if s.get('stale') else ''))
        reps = []
        for v in sorted(self.reports.data.values(), key=lambda v: -v.get('at', 0)):
            r = v.get('r') or {}
            if r and any(s['name'] == v.get('name') for s in live):
                reps.append(f'- {v["name"]}：为了 {r.get("goal", "")}；现在 {r.get("now", "")}；接下来 {"；".join(r.get("next") or [])}'
                            + (f'；产出 {"、".join(r.get("refs") or [])}' if r.get('refs') else ''))
        decs = [f'- {d["name"]}（{"他定的" if d["by"] == "user" else "agent 定的"}，{dur(d["at"])}）：{d["what"]}' for d in self.sums.decisions[-25:]]
        talk = [f'- {m["from"]} → {m["to"]}（{dur(m["at"])}）：{m["text"][:220]}' for m in self.talk.all()[:15]]
        queue = [f'- 交给 {i.get("to") or i.get("group") or "先空的"}（{i.get("status")}）：{i.get("text", "")[:160]}' for i in self.queue if i.get('status') in ('waiting', 'held', 'checking', 'ready')]
        locks = [f'- {l.get("branch")} of {os.path.basename(l.get("repo") or "")}：{l.get("holder")} 持有，{dur(l.get("since"))}' for l in self.state.get('locks') or []]
        named = [s for s in live if s['name'].lower() in q.lower() or (s.get('title') and s['title'] in q)][:2]
        detail = ''.join(f'\n会话 {s["name"]} 最近的对话：\n' + '\n'.join(recent(transcript_of(s), 5000)) + '\n' for s in named if transcript_of(s))
        hist = '\n'.join(f'{"他" if h.get("who") == "user" else "你"}：{str(h.get("text") or "")[:600]}' for h in (history or [])[-6:] if isinstance(h, dict)) or '（这是第一个问题）'
        prompt = ASSIST.format(now=time.strftime('%Y-%m-%d %H:%M'), sessions='\n'.join(map(line, live)) or '（没有会话）', reports='\n'.join(reps) or '（还没有）',
                               decisions='\n'.join(decs) or '（还没有）', talk='\n'.join(talk) or '（没有）', queue='\n'.join(queue) or '（没有）',
                               locks='\n'.join(locks) or '（没有）', detail=detail, history=hist, q=q[:2000])
        try:
            return True, {'answer': ask_model(prompt, self.cfg, 'assist').strip()}
        except Exception as e:
            return False, tx(f'助手没答上来：{e}', f'The assistant had no answer: {e}')[:300]

    def recommend(self, text, group, project=''):
        if not text:
            return False, tx('先写要做的事', 'Write what to do first')
        live = [s for s in getattr(self, 'all', []) if not s.get('parent_id') and not s.get('unknown') and s['state'] not in ('gone', 'ended')
                and (s.get('project') == project if project else not group or (s.get('loc') or {}).get('session') == group)]
        proj = self.projects.known.get(project)
        def line(s):
            st, label = standing(s)
            decs = [d['what'] for d in self.sums.decisions if d['sid'] == s['id']][-3:]
            g = (s.get('loc') or {}).get('session', '').removeprefix('tmux:') or '未托管'
            return (f'- {s["name"]}（{s["kind"]}，组 {g}，{label}，目录 {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")}）：'
                    f'{s.get("title") or ""} — {s.get("summary") or ""}' + (f'；定过：{"；".join(decs)}' if decs else ''))
        scope = (f'只在项目「{proj["name"]}」（{proj["path"]}）的会话里挑；新开的会话也开在这个项目里。' if proj
                 else f'只在组「{group.removeprefix("tmux:")}」里挑。' if group else '尽量在同一个组里挑。')
        try:
            out = ask_model(RECOMMEND.format(scope=scope, text=text, sessions='\n'.join(map(line, live)) or '（这里还没有会话）'), self.cfg, 'assist')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
        except Exception as e:
            return False, tx(f'助手没给出建议：{e}', f'The assistant gave no suggestion: {e}')[:200]
        to = next((s for s in live if s['name'] == r.get('to')), None)
        new = r.get('new') if isinstance(r.get('new'), dict) else None
        if new:
            cwd = new.get('cwd') or (to or {}).get('cwd') or '~'
            if proj and not os.path.realpath(os.path.expanduser(cwd)).startswith(proj['path']):
                cwd = proj['path']
            new = {'kind': new.get('kind') if new.get('kind') in ('claude', 'codex', 'cursor') else 'claude', 'cwd': cwd,
                   'name': new.get('name') if NAME.fullmatch(str(new.get('name') or '')) else '', 'why': str(new.get('why') or '')[:200],
                   'group': group or ((to or {}).get('loc') or {}).get('session') or self.ws_group(proj) or next(iter(self.state['groups']), '')}
        return True, {'to': to and {'name': to['name'], 'id': to['id'], 'title': to.get('title') or '', 'group': (to.get('loc') or {}).get('session')},
                      'why': str(r.get('why') or '')[:200], 'new': new}

    def ws_group(self, proj):
        """Where a project's new session goes: the group most of its workspace's sessions are in."""
        w = proj and proj['workspace'] and next((w for w in self.state.get('workspaces') or [] if w['key'] == A.key_of('w', proj['workspace'])), None)
        return w and (w['groups'] or [None])[0]

    def notify(self, to, text, kind='question'):
        """Mail from the deck itself, and the reader woken if it is idle."""
        if A.send('sturnus', to, text, kind):
            self.wake(to)

    def wake(self, name):
        """An idle session is told it has mail or a call on a channel: a Codex thread by its queue, else a line typed into
        its pane (its hook then hands it over). Never one at a prompt of the person's, or at work (its next step brings it)."""
        s = next((x for x in getattr(self, 'all', []) if x['name'] == name and not x.get('unknown')), None)
        if not s or s['state'] != 'idle' or s.get('prompting'):
            return False
        if DRY:
            self.note(tx(f'（试用，没有真的叫醒）{name}', f'(trial, nobody was really woken) {name}'))
            return True
        if s['kind'] == 'codex' and s.get('session'):
            mails, items = A.take(name), A.news(name)
            text = '\n'.join(x for x in [mails and A.mail_text(name, mails), items and A.news_text(name, items)] if x)
            return not text or DRY or A.wake_codex({'session': s['session']}, text)[0]
        if s.get('loc') and not in_view(s['loc']):  # (someone at that pane may be typing: its next turn brings it)
            return self.type_in(s, '[amail] 有新消息', True)[0]
        return False

    def call_in(self):
        """Who a channel's new posts call in: a discussion's members, those named (@NAME, @all: everyone on it) — woken
        when idle and something is still waiting for them (a stop may have handed it over already); at most once a
        minute and twenty times an hour each, so two sessions calling each other cannot run on and on. The rest of a
        channel waits for their next turn."""
        now = time.time()
        for k, meta in A.channels().items():
            if k not in self.chan_at:  # (a channel made since the deck started: from its start; an older one: from now)
                self.chan_at[k] = (meta.get('at', 0) - .001) if (meta.get('at') or 0) > STARTED else now
            for p in A.posts(k, since=self.chan_at[k] - A.LOOK):
                if p['id'] in self.chan_seen:
                    continue
                self.chan_seen[p['id']] = p['at']
                self.chan_at[k] = max(self.chan_at[k], p['at'])
                on, who = set(A.members(k)), set()
                t = p.get('topic') and A.topic_get(k, p['topic'])
                if t and not t.get('closed'):
                    who |= set(t['members'])
                who |= on if 'all' in (p.get('to') or ()) else set(p.get('to') or ()) & on
                for n in sorted(who - {p.get('from'), ME_NAME, 'sturnus', 'amail'}):
                    w = [x for x in self.woke.get(n, []) if now - x < 3600]
                    if (w and now - w[-1] < 60) or len(w) >= 20 or not A.news(n, take=False):
                        continue
                    if self.wake(n):
                        self.woke[n] = w + [now]
                        if len(w) + 1 == 20:
                            self.note(tx(f'{n} 这一小时被讨论区叫醒了 20 次，先不再叫它了', f'{n} was woken 20 times by channels this hour; not waking it again for now'), False)
        self.chan_seen = {i: at for i, at in self.chan_seen.items() if now - at < 3600}
        if now - getattr(self, 'pruned', 0) > 600:  # (a channel keeps its last 3000 posts, and discussions closed in the last three days)
            self.pruned = now
            for k in A.channels():
                d = os.path.join(A.HOME, 'channels', k, 'posts')
                old = sorted(f for f in os.listdir(d) if f.endswith('.json'))[:-3000] if os.path.isdir(d) else []
                for f in old:
                    os.remove(os.path.join(d, f))
                for t in A.topics(k):
                    if t.get('closed') and now - (t.get('closed_at') or t['at']) > 3 * 86400:
                        for ext in ('json', 'lock'):
                            try:
                                os.remove(os.path.join(A.HOME, 'channels', k, 'topics', f'{t["id"]}.{ext}'))
                            except OSError:
                                pass

    def mind_loop(self):
        self.prev, self.stopped, self.woken, self.checked, self.lock_seen = {}, {}, set(), {}, None
        while True:
            try:
                self.mind()
            except Exception as e:
                self.note(tx(f'amail 跟进出错：{e!r}', f'amail follow-up failed: {e!r}'), False)
            time.sleep(4)

    def mind(self):
        now, ss = time.time(), {s['name']: s for s in getattr(self, 'all', [])}
        for n, s in ss.items():  # (who has just stopped)
            st = standing(s)[0]
            if self.prev.get(n) == 'working' and st != 'working':
                self.stopped[n] = now
            self.prev[n] = st
        for f in glob.glob(A.path('watches', '*.json')):
            w = A.get(f)
            if w:
                self.watch(f, w, ss.get(w['on']), now)
        for box in glob.glob(A.path('mail', '*', 'new')):  # (a question to an idle session wakes it)
            name = os.path.basename(os.path.dirname(box))
            for f in glob.glob(os.path.join(box, '*.json')):
                m = A.get(f) or {}
                if m.get('kind', 'fyi') != 'fyi' and m.get('id') not in self.woken and name != ME_NAME:
                    self.woken.add(m.get('id'))
                    self.wake(name)
        for f in sorted(glob.glob(A.path('route', '*.json'))):  # (a note to all: to the sessions it concerns)
            r = A.get(f)
            os.remove(f)
            if r:
                for n in self.route(r, ss):
                    A.send(r['from'], n, r['text'], r.get('kind'), routed=True)
        self.call_in()
        locks = {os.path.basename(f): A.get(f) or {} for f in glob.glob(A.path('locks', '*.json'))}
        for k, old in (self.lock_seen or {}).items():  # (a lock let go: those it turned away are told)
            if old.get('waiters') and (k not in locks or locks[k].get('holder') != old.get('holder')):
                for n in old['waiters']:
                    self.notify(n, f'{old["branch"]} of {old["repo"]} is free now ({old["holder"]} let go of it)')
        self.lock_seen = locks

    def watch(self, f, w, t, now):
        """One wait: told when its session stops (once the stop is in its summary), or once its condition holds."""
        done = lambda text: (self.notify(w['by'], text), os.path.exists(f) and os.remove(f))
        if now - w['at'] > 86400:
            return done(f'stopped watching {w["on"]} after a day' + (f' ({w["until"]})' if w.get('until') else ''))
        if not t:
            if now - w['at'] > 3600:
                done(f'{w["on"]} is nowhere to be seen; stopped watching it')
            return
        st, label = standing(t)
        about = f' (you asked it: {w["about"]})' if w.get('about') else ''
        if st in ('gone', 'ended'):
            return done(f'{w["on"]} has exited{about}. Last: {t.get("summary") or t.get("said") or "-"}')
        if w.get('about') and any(m.get('from') == w['on'] and m['at'] > w['at'] for m in self.mail_of(w['by'])):
            return os.remove(f)  # (it answered: nothing more to say)
        stop = self.stopped.get(w['on'], 0)
        if st == 'working' or (w.get('about') and stop <= w['at']):
            return  # (an asked one: told once it has worked on it and stopped)
        if (t.get('summary_at') or 0) < stop and now - stop < 90:
            return  # (stopped just now: its summary catches up first)
        if not w.get('until'):
            return done(f'{w["on"]} has stopped: {label}. {t.get("title") or ""} — {t.get("summary") or t.get("said") or ""}{about}')
        key = (w['id'], t.get('summary_at'), st)
        if self.checked.get(w['id'], (None, 0))[0] == key or now - self.checked.get(w['id'], (None, 0))[1] < 60:
            return
        self.checked[w['id']] = (key, now)
        rep = (self.reports.data.get(t['id']) or {}).get('r') or {}
        try:
            out = ask_model(UNTIL.format(name=w['on'], until=w['until'], label=label, title=t.get('title') or '', summary=t.get('summary') or '',
                                         report=f'它的报告：现在 {rep.get("now", "")}；做成了 {"；".join(rep.get("done") or [])}\n' if rep else '',
                                         said=(t.get('said') or '')[:600]), self.cfg, 'assist')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
        except Exception:
            return
        if r.get('met'):
            done(f'{w["on"]}: {w["until"]} — yes: {r.get("why") or ""}')

    @staticmethod
    def mail_of(name):
        return [A.get(f) or {} for box in ('new', 'cur') for f in glob.glob(A.path('mail', name, box, '*.json'))]

    def route(self, r, ss):
        live = [s for s in ss.values() if s['name'] != r['from'] and standing(s)[0] not in ('gone', 'ended', 'quiet') and not s.get('unknown')]
        if len(live) <= 2:
            return [s['name'] for s in live]
        lines = '\n'.join(f'- {s["name"]}（{s["kind"]}，目录 {(s.get("cwd") or "?").replace(os.path.expanduser("~"), "~")}）：{s.get("title") or ""} — {s.get("summary") or ""}' for s in live)
        try:
            out = ask_model(ROUTE.format(frm=r['from'], text=r['text'], sessions=lines), self.cfg, 'assist')
            names = set(json.loads(re.search(r'\{.*\}', out, re.S).group(0)).get('to') or [])
            return [s['name'] for s in live if s['name'] in names]
        except Exception:
            return [s['name'] for s in live]  # (in doubt: everyone, as before)

    def summarize_loop(self):
        while True:
            try:
                live = [s for s in self.state['sessions'] if not (s.get('unknown') and not s.get('transcript'))]
                asked = next((s for s in live if s['id'] in self.reports.asked), None)
                if asked:  # (what the person asked for first: a report, then a story)
                    self.report(asked)
                    continue
                asked = next((s for s in live if s['id'] in self.stories.asked and self.stories.due(s)), None)
                if asked:
                    self.stories.make(asked, self.cfg)
                    continue
                w = next((w for w in self.state.get('workspaces') or [] if self.digests.due(w['key'], Digests.sessions(w['key'], live))), None)
                if w:  # (a dashboard open: what its workspace is doing, before the next summaries)
                    self.digests.make(w, Digests.sessions(w['key'], live), self.cfg, lambda s: (self.projects.known.get(s.get('project')) or {}).get('name'))
                    continue
                for s in sorted(live, key=lambda s: ({'working': 0, 'waiting': 1}.get(s['state'], 2), -(s['at'] or 0))):
                    basis = self.sums.due(s, self.cfg)
                    if basis:
                        self.sums.make(s, basis, self.cfg)
                        break
                else:  # (no summary due: a report, else a story)
                    s = next((s for s in sorted(live, key=lambda s: -(s['at'] or 0)) if self.reports.due(s)), None)
                    if s:
                        self.report(s)
                    else:
                        s = next((s for s in sorted(live, key=lambda s: -(s['at'] or 0)) if self.stories.due(s)), None)
                        if s:
                            self.stories.make(s, self.cfg)
                        else:  # (nothing else to do: a session that has ended, then the task lists)
                            s = next((s for s in self.everyone if self.reports.last_due(s)), None)
                            if s:
                                self.report(s)
                            else:
                                self.tidy_tasks()
            except Exception as e:
                self.sums.error = repr(e)[:300]
            time.sleep(4)

    def find(self, sid):
        return next((s for s in self.state['sessions'] if s['id'] == sid), None)

    # ---------- tasks: what the projects work through; sessions come and go on them ----------

    def report(self, s):
        self.reports.make(s, self.cfg, self.sums.decisions, self.stories.data.get(s['id']), self.scope_of(s))

    def scope_name(self, key):
        p = self.projects.known.get(key)
        return (p or self.projects.ws_channel(key) or {}).get('name')

    def scope_of(self, s):
        """Where a session's tasks are kept: its project, else its workspace, as (key, name); None when it has neither."""
        key = s.get('project') or s.get('workspace')
        return (key, self.scope_name(key) or key) if key else None

    def scope_at(self, folder):
        """Where the tasks of work in a folder are kept: as for scope_of."""
        at = self.projects.where(folder)
        p, w = at.get('project'), at.get('workspace')
        return (p['key'], p['name']) if p else (A.key_of('w', w), ws_name(w)) if w else None

    @staticmethod
    def task_shown(t, live):
        """How a task stands as the person sees it: what its sessions do now, over what was written down."""
        if t['status'] in A.TASK_CLOSED:
            return t['status']
        st = {standing(s)[0] for s in live}
        if t['status'] == 'waiting' or st & {'waiting', 'asking', 'blocked', 'review'}:
            return 'needs'
        return 'working' if 'working' in st else 'backlog' if t['status'] == 'backlog' else 'todo' if t['status'] == 'todo' else 'paused'

    def task_row(self, t, by_sid, by_name):
        links = []
        for x in t['sessions']:
            s = by_sid.get(x.get('sid')) or by_name.get(x['name'])
            on = bool(s) and s['state'] not in ('gone', 'ended') and not s.get('hidden')
            links.append({'name': x['name'], 'kind': x.get('kind'), 'sid': s['id'] if on else x.get('sid'), 'live': on, 'at': x.get('at'),
                          'st': standing(s)[0] if on else None, 'label': standing(s)[1] if on else None, 'title': (s.get('title') if on else None)})
        # (a session on several tasks is on the one it touched last: the others do not light up with it)
        live = [by_sid.get(x['sid']) for x in links if x['live'] and self.tasks_current.get(x['name']) == t['id']]
        return {**{k: t[k] for k in ('id', 'scope', 'scope_name', 'title', 'status', 'now', 'next', 'at', 'made', 'closed')}, 'shown': self.task_shown(t, live),
                'archived': t.get('archived'), 'orphan': t['status'] == 'waiting' and not any(x['live'] for x in links),  # (it waits on the person, and no session is there for the answer)
                'sessions': links, 'decs': t['decisions'][-2:], 'nd': len(t['decisions']), 'nr': len(t['results'])}

    def tasks_sweep(self, sessions, now=None):
        """Tasks nobody has touched for long are tidied (config task_days): one that waited on the person with no session
        left on it is put aside, as is one "under way" with no session; an ended one goes to the archive, and one put
        aside does after longer. What the person set stays as they set it. Returns how many were put aside and archived."""
        days = {**DEFAULTS['task_days'], **(self.cfg.get('task_days') or {})}
        now, aside, away = now or time.time(), 0, 0
        names = {s['name'] for s in sessions if s['state'] not in ('gone', 'ended')}
        ids = {s['id'] for s in sessions if s['state'] not in ('gone', 'ended')}
        for t in A.tasks_query(closed=True, limit=5000):
            on = any(x['name'] in names or x.get('sid') in ids for x in t['sessions'])
            age = (now - t['at']) / DAY
            limit = days[{'waiting': 'needs', 'doing': 'doing'}.get(t['status'], 'backlog')]
            if t['status'] in ('waiting', 'doing') and not on and limit and age > limit and 'status' not in t['held']:  # (what the person set stays theirs)
                A.task_do({'do': 'set', 'who': 'deck', 'id': t['id'], 'status': 'backlog', 'at': now})
                aside += 1
            elif (t['status'] in A.TASK_CLOSED and days['closed'] and (now - (t['closed'] or t['at'])) / DAY > days['closed']) or (t['status'] == 'backlog' and days['backlog'] and age > days['backlog']):
                A.task_do({'do': 'archive', 'who': 'deck', 'id': t['id'], 'at': now})
                away += 1
        if aside or away:
            self.note(tx(f'任务整理：{aside} 件等了很久没人接的移到搁置，{away} 件归档', f'Tasks tidied: {aside} long unanswered put aside, {away} archived'))
        return aside, away

    def tasks_tick(self, sessions):
        """Each collect, and after the person's changes: apply what sandboxes left, keep the store small, and the tasks as
        the page sees them. Whatever goes wrong here costs the page its update, never the collect, and it keeps the list it has."""
        with self.tasks_lock:
            try:
                A.task_flush()
                if time.time() - self.tasks_kept > 3600:
                    self.tasks_kept = time.time()
                    A.tasks_trim()
                    self.import_tasks(sessions)
                    self.tasks_sweep(sessions)
                m = os.stat(A.TASKS).st_mtime_ns
                if m != self.tasks_seen[0]:
                    self.tasks_seen = (m, A.tasks_query(closed=time.time() - 7 * DAY, limit=800))
                self.tasks_error = ''
            except Exception as e:
                if repr(e) != self.tasks_error:  # (said once, not on every pass)
                    self.tasks_error = repr(e)
                    self.note(tx(f'任务库出错：{e!r}', f'The task store failed: {e!r}'), False)
            on = {}
            for t in self.tasks_seen[1]:
                if t['status'] not in A.TASK_CLOSED:
                    for x in t['sessions']:
                        if (x.get('at') or 0) >= on.get(x['name'], (0, ''))[0]:
                            on[x['name']] = (x.get('at') or 0, t['id'])
            self.tasks_current = {k: v[1] for k, v in on.items()}
            by_sid, by_name = {s['id']: s for s in sessions}, {s['name']: s for s in sessions}
            return [self.task_row(t, by_sid, by_name) for t in self.tasks_seen[1]]

    def import_tasks(self, sessions):
        """Once: what the reports already say becomes tasks, so it outlasts their sessions. Unless its session runs, or it
        ended in the last three days with something left to do, it comes in as done: it can be looked up, and pretends to nothing."""
        if A.task_meta('imported'):
            return
        by = {s['id']: s for s in sessions}
        for sid, v in self.reports.data.items():
            r = v.get('r')
            if not r:
                continue
            s = by.get(sid)
            if not s:  # (ended: placed as it would be while it ran, by its folder and the files it worked on)
                kind, _, session = sid.partition(':')
                path = transcript_of({'kind': kind, 'session': session})
                cwd = transcript_cwd(path)
                s = {'id': sid, 'name': v.get('name') or sid, 'kind': kind, 'session': session, 'cwd': cwd, 'home': cwd, 'state': 'gone', 'transcript': path}
                self.projects.attribute(s)
            scope = self.scope_of(s)
            if not scope:
                continue
            old = s['state'] in ('gone', 'ended') and (time.time() - v.get('at', 0) > 3 * DAY or not r.get('next'))
            A.task_do({'do': 'add', 'who': 'summary', 'scope': scope[0], 'scope_name': scope[1], 'at': v.get('at'), 'status': 'done' if old else 'doing',
                       'title': (self.sums.data.get(sid) or {}).get('title') or r.get('goal'), 'now': r.get('now'), 'next': '；'.join(r.get('next') or []),
                       'decisions': [{'topic': '', 'what': d['what'], 'by': d['by']} for d in r.get('decisions') or []], 'results': r.get('refs') or [],
                       'session': {'name': v.get('name'), 'sid': sid, 'kind': v.get('kind')}})
        A.task_meta('imported', '1')

    def tidy_tasks(self):
        """When nothing else waits: a list that has changed, and has grown long enough to need it, gets looked over, at
        most every six hours: the same thing written twice is merged, what says it is finished is closed."""
        by = {}
        for t in A.tasks_query():
            by.setdefault(t['scope'], []).append(t)
        for scope, ts in by.items():
            sig = sorted((t['id'], t['at']) for t in ts)
            when, seen = self.tidied.get(scope, (0, None))
            if len(ts) < 6 or seen == sig or time.time() - when < 6 * 3600:
                continue
            self.tidied[scope] = (time.time(), sig)
            as_of = time.time()
            rows = '\n'.join(f'{t["id"]}｜{t["status"]}｜{t["title"]}｜{t["now"][:120]}｜{t["next"][:80]}｜{int((time.time() - t["at"]) // 3600)} 小时前' for t in ts[:60])
            out = ask_model(TIDY.format(name=ts[0].get('scope_name') or scope, rows=rows), self.cfg, 'summary')
            r = json.loads(re.search(r'\{.*\}', out, re.S).group(0))
            ids = {t['id'] for t in ts}
            for m in r.get('merge') or []:
                if isinstance(m, dict) and m.get('keep') in ids and isinstance(m.get('drop'), list):
                    A.task_do({'do': 'merge', 'who': 'summary', 'as_of': as_of, 'id': m['keep'], 'drop': [x for x in m['drop'] if x in ids]})
            for d in r.get('done') or []:
                if isinstance(d, dict) and d.get('id') in ids:
                    A.task_do({'do': 'set', 'who': 'summary', 'as_of': as_of, 'id': d['id'], 'status': 'done', 'now': d.get('now')})
            return

    def task_brief(self, t):
        """What a session is told when it is given a task: one line, typed as the person's."""
        i = t['id']
        told = t['now'] or t['next']
        return one_line(tx(f'接着做任务 {i}「{t["title"]}」。' + ('之前记下的，供参考，以实际情况为准：' if told else '') + (f'现状：{t["now"]}。' if t['now'] else '') + (f'接着做：{t["next"]}。' if t['next'] else '')
                           + f'开始时运行 amail task start {i}；有进展用 amail task update {i} --now "现状" --next "接着做"；做完运行 amail task done {i}。',
                           f'Pick up task {i} "{t["title"]}". ' + ('Noted earlier, for reference; check it against what you find: ' if told else '') + (f'Where it stands: {t["now"]}. ' if t['now'] else '') + (f'Next: {t["next"]}. ' if t['next'] else '')
                           + f'Start with: amail task start {i}. As it moves: amail task update {i} --now "where it stands" --next "next step". When finished: amail task done {i}.'), 1500)

    def task_view(self, tid):
        """One task in full, for its page."""
        t = A.task_get(tid)
        by = self.everyone
        row = self.task_row(t, {s['id']: s for s in by}, {s['name']: s for s in by})
        for x in row['sessions']:  # (how to go back to one that has ended)
            kind, _, session = (x.get('sid') or '').partition(':')
            x['resume'] = None if x['live'] or not session else f'claude --resume {session}' if kind == 'claude' else f'codex resume {session}' if kind == 'codex' else None
        return {**row, 'decisions': t['decisions'], 'results': t['results'], 'log': t['log'], 'brief': self.task_brief(t)}

    def tasks_find(self, q, scope, closed, archived=False):
        """Tasks beyond the page's own list: the long-ended, those that mention something (the archived among them), or
        the archive itself."""
        by = self.everyone
        rows = [self.task_row(t, {s['id']: s for s in by}, {s['name']: s for s in by})
                for t in A.tasks_query(scope or None, closed=True if archived else closed, q=q, limit=400 if archived else 200, archived=True if archived else None if q else False)]
        return {'ok': True, 'tasks': rows}

    def task_act(self, b):
        """What the person does to a task."""
        do, tid = b.get('do'), str(b.get('id') or '')
        s = self.find(b.get('sid')) if b.get('sid') else None
        me = s and {'name': s['name'], 'sid': s['id'], 'kind': s['kind']}
        if do == 'add':
            scope = str(b.get('scope') or '')
            name = self.scope_name(scope)
            if not name:
                return False, tx('先选一个项目或工作区', 'Pick a project or a workspace first')
            if not one_line(b.get('title'), 120):
                return False, tx('先写任务名', 'Write what the task is first')
            new = A.task_do({'do': 'add', 'who': 'person', 'scope': scope, 'scope_name': name, 'title': b.get('title'), 'now': b.get('now'), 'next': b.get('next')})
            if s:  # (given to a session as it is written down)
                A.task_do({'do': 'set', 'who': A.task_who(s['name']), 'id': new, 'session': me, 'status': 'doing'})
            return True, {'id': new, 'msg': tx('记下了', 'Added')}
        if do in ('archive', 'unarchive', 'aside') and isinstance(b.get('ids'), list):  # (several at once: put away, brought back, or put aside)
            ids = [str(x) for x in b['ids'][:1000]]
            for x in ids:
                with contextlib.suppress(ValueError, KeyError):
                    A.task_do({'do': 'set', 'who': 'person', 'id': x, 'status': 'backlog'} if do == 'aside' else {'do': do, 'who': 'person', 'id': x})
            n = len(ids)
            return True, {'n': n, 'msg': {'archive': tx(f'归档了 {n} 件', f'{n} archived'), 'unarchive': tx(f'{n} 件取消归档', f'{n} brought back'), 'aside': tx(f'{n} 件移到搁置', f'{n} put aside')}[do]}
        t = A.task_get(tid)
        if do in ('archive', 'unarchive'):
            A.task_do({'do': do, 'who': 'person', 'id': t['id']})
            return True, tx(f'「{t["title"]}」已归档' if do == 'archive' else f'「{t["title"]}」取消归档', f'“{t["title"]}” archived' if do == 'archive' else f'“{t["title"]}” brought back')
        if do == 'set':
            A.task_do({'do': 'set', 'who': 'person', 'id': t['id'], **{k: b[k] for k in ('title', 'now', 'next', 'status') if b.get(k) is not None}})
            return True, {}
        if do == 'delete':
            A.task_do({'do': 'delete', 'who': 'person', 'id': t['id']})
            return True, tx(f'删掉了「{t["title"]}」', f'Deleted “{t["title"]}”')
        if do == 'unlink':
            A.task_do({'do': 'unlink', 'who': 'person', 'id': t['id'], 'session': {'name': str(b.get('name') or '')}})
            return True, tx('不再关联', 'Unlinked')
        if do in ('link', 'give'):
            if not s:
                return False, tx('这个会话已经不在了', 'That session is gone')
            told = self.act('say', {'id': s['id'], 'text': self.task_brief(t)}) if do == 'give' else None
            if told and not told[0]:  # (it did not get there: nothing has changed)
                return told
            # (the session's act, not the person's word on the status: its own updates and the summaries go on moving it)
            A.task_do({'do': 'set', 'who': A.task_who(s['name']), 'id': t['id'], 'session': me, 'status': 'doing' if do == 'give' or t['status'] == 'todo' else None})
            return told or (True, tx(f'{s["name"]} 关联上了这个任务', f'{s["name"]} is linked to this task'))
        return False, tx('不知道要做什么', 'Unknown action')

    # actions
    def act(self, what, body, lang=None):
        if lang:
            _REQ.lang = lang
        s = self.find(body.get('id')) if body.get('id') else None
        if what == 'task':
            try:
                out = self.task_act(body)
            except ValueError as e:
                return False, str(e)
            except (sqlite3.Error, OSError) as e:
                return False, tx(f'任务库现在写不进去，这次没有保存：{e}', f'The task store cannot be written just now; this was not saved: {e}')
            rows = self.tasks_tick(self.everyone)  # (the page shows it at once, not at the next collect)
            with self.lock:
                self.state['tasks'] = rows
            return out
        if what == 'say':  # (words for a session, as the person's: how they get there follows how it stands)
            text = (body.get('text') or '').strip()
            if not s or not text:
                return False, tx('先写要说的话', 'Write what to say first')
            how = say_how(s, bool(body.get('now')))
            if how == 'gone':
                return False, tx(f'{s["name"]} 已经退出了', f'{s["name"]} has exited')
            if how == 'menu':
                return False, tx(f'{s["name"]} 停在一个授权或选择提示上，打进去的字会被当成对它的回答：先进终端处理它', f'{s["name"]} is stopped at a permission or choice prompt, and typed text would answer it: handle it in the terminal first')
            if how in ('type', 'queue'):
                ok, r = self.type_in(s, text, True) if how == 'type' else self.queue_act({'do': 'add', 'text': text, 'to': s['name'], 'mode': 'plain'})
                return (True, {**(r if isinstance(r, dict) else {'msg': r}), 'how': how}) if ok else (False, r)
            if not A.send(ME_NAME, s['name'], text, 'question'):
                return False, tx('发不出去', 'Could not send')
            self.wake(s['name'])
            return True, {'msg': tx(f'放进了 {s["name"]} 的信箱：它不在 Zellij 或 tmux 里，下一步就会看到', f'Put in the mailbox of {s["name"]}: it is not in Zellij or tmux, and sees it next'), 'how': 'mail'}
        if what == 'attribute':  # (the person's word on which project a session works on; '' goes back to what was found)
            v = str(body.get('project') or '')
            if not s:
                return False, tx('找不到这个会话', 'Session not found')
            if v and v not in self.projects.known and not (v.startswith('w:') and self.projects.ws_channel(v[2:])):
                return False, tx('没有这个项目', 'No such project')
            self.projects.set_manual(s['id'], v)  # (the next collect places it so: only that thread changes what is known)
            p = self.projects.known.get(v)
            return True, tx(f'{s["name"]} 算作' + (f'项目 {p["name"]} 的' if p else '工作区本身的' if v else '按它的目录和改的文件找到的项目的') + '会话', f'{s["name"]} now counts as a session of ' + (f'project {p["name"]}' if p else 'the workspace itself' if v else 'the project found from its folder and the files it changes'))
        if what in ('board_post', 'board_seen', 'topic_new', 'topic_close'):
            return self.board_act(what, str(body.get('key') or ''), body)
        if what == 'jump':
            if not s:
                return False, tx('找不到这个会话', 'Session not found')
            return go_to(s.get('loc'), body.get('via'))
        if what == 'send':
            to = s['name'] if s else body.get('to')
            text = (body.get('text') or '').strip()
            if not to or not text:
                return False, tx('缺少收件人或内容', 'Missing recipient or text')
            if body.get('wake'):
                threading.Thread(target=self._ask, args=(to, text), daemon=True).start()
                return True, tx(f'已发给 {to}，并在叫醒它', f'Sent to {to}, and waking it')
            sent = A.send(ME_NAME, to, text)
            return bool(sent), tx(f'已发给 {", ".join(sent)}', f'Sent to {", ".join(sent)}') if sent else tx('没有发出', 'Nothing sent')
        if what == 'rename':
            new = (body.get('name') or '').strip()
            if not s or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,40}', new):
                return False, tx('名字只能用字母、数字和 _ . -', 'A name can use only letters, digits and _ . -')
            return self.rename(s, new)
        if what == 'dirs':  # (the folders of this machine, for picking where a new session runs)
            d = os.path.realpath(os.path.expanduser(str(body.get('path') or '~')))
            if not os.path.isdir(d):
                return False, tx(f'没有这个目录：{d}', f'No such folder: {d}')
            try:
                names = sorted((e.name for e in os.scandir(d) if not e.name.startswith('.') and e.is_dir()), key=str.lower)
            except OSError as e:
                return False, tx(f'读不了 {d}：{e.strerror}', f'Can’t read {d}: {e.strerror}')
            h = os.path.expanduser('~')
            return True, {'path': d, 'show': d.replace(h, '~', 1) if d == h or d.startswith(h + '/') else d, 'dirs': names[:500], 'more': max(0, len(names) - 500)}
        if what == 'assistant':  # (a question to the deck's assistant)
            return self.assist(str(body.get('q') or '').strip(), body.get('history') or [])
        if what == 'recommend':  # (who should take a task: within a project or a group, or a new session there)
            return self.recommend(str(body.get('text') or '').strip(), str(body.get('group') or ''), str(body.get('project') or ''))
        if what == 'stop':  # (a session another one started: it and the processes under it)
            if not s or not s.get('parent_id') or not s.get('pid') or s['state'] in ('gone', 'ended'):
                return False, tx('只能停止由别的会话启动、还在跑的子 agent', 'Only a running sub-agent started by another session can be stopped')
            kids = [p for p in A.pids() if any(a == s['pid'] for a, _ in A.ancestors(p)[1:])]
            for pid in [s['pid']] + kids:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
            return True, tx(f'停止了 {s["name"]}（{s["parent"]} 启动的）', f'Stopped {s["name"]} (started by {s["parent"]})')
        if what == 'unlock':  # (the person lets go of a push lock whose holder is gone; those it turned away are told)
            key = str(body.get('key') or '')
            f = A.path('locks', f'{key}.json')
            if not re.fullmatch(r'[0-9a-f]{12}', key) or not os.path.exists(f):
                return False, tx('这把锁已经不在了', 'This lock is already gone')
            l = A.get(f) or {}
            if body.get('holder') and l.get('holder') != body['holder']:  # (a phone's view a collect old: someone else holds it now)
                return False, tx(f'这把锁现在是 {l.get("holder")} 的了：不释放', f'{l.get("holder")} holds this lock now: not released')
            os.remove(f)
            return True, tx(f'释放了 {l.get("holder")} 在 {os.path.basename(l.get("repo") or "")} 上的 {l.get("branch")} 推送锁', f'Released the push lock of {l.get("holder")} on {l.get("branch")} in {os.path.basename(l.get("repo") or "")}')
        if what == 'ask_done':  # (something a session asked of the person: handled)
            return self.sums.ask_done(str(body.get('ask') or ''))
        if what in ('mail_read', 'mail_reply'):  # (mail to the person: read, or answered, which wakes the writer)
            mid = str(body.get('mid') or '')
            f = next(iter(glob.glob(A.path('mail', ME_NAME, 'new', f'*-{mid}.json')))) if re.fullmatch(r'[0-9a-f]{12}', mid) else None
            m = f and A.get(f)
            if not m:
                return False, tx('这封已经处理过了', 'This one is already handled')
            text = (body.get('text') or '').strip()
            if what == 'mail_reply':
                if not text:
                    return False, tx('先写回复', 'Write a reply first')
                if not A.send(ME_NAME, m['from'], text, 'question'):
                    return False, tx('发不出去', 'Could not send')
                self.wake(m['from'])
            os.replace(f, A.path('mail', ME_NAME, 'cur', os.path.basename(f)))
            return True, tx(f'已回复 {m["from"]}', f'Replied to {m["from"]}') if what == 'mail_reply' else {}
        if what == 'report':  # (a report now, before the next summaries)
            if not s or not transcript_of(s):
                return False, tx('读不到这个会话的对话，写不了报告', 'Can’t read this session’s conversation, so no report')
            self.reports.asked.add(s['id'])
            self.stories.asked.add(s['id'])
            return True, {}
        if what == 'summarize':
            if not s:
                return False, tx('找不到这个会话', 'Session not found')
            self.sums.data.pop(s['id'], None)
            return True, tx('马上重新总结', 'Summarizing again now')
        if what == 'kept':  # (the person's word on a session that lasts)
            return self.kept_act(body)
        if what == 'space':  # (… on a workspace and its folders)
            return self.space_act(body)
        if what == 'resume':  # (a stopped session goes on, in a new terminal; with words, they are its next ask)
            return self.launch(str(body.get('id') or ''), prompt=(body.get('text') or '').strip(), group=str(body.get('group') or ''), kind=str(body.get('kind') or ''))
        if what == 'handover':  # (what another agent would be told on taking a session on: shown to the person first, to change)
            kid, kind = str(body.get('id') or ''), str(body.get('kind') or '')
            if kind not in K.AGENTS or not self.book.get(kid):
                return False, tx('选一个 agent', 'Pick an agent')
            note, f = self.handover(kid, kind, str(body.get('text') or ''))
            return True, {'note': note, 'file': f}
        if what == 'recover':  # (the sessions a restart ended: all of them on again, or the offer put away)
            return self.recover(body)
        if what == 'plan':  # (what is set to be done again and again by the clock)
            return self.plan_act(body)
        if what == 'terminal' and 'rest_days' in body:  # (how many days a session may rest before its terminal is closed; 0: never)
            try:
                days = float(body['rest_days'])
            except (TypeError, ValueError):
                days = -1
            if not 0 <= days <= 365:
                return False, tx('天数要在 0 到 365 之间', 'The days must be between 0 and 365')
            self.cfg['rest_days'] = days
            save_config({'rest_days': days})
            return True, tx(f'空闲 {days:g} 天的会话会自动关掉终端' if days else '不再自动关掉空闲会话的终端', f'A session idle for {days:g} days has its terminal closed' if days else 'Idle sessions keep their terminals')
        if what == 'terminal':  # (the way new terminals are opened)
            if body.get('way') not in T.WAYS or not T.WAYS[body['way']].usable():
                return False, tx('这台机器上用不了这种打开方式', 'That way of opening a terminal cannot be used on this machine')
            self.cfg['terminal'] = body['way']
            save_config({'terminal': body['way']})
            return True, tx(f'新终端的打开方式：{T.WAYS[body["way"]].label()}。已经开着的不动，下一个终端起按这个来', f'New terminals now open as: {T.WAYS[body["way"]].label()}. Those already open stay; the next one opens this way')
        if what == 'new':
            return self.new_session(body)
        if what == 'queue':
            return self.queue_act(body)
        if what == 'type':
            if 'seen' in body and s and phone_prompt(self, s) != str(body.get('seen') or ''):
                # (a phone's keys, sent for the prompt it showed, or for none: a prompt that came or went since would
                # take them as its answer)
                return False, tx('它的提示刚变了：看一眼屏幕再按', 'Its prompt has just changed: look at the screen, then press')
            return self.type_in(s, body.get('text') or '', bool(body.get('enter', True)))
        if what == 'models':
            try:
                role, m, key = self.model_from(body)
            except ValueError as e:
                return False, str(e)
            models = dict(self.cfg.get('models') or {})
            models[role] = m
            self.cfg['models'] = models
            save_config({'models': models})
            if key is not None:
                put_secret(role, key)
            return True, tx(f'{"总结模型" if role == "summary" else "辅助模型"}已换成 {model_label(self.cfg, role)}', f'The {"summary" if role == "summary" else "assistant"} model is now {model_label(self.cfg, role)}')
        if what == 'voice' and 'only_on' in body:  # (the switch: at once, the rest as it was)
            v = {**voice_cfg(self.cfg), 'on': bool(body['only_on'])}
            self.cfg['voice'] = v
            save_config({'voice': v})
            self.state['voice'] = self.voice_view()  # (the page reads it back at once)
            return True, tx(f'语音输入{"已开启：" + voice_label(v) if v["on"] else "已关闭"}', f'Voice input {"turned on: " + voice_label(v) if v["on"] else "turned off"}')
        if what in ('voice', 'voice_test'):
            v = voice_cfg(self.cfg)
            if body.get('provider') not in STT:
                return False, tx('选一个语音服务', 'Pick a voice service')
            model = str(body.get('model') or '').strip()[:80]
            v.update(on=bool(body.get('on')), provider=body['provider'], model='' if model == STT_MODEL[body['provider']] else model,
                     url=str(body.get('url') or '').strip(), lang=body.get('lang') if body.get('lang') in ('zh', 'en') else '')
            if v['url'] and not re.match(r'^https?://', v['url']):
                return False, tx('接口地址要以 http:// 或 https:// 开头', 'The API address must start with http:// or https://')
            key = body.get('key')
            key = key if key and '…' not in key and key not in ('已设置', 'set') else None
            if what == 'voice_test':
                t, k = time.time(), key if key is not None else voice_key(v['provider'])
                try:
                    transcribe(silence(), 'audio/wav', v, k)
                except Exception as e:
                    if v['provider'] == 'openai':  # (the model a compatible server lacks: the ones it has, to pick from)
                        try:
                            ids, model = voice_models(v, k), v['model'] or STT_MODEL['openai']
                        except Exception:
                            ids = None
                        if ids and model not in ids:
                            return False, {'msg': tx(f'这个接口没有模型 {model}。它有下面这些，点一个换上，再测试：', f'This endpoint has no model {model}. It has the ones below: pick one, then test again:'), 'models': ids[:30]}
                    return False, tx(f'{voice_label(v)} 没调通：{e}', f'{voice_label(v)} did not work: {e}')[:300]
                return True, tx(f'{voice_label(v)} 调通了（{time.time() - t:.1f} 秒）', f'{voice_label(v)} works ({time.time() - t:.1f} s)')
            self.cfg['voice'] = v
            save_config({'voice': v})
            if key is not None:
                put_secret(f'voice:{v["provider"]}', key)
            self.state['voice'] = self.voice_view()  # (the page reads it back at once)
            return True, tx(f'已保存：{voice_label(v)}' + ('' if v['on'] else '（语音输入还关着）'), f'Saved: {voice_label(v)}' + ('' if v['on'] else ' (voice input is still off)'))
        if what == 'models_test':
            try:
                role, m, key = self.model_from(body)
            except ValueError as e:
                return False, str(e)
            t = time.time()
            try:
                out = ask_model('只回复两个字：好的', self.cfg, role, m=m, key=key if key is not None else None)
            except Exception as e:
                return False, tx(f'没调通：{e}', f'Did not work: {e}')[:300]
            return True, tx(f'调通了（{time.time() - t:.1f} 秒）：{out.strip()[:40]}', f'Works ({time.time() - t:.1f} s): {out.strip()[:40]}')
        if what == 'draft':
            if not s:
                return False, tx('找不到这个会话', 'Session not found')
            path = transcript_of(s)
            lines = recent(path, 5000) if path else []
            need = s.get('needs_you') or s.get('waiting_for') or s.get('summary') or ''
            try:
                text = ask_model(DRAFT.format(name=s['name'], need=need, text='\n'.join(lines) or (s.get('said') or '')), self.cfg, 'assist')
            except Exception as e:
                return False, tx(f'起草失败：{e}', f'Drafting failed: {e}')[:300]
            return True, {'draft': text.strip()[:600]}
        if what == 'work_lang':  # (the language the models write in for the person)
            v = 'en' if body.get('lang') == 'en' else 'zh'
            self.cfg['work_lang'] = v
            save_config({'work_lang': v})
            return True, {'zh': 'agent 的工作语言：中文。之后写的总结、简报、回答都用中文', 'en': 'Agents now write in English: summaries, reports and answers from here on'}[v]
        if what == 'titles':
            self.cfg['pane_titles'] = bool(body.get('on'))
            save_config({'pane_titles': self.cfg['pane_titles']})
            return True, tx('窗格标题：' + ('开' if self.cfg['pane_titles'] else '关'), 'Pane titles: ' + ('on' if self.cfg['pane_titles'] else 'off'))
        return False, tx(f'不认识的操作 {what}', f'Unknown action {what}')

    def board_act(self, what, key, body):
        """The person on a channel: posts, starts or closes a discussion, has read it."""
        meta = A.channels().get(key)
        if not meta:  # (a project's or a workspace's that nobody has posted to yet)
            ch = self.projects.channel(self.projects.known.get(key)) or self.projects.ws_channel(key)
            if not ch:
                return False, tx('没有这个讨论区', 'No such channel')
            A.chan_ensure(ch)
            meta = ch
        try:
            if what == 'board_seen':
                A.put(A.seen_file(key, ME_NAME), {'at': time.time(), 'ids': [], 'auto': False})
                return True, {}
            if what == 'board_post':
                text = (body.get('text') or '').strip()
                if not text:
                    return False, tx('先写要说的话', 'Write what to say first')
                m = A.post(ME_NAME, key, text, body.get('topic') or None)
                A.put(A.seen_file(key, ME_NAME), {'at': m['at'], 'ids': [], 'auto': False})
                return True, tx(f'发到了 {meta["name"]} 的讨论区' + (f'，叫了 {"、".join(m["to"])}' if m['to'] else ''), f'Posted to the channel of {meta["name"]}' + (f', calling {", ".join(m["to"])}' if m['to'] else ''))
            if what == 'topic_new':
                title = (body.get('title') or '').strip()
                invite = [n for n in body.get('invite') or [] if isinstance(n, str) and NAME.fullmatch(n)]
                if not title:
                    return False, tx('给讨论起个题目', 'Give the discussion a topic')
                t = A.topic_new(ME_NAME, key, title, (body.get('text') or '').strip(), invite, int(body.get('max') or A.TOPIC_MAX))
                return True, {'msg': tx(f'在 {meta["name"]} 发起了讨论「{t["title"]}」' + (f'，叫了 {"、".join(invite)}' if invite else ''), f'Started the discussion “{t["title"]}” in {meta["name"]}' + (f', calling {", ".join(invite)}' if invite else '')), 'topic': t['id']}
            t = A.topic_close(ME_NAME, key, str(body.get('topic') or ''))
            return True, tx(f'讨论「{t["title"]}」结束了', f'The discussion “{t["title"]}” has ended')
        except ValueError as e:
            return False, str(e)

    # ---------- the queue: things to hand a session once it is free, checked by the assistant first ----------
    def qsave(self):
        A.put(self.qfile, self.queue[-300:])

    def queue_act(self, b):
        what = b.get('do')
        if what == 'add':
            text = (b.get('text') or '').strip()
            if not text:
                return False, tx('写下要做的事', 'Write what to do first')
            to, group = (b.get('to') or '').strip(), (b.get('group') or '').strip()
            item = {'id': os.urandom(5).hex(), 'text': text[:4000], 'to': to, 'group': group, 'mode': b.get('mode') if b.get('mode') in ('remind', 'plain') else 'auto',
                    'status': 'waiting', 'created': time.time(), 'note': ''}
            self.queue.append(item)
            self.qsave()
            if item['mode'] == 'plain':
                return True, tx(f'{to} 正在做事：等它这一轮做完，把你的原话发给它', f'{to} is working: your words will be sent when it finishes this turn')
            where = tx(f'等 {to} 空闲', f'wait for {to} to be free') if to else tx(f'等{group + " 组里" if group else ""}有会话空闲', f'wait for a free session{" in group " + group if group else ""}')
            return True, tx(f'排上了：{where}，' + ('到时先由助手确认再发' if item['mode'] == 'auto' else '到时提醒你'), f'Queued: {where}; ' + ('the assistant checks it before sending' if item['mode'] == 'auto' else 'you will be reminded then'))
        item = next((q for q in self.queue if q['id'] == b.get('id')), None)
        if not item:
            return False, tx('找不到这件排队的事', 'Queued item not found')
        if what == 'delete':
            self.queue.remove(item)
        elif what == 'drop':
            item.update(status='dropped', note=item.get('note') or tx('你取消了', 'You dropped it'))
        elif what == 'restore':
            item.update(status='waiting', note='', checked=0)
        elif what == 'edit':
            item['text'] = (b.get('text') or item['text']).strip()[:4000]
            if 'to' in b:
                item['to'] = (b.get('to') or '').strip()
        elif what == 'send':
            s = self.find_name(b.get('to') or item.get('to') or item.get('ready_to'))
            if not s:
                return False, tx('先选一个要发给的会话', 'Pick a session to send to first')
            ok, msg = self.deliver(s, item.get('text'))
            if not ok:
                return False, msg
            item.update(status='sent', sent_to=s['name'], sent_at=time.time(), note=tx('你手动发出', 'Sent by you'))
        else:
            return False, tx('不认识的操作', 'Unknown action')
        self.qsave()
        return True, tx({'delete': '删掉了', 'drop': '不发了', 'restore': '重新排上了', 'edit': '改好了', 'send': f'发给了 {item.get("sent_to")}'}[what], {'delete': 'Deleted', 'drop': 'Dropped', 'restore': 'Queued again', 'edit': 'Changed', 'send': f'Sent to {item.get("sent_to")}'}[what])

    def find_name(self, name):
        return next((x for x in self.state['sessions'] if x['name'] == name and not x.get('unknown')), None) if name else None

    def deliver(self, s, text):
        """Hand a session the text: into its terminal when it is in a pane, else into its amail box."""
        if s.get('loc'):
            ok, msg = self.type_in(s, text, True)
            if ok:
                return True, msg
        sent = A.send(ME_NAME, s['name'], text)
        return (True, tx(f'放进了 {s["name"]} 的信箱', f'Put in the mailbox of {s["name"]}')) if sent else (False, tx('发不出去', 'Could not send'))

    def free(self, s):
        return s['state'] == 'idle' and not s.get('needs_you') and s.get('status') not in ('waiting_user', 'blocked') and not s.get('unknown') and not s.get('stale')

    def queue_loop(self):
        while True:
            try:
                self.queue_pass()
            except Exception as e:
                self.note(tx(f'排队处理出错：{e!r}', f'Queue pass failed: {e!r}'), False)
            time.sleep(8)

    def queue_pass(self):
        now = time.time()
        sessions = self.state['sessions']
        for item in self.queue:
            if item['status'] not in ('waiting', 'held'):
                continue
            if item['status'] == 'held' and now - item.get('checked', 0) < 600:
                continue
            if item['to']:
                t = self.find_name(item['to'])
                if not t:
                    item.update(status='held', note=tx(f'{item["to"]} 不在了：换一个会话，或删掉', f'{item["to"]} is gone: pick another session, or delete it'), checked=now)
                    self.qsave()
                    continue
                if item['mode'] == 'plain':  # (the person's own words, held while it worked: as they are, once it stops)
                    if t['state'] in ('idle', 'waiting') and not t.get('prompting') and not t.get('unknown'):
                        ok, msg = self.deliver(t, item['text'])
                        item.update(status='sent' if ok else 'held', sent_to=t['name'] if ok else None, sent_at=now if ok else None, checked=now,
                                    note=tx('它这一轮做完了，原话发出', 'It finished its turn; your words were sent') if ok else tx(f'没发出去：{msg}', f'Not sent: {msg}')[:200])
                        self.qsave()
                    continue
                cands = [t] if self.free(t) else []
            else:
                cands = [x for x in sessions if self.free(x) and (not item['group'] or (x.get('loc') or {}).get('session') == item['group'])]
            if not cands:
                continue
            if item['mode'] == 'remind':
                item.update(status='ready', note=tx(f'{cands[0]["name"]} 空了，可以发了', f'{cands[0]["name"]} is free; ready to send'), ready_to=cands[0]['name'])
                self.qsave()
                continue
            item['status'] = 'checking'
            self.qsave()
            decs = '\n'.join(f'- {d["what"]}（{d["name"]}）' for d in self.sums.decisions[-12:]) or '（没有）'
            lines = '\n'.join(f'- {x["name"]} · 空闲 · {x.get("title") or ""} · {x.get("summary") or ""}' for x in cands[:8])
            prompt = CHECK.format(when=time.strftime('%m-%d %H:%M'), queued=ago_text(item['created']), text=item['text'], candidates=lines, decisions=decs,
                                  to_rule=f'只能是 {item["to"]}' if item['to'] else '从候选里挑最合适的一个')
            try:
                out = ask_model(prompt, self.cfg, 'assist')
                m = re.search(r'\{.*\}', out, re.S)
                r = json.loads(m.group(0)) if m else {}
            except Exception as e:
                item.update(status='waiting', note=tx(f'助手没回上来，稍后再试：{e}', f'The assistant did not answer; will try again later: {e}')[:160], checked=now)
                self.qsave()
                continue
            verdict, reason = r.get('verdict'), str(r.get('reason') or '')[:160]
            item['checked'] = now
            if verdict == 'drop':
                item.update(status='dropped', note=tx(f'助手觉得不用发了：{reason}', f'The assistant thinks it need not be sent: {reason}'))
            elif verdict == 'send':
                t = self.find_name(item['to'] or r.get('to'))
                t = t if t in cands else cands[0]
                text = str(r.get('text') or item['text']).strip() or item['text']
                ok, msg = self.deliver(t, text)
                item.update(status='sent' if ok else 'held', sent_to=t['name'] if ok else None, sent_at=now if ok else None,
                            sent_text=text if ok else None, note=(tx(f'助手确认后发出：{reason}', f'Sent after the assistant checked: {reason}') if ok else tx(f'没发出去：{msg}', f'Not sent: {msg}'))[:200])
                if ok:
                    self.note(tx(f'排队的事发给了 {t["name"]}', f'Queued item sent to {t["name"]}'))
            else:
                item.update(status='held', note=tx(f'助手建议先等：{reason}', f'The assistant suggests waiting: {reason}'))
            self.qsave()

    # ---------- the sessions that last (kept.py): what the rows are bound to, and the person's word on them ----------

    def first_spaces(self):
        """Once: the workspaces this deck used to find by itself (a folder of projects that sessions worked in) become
        the person's own, each with that one folder, under the key it had: its channel and its tasks stay its."""
        if self.book.meta('spaces'):
            return
        # (only folders still there, and none under a temporary folder; of two with one inside the other, the inner one:
        # the outer got to be a workspace only as "the folder above")
        tmp = tuple(dict.fromkeys(os.path.realpath(t).rstrip('/') + '/' for t in ('/tmp', '/var/folders', __import__('tempfile').gettempdir())))
        ws = [w for w in self.projects.workspace_paths() if os.path.isdir(w) and not (os.path.realpath(w) + '/').startswith(tmp) and not w.startswith(CACHE)]
        for w in ws:
            if any(x != w and x.startswith(w + '/') for x in ws):
                continue
            with contextlib.suppress(ValueError):
                self.book.space_add(ws_name(w), [w], sid=A.key_of('w', w))
        self.book.meta('spaces', time.time())

    def bind(self, sessions, born, now):
        """Each row is told the session it is ('kept'); a run another session started is its starter's. A process is one
        session's while it shows one conversation at a time: Claude Code's and Cursor's own, a Codex window (the Codex
        daemon its hooks run in is every thread's, so it names none)."""
        for s in sessions:
            if not K.bindable(s):
                continue
            pid = s.get('window_pid') or (s.get('pid') if s['kind'] != 'codex' else None)
            s['proc'], s['pid_at'] = pid, ((born.get(pid) or (A.proc(pid) or (0, 0, 0))[2] or 0) if pid else 0)
            if pid and (pid, s['pid_at']) not in self.wants:
                self.wants[(pid, s['pid_at'])] = (env_of(pid, 'STURNUS_SESSION') or '', env_of(pid, 'STURNUS_NEW') or '')
            s['want'], s['mark'] = [x or None for x in self.wants.get((pid, s['pid_at'])) or ('', '')]
        if len(self.wants) > 3000:
            self.wants.clear()
        got = self.book.bind(sessions, now, boot_time(), lambda t: T.there(T.loc_of(t)))
        by_id = {s['id']: s for s in sessions}
        for s in sessions:
            s['kept'] = got.get(s['id']) or (s.get('kept') if s.get('starting') else None)
            if s['kept'] and not s.get('title'):  # (until a summary says what it works on: what its session is called)
                s['title'] = (self.kept.get(s['kept']) or {}).get('title') or ''
        for s in sessions:
            if not s['kept'] and s.get('parent_id') in by_id:
                s['kept'] = by_id[s['parent_id']].get('kept')

    def meta_of(self, k, l, now):
        """The model a session runs on, with its effort and speed: read from the end of its conversation file when that
        has grown (every few seconds at most), and kept in the record, so a stopped session still says what it last ran on."""
        try:
            old = json.loads(k['meta']) if k.get('meta') else {}
        except ValueError:
            old = {}
        seg = k.get('seg')
        if not l or not seg or seg['kind'] not in ('claude', 'codex'):
            return old
        path = seg['path'] or l.get('transcript') or ''
        try:
            sig = (path, os.path.getsize(path))
        except OSError:
            return old
        hit = self.metas.get(k['id'])
        if hit and (hit[1] == sig or now - hit[0] < 6):
            return hit[2] or old
        got = conv_meta(path, seg['kind']) or old
        self.metas[k['id']] = (now, sig, got)
        if got != old:
            with contextlib.suppress(K.No, sqlite3.Error):
                self.book.set(k['id'], meta=got)
        return got

    def kept_view(self, sessions):
        """The sessions that last as the page lists them, each with the row that runs it now: the pinned and the running
        ones, and the latest 120 of the rest (all of them, the archived too, are at /api/kept). And the workspaces, each
        with its folders, how many sessions it has, and the group most of its running ones are in."""
        live, now = {}, time.time()
        for s in sessions:
            if s.get('kept') and not s.get('parent_id') and not s.get('hidden') and (s['kept'] not in live or live[s['kept']].get('unknown')):
                live[s['kept']] = s
        out = []
        for k in self.book.all():
            l, t, lt = live.get(k['id']), k.get('term'), k.get('last_term')
            if l and not t and not l.get('starting'):
                l = None  # (stopped a moment ago: what is still seen of it is on its way out)
            v = {f: k[f] for f in ('id', 'title', 'space', 'spaced', 'folder', 'kind', 'name', 'branch', 'made', 'at', 'pinned', 'archived', 'state', 'note', 'nsegs', 'nterms')}
            v.update(live=l and l['id'], conv=(k.get('seg') or {}).get('conv'), show=tilde(k['folder']), wt=k.get('wt') or '', model=self.meta_of(k, l, now),
                     term=t and {x: t[x] for x in ('n', 'mux', 'grp', 'pane', 'origin', 'began')},
                     ended=None if t or not lt else {'at': lt['ended'], 'why': lt['why']})
            out.append(v)
        self.kept = {k['id']: k for k in out}
        spaces = []
        for sp in self.book.spaces():
            mine = [k for k in out if k['space'] == sp['id'] and not k['archived']]
            groups = Counter(g for g in ((live[k['id']].get('loc') or {}).get('session') for k in mine if k['id'] in live) if g)
            spaces.append({'id': sp['id'], 'name': sp['name'], 'grp': sp['grp'], 'archived': sp['archived'], 'made': sp['made'],
                           'group': groups.most_common(1)[0][0] if groups else '', 'n': len(mine), 'live': sum(1 for k in mine if k['live']),
                           'places': [{'path': p['path'], 'show': tilde(p['path']), 'main': p['main'], 'there': os.path.isdir(p['path'])} for p in sp['places']]})
        shown = [k for k in out if not k['archived']]
        return [k for k in shown if k['pinned'] or k['live']] + [k for k in shown if not (k['pinned'] or k['live'])][:120], spaces

    def kept_refresh(self):
        """The page's list, now: after the person's word, not at the next collect."""
        self.book.bind(self.everyone, time.time(), boot_time(), lambda t: T.there(T.loc_of(t)))
        kept, spaces = self.kept_view(self.everyone)
        with self.lock:
            self.state['kept'], self.state['spaces'] = kept, spaces

    def kept_live(self, kid):
        """The row that runs a session now, or None."""
        lid = (self.kept.get(kid) or {}).get('live')
        return next((s for s in self.everyone if s['id'] == lid and s['state'] not in ('gone', 'ended')), None) if lid else None

    def kept_page(self, kid):
        k = self.book.get(kid)
        if not k:
            return None
        s = self.kept_live(kid)
        for t in k['terms']:
            t['words'] = T.attach_words(T.loc_of(t)) if t['ended'] is None and T.loc_of(t) else ''
        return {'ok': True, 'kept': {**k, 'live': s and s['id'], 'show': tilde(k['folder'])}}

    def keep_talk(self, only=None, room=8 << 20):
        """Each session's latest conversation, copied into the record as far as its file has grown (kept.py's said): at
        most ROOM bytes of a file a pass. A long file first met is read from its last six megabytes on. The conversation
        before the latest is read to its end too: its last words may not have been read when it was left."""
        left, pairs = 3 * room, []
        for k in ([self.book.get(only)] if only else self.book.all()):
            if k:
                pairs += [(k, seg) for seg in (k['segs'][-2:] if only else (k.get('prev'), k.get('seg'))) if seg]
        for k, seg in pairs:
            if left <= 0:
                break
            path = seg['path'] if seg['path'] and os.path.exists(seg['path']) else transcript_of({'kind': seg['kind'], 'session': seg['conv']})
            if not path or path.endswith('/store.db'):
                continue
            with self.keep_lock:
                try:
                    size = os.path.getsize(path)
                    r = self.book.reading(path)
                    off, first = (r['off'], False) if r else (max(0, size - 6 * (1 << 20)), True)
                    if size < off:  # (the file was cut short or written anew: on from its end as it is, not from the middle of a line later)
                        self.book.say(k['id'], seg['n'], path, size, [])
                    if size <= off:
                        continue
                    with open(path, 'rb') as f:
                        f.seek(off)
                        data = f.read(min(size - off, room))
                except OSError:
                    continue
                left -= len(data)
                head = data.find(b'\n') + 1 if first and off else 0  # (begun in the middle of a line: from the next one)
                end = data.rfind(b'\n')
                if end < head:
                    if len(data) == room:  # (one line longer than a pass reads: past it)
                        self.book.say(k['id'], seg['n'], path, off + len(data), [], clipped=first and off > 0)
                    continue
                self.book.say(k['id'], seg['n'], path, off + end + 1, said_of(data[head:end], path, off + head, functools.partial(self.book.pic_keep, k['id'])), clipped=first and off > 0)

    def keep_whole(self, kid, seg, room=512 << 20):
        """One of a session's conversations read again from its file's start, and the record's copy of it replaced in one
        step: for a long file first read from near its end, when the page is asked for what came before; and for a
        copy an older reading made (kept.py's SAID_V). A file longer than ROOM is read from ROOM before its end. A file
        that now holds less than the copy does leaves the copy as it is. Returns whether the copy was made."""
        path = seg['path'] if seg['path'] and os.path.exists(seg['path']) else transcript_of({'kind': seg['kind'], 'session': seg['conv']})
        if not path or path.endswith('/store.db'):
            return False
        with self.keep_lock:
            items, carry, done = [], b'', 0
            try:
                size = os.path.getsize(path)
                with open(path, 'rb') as f:
                    f.seek(max(0, size - room))
                    if f.tell():
                        f.readline()  # (begun in the middle of a line: from the next one)
                    base = f.tell()
                    while base + done + len(carry) < size:
                        data = carry + f.read(min(8 << 20, size - base - done - len(carry)))
                        end = data.rfind(b'\n')
                        if end < 0:
                            if len(data) == len(carry):
                                break  # (the file is shorter than it said)
                            carry = data  # (a line longer than one read: more of it)
                            continue
                        items += said_of(data[:end], path, base + done, functools.partial(self.book.pic_keep, kid))
                        done, carry = done + end + 1, data[end + 1:]
            except OSError:
                return False
            # (the record's copy outlasts the file: a file cut short or written anew since it was read has less than the copy, which then stays)
            if len([1 for it in items if K.worth(it)]) < self.book.said_in(kid, seg['n']):
                return False
            self.book.say(kid, seg['n'], path, base + done, items, clipped=2 if base else 0, whole=True)  # (2: from as far back as is read at all)
        return True

    def keep_again(self, room=256 << 20):
        """The copies an older reading made, made again, a few each pass (ROOM bytes of files at most, one file at least):
        sessions running now first, then the latest. A file that is gone keeps the copy it has."""
        rows = self.book.stale()
        if not rows:
            return
        kept = {k['id']: k for k in self.book.all()}
        rows.sort(key=lambda r: (not (kept.get(r['kept']) or {}).get('live'), -((kept.get(r['kept']) or {}).get('at') or 0)))
        done = False
        for r in rows:
            k = self.book.get(r['kept']) if r['kept'] in kept else None
            seg = next((x for x in (k or {}).get('segs') or [] if x['n'] == r['seg']), None)
            try:
                size = os.path.getsize(r['path'])
            except OSError:
                size = None
            if not seg or size is None or (seg['path'] and seg['path'] != r['path']):
                self.book.reread(r['path'])
                continue
            if size > room and done:
                break  # (too much for what is left of this pass: the next one begins with it)
            if not self.keep_whole(r['kept'], {**seg, 'path': r['path']}):
                self.book.reread(r['path'])
            room, done = room - size, True
            if room <= 0:
                break

    def keep_loop(self):
        time.sleep(12)
        while True:
            try:
                self.keep_talk()
                self.keep_again()
            except Exception as e:
                self.note(tx(f'抄录对话出错：{e!r}', f'Copying the conversations failed: {e!r}'), False)
            time.sleep(15)

    def handover(self, kid, kind, words=''):
        """What another agent is told when it takes a session on: what the session is for, what was settled, where it
        stands, the last of what was said, and the file with all of it (written now). In the agents' working language.
        Returns (note, file)."""
        k = self.book.get(kid)
        if not k:
            return '', ''
        self.keep_talk(only=kid)
        en = (self.cfg.get('work_lang') or 'zh') == 'en'
        w = lambda zh, e: e if en else zh
        full = {'claude': 'Claude Code', 'codex': 'Codex', 'cursor': 'Cursor'}
        said = self.book.said(kid, 4000, talk=True)
        folder = os.path.join(os.path.dirname(self.book.path), 'handover')
        os.makedirs(folder, mode=0o700, exist_ok=True)
        f = os.path.join(folder, f'{kid}.md')
        who = {'user': w('用户', 'The person'), 'assistant': w('助手', 'The agent')}
        with open(f, 'w') as h:
            h.write(f'# {k["title"] or kid}\n\n' + w(f'目录：{k["folder"]}\n\n以下是这条会话到目前为止说过的话，按先后。\n', f'Folder: {k["folder"]}\n\nEverything said in this session so far, in order.\n'))
            for it in said:
                h.write(f'\n## {who.get(it["who"], it["who"])}' + (f'（{full.get(it["kind"], it["kind"])}）' if it['who'] == 'assistant' else '')
                        + (time.strftime(' %Y-%m-%d %H:%M', time.localtime(it['at'])) if it.get('at') else '') + f'\n\n{it["text"]}\n'
                        + (w(f'\n（附了 {len(it["pics"])} 张图片）\n', f'\n({len(it["pics"])} picture{"s" if len(it["pics"]) > 1 else ""} came with this)\n') if it.get('pics') else ''))
        ids = {f'{x["kind"]}:{x["conv"]}' for x in k['segs']}
        tasks = [t for t in self.state.get('tasks') or [] if t.get('shown') not in ('done', 'dropped', 'backlog')
                 and any(l.get('sid') in ids or (k['name'] and l.get('name') == k['name']) for l in t.get('sessions') or [])][:3]
        topics = [x for sid in sorted(ids, key=lambda i: -((self.stories.data.get(i) or {}).get('at') or 0)) for x in (self.stories.data.get(sid) or {}).get('topics') or []][:12]
        dirty = len((git(k['work'] or k['folder'], 'status', '--porcelain') or '').splitlines()) if os.path.isdir(k['work'] or k['folder'] or '') else 0
        last, room = [], 5000
        for it in reversed(said[-14:]):
            line = f'{who.get(it["who"], it["who"])}: {" ".join(it["text"].split())[:700]}'
            if room - len(line) < 0:
                break
            room -= len(line)
            last.insert(0, line)
        was = full.get(k['kind'], k['kind'] or '?')
        out = [w(f'你来接手一条进行中的会话，之前由 {was} 在做。下面是交接说明；要细节时读完整记录：{f}', f'You are taking on a session under way, so far done by {was}. Below is the handover; for detail, read the full record: {f}'),
               w(f'这条会话在做的事：{k["title"] or "（没有名字）"}', f'What this session is for: {k["title"] or "(not named)"}'),
               w(f'目录：{k["folder"]}', f'Folder: {k["folder"]}') + (w(f'，分支 {k["branch"]}', f', branch {k["branch"]}') if k['branch'] else '')
               + (w(f'，有 {dirty} 个文件还没提交', f', {dirty} file(s) not committed') if dirty else '')]
        for t in tasks:
            out.append(w(f'任务「{t["title"]}」：现状 {t.get("now") or "—"}；接着做 {t.get("next") or "—"}', f'Task “{t["title"]}”: now {t.get("now") or "—"}; next {t.get("next") or "—"}'))
        if topics:
            out.append(w('已经定下的事：', 'Settled so far:'))
            out += [f'- {x.get("topic")}: {x.get("now")}' + (f'（{x["why"]}）' if x.get('why') else '') for x in topics]
        if last:
            out.append(w('最近说过的话（更早的在完整记录里）：', 'The last of what was said (earlier words are in the full record):'))
            out += last
        out.append(w('接下来：', 'Next: ') + (words.strip() or w('先读完整记录里和现状有关的部分，再说你打算怎么接着做，等用户确认。', 'read what bears on where things stand in the full record, then say how you mean to go on, and wait for the person to confirm.')))
        return '\n'.join(out), f

    def recover_view(self, kept):
        """The sessions the last restart of the machine ended, not gone on with since: offered once, to go on together."""
        if self.recovered == str(int(boot_time())):
            return []
        return [k['id'] for k in kept if not k['archived'] and not k['live'] and (k.get('ended') or {}).get('why') == 'restart' and (k['ended'].get('at') or 0) > boot_time() - 14 * 86400]

    def recover(self, b):
        ids = self.recover_view(list(self.kept.values()))
        self.recovered = self.book.meta('recover', int(boot_time()))
        if b.get('do') != 'all':
            self.kept_refresh()
            return True, {}
        done = []
        for kid in ids:
            ok, _ = self.launch(kid)
            done += [kid] if ok else []
        self.kept_refresh()
        return True, tx(f'继续了 {len(done)} 条会话' + (f'，{len(ids) - len(done)} 条没开起来' if len(done) < len(ids) else ''), f'{len(done)} session(s) going on' + (f', {len(ids) - len(done)} could not be started' if len(done) < len(ids) else ''))

    def search(self, q):
        """Where something was said, for the page: each hit with its session's title and a line around the words."""
        out = []
        for h in self.book.find(q, 40):
            k = self.kept.get(h['kept'])
            if not k:
                continue
            text = ' '.join(h['text'].split())
            i = max(0, text.lower().find(q.lower()) - 40)
            out.append({'kept': h['kept'], 'title': k['title'] or k['name'], 'who': h['who'], 'at': h['at'], 'archived': bool(k['archived']), 'line': ('…' if i else '') + text[i:i + 160]})
        return out

    def kept_items(self, kid, limit=200):
        """A session's conversations one after another, as items for the page ({who, text, at, seg}): the last of them,
        from the record's own copy (brought up to date first); from the files themselves while it has none."""
        try:
            self.keep_talk(only=kid)
            got = self.book.said(kid, limit)
            if got:
                return got
        except (sqlite3.Error, OSError):
            pass
        out = []
        for seg in (self.book.get(kid) or {}).get('segs') or []:
            path = seg['path'] if seg['path'] and os.path.exists(seg['path']) else transcript_of({'kind': seg['kind'], 'session': seg['conv']})
            if not path:
                continue
            try:
                st = os.stat(path)
            except OSError:
                continue
            hit = self.items.get(path)
            if not hit or hit[0] != (st.st_size, st.st_mtime):
                if len(self.items) > 200:
                    self.items.clear()
                hit = self.items[path] = ((st.st_size, st.st_mtime), transcript_items(path, limit))
            out += [{**it, 'seg': seg['n'], 'kind': seg['kind']} for it in hit[1]]
        return out[-limit:]

    def kept_pic(self, kid, seg, n, i, h=''):
        """One picture of a session's conversation: (png|jpeg|gif|webp, its bytes), or None when it is not there any
        more. A picture the person sent is kept with the record; another (what a step showed the agent) is read from
        where it lies in the agent's own file, and is there as long as that file holds it."""
        p = self.book.pic(kid, seg, n, i)
        if not p or p.get('t') not in PIC_TYPES or (h and p.get('h') != h):
            return None
        try:
            own = self.book.pic_kept(kid, f'{p["h"]}.{p["t"]}') if p.get('k') else None
            if own:
                with open(own, 'rb') as f:
                    return p['t'], f.read()
            if not 0 < p['l'] <= PIC_MOST:
                return None
            with open(p['p'], 'rb') as f:
                f.seek(p['o'])
                raw = f.read(p['l'])
            if len(raw) != p['l'] or hashlib.sha1(raw).hexdigest()[:16] != p['h']:  # (the file is not what it was when this was read)
                return None
            return p['t'], base64.b64decode(raw, validate=True)
        except (OSError, ValueError, KeyError, TypeError):
            return None

    def kept_said(self, kid, limit=200):
        """The last LIMIT of what was said in a session, and whether there is more before it: (items, more). Asked for
        more than the record holds of a conversation that was first read from near its end, the whole file is read
        now, once."""
        limit = max(50, min(int(limit or 200), 20000))
        items = self.kept_items(kid, limit)
        try:
            n, clipped = self.book.said_n(kid)
            if clipped and limit > 200 and n < limit:
                segs = {r['path']: r['seg'] for r in self.book.readings().values() if r['kept'] == kid}
                for path in clipped:
                    seg = next((x for x in (self.book.get(kid) or {}).get('segs') or [] if x['n'] == segs.get(path)), None)
                    if not seg or not self.keep_whole(kid, {**seg, 'path': path}):
                        self.book.reread(path)  # (its beginning cannot be read: not asked for again)
                items = self.kept_items(kid, limit)
                n, clipped = self.book.said_n(kid)
            return items, n > len(items) or bool(clipped)
        except (sqlite3.Error, OSError):
            return items, False

    @staticmethod
    def kept_words(e):
        """Why something asked of the record cannot be, in the person's language."""
        a = e.args[1:]
        return {'name': tx('先起个名字', 'Give it a name first'), 'there': tx('已经有这个工作区了', 'That workspace is already there'),
                'folder': tx('这个目录不能当工作区的目录', 'That folder cannot be a workspace’s'),
                'taken': tx(f'{tilde(a[0])} 已经在工作区「{a[1]}」里了', f'{tilde(a[0])} is already in workspace “{a[1]}”') if len(a) == 2 else '',
                'space': tx('没有这个工作区', 'No such workspace'), 'place': tx('这个目录不在这个工作区里', 'That folder is not in this workspace'),
                'session': tx('找不到这条会话', 'Session not found'), 'archive': tx('先归档，才能删除', 'Archive it first, then delete')}.get(getattr(e, 'code', ''), str(e))

    def stop(self, s, kid=None, why='stopped'):
        """A session's agent ended, with what it started: its window's process (a Codex thread with no window of its own,
        the desktop app's, has none to end). Its terminal is marked over at once, for the reason given."""
        pid = s.get('window_pid') or (s.get('pid') if s['kind'] != 'codex' else None)
        if not pid:
            return False
        at = (A.proc(pid) or (0, 0, 0))[2]
        if at and s.get('pid_at') and abs(at - s['pid_at']) > 2:
            return False  # (that number is another process's by now: not this session's to end)
        for p in ([pid] + [p for p in A.pids() if any(a == pid for a, _ in A.ancestors(p)[1:])]) if at else []:
            with contextlib.suppress(OSError):
                os.kill(p, signal.SIGTERM)
        if kid:
            self.book.close(kid, why)
        return True

    def rest_pass(self, now=None):
        """Sessions nobody has used for the days set (rest_days) have their terminals closed: an agent at rest still holds
        its memory and its pane. Only one at rest (idle, or waiting on the person for an answer in words) with no prompt
        open, that nobody is looking at, that is not
        pinned, whose process is the deck's to end and whose conversation is there to go on with. It stays in the list,
        stopped, and goes on in a new terminal when taken up again. Returns the sessions it closed."""
        days = float(self.cfg.get('rest_days', DEFAULTS['rest_days']) or 0)
        if days <= 0:
            return []
        now, out = now or time.time(), []
        for s in list(self.everyone):
            k = self.kept.get(s.get('kept') or '')
            if (not k or k['pinned'] or k['live'] != s['id'] or s.get('starting') or s.get('parent_id') or s.get('unknown')
                    or s['state'] not in ('idle', 'waiting') or s.get('prompting') or at_menu(s)  # (at rest, or waiting on the person with words; not at a prompt that only its terminal can answer)
                    or now - max(s.get('at') or 0, s.get('since') or 0, k.get('at') or 0) < days * 86400):
                continue
            if not (s.get('window_pid') or (s.get('pid') if s['kind'] != 'codex' else None)):
                continue  # (not the deck's to end: the Codex app's own)
            full = self.book.get(k['id'])
            seg = full['segs'][-1] if full and full['segs'] else None
            if not seg or seg['kind'] != s['kind'] or not ((seg['path'] and os.path.exists(seg['path'])) or transcript_of({'kind': seg['kind'], 'session': seg['conv']})):
                continue  # (nothing to go on with afterwards: left as it is)
            try:
                if s.get('loc') and T.in_view(s['loc']):
                    continue  # (someone has it in front of them)
            except Exception:
                continue
            if self.stop(s, k['id'], 'rested'):
                out.append(k['id'])
                self.note(tx(f'「{k["title"] or s["name"]}」{days:g} 天没用了：关了它的终端，对话都还在，要用时点继续', f'“{k["title"] or s["name"]}” was not used for {days:g} days: its terminal is closed, the conversation is all there, Go on takes it up again'))
        if out:
            self.kept_refresh()
        return out

    def take(self, kid, s, group=''):
        """A session running where the page cannot reach it — a terminal window outside Zellij and tmux, the Codex app —
        goes on in a terminal of the deck's own. A process the deck can end is ended first, so no two write one
        conversation; the Codex app's thread has none of its own, and is the person's to leave alone there."""
        if s.get('loc'):
            return False, tx('它已经在 Zellij 或 tmux 里了', 'It is already in Zellij or tmux')
        if s.get('starting') or s['state'] == 'working':
            return False, tx('它正在工作：等它停下来再搬', 'It is at work: move it once it has come to rest')
        pid = s.get('window_pid') or (s.get('pid') if s['kind'] != 'codex' else None)
        if pid:
            if not self.stop(s, kid, 'moved'):
                return False, tx('结束不了它现在的进程，没有搬', 'Its process could not be ended: not moved')
            for _ in range(50):
                if not A.proc(pid):
                    break
                time.sleep(.2)
            else:
                return False, tx('它现在的进程还没退出：等它退出后点「继续」', 'Its process has not exited yet: once it has, Go on')
        else:
            self.book.close(kid, 'moved')
        self.kept_refresh()
        return self.launch(kid, group=group, force=True)

    def kept_act(self, b):
        """The person's word on a session that lasts: its title, pinned, its workspace, stopped, archived (a running one
        is stopped first), deleted (an archived one only)."""
        kid, do = str(b.get('id') or ''), b.get('do')
        if not self.book.get(kid):
            return False, tx('找不到这条会话', 'Session not found')
        s, on = self.kept_live(kid), bool(b.get('on', True))
        try:
            if do == 'title':
                self.book.set(kid, title=str(b.get('title') or ''))
            elif do == 'pin':
                self.book.set(kid, pinned=on)
            elif do == 'space':
                self.book.set(kid, space=str(b.get('space') or ''))
            elif do == 'take':  # (out of where the page cannot reach it, into a terminal of the deck's own)
                return self.take(kid, s, str(b.get('group') or '')) if s else self.launch(kid, group=str(b.get('group') or ''))
            elif do == 'stop':
                if not s or not self.stop(s, kid):
                    return False, tx('它没有在这台机器的终端里跑，这里停不了', 'It is not running in a terminal on this machine, so it cannot be stopped from here')
            elif do == 'archive':
                if on and s:
                    self.stop(s, kid)
                self.book.set(kid, archived=on)
            elif do == 'delete':
                self.book.drop(kid)
            elif do == 'merge':  # (its own worktree merged into the main branch and taken away)
                if s:
                    return False, tx('它还在跑：先停止，再合并', 'It is still running: stop it first, then merge')
                k = self.book.get(kid)
                if not k['wt'] or not os.path.isdir(k['wt']):
                    return False, tx('这条会话没有 Sturnus 给它开的 worktree', 'This session has no worktree that Sturnus made for it')
                top = os.path.realpath(k['wt'])
                inside = lambda f: bool(f) and (os.path.realpath(f) + os.sep).startswith(top + os.sep)
                with self.lock:
                    rows = list(self.everyone)
                other = next((x for x in rows if x.get('kept') != kid and x['state'] not in ('gone', 'ended') and any(inside(x.get(f)) for f in ('cwd', 'home', 'work'))), None)
                if other:
                    who = other.get('title') or other.get('name') or other['id']
                    return False, tx(f'「{who}」还在这个 worktree 里跑：先停掉它，再合并', f'“{who}” is still running in this worktree: stop it first, then merge')
                ok, words = worktree_done(top, k['wt_branch'], drop=bool(b.get('drop')))
                if ok:
                    self.book.set(kid, wt='')
                    self.projects.places.clear()
                    self.kept_refresh()
                return ok, words
            else:
                return False, tx(f'不认识的操作 {do}', f'Unknown action {do}')
        except K.No as e:
            return False, self.kept_words(e)
        self.kept_refresh()
        return True, {}

    def space_act(self, b):
        """The person's word on a workspace: a new one, its name, its folders (one added, taken out, made the default
        for new sessions), its group for new terminals, archived, deleted."""
        do, sid = b.get('do'), str(b.get('id') or '')
        folder = lambda p: os.path.realpath(os.path.expanduser(str(p or '').strip()))
        try:
            if do == 'add':
                paths = [folder(p) for p in b.get('paths') or [] if str(p or '').strip()]
                gone = next((p for p in paths if not os.path.isdir(p)), None)
                if gone:
                    return False, tx(f'没有这个目录：{tilde(gone)}', f'No such folder: {tilde(gone)}')
                sid = self.book.space_add(str(b.get('name') or ''), paths)
            elif do == 'rename':
                self.book.space_set(sid, name=str(b.get('name') or ''))
            elif do == 'group':
                g = str(b.get('group') or '').strip()
                if g and not NAME.fullmatch(g.removeprefix('tmux:')):
                    return False, tx('组名只能用字母、数字和 _ . -', 'A group name can use only letters, digits and _ . -')
                self.book.space_set(sid, grp=g)
            elif do == 'place_add':
                p = folder(b.get('path'))
                if not os.path.isdir(p):
                    return False, tx(f'没有这个目录：{tilde(p)}', f'No such folder: {tilde(p)}')
                self.book.place_add(sid, p)
            elif do == 'place_drop':
                self.book.place_drop(sid, folder(b.get('path')))
            elif do == 'place_main':
                self.book.place_main(sid, folder(b.get('path')))
            elif do == 'archive':
                self.book.space_set(sid, archived=bool(b.get('on', True)))
            elif do == 'delete':
                self.book.space_drop(sid)
            else:
                return False, tx(f'不认识的操作 {do}', f'Unknown action {do}')
        except K.No as e:
            return False, self.kept_words(e)
        self.kept_refresh()
        return True, {'id': sid}

    def launch(self, kid, prompt='', group='', kind='', force=False):
        """A stopped session goes on in a new terminal; with KIND, another agent takes it on. Refused while one already
        runs for it: two processes on one conversation would both write it (FORCE: the caller has seen to that)."""
        if (not force and self.kept_live(kid)) or any(l.get('kept') == kid for l in self.launched.values()):
            return False, tx('这条会话已经在跑了：进它现在的终端', 'This session is already running: go to its terminal')
        sp = next((x for x in self.state.get('spaces') or [] if x['id'] == (self.kept.get(kid) or {}).get('space')), None)
        # (a name still held by a row on its way out is left to it: the mailbox knows one session by a name at a time)
        taken = {s['name'] for s in self.everyone if s['state'] not in ('gone', 'ended')}
        ok, r = launch_session(self.book, self.cfg, kid, prompt, group, (sp or {}).get('group') or '', taken, kind)
        if not ok:
            return False, r
        self.launched[r['marker']] = {'kind': r['kind'], 'name': r['tab'], 'group': r['group'], 'cwd': r['cwd'], 'at': time.time(), 'kept': kid}
        self.book.set(kid, archived=False)
        self.note(r['msg'])
        return True, {'msg': r['msg'], 'kept': kid, 'marker': r['marker']}

    def plan_act(self, b):
        """The person's word on what runs by the clock: one more, switched on or off, run now, deleted."""
        do, pid = b.get('do'), str(b.get('id') or '')
        try:
            if do == 'add':
                folder = os.path.realpath(os.path.expanduser(str(b.get('folder') or '').strip()))
                if not os.path.isdir(folder):
                    return False, tx(f'没有这个目录：{tilde(folder)}', f'No such folder: {tilde(folder)}')
                pid = self.book.plan_add(str(b.get('title') or ''), str(b.get('prompt') or ''), b.get('kind'), folder, str(b.get('every') or ''), str(b.get('space') or '') or None)
            elif do == 'set':
                self.book.plan_set(pid, live=bool(b.get('on')))
            elif do == 'delete':
                self.book.plan_drop(pid)
            elif do == 'run':
                p = next((x for x in self.book.plans() if x['id'] == pid), None)
                return self.plan_run(p, due=False) if p else (False, tx('没有这一项了', 'That one is gone'))
            else:
                return False, tx(f'不认识的操作 {do}', f'Unknown action {do}')
        except K.No as e:
            return False, {'plan': tx('要有名字，和要做的事', 'It needs a name, and what to do'), 'every': tx('选一个 agent，和什么时候做', 'Pick an agent, and when')}.get(e.code, str(e))
        with self.lock:
            self.state['plans'] = self.book.plans()
        return True, {'id': pid}

    def plan_run(self, p, due=True):
        """One run of something set by the clock: a new session with what it says, in its folder."""
        ok, r = False, ''
        try:
            ok, r = self.new_session({'kind': p['kind'], 'cwd': p['folder'], 'prompt': p['prompt'], 'space': p['space'] or '',
                                      'title': f'{p["title"]} · {time.strftime("%m-%d %H:%M")}'})
        except Exception as e:
            r = repr(e)
        finally:  # (run or not, its next time is set: one that fails is not tried again every half minute)
            self.book.plan_ran(p['id'], r.get('kept') if ok and isinstance(r, dict) else None, due=due)
        if not ok:
            self.note(tx(f'定时的「{p["title"]}」没开起来：{r}', f'“{p["title"]}”, set by the clock, could not be started: {r}'), False)
        with self.lock:
            self.state['plans'] = self.book.plans()
        return (True, {'kept': r.get('kept'), 'msg': r.get('msg')}) if ok else (False, r)

    def plan_loop(self):
        """What is set by the clock is started when its time comes (one that came due while the deck was down: once, late).
        A session the clock started is stopped once it has rested half an hour (PLAN_REST), while nobody but the clock
        has said anything in it: it is still there to read and go on with. One the person has spoken in, or pinned, is
        theirs to stop."""
        time.sleep(20)
        rested = time.time() - REST_EVERY + min(60, REST_EVERY)  # (the first look a minute after the deck is up)
        while True:
            try:
                now = time.time()
                if now - rested >= REST_EVERY:
                    rested = now
                    self.rest_pass(now)
                for p in self.book.plans():
                    if p['live'] and p['next'] and p['next'] <= now:
                        try:
                            self.plan_run(p)
                        except Exception as e:  # (one that fails does not hold the others up)
                            self.note(tx(f'定时的「{p["title"]}」出错：{e!r}', f'“{p["title"]}”, set by the clock, failed: {e!r}'), False)
                mine = self.book.plan_kept(now - 3 * 86400)
                for s in self.everyone if mine else []:
                    k = self.kept.get(s.get('kept')) if s.get('kept') in mine else None
                    if (k and not k['pinned'] and k['live'] == s['id'] and s['state'] == 'idle' and not s.get('starting') and now - (s.get('since') or now) > PLAN_REST
                            and self.book.asks(k['id']) <= 1):
                        self.stop(s, k['id'])
            except Exception as e:
                self.note(tx(f'定时任务出错：{e!r}', f'The clock failed: {e!r}'), False)
            time.sleep(min(30, REST_EVERY))

    def subs_out(self):
        """Sessions in the record that are no sessions of the person's, kept as such before the deck could tell them
        apart: taken out of the record (Codex's own files are not touched). A Codex sub-agent's thread: one whose every
        conversation is such a thread. A thread that kept no conversation (the desktop app's own short runs): one with
        no file ever named for it and none on disk, nothing of it copied here, and no title the person gave it. Only
        one that is not running and not pinned. Returns how many."""
        n = 0
        for k in self.book.all():
            if k['kind'] != 'codex' or k['pinned'] or k.get('term'):
                continue
            segs = (self.book.get(k['id']) or {}).get('segs') or []
            if not segs or any(x['kind'] != 'codex' for x in segs):
                continue
            files = [(x['path'] if x['path'] and os.path.exists(x['path']) else transcript_of({'kind': 'codex', 'session': x['conv']})) or '' for x in segs]
            subs = all(codex_sub(codex_meta(f)) for f in files)
            bare = (not any(files) and not any(x['path'] for x in segs) and not self.book.said_n(k['id'])[0]
                    and (not k['titled'] or k['title'] == k['name']))
            if subs or bare:
                with contextlib.suppress(K.No):
                    self.book.set(k['id'], archived=True)
                    self.book.drop(k['id'])
                    n += 1
        if n:
            self.note(tx(f'{n} 条记录不是你的会话（Codex 的子 agent 线程，或桌面应用自己起的、不留对话的临时线程），已从会话列表里拿掉',
                         f'{n} record(s) that were no sessions of yours (Codex sub-agent threads, or the desktop app\'s own short-lived threads that keep no conversation) were taken out of the sessions'))
            self.kept_refresh()
        return n

    def index_loop(self):
        """The conversations on disk, looked through now and then: one no session has yet becomes a stopped session."""
        time.sleep(8)
        while True:
            try:
                with self.book.read() as c:
                    known = {(r['kind'], r['conv']) for r in c.execute('SELECT kind, conv FROM segs UNION SELECT kind, conv FROM dropped')}
                self.book.learn(claude_convs(known) + codex_convs(known))
                self.subs_out()
            except Exception as e:
                self.note(tx(f'读磁盘上的旧对话出错：{e!r}', f'Reading the conversations on disk failed: {e!r}'), False)
            time.sleep(600)

    def new_session(self, b):
        """A new agent in a terminal of its own at a folder, as a session that lasts: in the workspace named, else the
        one its folder is in. Its group (a Zellij or tmux session; made in the background when new) is the one named,
        else the one its workspace's sessions are in, as the way terminals are opened here has it."""
        kind, group = b.get('kind'), (b.get('group') or '').strip()
        name, prompt = (b.get('name') or '').strip(), (b.get('prompt') or '').strip()
        cwd = os.path.realpath(os.path.expanduser((b.get('cwd') or '~').strip()))
        if kind not in ('claude', 'codex', 'cursor', 'shell'):
            return False, tx('选一个 agent，或终端', 'Pick an agent, or a terminal')
        way = T.WAYS['tmux-window' if group.startswith('tmux:') or b.get('mux') == 'tmux' else 'zellij-tab'] if group else T.way(self.cfg)
        group = group.removeprefix('tmux:')
        if group and not NAME.fullmatch(group):
            return False, tx('组名只能用字母、数字和 _ . -', 'A group name can use only letters, digits and _ . -')
        if name and not NAME.fullmatch(name):
            return False, tx('名字只能用字母、数字和 _ . -', 'A name can use only letters, digits and _ . -')
        if name and name in A.rows():
            return False, tx(f'{name} 已经有会话在用了', f'{name} is already used by a session')
        if not os.path.isdir(cwd):
            return False, tx(f'目录不存在：{cwd}', f'Folder does not exist: {cwd}')
        spaces = self.book.spaces()
        space = str(b.get('space') or '')
        if space and not any(x['id'] == space for x in spaces):
            return False, tx('没有这个工作区', 'No such workspace')
        argv = [os.environ.get('SHELL') or '/bin/bash', '-l'] if kind == 'shell' else agent_argv(self.cfg, kind, name=name)
        title, own = K.line(b.get('title'), 80), bool(K.line(b.get('title'), 80))
        if b.get('task_title') and kind != 'shell':  # (something the person asked to get done: a task from the start)
            scope = self.scope_at(cwd)
            if scope:
                b = {**b, 'task': A.task_do({'do': 'add', 'who': 'person', 'scope': scope[0], 'scope_name': scope[1], 'title': b['task_title']})}
        title = title or K.line(prompt.split('\n')[0], 60)
        if b.get('task'):  # (to work on a task: it says what to do unless the person wrote otherwise)
            task = A.task_get(b['task'])
            b = {**b, 'task': task['id']}
            title = title or K.line(task['title'], 60)
            prompt = prompt or self.task_brief(task)
        if prompt and kind != 'shell':
            argv.append(prompt)
        wt = None
        if b.get('worktree') and kind != 'shell':  # (a worktree and branch of its own, off the main branch)
            ok, where, branch = worktree_add(cwd, title or name)
            if not ok:
                return False, where
            if not space and K.nearest(spaces, cwd):
                space = K.nearest(spaces, cwd)  # (its workspace is the one of the folder it was asked for)
            cwd, wt = where, (where, branch)
        kid = None
        if kind != 'shell':
            kid = self.book.add(title=title, folder=cwd, kind=kind, space=space or None, name=name)
            if wt:  # (the worktree made for it: the only one that is its to merge and clear away)
                self.book.set(kid, wt=wt[0], wt_branch=wt[1])
            if title and not own:  # (called after its first ask for now: the summary's title takes over)
                with self.book.tx() as c:
                    c.execute('UPDATE kept SET titled = 0 WHERE id = ?', (kid,))
        sp = next((x for x in self.state.get('spaces') or [] if x['id'] == (space or K.nearest(spaces, cwd))), None)
        if not group:
            g = (sp or {}).get('group') or ''
            group = way.group(sp, {'id': kid}, g if g and g.startswith('tmux:') == (way.mux == 'tmux') else None).removeprefix('tmux:')
        marker = os.urandom(6).hex()
        env = [f'STURNUS_NEW={marker}'] + ([f'STURNUS_SESSION={kid}'] if kid else []) + ([f'AMAIL_NAME={name}'] if name else [])
        tab = name or (kid and K.line(title, 24)) or f'{tx("终端", "shell") if kind == "shell" else kind}·{os.path.basename(cwd) or "~"}'
        try:
            if kid:
                self.book.start(marker, kid)  # (the first process seen with this mark is the session's; what that one starts is not)
            ok, made, loc = way.start(group, tab, cwd, env, argv, marker)
        except Exception as e:
            ok, made, loc = False, tx(f'终端没开起来：{e!r}', f'The terminal could not be opened: {e!r}'), None
        if not ok:
            if kid:  # (nothing was started for it: it never was)
                self.book.set(kid, archived=True)
                self.book.drop(kid)
            if wt:
                worktree_gone(*wt, force=True)
            return False, made
        return self.started({**b, 'kept': kid}, kind, name, tab, f'tmux:{group}' if way.mux == 'tmux' else group, cwd, marker, made, loc)

    def started(self, b, kind, name, tab, group, cwd, marker, made, loc=None):
        if kind == 'shell':  # (not an agent: no card; the page opens it in its terminal once it runs)
            for _ in range(24):
                loc = loc or marked(marker)
                if loc:
                    return True, {'msg': tx(f'{made}在 {group.removeprefix("tmux:")} 里开了终端「{tab}」', f'{made}Opened terminal “{tab}” in {group.removeprefix("tmux:")}'), 'term': {'group': loc['session'], 'pane': loc['pane']}}
                time.sleep(.25)
            return True, tx(f'{made}在 {group.removeprefix("tmux:")} 里开了终端「{tab}」', f'{made}Opened terminal “{tab}” in {group.removeprefix("tmux:")}')
        if kind == 'codex' and name:
            self.pending[marker] = name  # (a Codex thread takes its name once it shows up)
        self.launched[marker] = {'kind': kind, 'name': name or tab, 'group': group, 'cwd': cwd, 'at': time.time(), 'kept': b.get('kept')}
        if b.get('task'):
            self.linking[marker] = {'task': b['task'], 'loc': loc, 'at': time.time()}
        if b.get('jump'):
            threading.Thread(target=self._jump_when_up, args=(marker, tab), daemon=True).start()
        msg = tx(f'{made}在 {group.removeprefix("tmux:")} 里开了「{tab}」（{ {"claude": "Claude Code", "codex": "Codex", "cursor": "Cursor"}[kind]}，{cwd.replace(os.path.expanduser("~"), "~")}）', f'{made}Opened “{tab}” in {group.removeprefix("tmux:")} ({ {"claude": "Claude Code", "codex": "Codex", "cursor": "Cursor"}[kind]}, {cwd.replace(os.path.expanduser("~"), "~")})')
        self.note(msg)
        return True, {'msg': msg, 'kept': b.get('kept'), 'marker': marker}

    def type_in(self, s, text, enter):
        """Type into a session's pane as if at its keyboard (and press Enter)."""
        if not s or not s.get('loc'):
            return False, tx('这个会话不在 Zellij 或 tmux 里', 'This session is not in Zellij or tmux')
        if DRY:
            self.note(tx(f'（试用，没有真的输入）{s["name"]}：{text[:80]}', f'(trial, nothing was typed) {s["name"]}: {text[:80]}'))
            return True, tx(f'（试用）会在 {s["name"]} 的终端里输入', f'(trial) would type in the terminal of {s["name"]}')
        loc = s['loc']
        ok, why = T.type_in(loc, text, enter, bool((self.state['groups'].get(loc['session']) or {}).get('clients')))
        if ok:
            return True, tx(f'已在 {s["name"]} 的终端里输入', f'Typed in the terminal of {s["name"]}')
        if why == 'grant':
            return False, tx(f'第一次在组 {loc["session"]} 里输入：Zellij 在你的终端里弹了一个授权框，按 y 同意后再发一次', f'First time typing in group {loc["session"]}: Zellij showed a permission prompt in your terminal; press y, then send again')
        if why == 'detached':
            return False, tx(f'写不进去：组 {loc["session"]} 要有终端连着', f'Could not type: group {loc["session"]} needs a terminal attached')
        return False, tx('写不进它的 tmux 窗格', 'Could not write to its tmux pane')

    def _jump_when_up(self, marker, tab):
        for _ in range(40):
            loc = marked(marker)
            if loc:
                ok, msg = go_to(loc)
                self.note(f'「{tab}」：{msg}', ok)
                return
            time.sleep(.25)
        self.note(tx(f'「{tab}」还没起来，稍后在卡片上点跳转', f'“{tab}” has not come up yet; use Jump on the card in a moment'), False)

