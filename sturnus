def one_line(x, n):
    return re.sub(r'\s+', ' ', str(x or '')).strip()[:n]


def standing(s):
    """How a session stands, in a word and in words: as the page shows it (the page also marks one that works on while
    something it asked waits on the person)."""
    st = s.get('status')
    if s['state'] in ('gone', 'ended'):
        return s['state'], 'exited'
    if s.get('stale'):
        return 'quiet', 'quiet for a day'
    asks = s.get('needs_you') or s.get('asks')
    if s['state'] == 'waiting' or at_menu(s) or (s['state'] != 'working' and (st == 'waiting_user' or (asks and st not in ('blocked', 'review')))):
        return 'waiting', 'waits on the person'
    if st == 'blocked':
        return 'blocked', 'blocked'
    if st == 'review':
        return 'review', 'ready for review'
    if s['state'] == 'working':  # (it can work on and still wait on the person for something it asked)
        return 'working', 'working; also waits on the person' if asks or st == 'waiting_user' else 'working'
    return 'idle', 'idle'


class Reports:
    """Each session's report: what it is for, what it got done, what was decided and by whom, where it stands, what is
    next. Made by the summary model when the conversation has moved on (at most every half hour), at once when asked."""

    def __init__(self):
        self.file = os.path.join(CACHE, 'reports.json')
        self.data = A.get(self.file, {}) or {}
        self.asked, self.busy, self.error = set(), None, ''
        self.closing = set()  # (sessions that had their last report)

    @staticmethod
    def moved(path):
        return max((os.path.getmtime(p) for p in (path, path + '-wal') if os.path.exists(p)), default=0)

    def due(self, s):
        if s['id'] in self.asked:
            return True
        path = transcript_of(s)
        cur = self.data.get(s['id'])
        if not path or s.get('starting') or (cur and (s.get('stale') or s['state'] in ('gone', 'ended'))):
            return False
        return not cur or (self.moved(path) > cur['basis'] + 1 and time.time() - cur['at'] > 1800)

    def last_due(self, s):
        """A session that has just ended: once more, for what it did after its last report, so that its tasks hear of it."""
        if s['state'] not in ('gone', 'ended') or s.get('starting') or s.get('unknown') or s['id'] in self.closing or time.time() - (s.get('at') or 0) > 6 * 3600:
            return False
        path = transcript_of(s)
        cur = self.data.get(s['id'])
        return bool(path) and (not cur or self.moved(path) > cur['basis'] + 1)

    @staticmethod
    def offered(s, key):
        """The open tasks a report may name: those here, and this session's own wherever they are (it may have been placed
        on the workspace at first, and on a project since)."""
        return [t for t in A.tasks_query() if t['scope'] == key or any(x['name'] == s['name'] for x in t['sessions'])]

    @classmethod
    def absorb(cls, s, scope, name, items, as_of):
        """What a report says of the tasks: by id when the model names one it was offered, else a new one. What is under way
        comes last: the last task a session touched counts as the one it is on."""
        here = {t['id'] for t in cls.offered(s, scope)}
        me = {'name': s['name'], 'sid': s['id'], 'kind': s['kind']}
        items = [x for x in (items if isinstance(items, list) else [])[:6] if isinstance(x, dict)]
        for x in sorted(items, key=lambda x: x.get('status') in ('doing', 'waiting')):
            op = {'who': 'summary', 'as_of': as_of, 'session': me, 'now': x.get('now'), 'next': x.get('next'),
                  'status': x.get('status') if x.get('status') in ('todo', 'doing', 'waiting', 'done') else None,
                  'decisions': x.get('decisions') if isinstance(x.get('decisions'), list) else [],
                  'results': x.get('results') if isinstance(x.get('results'), list) else []}
            if str(x.get('id') or '') in here:
                A.task_do({**op, 'do': 'set', 'id': x['id'], 'scope': scope, 'scope_name': name})
            elif one_line(x.get('title'), 120):
                A.task_do({**op, 'do': 'add', 'scope': scope, 'scope_name': name, 'title': x['title']})

    def make(self, s, cfg, decisions, story=None, scope=None):
        self.asked.discard(s['id'])
        path = transcript_of(s)
        if not path:
            return
        key, sname = scope or (None, None)
        tasks = self.offered(s, key)[:30] if key else []
        mine = lambda t: '*' if any(x['name'] == s['name'] for x in t['sessions']) else ''
        known = [f'- {x["topic"]}：{x["now"]}（{"开发者" if x["by"] == "user" else "agent"}）' for x in (story or {}).get('topics') or []][:12] \
            or [f'- {d["what"]}（{"开发者" if d["by"] == "user" else "agent"}）' for d in decisions if d['sid'] == s['id']][-12:]
        prompt = REPORT.format(kind=s['kind'], name=s['name'], cwd=s.get('cwd') or '?', known='\n'.join(known) or '（无）',
                               opening='\n'.join(opening(path)) or '（读不到）', log='\n'.join(recent(path, 16000)),
                               scope=f'「{sname}」' if key else '（这个会话不在任何项目或工作区里，tasks 给空列表）',
                               open='\n'.join(f'{mine(t)}{t["id"]}｜{t["status"]}｜{t["title"]}｜{t["now"][:100]}' for t in tasks) or '（无）',
                               gone='\n'.join(f'- {x}' for x in A.tasks_gone(key)) if key and A.tasks_gone(key) else '（无）')
        if s['state'] in ('gone', 'ended'):
            self.closing.add(s['id'])
        self.busy = s['id']
        try:
            basis = self.moved(path)
            out = ask_model(prompt, cfg, 'summary')
            m = re.search(r'\{.*\}', out, re.S)
            r = json.loads(m.group(0))
            lst = lambda k, n, w: [one_line(x, w) for x in (r.get(k) or []) if one_line(x, w)][:n]
            self.data[s['id']] = {'at': time.time(), 'basis': basis, 'name': s['name'], 'kind': s['kind'],
                                  'group': (s.get('loc') or {}).get('session'),
                                  'r': {'goal': one_line(r.get('goal'), 160), 'done': lst('done', 8, 200), 'now': one_line(r.get('now'), 200),
                                        'next': lst('next', 4, 200), 'refs': lst('refs', 8, 300),
                                        'decisions': [{'what': one_line(d.get('what'), 160), 'by': 'user' if d.get('by') == 'user' else 'agent'}
                                                      for d in (r.get('decisions') or []) if isinstance(d, dict) and one_line(d.get('what'), 160)][:8]}}
            self.error = ''
            A.put(self.file, self.data)
            if key:
                self.absorb(s, key, sname, r.get('tasks'), basis)
        except Exception as e:
            self.error = f'{type(e).__name__}: {e}'[:300]
            self.data.setdefault(s['id'], {'r': None, 'basis': 0, 'name': s['name'], 'kind': s['kind']})['at'] = time.time()
        finally:
            self.busy = None


def stamp(ts):
    """An ISO time from a conversation file (UTC), as seconds."""
    try:
        return calendar.timegm(time.strptime(str(ts)[:19], '%Y-%m-%dT%H:%M:%S'))
    except (TypeError, ValueError):
        return None


def talk_of(d):
    """One line of a conversation file as (who, text, at): the person's words ('user', or 'mid' for what they sent while
    the agent worked) or the agent's ('assistant'); None for tools, their results and the harness."""
    at = stamp(d.get('timestamp'))
    if d.get('type') == 'attachment':  # (Claude Code: words the person sent mid-turn)
        a = d.get('attachment') or {}
        return ('mid', a['prompt'].strip(), at) if a.get('type') == 'queued_command' and isinstance(a.get('prompt'), str) and a['prompt'].strip() else None
    if d.get('type') in ('user', 'assistant') and isinstance(d.get('message'), dict):  # Claude Code
        if d.get('isMeta') or d.get('isCompactSummary'):
            return None
        m = d['message']
        c = m.get('content')
        if m.get('role') == 'user' and isinstance(c, list) and any(isinstance(x, dict) and x.get('type') == 'tool_result' for x in c):
            return None
        who, (t, _) = m.get('role'), text_of(c)
    elif d.get('type') == 'response_item' and isinstance(d.get('payload'), dict):  # Codex
        q = d['payload']
        if q.get('type') != 'message' or q.get('role') not in ('user', 'assistant'):
            return None
        who, (t, _) = q['role'], text_of(q.get('content'))
    elif d.get('role') in ('user', 'assistant'):  # Cursor
        d = cursor_message(d)
        who, (t, _) = d['role'], text_of(d.get('content'))
    else:
        return None
    t = (t or '').strip()
    if not t or who == 'user' and t.startswith(('<', '# AGENTS.md', '[Request interrupted', 'This session is being continued')):
        return None
    return who, t, at


def cut_into(segs, item):
    """Add a line to a conversation cut at the person's words: each piece {at, ask: [their words], reply: the agent's
    last words in it}. Words sent mid-turn stay with the turn they came into."""
    who, t, at = item
    if who in ('user', 'mid'):
        last = segs[-1] if segs else None
        if last and (who == 'mid' or not last['reply']) and len(last['ask']) < 8:
            last['ask'].append(t[:600])
        else:
            segs.append({'at': at, 'ask': [t[:600]], 'reply': ''})
    elif segs:
        segs[-1]['reply'] = t[:2400]


class Cuts:
    """Conversations cut at the person's words, each file read on from where it was last read (one can be 100 MB)."""

    def __init__(self):
        self.seen = {}  # path -> {off, rest, segs}

    def of(self, path):
        if path.endswith('/store.db'):  # (a Cursor chat store: small, read whole)
            segs = []
            for d in cursor_messages(path):
                x = talk_of(d)
                if x:
                    cut_into(segs, x)
            return segs
        try:
            size = os.path.getsize(path)
        except OSError:
            return []
        st = self.seen.get(path)
        if not st or size < st['off']:
            st = self.seen[path] = {'off': 0, 'rest': b'', 'segs': []}
        with open(path, 'rb') as f:
            f.seek(st['off'])
            while True:
                data = f.read(8 << 20)
                if not data:
                    break
                st['off'] += len(data)
                lines = (st['rest'] + data).split(b'\n')
                st['rest'] = lines.pop()  # (a line still being written)
                for line in lines:
                    if b'"text"' not in line and b'queued_command' not in line and b'"content"' not in line:
                        continue  # (no words in it: progress, metadata)
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    x = isinstance(d, dict) and talk_of(d)
                    if x:
                        cut_into(st['segs'], x)
        return st['segs']


def turn_at(turns, n):
    """When the turn a topic points at began (none once that turn is read anew)."""
    return turns[n - 1]['at'] if isinstance(n, int) and 0 < n <= len(turns) else None


