    return '\n'.join(x for x in out if x)


def newer(a, b):
    return [int(x) for x in a.split('.')] > [int(x) for x in b.split('.')]


RELEASES = 'ethannortharc/sturnus'  # (the GitHub repository releases come from; config "releases" names another)


def git_source(src):
    """A git checkout to upgrade from: pull it (fast-forward only, when nothing is uncommitted). Says what happened."""
    if not src or run(['git', '-C', src, 'rev-parse', '--is-inside-work-tree']).stdout.strip() != 'true':
        return None
    if run(['git', '-C', src, 'status', '--porcelain']).stdout.strip():
        return f'{src} has uncommitted changes: not pulled'
    if run(['git', '-C', src, 'rev-parse', '--abbrev-ref', '@{u}']).returncode != 0:
        return f'{src} follows no remote branch: not pulled'
    r = run(['git', '-C', src, 'pull', '--ff-only', '-q'], timeout=120)
    return f'pulled {src}' if r.returncode == 0 else f'could not pull {src}: {(r.stderr or r.stdout).strip()[:200]}'


def latest_release(cfg):
    """The newest release on GitHub: (version, archive url, checksum url)."""
    repo = cfg.get('releases') or RELEASES
    d = http_json(f'https://api.github.com/repos/{repo}/releases/latest', headers={'Accept': 'application/vnd.github+json', 'User-Agent': f'sturnus/{VERSION}'}, timeout=30)
    v = str(d.get('tag_name') or '').lstrip('v')
    if not re.fullmatch(r'\d+(\.\d+)*', v):
        raise ValueError(f'the newest release of {repo} is not a version: {d.get("tag_name")!r}')
    assets = {a.get('name'): a.get('browser_download_url') for a in d.get('assets') or []}
    tar, sha = assets.get(f'sturnus-{v}.tar.gz'), assets.get(f'sturnus-{v}.tar.gz.sha256')
    if not tar or not sha:
        raise ValueError(f'release v{v} of {repo} has no sturnus-{v}.tar.gz with its .sha256')
    return v, tar, sha


def fetch_release(v, tar, sha):
    """A release archive, downloaded, checked against its checksum and unpacked under the install's own folder: the
    folder to install from."""
    import io, tarfile
    get = lambda url: urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': f'sturnus/{VERSION}'}), timeout=120).read()
    data, want = get(tar), get(sha).decode().split()[0].lower()
    if hashlib.sha256(data).hexdigest() != want:
        raise ValueError(f'sturnus-{v}.tar.gz does not match its checksum: not installed')
    top, dest = f'sturnus-{v}', os.path.join(SHARE, 'src')
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:gz') as t:
        for m in t.getmembers():  # (only plain files and folders inside its own folder)
            parts = m.name.split('/')
            if parts[0] != top or '..' in parts or m.name.startswith('/') or not (m.isfile() or m.isdir()):
                raise ValueError(f'sturnus-{v}.tar.gz holds {m.name!r}: not installed')
        shutil.rmtree(os.path.join(dest, top), ignore_errors=True)
        os.makedirs(dest, exist_ok=True)
        t.extractall(dest, **({'filter': 'data'} if hasattr(tarfile, 'data_filter') else {}))  # (newer Pythons check again, and say nothing)
    return os.path.join(dest, top)


def upgrade(argv):
    """The newest version, installed by itself (its own install steps, not this one's)."""
    cfg = A.get(CONF, {}) or {}
    src = cfg.get('source')
    pulled = None if '--release' in argv else git_source(src)
    if pulled is not None:
        print(pulled)
        v = open(os.path.join(src, 'VERSION')).read().strip()
        if not newer(v, VERSION) and '--force' not in argv:
            return print(f'sturnus {VERSION} is current ({src} has {v}); --force to install it again')
    else:
        try:
            v, tar, sha = latest_release(cfg)
        except Exception as e:
            sys.exit(f'sturnus: could not see the newest release: {e}')
        if not newer(v, VERSION) and '--force' not in argv:
            return print(f'sturnus {VERSION} is current (the newest release is {v}); --force to install it again')
        try:
            src = fetch_release(v, tar, sha)
        except Exception as e:
            sys.exit(f'sturnus: could not get release {v}: {e}')
        print(f'got release {v}')
    sys.stdout.flush()  # (what was said so far, before this process becomes the new version's install)
    os.execv(sys.executable, [sys.executable, os.path.join(src, 'sturnus'), 'install', '--from', src] + (['--no-service'] if '--no-service' in argv else []))


# ---------- the sessions at a terminal: `sturnus ls`, `sturnus open` ----------

def cell(s, n):
    """Text cut and padded to n columns of a terminal (a Chinese character takes two)."""
    import unicodedata
    width = lambda ch: 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1
    s = str(s)
    full = sum(map(width, s))
    if full <= n:
        return s + ' ' * (n - full)
    out, w = '', 0
    for ch in s:
        if w + width(ch) > n - 1:
            break
        out, w = out + ch, w + width(ch)
    return out + '…' + ' ' * (n - w - 1)


LS_FILE = os.path.join(CACHE, 'ls.json')  # (the list as last printed: `sturnus open 3` means its third)


def ls_rows(book, every=False):
    """The sessions as a terminal lists them: the running ones first, then the latest; with --all the archived too. One
    that the record has running, but whose pane is gone (the service was not there to see it end), is shown stopped."""
    names = {sp['id']: sp['name'] for sp in book.spaces()}
    out = []
    for k in book.all():
        if k['archived'] and not every:
            continue
        t = k.get('term')
        loc = T.loc_of(t) if t else None
        running = bool(t) and k['state'] != 'stopped' and (T.there(loc) is not False if loc else True)
        state = k['state'] if running else 'stopped'
        where = (f'{t["mux"]} {t["grp"].removeprefix("tmux:")}' if loc else (t['origin'] or tx('不在 Zellij 或 tmux 里', 'not in Zellij or tmux'))) if running else tx('没有', 'none')
        out.append({'id': k['id'], 'title': k['title'] or k['name'] or k['id'], 'space': names.get(k['space']) or tx('未归入', 'none'), 'state': state,
                    'where': where, 'at': k['at'], 'archived': bool(k['archived'])})
    rank = {'waiting': 0, 'working': 1, 'idle': 2, 'stopped': 3}
    out.sort(key=lambda r: (r['archived'], rank.get(r['state'], 3) == 3, -r['at']))
    return out if every else out[:40]


def ls_text(every=False):
    rows = ls_rows(K.Book(), every)
    if not rows:
        return tx('还没有会话。在页面上开一个，或者在终端里直接运行 claude / codex。', 'No sessions yet. Start one from the page, or just run claude / codex in a terminal.')
    os.makedirs(CACHE, exist_ok=True)
    A.put(LS_FILE, [r['id'] for r in rows])
    words = {'working': tx('工作中', 'working'), 'waiting': tx('等你', 'needs you'), 'idle': tx('空闲', 'idle'), 'stopped': tx('已停止', 'stopped')}
    head = f'{"":>3}  {cell(tx("会话", "session"), 34)} {cell(tx("工作区", "workspace"), 16)} {cell(tx("状态", "state"), 9)} {tx("终端", "terminal")}'
    lines = [f'{i:>3}  {cell(r["title"], 34)} {cell(r["space"], 16)} {cell(words[r["state"]] + (tx("，已归档", ", archived") if r["archived"] else ""), 9)} {r["where"]}'
             for i, r in enumerate(rows, 1)]
    return '\n'.join([head] + lines + ['', tx('sturnus open 编号或名字：这个终端进到那条会话；已停止的先新开终端接着做', 'sturnus open NUMBER or TITLE: this terminal goes to that session; a stopped one gets a new terminal first and goes on')])


def pick_session(book, words):
    """The session a person means at a terminal: its number in the list last printed, its id, its title (whole, else the
    one title that holds the words). Returns (session, None) or (None, why)."""
    rows = [k for k in book.all() if not k['archived']]
    if words.isdigit():
        ids = A.get(LS_FILE, []) or [r['id'] for r in ls_rows(book)]
        hit = next((k for k in rows if 0 < int(words) <= len(ids) and k['id'] == ids[int(words) - 1]), None)
        return (hit, None) if hit else (None, tx(f'列表里没有第 {words} 条：先 sturnus ls', f'No number {words} in the list: run sturnus ls first'))
    name = lambda k: k['title'] or k['name'] or ''
    hits = [k for k in rows if k['id'] == words] or [k for k in rows if name(k) == words] or [k for k in rows if words.lower() in name(k).lower()]
    if len(hits) == 1:
        return hits[0], None
    if not hits:
        return None, tx(f'没有叫这个的会话：{words}', f'No session by that name: {words}')
    return None, tx('有几条都对得上，用编号或写全一点：\n', 'Several match; use a number or more of the title:\n') + '\n'.join(f'  {name(k)}' for k in hits[:12])


def open_session(words):
    """This terminal goes to a session's terminal; a stopped session is given a new one first, on with its conversation.
    Returns what to exit with (words on failure)."""
    book = K.Book()
    k, why = pick_session(book, words.strip())
    if not k:
        return why
    t = k.get('term')
    loc = T.loc_of(t) if t else None
    if t and k['state'] != 'stopped' and not loc:
        return tx(f'这条会话正在跑，但不在 Zellij 或 tmux 里（{t["origin"] or "来源不明"}），这里进不去', f'This session is running, but not in Zellij or tmux ({t["origin"] or "origin unknown"}): it cannot be entered from here')
    if not (loc and k['state'] != 'stopped' and T.there(loc)):
        ok, r = launch_session(book, config(), k['id'], prefer=(k.get('last_term') or {}).get('grp') or '')
        if not ok:
            return r
        print(r['msg'], flush=True)
        loc = r['loc']
        for _ in range(40):
            loc = loc or marked(r['marker'])
            if loc:
                break
            time.sleep(.25)
        if not loc:
            return tx('终端开了，但还没找到它在哪：过一会儿再运行一次', 'The terminal was opened but not found yet: run this again in a moment')
    ok, msg = T.enter(loc)
    return None if ok else (msg or tx('切不过去', 'Could not switch there'))


def main(argv):
    c = argv[0] if argv else 'help'
    if c == 'serve':
        serve()
    elif c == 'install':
        src = argv[argv.index('--from') + 1] if '--from' in argv else APP
        print(install(src, '--no-service' not in argv))
    elif c == 'upgrade':
        upgrade(argv)
    elif c == 'uninstall':
        print(uninstall('--purge' in argv, '--no-service' not in argv))
    elif c == 'status':
        cfg = config()
        reach = tailnet_urls(cfg)
        print(f'sturnus {VERSION} ({APP})\nservice: {service("state")}' + (f' (log: {LOG})' if MAC else '') +
              f'\nhttp://{cfg["host"]}:{cfg["port"]}' + (f'\ntailnet: {reach}' if reach else ''))
    elif c == 'ls':
        _REQ.lang = 'en' if config().get('work_lang') == 'en' else 'zh'
        print(ls_text('--all' in argv))
    elif c == 'open' and len(argv) > 1:
        _REQ.lang = 'en' if config().get('work_lang') == 'en' else 'zh'
        sys.exit(open_session(' '.join(argv[1:])))
    elif c == 'open':
        cfg = config()
        url = f'http://{cfg["host"]}:{cfg["port"]}'
        print(url)
        run(['open' if MAC else 'xdg-open', url])
    elif c == 'token':  # (the sign-in token, for the person at this terminal; --rotate signs every browser out)
        d = access_data('--rotate' in argv)
        if '--rotate' in argv:
            print('new token; every browser and paired phone signed out')
        print(d['token'])
    elif c == 'pair':  # (a pairing code for the phone app, for a machine reached only by ssh)
        cfg = config()
        code = Access().pair_code()
        url, _ = pair_link(cfg, code)
        print(f'In the Sturnus app: + → type it in\naddress: {url or "(this machine is not on Tailscale: a phone cannot reach it)"}\n'
              f'code:    {code[:4]}-{code[4:]}   (good for {PAIR_LIFE // 60} minutes, once)')
    elif c == 'version':
        print(VERSION)
    elif c == 'check':
        d = Deck()
        d.cfg['pane_titles'] = False  # (a check names no panes)
        d.collect()
        d.launched['0' * 12] = {'kind': 'claude', 'name': 'check', 'group': 'check', 'cwd': '/', 'at': time.time()}
        d.collect()
        print(f'ok: {len(d.state["sessions"])} sessions, {len(d.state["groups"])} groups, {len(d.state["talk"])} messages')
    else:
        print(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
