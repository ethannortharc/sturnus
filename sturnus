    def rename(self, s, new):
        if s['kind'] == 'claude':
            return False, tx(f'Claude 会话的名字由它自己定：在那个会话里输入 /rename {new}，这里和 amail 会跟着变', f'A Claude session names itself: type /rename {new} in that session, and the name changes here and in amail')
        if new in A.rows():
            return False, tx(f'{new} 已经有人用了', f'{new} is already taken')
        if s['kind'] == 'codex' and s.get('session'):
            ok, msg = codex_set_name(s['session'], new)
            if not ok:
                self.note(tx(f'Codex 会话名没改成：{msg}', f'Codex session name was not changed: {msg}'), False)
        r = run([sys.executable, os.path.join(APP, 'amail'), '--as', s['name'], 'rename', new])
        if r.returncode != 0:
            return False, (r.stderr or r.stdout).strip()[:200]
        self.titles = {}
        return True, tx(f'{s["name"]} 改名为 {new}（amail、Zellij 窗格{"、Codex 会话" if s["kind"] == "codex" else ""}都已同步）', f'{s["name"]} renamed to {new} (amail, the Zellij pane{" and the Codex session" if s["kind"] == "codex" else ""} are in sync)')


ASKS = ('AskUserQuestion', 'ExitPlanMode')  # (tools that put a choice to the person in the terminal)


def at_menu(s):
    """At a permission or choice prompt in its terminal: typed text would answer it."""
    return bool(s.get('prompting') or (s.get('tool') in ASKS and s['state'] == 'working' and (s.get('tool_at') or 0) > (s.get('tool_end') or 0)))


def say_how(s, now=False):
    """How the person's words for a session get there: typed into its pane, at work or not (the agents' own command
    lines take words in the middle of a turn, and hand them over at the next step); not at all while it sits at a
    permission or choice prompt (they would answer it); by mail when it is in no pane."""
    if s['state'] in ('gone', 'ended'):
        return 'gone'
    if at_menu(s):
        return 'menu'
    if not s.get('loc'):
        return 'mail'
    return 'type'


def codex_set_name(thread, name):
    """Name a Codex thread through the shared app-server daemon (WebSocket on its control socket)."""
    import base64, socket, struct
    path = os.path.expanduser('~/.codex/app-server-control/app-server-control.sock')
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(10)
        s.connect(path)
        s.sendall(('GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                   f'Sec-WebSocket-Key: {base64.b64encode(os.urandom(16)).decode()}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
        buf = b''
        while b'\r\n\r\n' not in buf:
            buf += s.recv(4096)
        rest = buf.split(b'\r\n\r\n', 1)[1]

        def send(obj):
            d = json.dumps(obj).encode()
            mask = os.urandom(4)
            n = len(d)
            hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0xFE]) + struct.pack('>H', n))
            s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(d)))

        def recv():
            nonlocal rest
            def take(n):
                nonlocal rest
                while len(rest) < n:
                    rest += s.recv(65536)
                d, rest = rest[:n], rest[n:]
                return d
            msg = b''
            while True:
                b0, b1 = take(2)
                n = b1 & 0x7f
                if n == 126:
                    n = struct.unpack('>H', take(2))[0]
                elif n == 127:
                    n = struct.unpack('>Q', take(8))[0]
                d = take(n)
                if b0 & 0x0f in (8,):
                    raise ConnectionError('closed')
                if b0 & 0x0f in (9, 10):
                    continue
                msg += d
                if b0 & 0x80:
                    return json.loads(msg)

        def call(i, method, params):
            send({'jsonrpc': '2.0', 'id': i, 'method': method, 'params': params})
            while True:
                m = recv()
                if m and m.get('id') == i:
                    return m

        call(1, 'initialize', {'clientInfo': {'name': 'sturnus', 'version': VERSION}})
        send({'jsonrpc': '2.0', 'method': 'initialized'})
        r = call(2, 'thread/name/set', {'threadId': thread, 'name': name})
        s.close()
        return 'error' not in r, str(r.get('error') or 'ok')
    except Exception as e:
        return False, repr(e)


# ---------- the phone: what waits on the person, and the answers a phone may give (Columba) ----------
#
# GET /api/phone/summary, GET /api/phone/inbox, POST /api/phone/actions/<id> {choice, text}: the same sign-in as the page.
# A phone answers only the prompt it was shown: an item's id names the prompt (its tool call), and an answer to an id
# that is no longer there is refused, so a late tap cannot land on a later prompt or in the input line.
# A permission prompt gets Yes (key 1, always the first) or No (Esc, always a cancel); the choices that change lasting
# rules ("always allow", "switch to auto mode") are left to the terminal. A question gets its option's number, when it
# is one question with one answer; anything else (several questions, a plan, Codex) is opened, not answered.

PHONE_FIELD = {'Bash': 'command', 'Edit': 'file_path', 'MultiEdit': 'file_path', 'Write': 'file_path', 'NotebookEdit': 'notebook_path',
               'Read': 'file_path', 'WebFetch': 'url', 'WebSearch': 'query', 'Glob': 'pattern', 'Grep': 'pattern'}


def phone_said(tool, inp):
    """What a permission prompt is for, in the few lines a person needs to judge it."""
    inp = inp if isinstance(inp, dict) else {}
    main = str(inp.get(PHONE_FIELD.get(tool, '')) or '')
    if tool == 'Bash':
        lines = [tx('运行：', 'Run: ') + main, str(inp.get('description') or '')]
    elif tool in ('Edit', 'MultiEdit', 'NotebookEdit'):
        lines = [tx('改文件：', 'Edit: ') + main, (tx('改成：', 'To: ') + str(inp['new_string'])[:300]) if inp.get('new_string') else '']
    elif tool == 'Write':
        lines = [tx('写文件：', 'Write: ') + main]
    elif tool == 'WebFetch':
        lines = [tx('打开网页：', 'Fetch: ') + main]
    elif main:
        lines = [f'{tool}：{main}']
    else:
        rest = json.dumps(inp, ensure_ascii=False)
        lines = [tool, rest[:400] if rest != '{}' else '']
    return '\n'.join(x for x in lines if x)[:1200]


def phone_question(inp):
    """The one question with one answer a phone can give, or None."""
    qs = (inp or {}).get('questions') if isinstance(inp, dict) else None
    if not isinstance(qs, list) or len(qs) != 1 or not isinstance(qs[0], dict) or qs[0].get('multiSelect'):
        return None
    opts = [str((o or {}).get('label') or '') for o in qs[0].get('options') or [] if isinstance(o, dict)]
    return {'question': str(qs[0].get('question') or ''), 'options': opts} if 2 <= len(opts) <= 9 and all(opts) else None


def phone_keys_reach(s, groups):
    """Whether keys typed for a phone would reach this session's prompt: Claude Code itself says it waits, the pane is
    the one its process runs in now, the prompt on record began with this wait and is the only one open, and a Zellij
    pane has a client (the deck's plugin types through one)."""
    ask, loc = s.get('asking') or {}, s.get('loc') or {}
    return (s['kind'] == 'claude' and s.get('cc_status') == 'waiting' and bool(s.get('loc_live')) and bool(ask) and not ask.get('many')
            and (ask.get('at') or 0) >= (s.get('cc_since') or 0) - 5
            and (loc.get('mux') != 'zellij' or bool((groups.get(loc.get('session')) or {}).get('clients'))))


def phone_items(sessions, project_of=lambda s: '', groups=None):
    """What waits on the person, most pressing first: prompts an agent is stopped at, then what summaries say it needs."""
    from urllib.parse import quote
    out = []
    for s in sessions:
        if s.get('hidden') or s.get('unknown') or s['state'] in ('gone', 'ended'):
            continue
        who = s.get('title') or s['name']
        meta = ' · '.join(x for x in (project_of(s), s['name'] if s.get('title') else '') if x)
        ask = s.get('asking') or {}
        if at_menu(s):
            here = phone_keys_reach(s, groups or {})
            tool, inp = ask.get('tool') or s.get('tool') or '', ask.get('input') or {}
            # (the id names this very prompt: its tool call, and what it is for)
            key = f'{s["id"]}|menu|{ask.get("use") or ask.get("at") or s.get("since")}|{tool}|{json.dumps(inp, sort_keys=True, ensure_ascii=False)}'
            q = phone_question(inp) if s['kind'] == 'claude' and tool == 'AskUserQuestion' else None
            if q:
                item = {'kind': 'question', 'title': tx(f'{who} 问你', f'{who} asks you'), 'body': q['question'],
                        'actions': [{'id': f'o{n}', 'label': o} for n, o in enumerate(q['options'], 1)] if here else []}
            elif s['kind'] == 'claude' and ask.get('tool') and tool not in ASKS:
                item = {'kind': 'permission', 'title': tx(f'{who} 要你确认', f'{who} needs your OK'), 'body': phone_said(tool, inp),
                        'actions': [{'id': 'allow', 'label': tx('允许', 'Allow'), 'style': 'primary'},
                                    {'id': 'deny', 'label': tx('拒绝', 'Deny'), 'style': 'danger'}] if here else []}
            else:
                body = str(inp.get('plan') or '')[:600] if tool == 'ExitPlanMode' else '\n'.join(
                    str(q.get('question') or '') for q in inp.get('questions') or [] if isinstance(q, dict)) if tool == 'AskUserQuestion' else ''
                item = {'kind': 'menu', 'title': tx(f'{who} 停在一个提示上', f'{who} is stopped at a prompt'),
                        'body': body or s.get('waiting_for') or tool, 'actions': []}
            item.update(level='urgent', at=ask.get('at') or s.get('since') or s.get('at'))
        elif s.get('needs_you') or s.get('asks'):
            asks = s.get('asks') or []
            need = s.get('needs_you') or asks[0]['what']
            key = f'{s["id"]}|need|{need}|{",".join(a["id"] for a in asks)}'
            acts = [{'id': 'reply', 'label': tx('回复', 'Reply'), 'text': {'placeholder': tx(f'对 {s["name"]} 说…', f'Say to {s["name"]}…')}}]
            if asks:
                acts.append({'id': 'done', 'label': tx('已处理', 'Handled')})
            item = {'kind': 'needs', 'title': tx(f'{who} 在等你', f'{who} is waiting for you'), 'body': need, 'actions': acts,
                    'level': 'attention', 'at': s.get('summary_at') or s.get('at'), 'asks': [a['id'] for a in asks]}
        else:
            continue
        item.update(id=hashlib.sha1(key.encode()).hexdigest()[:16], meta=meta, session=s['id'], open_url='/#/s/' + quote(s['id'], safe=''))
        out.append(item)
    out.sort(key=lambda i: (i['level'] != 'urgent', -(i['at'] or 0)))
    return out


def phone_summary(sessions, items):
    live = [s for s in sessions if not (s.get('hidden') or s.get('unknown') or s['state'] in ('gone', 'ended'))]
    working, n = sum(1 for s in live if s['state'] == 'working'), len(items)
    parts = ([tx(f'{n} 件事在等你', f'{n} waiting for you')] if n else []) + ([tx(f'{working} 个会话在工作', f'{working} working')] if working else [])
    return {'status': 'attention' if n else 'ok', 'headline': ' · '.join(parts) or tx('没有会话在工作', 'Nothing is working'),
            'metrics': [{'label': tx('等你', 'Waiting'), 'value': str(n)}, {'label': tx('工作中', 'Working'), 'value': str(working)},
                        {'label': tx('会话', 'Sessions'), 'value': str(len(live))}],
            'needs_me': n}


PHONE_HIDDEN = ('kind', 'session', 'asks')  # (for answering only, not shown)


def phone_view(deck, what):
    with deck.lock:
        sessions, groups = list(deck.state['sessions']), dict(deck.state.get('groups') or {})
    items = phone_items(sessions, lambda s: (deck.projects.known.get(s.get('project')) or {}).get('name') or '', groups)
    public = [{k: v for k, v in i.items() if k not in PHONE_HIDDEN} for i in items]
    return phone_summary(sessions, items) if what == 'summary' else {'items': public}


# ---------- the Sturnus phone app: this machine's sessions, small enough to merge with other machines' on a phone ----------

def app_attention(s):
    """As the page's attention(): what a session needs of the person, or None."""
    if s['state'] in ('gone', 'ended') or s.get('stale') or (s.get('unknown') and not s.get('starting') and not s.get('summary')):
        return None
    asking = s.get('tool') in ASKS and s['state'] == 'working' and (s.get('tool_at') or 0) > (s.get('tool_end') or 0)
    if s['state'] == 'waiting' or s.get('status') == 'waiting_user' or asking:
        return 'decide'
    if s.get('status') in ('blocked', 'review'):
        return s['status']
    return 'decide' if s.get('needs_you') or s.get('asks') else None


def app_standing(s):
    """As the page's standing(): asking (works on, and waits on you) · waiting · blocked · review · working · idle."""
    if s['state'] in ('gone', 'ended'):
        return s['state']
    a = app_attention(s)
    if a == 'decide':
        return 'asking' if s['state'] == 'working' and not at_menu(s) else 'waiting'
    return a or ('working' if s['state'] == 'working' else 'idle')


def app_title(s):
    if s.get('title'):
        return s['title']
    first = re.split(r'[，。；,;：:]', s.get('summary') or '')[0][:18]
    return first or (tx('还认不出在做什么', 'Can’t tell yet what it is doing') if s.get('unknown') else s['name'])


APP_RANK = {'waiting': 0, 'asking': 1, 'blocked': 2, 'review': 3, 'working': 4, 'idle': 5}


def app_view(deck):
    """What the phone app shows of this machine: its live sessions with how each stands (a sub-agent another session
    started names it as `parent`), and what waits on the person with the answers a phone may give. `rev` changes whenever
    any of it does, except a session's last stir alone."""
    with deck.lock:
        state = dict(deck.state)  # (each collect puts new values in: these stay as they are while read)
        sessions, groups = list(state['sessions']), dict(state.get('groups') or {})
        spaces = {w['key']: w['name'] for w in state.get('workspaces') or []}
        dirs = list(state.get('dirs') or [])[:30]
    current = dict(getattr(deck, 'tasks_current', None) or {})  # (the task each session is on: the one it touched last)
    pname = lambda s: (deck.projects.known.get(s.get('project')) or {}).get('name') or ''
    # (a session that lasts stays in the list however long it has been quiet: its row with it)
    live = [s for s in sessions if not (s.get('hidden') or s['state'] in ('gone', 'ended')) and (not s.get('stale') or (s.get('kept') and not s.get('parent_id')))]
    kids = Counter(s['parent_id'] for s in live if s.get('parent_id'))
    rows = []
    for s in live:
        st = app_standing(s)
        need = s.get('needs_you') or ((s.get('asks') or [{}])[0].get('what')) or (s.get('waiting_for') if st == 'waiting' else '') or ''
        rows.append({'id': s['id'], 'name': s['name'], 'kind': s['kind'], 'title': app_title(s), 'summary': (s.get('summary') or '')[:400],
                     'standing': st, 'need': str(need)[:400], 'project': pname(s), 'workspace': spaces.get(s.get('workspace')) or '',
                     'pkey': s.get('project') or '', 'wkey': s.get('workspace') or '', 'task': current.get(s['name']) or '',
                     'branch': s.get('branch') or '', 'since': s.get('since'), 'at': s.get('at'),
                     'born': s.get('born'), 'say': say_how(s), 'pane': bool((s.get('loc') or {}).get('pane')), 'kids': kids.get(s['id'], 0),
                     'group': (s.get('loc') or {}).get('session') or '',  # (a tmux group's name carries its tmux: already)
                     'parent': s.get('parent_id') or '', 'kept': '' if s.get('parent_id') else s.get('kept') or ''})
    rows.sort(key=lambda r: (APP_RANK.get(r['standing'], 9), r['born'] or 0))  # (within a standing, by when it began: rows keep their places)
    items = [{k: v for k, v in i.items() if k != 'asks'} for i in phone_items(sessions, pname, groups)]
    name, _ = tailnet_self()
    # (and where a new session can start: the groups there are, the folders sessions ran in lately)
    made = sorted(groups)
    view = {'machine': {'name': (name or socket.gethostname()).split('.')[0], 'version': VERSION, 'me': ME_NAME}, 'sessions': rows, 'inbox': items,
            'groups': made, 'dirs': dirs, **app_places(state, {r['id'] for r in rows}), **app_lasting(state, rows)}
    # (a working session stirs every few seconds, and the project and workspace it is in with it; a window no hook saw
    # has its file's time as `since`; the recent folders reorder as sessions take turns: none of that is news worth
    # waking every phone for. A phone gets it with the next news, or at the end of its wait.)
    view['rev'] = hashlib.sha1(json.dumps(no_stir({k: v for k, v in view.items() if k != 'dirs'}), sort_keys=True, ensure_ascii=False,
                                          default=str).encode()).hexdigest()[:16]
    return view


def no_stir(v):
    """A view without its times of the last stir ('at') and of the last change of state ('since'), at every depth."""
    if isinstance(v, dict):
        return {k: no_stir(x) for k, x in v.items() if k not in ('at', 'since')}
    return [no_stir(x) for x in v] if isinstance(v, list) else v


APP_PROJECTS, APP_WORKS = 30, 6  # (a workspace's projects on the phone, those with sessions first; a project's work items besides its main)
APP_KEPT = 150  # (the sessions that last on the phone: the pinned and running ones, then the latest; all of them are at /api/kept)


def app_lasting(st, rows):
    """The sessions that last as the phone lists them, and the workspaces the person keeps: each session with how it stands
    (its running row's standing, or stopped) and the title the page gives it; each workspace with its folders and the
    keys its tasks and channels are kept under (its own, and those of the projects and old workspaces in its folders).
    Also what runs by the clock, the sessions a restart ended (offered once, to go on), and the agents a new session can
    be. In the order they were made, so that one at work moving up the record wakes no phone."""
    by = {r['id']: r for r in rows}
    out = []
    for k in (st.get('kept') or [])[:APP_KEPT]:
        r, t, e = by.get(k.get('live') or ''), k.get('term') or {}, k.get('ended') or {}
        out.append({'id': k['id'], 'title': k.get('title') or (r or {}).get('title') or k.get('name') or tx('还没有名字', 'Not named yet'),
                    'kind': k.get('kind') or '', 'space': k.get('space') or '', 'spaced': bool(k.get('spaced')), 'show': k.get('show') or '',
                    'branch': k.get('branch') or '', 'name': k.get('name') or '', 'made': k.get('made') or 0, 'at': k.get('at') or 0,
                    'pinned': bool(k.get('pinned')), 'live': r['id'] if r else '', 'standing': r['standing'] if r else 'idle' if k.get('live') else 'stopped',
                    'note': (k.get('note') or '')[:300], 'model': k.get('model') or {}, 'wt': bool(k.get('wt')),
                    'term': {'mux': t.get('mux') or '', 'grp': t.get('grp') or '', 'origin': t.get('origin') or ''} if t else None,
                    'ended': {'at': e.get('at') or 0, 'why': e.get('why') or ''} if e else None})
    out.sort(key=lambda k: (-(k['made'] or 0), k['id']))
    projects, olds = st.get('projects') or {}, st.get('workspaces') or []
    inside = lambda sp, p: bool(p) and any(p == x['path'] or p.startswith(x['path'].rstrip('/') + '/') for x in sp.get('places') or [])
    spaces = [{'id': sp['id'], 'name': sp.get('name') or sp['id'], 'n': sp.get('n') or 0, 'live': sp.get('live') or 0, 'group': sp.get('group') or '',
               'places': [{'path': x['path'], 'show': x.get('show') or tilde(x['path']), 'main': bool(x.get('main')), 'there': bool(x.get('there', True))}
                          for x in sp.get('places') or []],
               'scopes': list(dict.fromkeys([sp['id']] + sorted(k for k, p in projects.items() if inside(sp, p.get('path')))
                                            + [w['key'] for w in olds if inside(sp, w.get('path'))])),
               'dash': any(w.get('key') == sp['id'] for w in olds)}
              for sp in st.get('spaces') or [] if not sp.get('archived')]
    plans = [{'id': p['id'], 'title': p.get('title') or '', 'prompt': (p.get('prompt') or '')[:400], 'kind': p.get('kind') or '',
              'folder': tilde(p.get('folder') or ''), 'space': p.get('space') or '', 'every': p.get('every') or '', 'live': bool(p.get('live')),
              'next': p.get('next') if p.get('live') else None, 'runs': [{'kept': r.get('kept') or '', 'at': r.get('at') or 0} for r in p.get('runs') or []][:5]}
             for p in st.get('plans') or []]
    return {'kept': out, 'spaces': spaces, 'plans': plans, 'recover': list(st.get('recover') or []),
            'kinds': [k for k in (st.get('launch') or DEFAULTS['launch']) if k in ('claude', 'codex', 'cursor')],
            'terminal': (st.get('terminal') or {}).get('way') or ''}


def app_places(st, on):
    """Where the work is, for the phone: each workspace with the overview its dashboard keeps, its projects (each with its
    work items: the main checkout and its newest worktrees) and how much is new in their channels; the tasks; the
    channels; mail to the person; push locks left behind. `on` is the sessions the phone is shown: an overview names no other."""
    projects, digests, boards = st.get('projects') or {}, st.get('digests') or {}, st.get('boards') or {}
    hour = lambda t: int((t or 0) // 3600)  # (the order moves with the hour things last moved in, not with every stir)

    def board(k):
        b = boards.get(k)
        return {'unread': b.get('unread') or 0, 'calls': b.get('calls') or 0, 'open': sum(1 for t in b.get('topics') or [] if not t.get('closed'))} if b else None

    def project(k):
        p, f = projects[k], projects[k].get('facts') or {}
        works = [{'branch': w.get('branch') or '', 'main': bool(w.get('main')), 'dirty': w.get('dirty') or 0, 'ahead': w.get('ahead'),
                  'behind': w.get('behind'), 'subject': w.get('subject') or '', 'at': w.get('at') or 0} for w in f.get('works') or []]
        works = [w for w in works if w['main']] + sorted((w for w in works if not w['main']), key=lambda w: -w['at'])[:APP_WORKS]
        return {'key': k, 'name': p.get('name') or k, 'path': tilde(p.get('path') or ''), 'git': bool(p.get('git')), 'live': p.get('live') or 0, 'at': p.get('at') or 0,
                'main': f.get('main') or '', 'tag': f.get('tag') or '', 'ahead': f.get('ahead'), 'behind': f.get('behind'),
                'works': works, 'board': board(k)}

    spaces = []
    for w in st.get('workspaces') or []:
        d = digests.get(w['key']) or {}
        keys = sorted((k for k in w.get('projects') or [] if k in projects),
                      key=lambda k: (-(projects[k].get('live') or 0), -hour(projects[k].get('at')), str(projects[k].get('name')).lower()))
        things = [{'thing': x.get('thing') or '', 'now': x.get('now') or '', 'sessions': [i for i in x.get('sessions') or [] if i in on]}
                  for x in d.get('items') or []]
        spaces.append({'key': w['key'], 'name': w.get('name') or w['key'], 'live': w.get('live') or 0, 'at': w.get('at') or 0,
                       'headline': d.get('headline') or '', 'things': [x for x in things if x['sessions']],
                       'projects': [project(k) for k in keys[:APP_PROJECTS]], 'board': board(w['key'])})
    spaces.sort(key=lambda w: (-w['live'], -hour(w['at']), w['name'].lower()))
    brief = lambda t: {'id': t['id'], 'scope': t.get('scope') or '', 'scope_name': t.get('scope_name') or '', 'title': t.get('title') or '',
                       'status': t.get('status') or '', 'shown': t.get('shown') or t.get('status') or '', 'now': (t.get('now') or '')[:300],
                       'next': (t.get('next') or '')[:300], 'at': t.get('at') or 0, 'closed': t.get('closed'), 'orphan': bool(t.get('orphan')),
                       'sessions': [{'name': x.get('name') or '', 'sid': x.get('sid') or '', 'live': bool(x.get('live')), 'st': x.get('st') or ''}
                                    for x in t.get('sessions') or []][:6]}
    tasks, closed = st.get('tasks') or [], ('done', 'dropped')
    shut = sorted((t for t in tasks if t.get('status') in closed), key=lambda t: -(t.get('closed') or 0))
    # (still to do; then what was put aside; then what ended lately)
    tasks = ([brief(t) for t in tasks if t.get('status') not in closed and t.get('status') != 'backlog'][:150]
             + [brief(t) for t in tasks if t.get('status') == 'backlog'][:60] + [brief(t) for t in shut[:30]])
    chans = [{'key': k, 'name': b.get('name') or k, 'kind': b.get('kind') or 'project', 'unread': b.get('unread') or 0, 'calls': b.get('calls') or 0,
              'last': {'from': b['last'].get('from') or '', 'text': (b['last'].get('text') or '')[:200], 'at': b['last'].get('at') or 0} if b.get('last') else None,
              'topics': [{'id': t.get('id') or '', 'title': t.get('title') or '', 'n': t.get('n') or 0, 'at': t.get('at') or 0}
                         for t in b.get('topics') or [] if not t.get('closed')][:8]} for k, b in boards.items()]
    # (newest post first: the time of a post, not a stir, so it moves only when someone writes)
    chans.sort(key=lambda c: (-(c['unread'] > 0), -((c['last'] or {}).get('at') or 0)))
    mail = [{'id': m.get('id') or '', 'from': m.get('from') or '', 'text': (m.get('text') or '')[:1500], 'at': m.get('at') or 0}
            for m in (st.get('inbox') or [])[-30:]]  # (oldest first: the newest 30)
    locks = [{'key': l.get('key') or '', 'holder': l.get('holder') or '', 'branch': l.get('branch') or '', 'repo': os.path.basename(l.get('repo') or ''),
              'since': l.get('since') or 0, 'why': l.get('why') or '', 'waiters': list(l.get('waiters') or [])} for l in st.get('lock_issues') or []]
    return {'workspaces': spaces, 'tasks': tasks, 'boards': chans[:60], 'mail': mail, 'locks': locks}


def app_session(deck, sid):
    """One session as its page on the phone shows it beyond the list: what it asked of the person (each to tick off),
    its report, the tasks it is on, the sub-agents it started, and the messages to and from it. None when it is gone."""
    s = deck.find(sid)
    if not s:
        return None
    with deck.lock:
        st = deck.state
        rep, talk, tasks = (st.get('reports') or {}).get(sid) or {}, list(st.get('talk') or []), list(st.get('tasks') or [])
        reporting, sessions = sid in (st.get('reporting') or []), list(st['sessions'])
        mail = [m for m in st.get('inbox') or [] if m.get('from') == s['name']]
    mine = [t for t in tasks if any(x.get('sid') == sid if x.get('sid') else x.get('name') == s['name'] for x in t.get('sessions') or [])]
    kids = [{'id': k['id'], 'name': k['name'], 'kind': k['kind'], 'title': app_title(k), 'standing': app_standing(k),
             'running': bool(k.get('pid')) and k['state'] not in ('gone', 'ended')} for k in sessions if k.get('parent_id') == sid]
    msgs = sorted(({'from': m.get('from') or '', 'to': m.get('to') or '', 'text': (m.get('text') or '')[:2000], 'at': m.get('at') or 0}
                   for m in talk if s['name'] in (m.get('from'), m.get('to'))), key=lambda m: m['at'])[-80:]
    return {'ok': True, 'id': sid, 'asks': [{k: a.get(k) for k in ('id', 'what', 'quote', 'at')} for a in s.get('asks') or []],
            'report': rep.get('r'), 'report_at': rep.get('at') or 0, 'reporting': reporting,
            'tasks': [{k: t.get(k) for k in ('id', 'title', 'status', 'shown', 'now', 'next', 'scope', 'scope_name', 'at')} for t in mine][:20],
            'kids': kids, 'msgs': msgs, 'mail': [{'id': m.get('id'), 'text': (m.get('text') or '')[:1500], 'at': m.get('at')} for m in mail],
            'cwd': tilde(s.get('home') or s.get('cwd') or ''), 'pane': (s.get('loc') or {}).get('pane') or ''}


def app_kept_page(deck, kid):
    """One session that lasts as its page on the phone shows it beyond the list: what it is, the terminals it has run in
    and its conversations; its report and its story (of the row that runs it, else of its latest conversation, as the
    page reads them); and while it runs, what app_session says of that row, with Claude Code's own sub-agents. None when
    the record has no such session."""
    page = deck.kept_page(kid)
    if not page:
        return None
    k, lid = page['kept'], page['kept'].get('live') or ''
    s = deck.find(lid) if lid else None
    base = (app_session(deck, lid) if s else None) or {'ok': True, 'id': '', 'asks': [], 'tasks': [], 'kids': [], 'msgs': [], 'mail': [], 'cwd': k.get('show') or '', 'pane': ''}
    conv = (k.get('segs') or [{}])[-1].get('conv') or ''
    rid = lid or (f"{k.get('kind')}:{conv}" if conv else '')  # (a stopped one's report and story were kept under its last conversation)
    with deck.lock:
        st = deck.state
        rep, reporting = (st.get('reports') or {}).get(rid) or {}, rid in (st.get('reporting') or [])
    stories = getattr(deck, 'stories', None)
    if stories is not None and s and rid not in stories.data:
        stories.asked.add(rid)  # (as /api/story: asking for one it lacks makes the deck build it)
    meta = (getattr(deck, 'kept', None) or {}).get(kid) or {}
    par = s and s.get('parent_id') and deck.find(s['parent_id'])
    return {**base, 'report': rep.get('r'), 'report_at': rep.get('at') or 0, 'reporting': reporting, 'rid': rid,
            'story': stories.view(rid) if stories is not None and rid else None,
            'summary': ((s or {}).get('summary') or k.get('note') or '')[:1500], 'origin': (s or {}).get('origin') or '',
            'started_by': {'id': par['id'], 'title': app_title(par)} if par else None,
