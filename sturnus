        write_private(ACCESS, d)
    return d


class Access:
    """Every page and call needs the token once per browser; the browser then holds a session cookie for 30 days."""

    def __init__(self):
        self.lock = threading.Lock()
        self.fails = deque(maxlen=20)
        self.d, self.mtime = access_data(), os.path.getmtime(ACCESS)

    def fresh(self):  # (`sturnus token --rotate` writes the file under the running service)
        m = os.path.getmtime(ACCESS) if os.path.exists(ACCESS) else 0
        if m != self.mtime:
            self.d, self.mtime = access_data(), os.path.getmtime(ACCESS)

    def save(self):
        write_private(ACCESS, self.d)
        self.mtime = os.path.getmtime(ACCESS)

    @staticmethod
    def key(sid):
        return hashlib.sha256(sid.encode()).hexdigest()  # (what is kept is a hash: the file holds no live cookie)

    def check(self, sid):
        with self.lock:
            self.fresh()
            s = sid and self.d['sessions'].get(self.key(sid))
            return bool(s) and time.time() - s['at'] < 30 * DAY

    def login(self, token, who):
        now = time.time()
        with self.lock:
            self.fresh()
            if sum(1 for t in self.fails if now - t < 600) >= 8:
                return None, '试错太多次，10 分钟后再试'
            if not hmac.compare_digest(token.encode(), self.d['token'].encode()):
                self.fails.append(now)
                return None, '令牌不对'
            sid = secrets.token_urlsafe(32)
            self.d['sessions'] = {k: v for k, v in self.d['sessions'].items() if now - v['at'] < 30 * DAY}
            self.d['sessions'][self.key(sid)] = {'at': now, 'who': who}
            self.save()
            return sid, ''

    def drop(self, key):
        with self.lock:
            self.fresh()
            if self.d['sessions'].pop(key, None):
                self.save()

    def listing(self, mine):
        with self.lock:
            self.fresh()
            return [{'key': k, 'who': v['who'], 'at': v['at'], 'me': k == mine} for k, v in
                    sorted(self.d['sessions'].items(), key=lambda kv: -kv[1]['at'])]


