# ---------- access: a login token, then a session cookie per browser ----------

ACCESS = os.path.join(os.path.dirname(CONF), 'access.json')  # (0600: the token, the signed-in browsers, the paired phones)
DAY = 86400
PAIR_ABC, PAIR_LIFE = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789', 600  # (no 0/O, 1/I/L: a code read off a screen and typed)


def write_private(path, data):
    """All of it or none: written beside the file (0600), then put in its place, so no reader sees half a file."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f'.{os.path.basename(path)}.{os.getpid()}.{threading.get_ident()}.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, json.dumps(data).encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


@contextlib.contextmanager
def access_locked():
    """The access file's read-change-write, one process at a time: the service, `sturnus token`, `sturnus pair`."""
    os.makedirs(os.path.dirname(ACCESS), exist_ok=True)
    fd = os.open(ACCESS + '.lock', os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def access_read():
    """The access file ({} when there is none). One that cannot be read is an error, never a reason for a new token:
    that would sign out every browser and phone."""
    try:
        with open(ACCESS) as f:
            d = json.load(f)
    except FileNotFoundError:
        return {}
    if not isinstance(d, dict):
        raise ValueError(f'{ACCESS} is not an object')
    return d


def access_data(rotate=False):
    with access_locked():
        try:
            d = {} if rotate else access_read()
        except ValueError as e:
            raise SystemExit(f'{ACCESS} cannot be read ({e}); `sturnus token --rotate` makes a new one (everyone signs in again)')
        if rotate or not d.get('token'):
            d = {'token': secrets.token_urlsafe(24), 'sessions': {}}  # (a new token signs every browser and phone out)
            write_private(ACCESS, d)
        return d


def access_mtime():
    try:
        return os.stat(ACCESS).st_mtime_ns
    except OSError:
        return 0


class Access:
    """Every page and call needs the token once per browser; the browser then holds a session cookie for 30 days."""

    def __init__(self):
        self.lock = threading.Lock()
        self.fails = {}  # (who → when they tried a wrong token or code: each caller its own count)
        self.d, self.mtime = access_data(), access_mtime()

    def fresh(self, force=False):  # (`sturnus token --rotate` and `sturnus pair` write the file under the running service)
        m = access_mtime()
        if force or m != self.mtime:
            try:
                d = access_read()
            except ValueError:
                return  # (kept as it was; read again next time)
            if d.get('token'):
                self.d, self.mtime = d, m

    @contextlib.contextmanager
    def changing(self):
        """Read, change and save the file with no other thread or process in between."""
        with self.lock, access_locked():
            self.fresh(force=True)
            yield

    def save(self):
        write_private(ACCESS, self.d)
        self.mtime = access_mtime()

    @staticmethod
    def key(sid):
        return hashlib.sha256(sid.encode()).hexdigest()  # (what is kept is a hash: the file holds no live cookie)

    def tries(self, who, now):
        return sum(1 for t in self.fails.get(who) or () if now - t < 600)

    def wrong(self, who, now):
        if len(self.fails) > 200:
            self.fails = {k: v for k, v in self.fails.items() if v and now - v[-1] < 600}
        self.fails.setdefault(who, deque(maxlen=20)).append(now)

    def check(self, sid):
        with self.lock:
            self.fresh()
            s = sid and self.d['sessions'].get(self.key(sid))
            return bool(s) and time.time() - s['at'] < 30 * DAY

    def login(self, token, who):
        now = time.time()
        with self.changing():
            if self.tries(who, now) >= 8:
                return None, tx('试错太多次，10 分钟后再试', 'Too many wrong tries; try again in 10 minutes')
            if not hmac.compare_digest(token.encode(), self.d['token'].encode()):
                self.wrong(who, now)
                return None, tx('令牌不对', 'Wrong token')
            sid = secrets.token_urlsafe(32)
            self.d['sessions'] = {k: v for k, v in self.d['sessions'].items() if now - v['at'] < 30 * DAY}
            self.d['sessions'][self.key(sid)] = {'at': now, 'who': who}
            self.save()
            return sid, ''

    def drop(self, key):
        with self.changing():
            if self.d['sessions'].pop(key, None) or (self.d.get('devices') or {}).pop(key, None):
                self.save()

    # (the phone app: a pairing code made here, typed or scanned on the phone, buys that phone a key of its own; the key
    # is sent as "Authorization: Bearer", kept as a hash, and holds until the phone is taken out or the token rotated)

    def pair_code(self):
        """A new code; any earlier one stops working (a code once shown on a screen may have been seen)."""
        code = ''.join(secrets.choice(PAIR_ABC) for _ in range(8))
        with self.changing():
            self.d['codes'] = {self.key(code): time.time() + PAIR_LIFE}
            self.save()
        return code

    def pair(self, code, device, who):
        now, code = time.time(), re.sub(r'[^A-Z0-9]', '', str(code).upper())
        with self.changing():
            if self.tries(who, now) >= 8:
                return None, tx('试错太多次，10 分钟后再试', 'Too many wrong tries; try again in 10 minutes')
            codes = self.d.get('codes') or {}
            if codes.pop(self.key(code), 0) < now:  # (used once: a code that worked is gone, as is one that ran out)
                self.wrong(who, now)
                return None, tx('配对码不对，或者已经过期：在电脑上的设置 → 访问里再生成一个', 'Wrong or expired pairing code: make a new one in Settings → Access on the computer')
            key = secrets.token_urlsafe(32)
            name = re.sub(r'\s+', ' ', str(device or '')).strip()[:60] or 'iPhone'
            self.d.setdefault('devices', {})[self.key(key)] = {'name': name, 'at': now, 'seen': now, 'who': who}
            self.save()
            return key, ''

    def device(self, key):
        """The paired phone a key belongs to, or None."""
        if not key:
            return None
        h = self.key(key)
        with self.lock:
            self.fresh()
            d = (self.d.get('devices') or {}).get(h)
        if d and time.time() - d.get('seen', 0) > 3600:  # (when it was last seen, to the hour: not a write per call)
            with self.changing():
                d = (self.d.get('devices') or {}).get(h)
                if d:
                    d['seen'] = time.time()
                    self.save()
        return d

    def devices(self):
        with self.lock:
            self.fresh()
            return [{'key': k, 'name': v['name'], 'at': v['at'], 'seen': v.get('seen'), 'who': v.get('who')} for k, v in
                    sorted((self.d.get('devices') or {}).items(), key=lambda kv: -kv[1]['at'])]

    def listing(self, mine):
        with self.lock:
            self.fresh()
            return [{'key': k, 'who': v['who'], 'at': v['at'], 'me': k == mine} for k, v in
                    sorted(self.d['sessions'].items(), key=lambda kv: -kv[1]['at'])]


_tailnet = {'at': 0}


@functools.lru_cache(None)
def tailscale():
    """The tailscale command, as the start of an argv; None without one. On macOS the app's own (a Homebrew one can be
    older than the app's daemon), through sh with stdin from /dev/null: run straight from a launchd job, it starts as the
    app and fails, not as the command line."""
    app = '/Applications/Tailscale.app/Contents/MacOS/Tailscale'
    if MAC and os.path.exists(app):
        return ['/bin/sh', '-c', 'exec "$0" "$@" < /dev/null', app]
    found = shutil.which('tailscale')
    return [found] if found else None


def tailnet_self():
    """This machine's tailnet name and its owner's login (looked up again every few minutes), or (None, None)."""
    if time.time() - _tailnet['at'] > 300:
        r = run([*tailscale(), 'status', '--json'], timeout=5) if tailscale() else None
        try:
            d = json.loads(r.stdout)
            me = d['Self']
            _tailnet.update(name=me['DNSName'].rstrip('.').lower(), owner=d['User'][str(me['UserID'])]['LoginName'],
                            ips=[x for x in me.get('TailscaleIPs') or [] if '.' in x])
        except (AttributeError, ValueError, KeyError, TypeError):
            _tailnet.update(name=None, owner=None, ips=[])
        _tailnet['at'] = time.time()
    return _tailnet.get('name'), _tailnet.get('owner')


