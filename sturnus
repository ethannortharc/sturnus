class Stories:
    """Each session's story: a timeline cut at the person's words (what they asked, what got done, what was settled, what
    came out), and what was settled merged by topic, the latest word on each (what it replaced kept under it). Built by
    the summary model a few pieces at a time, when a turn has ended."""

    def __init__(self):
        self.file = os.path.join(CACHE, 'stories.json')
        self.data = A.get(self.file, {}) or {}
        self.cuts = Cuts()
        self.asked, self.busy, self.error, self.tried, self.failed = set(), None, '', {}, {}

    @staticmethod
    def key(seg):
        return hashlib.sha1(json.dumps([seg['at'], seg['ask'], seg['reply']], ensure_ascii=False).encode()).hexdigest()[:12]

    def todo(self, s):
        """The pieces of its conversation the story does not have yet (or has an older reading of); None without one."""
        path = transcript_of(s)
        if not path:
            return None
        segs = self.cuts.of(path)
        if s['state'] == 'working' and s['id'] not in self.asked:
            segs = segs[:-1]  # (the turn under way: read once it ends)
        turns = (self.data.get(s['id']) or {}).get('turns') or []
        i = next((i for i, t in enumerate(turns) if i >= len(segs) or t['k'] != self.key(segs[i])), len(turns))
        return segs, i

    def due(self, s):
        if s.get('starting') or (s['id'] not in self.asked and (s.get('stale') or s['state'] in ('gone', 'ended'))):
            return False
        if s['id'] not in self.asked and time.time() - self.tried.get(s['id'], 0) < 60:
            return False  # (at most a run a minute for one session: a failing model is not hammered)
        t = self.todo(s)
        if not t:
            self.asked.discard(s['id'])  # (nothing to read: no conversation file)
            return False
        cur = self.data.get(s['id']) or {}
        return t[1] < len(t[0]) or (cur.get('merged') or 0) < len(cur.get('turns') or []) or s['id'] in self.asked

    def make(self, s, cfg):
        sid = s['id']
        self.tried[sid] = time.time()
        t = self.todo(s)
        self.asked.discard(sid)
        if not t:
            return
        segs, i = t
        cur = self.data.get(sid) or {}
        turns, topics, merged = list((cur.get('turns') or [])[:i]), cur.get('topics') or [], min(cur.get('merged') or 0, i)
        self.busy = sid
        try:
            for _ in range(3):  # (a few batches a run: a long conversation is caught up over several runs)
                batch, size = [], 0
                for n in range(len(turns), len(segs)):
                    g = segs[n]
                    text = f'【第 {n + 1} 段】\n' + '\n'.join(f'{"他说" if j == 0 else "中途"}：{a[:600]}' for j, a in enumerate(g['ask'][:4])) + f'\nagent 最后说：{g["reply"][:1500] or "（还没有）"}'
                    if batch and (size + len(text) > 14000 or len(batch) == 10):
                        break
                    batch.append((n, text))
                    size += len(text)
                if not batch:
                    break
                got, at = {}, (sid, batch[0][0])
                try:
                    out = ask_model(TURNS.format(kind=s['kind'], name=s['name'], cwd=s.get('cwd') or '?', segs='\n\n'.join(x for _, x in batch)), cfg, 'summary')
                    for r in json.loads(re.search(r'\{.*\}', out, re.S).group(0)).get('turns') or []:
                        if isinstance(r, dict) and str(r.get('n')).isdigit():
                            got[int(r['n'])] = r
                except Exception:
                    self.failed[at] = self.failed.get(at, 0) + 1
                    if self.failed[at] < 3:
                        raise
                    self.error = ''  # (the third time on the same turns: they go in with your words alone, and it moves on)
                for n, _ in batch:
                    r, g = got.get(n + 1) or {}, segs[n]
                    lst = lambda k, w: [one_line(x, w) for x in (r.get(k) or []) if isinstance(x, str) and one_line(x, w)][:3]
                    turns.append({'k': self.key(g), 'at': g['at'], 'words': one_line(g['ask'][0], 300), 'more': len(g['ask']) - 1,
                                  'ask': one_line(r.get('ask'), 80) or one_line(g['ask'][0], 80), 'done': lst('done', 120), 'out': lst('out', 200),
                                  'decided': [{'what': one_line(d.get('what'), 100), 'by': 'user' if d.get('by') == 'user' else 'agent', 'why': one_line(d.get('why'), 120)}
                                              for d in (r.get('decided') or []) if isinstance(d, dict) and one_line(d.get('what'), 100)][:3]})
                self.data[sid] = {**cur, 'name': s['name'], 'turns': turns, 'topics': topics, 'merged': merged, 'at': time.time(), 'left': len(segs) - len(turns)}
            decs = [(n, d) for n, t in enumerate(turns[merged:], merged + 1) for d in t['decided']]
            while decs:  # (merged by topic, sixty at a time over what is there)
                part, decs = decs[:60], decs[60:]
                out = ask_model(TOPICS.format(cap=24, topics=json.dumps(topics, ensure_ascii=False) if topics else '（还没有）',
                                              decs='\n'.join(f'{n}｜{"他" if d["by"] == "user" else "agent"}｜{d["what"]}｜{d["why"]}' for n, d in part)), cfg, 'summary')
                got = json.loads(re.search(r'\{.*\}', out, re.S).group(0)).get('topics') or []
                topics = [{'topic': one_line(x.get('topic'), 24), 'now': one_line(x.get('now'), 120), 'by': 'user' if x.get('by') == 'user' else 'agent',
                           'n': int(x['n']) if str(x.get('n')).isdigit() and 0 < int(x['n']) <= len(turns) else None, 'why': one_line(x.get('why'), 140),
                           'was': [one_line(w, 120) for w in (x.get('was') or []) if isinstance(w, str) and one_line(w, 120)][:6]}
                          for x in got if isinstance(x, dict) and one_line(x.get('now'), 120)][:24]
                merged = part[-1][0]
            self.data[sid] = {**cur, 'name': s['name'], 'turns': turns, 'topics': topics, 'merged': len(turns), 'at': time.time(), 'left': len(segs) - len(turns)}
            self.error = ''
        except Exception as e:
            self.error = f'{type(e).__name__}: {e}'[:300]
            if turns:  # (what got read before the failure stays)
                self.data[sid] = {**cur, 'name': s['name'], 'turns': turns, 'topics': topics, 'merged': merged, 'at': time.time(), 'left': len(segs) - len(turns)}
        finally:
            self.busy = None
            week = time.time() - 7 * DAY
            self.data = {k: v for k, v in self.data.items() if v.get('at', 0) > week}
            os.makedirs(CACHE, exist_ok=True)
            A.put(self.file, self.data)

    def view(self, sid):
        cur = self.data.get(sid) or {}
        turns = cur.get('turns') or []
        return {'turns': [{k: t.get(k) for k in ('at', 'words', 'more', 'ask', 'done', 'decided', 'out')} for t in turns],
                'topics': [{**x, 'at': turn_at(turns, x.get('n'))} for x in cur.get('topics') or []],
                'at': cur.get('at'), 'left': cur.get('left', 0), 'busy': self.busy == sid, 'asked': sid in self.asked}

    def latest(self, n=150):
        """The latest word on each topic, across the sessions: for the project pages and the workspace feeds."""
        out = []
        for sid, cur in self.data.items():
            turns = cur.get('turns') or []
            out += [{'sid': sid, 'name': cur.get('name'), 'topic': x['topic'], 'what': x['now'], 'by': x['by'],
                     'at': turn_at(turns, x.get('n')) or cur.get('at')} for x in cur.get('topics') or []]
        return sorted(out, key=lambda x: -(x['at'] or 0))[:n]


